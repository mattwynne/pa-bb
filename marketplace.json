{
  "$schema": "https://getbb.app/schemas/marketplace-v2.schema.json",
  "schemaVersion": 2,
  "name": "pa-for-bb",
  "displayName": "PA for BB",
  "description": "Personal assistant integrations for BB, installed separately as needed.",
  "plugins": [
    {
      "id": "google-calendar",
      "displayName": "Google Calendar",
      "description": "Connect multiple Google accounts and use Calendar tools from BB.",
      "icon": "Calendar",
      "tags": ["calendar", "google", "productivity"],
      "author": { "name": "Matt Wynne", "github": "mattwynne" },
      "source": {
        "git": { "url": "https://github.com/mattwynne/pa-bb.git", "subdir": "plugins/google-calendar", "ref": "main" }
      }
    },
    {
      "id": "fastmail",
      "displayName": "Fastmail",
      "description": "Connect one Fastmail account and use the mail, calendar, contacts and other tools granted by Fastmail.",
      "icon": "Mail",
      "tags": ["fastmail", "mail", "calendar", "contacts"],
      "author": { "name": "Matt Wynne", "github": "mattwynne" },
      "source": {
        "git": { "url": "https://github.com/mattwynne/pa-bb.git", "subdir": "plugins/fastmail", "ref": "main" }
      }
    },
    {
      "id": "google-drive",
      "displayName": "Google Drive",
      "description": "Find files and folders in Google Drive and read Google Docs, with a read-only grant.",
      "icon": "HardDrive",
      "tags": ["drive", "docs", "google", "productivity"],
      "author": { "name": "Matt Wynne", "github": "mattwynne" },
      "source": {
        "git": { "url": "https://github.com/mattwynne/pa-bb.git", "subdir": "plugins/google-drive", "ref": "main" }
      }
    }
  ]
}
