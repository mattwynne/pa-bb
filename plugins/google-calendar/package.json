{
  "name": "bb-plugin-google-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.45.0",
    "bbPluginSdk": ">=0.6.15 <1"
  },
  "bb": {
    "name": "Google Calendar",
    "description": "Connect Google accounts and work with their calendars in BB.",
    "branding": {
      "icon": "Calendar"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/react": "19.2.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bb-app": "0.45.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node ../../scripts/sync-connection-ui.mjs --check && npm run build && cucumber-js --format progress && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && bb plugin types --check",
    "build": "bb plugin build"
  }
}
