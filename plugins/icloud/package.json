{
  "name": "bb-plugin-icloud",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.45.0",
    "bbPluginSdk": ">=0.6.15 <1"
  },
  "bb": {
    "name": "iCloud",
    "description": "Sync selected iCloud Drive folders with persistent local folders.",
    "branding": {
      "icon": "Cloud"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "bb-app": "0.45.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "playwright": "^1.51.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit && bb plugin types --check",
    "spec": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --import 'features/step_definitions/*.ts' --format progress",
    "test": "node ../../scripts/sync-connection-ui.mjs --check && npm run build && npm run spec && node --import tsx --test test/*.test.ts"
  }
}
