+package bisync
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"os"
+	"path"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+)
+
+const bbDeliveryLimit = 256
+const bbDeliveryBytes = 1 << 20
+const bbDeliveryStateLimit = 3 << 20
+
+var bbOperationID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var ErrBBDeliveryUnsettled = errors.New("an expedited iCloud publication still needs verification")
+var errBBInvalidDelivery = errors.New("invalid expedited delivery record")
+
+type BBDeliveryIntent struct {
+	OperationID string
+	Path        string
+	Hash        [sha256.Size]byte
+	Create      bool
+}
+
+type BBDeliveryReceipt struct {
+	BBDeliveryIntent
+	Modified         time.Time
+	Size             int64
+	DocumentID       string
+	ProviderID       string
+	ETag             string
+	RemovedPath      string `json:",omitempty"`
+	ProviderParentID string `json:",omitempty"`
+}
+
+type bbDeliveryStore struct {
+	Version           int
+	Pending           *BBDeliveryIntent
+	Relocation        *BBRelocation `json:",omitempty"`
+	Dispatched        bool
+	AllocatedDocument string
+	Applied           []BBDeliveryReceipt
+	Confirmed         []BBDeliveryReceipt
+}
+
+func bbDeliveryPath(workdir string) string { return filepath.Join(workdir, "bb-delivery-v1.json") }
+
+func validBBDelivery(intent BBDeliveryIntent) bool {
+	p := intent.Path
+	return bbOperationID.MatchString(intent.OperationID) && intent.Hash != ([sha256.Size]byte{}) &&
+		p != "." && len(p) <= 1024 && path.Clean(p) == p && !path.IsAbs(p) &&
+		!strings.HasPrefix(p, "../") && !strings.ContainsAny(p, "\\\x00\r\n") && strings.HasSuffix(p, ".md")
+}
+
+func validBBReceipt(receipt BBDeliveryReceipt) bool {
+	return validBBDelivery(receipt.BBDeliveryIntent) &&
+		(receipt.RemovedPath == "" || (receipt.Create && receipt.ProviderParentID != "" && receipt.ProviderID != "" && receipt.ETag != "" && receipt.DocumentID != "" && validBBRelocationPaths(receipt.RemovedPath, receipt.BBDeliveryIntent)))
+}
+
+func readBBDeliveries(workdir string) (bbDeliveryStore, error) {
+	raw, err := bbReadBounded(bbDeliveryPath(workdir), bbDeliveryStateLimit)
+	if errors.Is(err, os.ErrNotExist) {
+		return bbDeliveryStore{Version: 1}, nil
+	}
+	if err != nil {
+		return bbDeliveryStore{}, err
+	}
+	var state bbDeliveryStore
+	if err := json.Unmarshal(raw, &state); err != nil || (state.Version != 1 && state.Version != 2) ||
+		(state.Relocation != nil && (state.Version != 2 || state.Pending != nil || !state.Relocation.valid())) ||
+		len(state.Confirmed) > bbDeliveryLimit || len(state.Applied) > bbDeliveryLimit || (state.Pending == nil && state.Dispatched) || (state.Pending != nil && !validBBDelivery(*state.Pending)) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	seen := map[string]bool{}
+	for _, receipt := range state.Confirmed {
+		if !validBBReceipt(receipt) || (state.Version == 1 && receipt.RemovedPath != "") || seen[receipt.Path] || receipt.Modified.IsZero() ||
+			receipt.Size < 1 || receipt.Size > bbDeliveryBytes {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+		seen[receipt.Path] = true
+	}
+	for _, receipt := range state.Applied {
+		if !validBBReceipt(receipt) || (state.Version == 1 && receipt.RemovedPath != "") || receipt.Modified.IsZero() || receipt.Size < 1 || receipt.Size > bbDeliveryBytes {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	}
+	return state, nil
+}
+
+func (state bbDeliveryStore) write(workdir string) error {
+	raw, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	if !filepath.IsAbs(workdir) || len(raw) > bbDeliveryStateLimit {
+		return errBBInvalidDelivery
+	}
+	return (bbListingPair{directory: workdir}).publishFile(bbDeliveryPath(workdir), raw, false)
+}
+
+// All delivery state transitions run while the caller owns this mirror's
+// mutation lock. The intent is durable before any request can publish bytes.
+func BBBeginDelivery(workdir string, intent BBDeliveryIntent) error {
+	if !validBBDelivery(intent) {
+		return errBBInvalidDelivery
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending != nil || state.Relocation != nil {
+		return ErrBBDeliveryUnsettled
+	}
+	if slices.ContainsFunc(state.Confirmed, func(receipt BBDeliveryReceipt) bool {
+		return receipt.RemovedPath != "" && (equalBBPaths(receipt.Path, intent.Path) || equalBBPaths(receipt.RemovedPath, intent.Path))
+	}) {
+		return ErrBBDeliveryUnsettled
+	}
+	if len(state.Confirmed) == bbDeliveryLimit && !slices.ContainsFunc(state.Confirmed, func(r BBDeliveryReceipt) bool { return r.Path == intent.Path }) {
+		return ErrBBDeliveryUnsettled
+	}
+	state.Pending = &intent
+	return state.write(workdir)
+}
+
+// Resolve only from verified provider evidence. A definitive precondition
+// refusal is represented by a nil receipt; uncertain attempts stay pending.
+func BBResolveDelivery(workdir string, intent BBDeliveryIntent, receipt *BBDeliveryReceipt) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending == nil || *state.Pending != intent {
+		return errBBInvalidDelivery
+	}
+	if receipt != nil {
+		if receipt.BBDeliveryIntent != intent || receipt.Modified.IsZero() || receipt.Size < 1 || receipt.Size > bbDeliveryBytes {
+			return errBBInvalidDelivery
+		}
+		recorded := *receipt
+		if intent.Create {
+			recorded.DocumentID = state.AllocatedDocument
+		}
+		receipt = &recorded
+		index := slices.IndexFunc(state.Confirmed, func(old BBDeliveryReceipt) bool { return old.Path == receipt.Path })
+		if index >= 0 {
+			// Keep the fact that this path may not exist in the prior listing until
+			// both listings have incorporated the earliest create receipt.
+			kept := *receipt
+			kept.Create = kept.Create || state.Confirmed[index].Create
+			state.Confirmed[index] = kept
+		} else {
+			state.Confirmed = append(state.Confirmed, *receipt)
+		}
+	}
+	state.Pending = nil
+	state.Dispatched = false
+	state.AllocatedDocument = ""
+	return state.write(workdir)
+}
+
+// BBDispatchDelivery is written after all precondition checks and immediately
+// before the conditional content publication request.
+func BBDispatchDelivery(workdir string, intent BBDeliveryIntent, allocated ...string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending == nil || *state.Pending != intent {
+		return errBBInvalidDelivery
+	}
+	if intent.Create {
+		if len(allocated) != 1 || allocated[0] == "" || len(allocated[0]) > 512 || state.Dispatched {
+			return errBBInvalidDelivery
+		}
+		state.AllocatedDocument = allocated[0]
+	}
+	state.Dispatched = true
+	return state.write(workdir)
+}
+
+func BBAllocatedDocument(workdir string, intent BBDeliveryIntent) (string, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return "", err
+	}
+	if !intent.Create {
+		return "", errBBInvalidDelivery
+	}
+	if state.Pending != nil && *state.Pending == intent && state.Dispatched && state.AllocatedDocument != "" {
+		return state.AllocatedDocument, nil
+	}
+	same := func(r BBDeliveryReceipt) bool {
+		return r.OperationID == intent.OperationID && r.Path == intent.Path && r.Hash == intent.Hash
+	}
+	for _, receipts := range [][]BBDeliveryReceipt{state.Confirmed, state.Applied} {
+		if i := slices.IndexFunc(receipts, same); i >= 0 && receipts[i].DocumentID != "" {
+			return receipts[i].DocumentID, nil
+		}
+	}
+	return "", errBBInvalidDelivery
+}
+
+type BBDeliveryStage string
+
+const (
+	BBDeliveryMissing    BBDeliveryStage = "missing"
+	BBDeliveryPrepared   BBDeliveryStage = "prepared"
+	BBDeliveryDispatched BBDeliveryStage = "dispatched"
+	BBDeliveryRecorded   BBDeliveryStage = "recorded"
+	BBDeliveryApplied    BBDeliveryStage = "applied"
+)
+
+func BBReadDeliveryStage(workdir string, intent BBDeliveryIntent) (BBDeliveryStage, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return "", err
+	}
+	if state.Pending != nil && *state.Pending == intent {
+		if state.Dispatched {
+			return BBDeliveryDispatched, nil
+		}
+		return BBDeliveryPrepared, nil
+	}
+	equal := func(r BBDeliveryReceipt) bool {
+		return r.OperationID == intent.OperationID && r.Path == intent.Path && r.Hash == intent.Hash
+	}
+	if slices.ContainsFunc(state.Confirmed, equal) {
+		return BBDeliveryRecorded, nil
+	}
+	if slices.ContainsFunc(state.Applied, equal) {
+		return BBDeliveryApplied, nil
+	}
+	return BBDeliveryMissing, nil
+}
