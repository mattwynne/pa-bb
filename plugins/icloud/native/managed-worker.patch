+func TestOwnedRecoveryUsesStagedDataWhenTheLocalNoteIsSuperseded(t *testing.T) {
+	for _, create := range []bool{false, true} {
+		for _, beforeDispatch := range []bool{false, true} {
+			name := "replace"
+			if create {
+				name = "create"
+			}
+			timing := "lost response"
+			if beforeDispatch {
+				timing = "before dispatch"
+			}
+			for _, text := range []string{"first BB edit", ""} {
+				variant := "nonempty"
+				if text == "" {
+					variant = "empty"
+				}
+				t.Run(name+"/"+timing+"/"+variant, func(t *testing.T) {
+					fixture := ownedRecoveryFixture{beforeDispatch: beforeDispatch, loseResponse: !beforeDispatch}
+					request := ownedNoteFrame{Workdir: t.TempDir(), Binding: "parent", Path: "Generated.md",
+						OperationID: "40b59f60-57ab-4486-a651-8b265a4ddda3", Text: &text}
+					apply := applyOwnedReplacement
+					recover := "recover"
+					if create {
+						recover = "recover-create"
+						apply = func(ctx context.Context, _ ownedReplacementCloud, operation string, request ownedNoteFrame) ownedNoteReply {
+							return applyOwnedCreate(ctx, &fixture, operation, request)
+						}
+					} else {
+						previousHash := sha256.Sum256([]byte("previous content"))
+						fixture.current = iclouddrive.BBNotePublication{
+							Revision: iclouddrive.BBNoteRevision{DriveID: "FILE::com.apple.CloudDocs::original", ParentID: "parent", ETag: "previous", Hash: previousHash},
+							Modified: time.Unix(100, 0), Size: 16,
+						}
+						request.Expected = &ownedNoteVersion{DocumentID: fixture.current.Revision.DriveID,
+							ParentID: "parent", ETag: "previous", Hash: hex.EncodeToString(previousHash[:])}
+					}
+					if reply := apply(context.Background(), &fixture, name, request); reply.Outcome != "uncertain" {
+						t.Fatalf("first publication = %s", reply.Outcome)
+					}
+					intent := bisync.BBDeliveryIntent{OperationID: request.OperationID, Path: request.Path,
+						Hash: sha256.Sum256([]byte(*request.Text)), Create: create}
+					if data, err := bisync.BBPendingDeliveryData(request.Workdir, intent); err != nil || data == nil || string(data) != text {
+						t.Fatal("the uncertain publication did not retain its bytes")
+					}
+					// The next BB edit has already replaced the mirror file. The
+					// command can rely only on the durable identity and wanted hash.
+					request.WantedHash = hex.EncodeToString(intent.Hash[:])
+					request.Text = nil
+					reply := apply(context.Background(), &fixture, recover, request)
+					if reply.Outcome != "published" || reply.Observation == nil || reply.Observation.Hash != request.WantedHash {
+						t.Fatalf("hash-only recovery = %s", reply.Outcome)
+					}
+					wantCalls := 1
+					if beforeDispatch {
+						wantCalls++
+					}
+					if fixture.attempts != wantCalls || string(fixture.sent) != text {
+						t.Fatalf("published the wrong revision or repeated a confirmed request (%d attempts)", fixture.attempts)
+					}
+					if data, err := bisync.BBPendingDeliveryData(request.Workdir, intent); err != nil || len(data) != 0 {
+						t.Fatal("verified publication kept staging bytes")
+					}
+				})
+			}
+		}
+	}
+}
