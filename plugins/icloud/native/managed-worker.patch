+package main
+
+import (
+	"context"
+	"errors"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type ownedCloneMover interface {
+	ownedCloneCloud
+	BBMoveFolder(context.Context, iclouddrive.BBFolderItem, string) error
+	BBRetireCopiedFolderItemWithDispatch(context.Context, string, iclouddrive.BBFolderItem, func() error, func() error) error
+}
+
+var errFolderDeferredToScheduledSync = errors.New("unconfirmed folder copy deferred to scheduled sync")
+
+func cloneLocation(ctx context.Context, cloud folderProofCloud, journal *bisync.BBFolderCloneJournal, entry string, copied bool) (*iclouddrive.BBFolderItem, error) {
+	intent := journal.Intent
+	location := intent.Source
+	var parent string
+	var err error
+	if copied {
+		location = intent.Path
+		if journal.Published == nil {
+			parent = journal.Stage.DocumentID
+		} else {
+			parent, err = folderParentByName(ctx, cloud, intent.Binding, path.Dir(location))
+			if err != nil || parent != intent.DestinationParent {
+				return nil, api.ErrConditionalConflict
+			}
+		}
+	} else {
+		parent, err = folderParentByName(ctx, cloud, intent.Binding, path.Dir(location))
+	}
+	if err != nil {
+		return nil, err
+	}
+	item, err := cloneFolderLeaf(ctx, cloud, intent.Binding, parent, path.Base(location))
+	if err != nil || item == nil {
+		return item, err
+	}
+	expected := func(name string) bisync.BBIndexedVersion {
+		if copied {
+			return journal.Copies[name]
+		}
+		return intent.Entries[name].BBIndexedVersion
+	}
+	if item.DocumentID != expected(intent.Source).DocumentID || !item.Directory {
+		return nil, api.ErrConditionalConflict
+	}
+	current := intent.Source
+	suffix := strings.TrimPrefix(entry, current)
+	if suffix == "" {
+		return item, nil
+	}
+	for _, leaf := range strings.Split(strings.TrimPrefix(suffix, "/"), "/") {
+		if !item.Directory {
+			return nil, api.ErrConditionalConflict
+		}
+		parent = item.DocumentID
+		current = path.Join(current, leaf)
+		item, err = cloneFolderLeaf(ctx, cloud, intent.Binding, parent, leaf)
+		if err != nil || item == nil {
+			return item, err
+		}
+		if item.DocumentID != expected(current).DocumentID ||
+			item.Directory != intent.Entries[current].Directory {
+			return nil, api.ErrConditionalConflict
+		}
+	}
+	return item, nil
+}
+
+func advanceCloneRetirement(ctx context.Context, cloud ownedCloneMover, workdir string, journal *bisync.BBFolderCloneJournal, original string) error {
+	intent := journal.Intent
+	dispatched := journal.Dispatched
+	record := func() error {
+		if dispatched {
+			return nil
+		}
+		if err := bisync.BBDispatchFolderCloneStep(workdir, intent.OperationID, journal.Step); err != nil {
+			return err
+		}
+		dispatched = true
+		return nil
+	}
+	finish := func(retained bool) error {
+		if err := record(); err != nil {
+			return err
+		}
+		return bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, nil, retained)
+	}
+	copied, err := cloneLocation(ctx, cloud, journal, original, true)
+	if err != nil || copied == nil {
+		return api.ErrConditionalUnconfirmed
+	}
+	if !copied.Directory {
+		body, err := cloud.BBFolderFileHash(ctx, *copied)
+		if err != nil {
+			return err
+		}
+		if body != intent.Hashes[original] {
+			if journal.Published == nil {
+				return api.ErrConditionalConflict
+			}
+			return finish(true)
+		}
+	}
+	source, err := cloneLocation(ctx, cloud, journal, original, false)
+	if err != nil && !errors.Is(err, api.ErrConditionalConflict) {
+		return err
+	}
+	if errors.Is(err, api.ErrConditionalConflict) {
+		return finish(true)
+	}
+	if source == nil {
+		// A lost reply cannot prove the caller removed this item. Before a
+		// case-only publication preserve a possible independent deletion.
+		return finish(journal.Published == nil && !journal.RetireAcknowledged)
+	}
+	if !source.Directory && source.ETag != intent.Entries[original].ETag {
+		return finish(true)
+	}
+	if journal.Dispatched {
+		return api.ErrConditionalUnconfirmed
+	}
+	if err := cloud.BBRetireCopiedFolderItemWithDispatch(ctx, intent.Binding, *source, func() error {
+		return beforeCloneDispatch(ctx, record)
+	}, func() error {
+		return bisync.BBRecordFolderCloneRetirement(workdir, intent.OperationID, journal.Step)
+	}); err != nil {
+		if errors.Is(err, api.ErrConditionalConflict) {
+			return finish(true)
+		}
+		return err
+	}
+	return finish(false)
+}
+
+func advanceClonePublish(ctx context.Context, cloud ownedCloneMover, workdir string, journal *bisync.BBFolderCloneJournal) (ownedNoteReply, error) {
+	intent := journal.Intent
+	parent, err := folderParentByName(ctx, cloud, intent.Binding, path.Dir(intent.Path))
+	if err != nil || parent != intent.DestinationParent {
+		return ownedNoteReply{}, api.ErrConditionalConflict
+	}
+	name := path.Base(intent.Path)
+	if strings.EqualFold(intent.Source, intent.Path) && len(journal.Retained) > 0 {
+		return ownedNoteReply{Outcome: "folder_case_conflict", AlternatePath: path.Join(journal.StageName(), name)}, nil
+	}
+	if !journal.Dispatched {
+		if err := verifyOwnedCloneTree(ctx, cloud, journal, false); err != nil {
+			return ownedNoteReply{}, err
+		}
+		occupant, err := cloneFolderLeaf(ctx, cloud, intent.Binding, parent, name)
+		if err != nil || occupant != nil {
+			return ownedNoteReply{}, api.ErrConditionalConflict
+		}
+		source, err := cloneFolderLeaf(ctx, cloud, intent.Binding, journal.Stage.DocumentID, name)
+		if err != nil || source == nil || source.DocumentID != journal.Copies[intent.Source].DocumentID {
+			return ownedNoteReply{}, api.ErrConditionalUnconfirmed
+		}
+		if err := beforeCloneDispatch(ctx, func() error {
+			return bisync.BBDispatchFolderCloneStep(workdir, intent.OperationID, journal.Step)
+		}); err != nil {
+			return ownedNoteReply{}, err
+		}
+		// Exact read-back determines whether the move landed.
+		_ = cloud.BBMoveFolder(ctx, *source, parent)
+	}
+	siblings, err := cloud.BBFolderList(ctx, intent.Binding, parent)
+	if err != nil {
+		return ownedNoteReply{}, err
+	}
+	var child *iclouddrive.BBFolderItem
+	for i := range siblings {
+		if siblings[i].DocumentID == journal.Copies[intent.Source].DocumentID {
+			if child != nil {
+				return ownedNoteReply{}, api.ErrConditionalUnconfirmed
+			}
+			child = &siblings[i]
+		}
+	}
+	if child == nil || !child.Directory {
+		return ownedNoteReply{}, api.ErrConditionalUnconfirmed
+	}
+	if child.Name != name {
+		if !validFolderPath(child.Name) || path.Base(child.Name) != child.Name {
+			return ownedNoteReply{}, api.ErrConditionalUnconfirmed
+		}
+		return ownedNoteReply{Outcome: "folder_collision", AlternatePath: path.Join(path.Dir(intent.Path), child.Name)}, nil
+	}
+	if err := verifyOwnedCloneTree(ctx, cloud, journal, true); err != nil {
+		return ownedNoteReply{}, err
+	}
+	version := ownedFolderVersion(*child)
+	return ownedNoteReply{}, bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, &version, false)
+}
+
+func advanceCloneCleanup(ctx context.Context, cloud ownedCloneMover, workdir string, journal *bisync.BBFolderCloneJournal) error {
+	intent := journal.Intent
+	target, err := cloneLocation(ctx, cloud, journal, intent.Source, true)
+	if err != nil || target == nil {
+		return api.ErrConditionalUnconfirmed
+	}
+	folder, err := cloneFolderLeaf(ctx, cloud, intent.Binding, intent.Binding, journal.StageName())
+	if err != nil {
+		return err
+	}
+	if folder != nil && (!folder.Directory || folder.DocumentID != journal.Stage.DocumentID) {
+		return api.ErrConditionalConflict
+	}
+	record := func() error {
+		return bisync.BBDispatchFolderCloneStep(workdir, intent.OperationID, journal.Step)
+	}
+	if folder != nil {
+		if journal.Dispatched {
+			return api.ErrConditionalUnconfirmed
+		}
+		if err := cloud.BBRetireCopiedFolderItemWithDispatch(ctx, intent.Binding, *folder, func() error {
+			return beforeCloneDispatch(ctx, record)
+		}, func() error {
+			return bisync.BBRecordFolderCloneRetirement(workdir, intent.OperationID, journal.Step)
+		}); err != nil {
+			return err
+		}
+	} else if !journal.Dispatched {
+		if err := record(); err != nil {
+			return err
+		}
+	}
+	return bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, nil, false)
+}
+
+func runOwnedFolderClone(ctx context.Context, cloud ownedCloneMover, request ownedNoteFrame) ownedNoteReply {
+	unconfirmed := ownedNoteReply{Outcome: "uncertain"}
+	for steps := 0; steps < 4; steps++ {
+		journal, err := bisync.BBReadFolderClone(request.Workdir)
+		if err != nil || journal == nil {
+			return unconfirmed
+		}
+		intent := journal.Intent
+		if intent.OperationID != request.OperationID || intent.Binding != request.Binding ||
+			intent.Source != request.Source || intent.Path != request.Path {
+			return unconfirmed
+		}
+		action, entry, exists := journal.Current()
+		if !exists {
+			move, err := bisync.BBAdoptFinishedFolderClone(request.Workdir, request.OperationID)
+			if err != nil {
+				return unconfirmed
+			}
+			return ownedNoteReply{Outcome: "folder_published", Folder: &ownedFolderObservation{
+				Source: *move.Published, DestinationParent: move.Intent.DestinationParent, Method: "copy",
+			}}
+		}
+		if deadline, ok := ctx.Deadline(); ok && time.Until(deadline) < 5*time.Second {
+			return unconfirmed
+		}
+		switch action {
+		case "retire_original_entry":
+			err = advanceCloneRetirement(ctx, cloud, request.Workdir, journal, entry)
+		case "publish_verified_tree":
+			var response ownedNoteReply
+			response, err = advanceClonePublish(ctx, cloud, request.Workdir, journal)
+			if response.Outcome != "" {
+				return response
+			}
+		case "retire_empty_stage":
+			err = advanceCloneCleanup(ctx, cloud, request.Workdir, journal)
+		default:
+			err = advanceCloneConstruction(ctx, cloud, request.Workdir, journal)
+		}
+		if errors.Is(err, errFolderDeferredToScheduledSync) {
+			return ownedNoteReply{Outcome: "folder_refused"}
+		}
+		if err != nil {
+			return unconfirmed
+		}
+	}
+	return unconfirmed
+}
