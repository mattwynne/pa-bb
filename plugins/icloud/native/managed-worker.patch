+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+	"github.com/rclone/rclone/fs"
+)
+
+type relocationFake struct {
+	notes                               map[string]iclouddrive.BBNotePublication
+	lostCreate, lostTrash, editSource   bool
+	lostConflictCopy, editTargetOnTrash bool
+	loseSourceRead                      bool
+	creates, trashes                    int
+}
+
+func fixturePublication(id, etag string, data []byte) iclouddrive.BBNotePublication {
+	return iclouddrive.BBNotePublication{
+		Revision: iclouddrive.BBNoteRevision{DriveID: "FILE::com.apple.CloudDocs::" + id,
+			ParentID: "FOLDER::com.apple.CloudDocs::folder", ETag: etag, Hash: sha256.Sum256(data)},
+		Modified: time.Unix(1700000000, 0), Size: int64(len(data)),
+	}
+}
+
+func (f *relocationFake) ObserveBBCreate(_ context.Context, name string) (iclouddrive.BBNotePublication, error) {
+	object, ok := f.notes[name]
+	if f.loseSourceRead && name == "from.md" {
+		f.loseSourceRead = false
+		return object, errors.New("source read failed after the lost reply")
+	}
+	if !ok {
+		return object, fs.ErrorObjectNotFound
+	}
+	return object, nil
+}
+
+func (f *relocationFake) CreateBBNote(_ context.Context, name, _ string, data []byte, dispatch func(string) error) (iclouddrive.BBNotePublication, error) {
+	var absent iclouddrive.BBNotePublication
+	if _, ok := f.notes[name]; ok {
+		return absent, api.ErrConditionalConflict
+	}
+	conflictCopy := strings.HasPrefix(name, "BB move conflict ")
+	docID := "allocated-document"
+	if conflictCopy {
+		docID = "conflict-allocation"
+	}
+	if err := dispatch(docID); err != nil {
+		return absent, err
+	}
+	f.creates++
+	published := fixturePublication(docID, "destination-version", data)
+	f.notes[name] = published
+	if f.editSource {
+		f.notes["from.md"] = fixturePublication("original-document", "newer-source", []byte("Mac update"))
+	}
+	if (!conflictCopy && f.lostCreate) || (conflictCopy && f.lostConflictCopy) {
+		return absent, api.ErrConditionalUnconfirmed
+	}
+	return published, nil
+}
+
+func (f *relocationFake) CheckBBNoteVersion(ctx context.Context, name string, expected iclouddrive.BBNoteRevision) (iclouddrive.BBNotePublication, error) {
+	current, err := f.ObserveBBCreate(ctx, name)
+	if err != nil || current.Revision != expected {
+		return iclouddrive.BBNotePublication{}, api.ErrConditionalConflict
+	}
+	return current, nil
+}
+
+func (f *relocationFake) TrashBBNote(_ context.Context, name string, expected iclouddrive.BBNoteRevision, dispatch func() error) error {
+	if source, ok := f.notes[name]; !ok || source.Revision != expected {
+		return api.ErrConditionalConflict
+	}
+	if err := dispatch(); err != nil {
+		return err
+	}
+	f.trashes++
+	delete(f.notes, name)
+	if f.editTargetOnTrash {
+		f.notes["to.md"] = fixturePublication("allocated-document", "after-removal", []byte("Newer destination while removing"))
+	}
+	if f.lostTrash {
+		f.loseSourceRead = true
+		return api.ErrConditionalUnconfirmed
+	}
+	return nil
+}
+
+func TestBBRelocationRecoversByIdentityWithoutReplaying(t *testing.T) {
+	for _, scenario := range []string{"success", "recent source publication", "lost create", "same bytes foreign destination", "changed destination", "lost conflict copy reply", "conflict copy occupied", "changed during source removal", "lost trash", "recreated source after lost trash", "later source edit", "occupied destination"} {
+		t.Run(scenario, func(t *testing.T) {
+			ctx := context.Background()
+			source := fixturePublication("original-document", "prior-version", []byte("original"))
+			text := "destination after link update"
+			request := ownedNoteFrame{
+				Binding: "FOLDER::com.apple.CloudDocs::binding", Workdir: t.TempDir(), Source: "from.md", Path: "to.md",
+				OperationID: "7dcdd7dc-ad20-4d59-a8f3-4977f85c0960", Text: text,
+				Expected: &ownedNoteVersion{source.Revision.DriveID, source.Revision.ParentID, source.Revision.ETag, hex.EncodeToString(source.Revision.Hash[:])},
+			}
+			cloud := &relocationFake{notes: map[string]iclouddrive.BBNotePublication{"from.md": source},
+				lostCreate: scenario == "lost create" || scenario == "same bytes foreign destination" || scenario == "changed destination" ||
+					scenario == "lost conflict copy reply" || scenario == "conflict copy occupied",
+				lostConflictCopy: scenario == "lost conflict copy reply", editTargetOnTrash: scenario == "changed during source removal",
+				lostTrash: scenario == "lost trash" || scenario == "recreated source after lost trash", editSource: scenario == "later source edit",
+			}
+			if scenario == "recent source publication" {
+				prior := bisync.BBDeliveryIntent{OperationID: "762407e3-1321-4b67-a506-020a1917e0ae", Path: "from.md", Hash: source.Revision.Hash}
+				if err := bisync.BBBeginDelivery(request.Workdir, prior); err != nil {
+					t.Fatal(err)
+				}
+				if err := bisync.BBResolveDelivery(request.Workdir, prior, &bisync.BBDeliveryReceipt{
+					BBDeliveryIntent: prior, Modified: source.Modified, Size: source.Size, ProviderID: source.Revision.DriveID, ETag: source.Revision.ETag,
+				}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if scenario == "occupied destination" {
+				cloud.notes["to.md"] = fixturePublication("unrelated-document", "existing", []byte("Independent Mac bytes"))
+			}
+			hashOnly := request
+			hashOnly.Text = ""
+			destinationHash := sha256.Sum256([]byte(text))
+			hashOnly.WantedHash = hex.EncodeToString(destinationHash[:])
+			if unexpected := applyOwnedRelocation(ctx, cloud, hashOnly); unexpected.Outcome != "refused" || cloud.creates != 0 {
+				t.Fatalf("hash-only frame started an unrecorded move: %+v", unexpected)
+			}
+			first := applyOwnedRelocation(ctx, cloud, request)
+			want := "uncertain"
+			if scenario == "occupied destination" {
+				want = "refused"
+			}
+			if scenario == "success" || scenario == "recent source publication" || scenario == "later source edit" {
+				want = "published"
+			}
+			if scenario == "changed during source removal" {
+				want = "conflict_preserved"
+			}
+			if first.Outcome != want {
+				t.Fatalf("first outcome %q, want %q", first.Outcome, want)
+			}
+
+			if first.Outcome == "uncertain" {
+				intent := bisync.BBDeliveryIntent{OperationID: "41738d2b-467e-41ed-841a-a17449c4e8dd", Path: "Other.md", Hash: sha256.Sum256([]byte("Other"))}
+				if err := bisync.BBBeginDelivery(request.Workdir, intent); !errors.Is(err, bisync.ErrBBDeliveryUnsettled) {
+					t.Fatalf("competing delivery admitted after ambiguous move: %v", err)
+				}
+			}
+			if scenario == "same bytes foreign destination" {
+				cloud.notes["to.md"] = fixturePublication("unrelated-document", "mac", []byte(text))
+			}
+			if scenario == "changed destination" || scenario == "lost conflict copy reply" || scenario == "conflict copy occupied" {
+				cloud.notes["to.md"] = fixturePublication("allocated-document", "mac", []byte("Mac destination edit"))
+			}
+			copyPath := "BB move conflict " + request.OperationID + ".md"
+			if scenario == "conflict copy occupied" {
+				cloud.notes[copyPath] = fixturePublication("foreign-conflict", "older", []byte("Already occupied"))
+			}
+			expectedTarget := cloud.notes["to.md"]
+			expectedSource := cloud.notes["from.md"]
+			if scenario == "recreated source after lost trash" {
+				cloud.notes["from.md"] = fixturePublication("new-source", "mac-recreation", []byte("Recreated by Mac"))
+			}
+			second := applyOwnedRelocation(ctx, cloud, hashOnly)
+			switch scenario {
+			case "later source edit", "recreated source after lost trash":
+				trashes := 0
+				if scenario == "recreated source after lost trash" {
+					trashes = 1
+				}
+				if second.Outcome != "published" || !second.SourceRetained || cloud.trashes != trashes || cloud.creates != 1 ||
+					cloud.notes["from.md"].Revision.ETag == "prior-version" || cloud.notes["from.md"].Size == 0 {
+					t.Fatalf("the independently changed source was not accounted for: %+v; trashes=%d", second, cloud.trashes)
+				}
+			case "same bytes foreign destination", "changed destination", "changed during source removal", "lost conflict copy reply":
+				if scenario == "lost conflict copy reply" {
+					if second.Outcome != "uncertain" {
+						t.Fatalf("lost response unexpectedly confirmed: %+v", second)
+					}
+					second = applyOwnedRelocation(ctx, cloud, hashOnly)
+				}
+				if second.Outcome != "conflict_preserved" || second.ConflictCopy != copyPath || cloud.creates != 2 ||
+					cloud.notes[copyPath].Revision.Hash != destinationHash || cloud.notes["from.md"] != expectedSource ||
+					cloud.notes["to.md"] != expectedTarget {
+					t.Fatalf("conflict was not independently preserved: %+v; creates=%d", second, cloud.creates)
+				}
+				if again := applyOwnedRelocation(ctx, cloud, hashOnly); again.Outcome != "conflict_preserved" || cloud.creates != 2 {
+					t.Fatalf("an already confirmed conflict copy was replayed: %+v", again)
+				}
+			case "conflict copy occupied", "occupied destination":
+				creates := 0
+				if scenario == "conflict copy occupied" {
+					creates = 1
+				}
+				if second.Outcome != want || cloud.trashes != 0 || cloud.creates != creates || cloud.notes["from.md"] != expectedSource ||
+					cloud.notes["to.md"] != expectedTarget {
+					t.Fatalf("occupancy triggered replacement: %+v", second)
+				}
+			default:
+				if second.Outcome != "published" || cloud.creates != 1 || cloud.trashes != 1 || second.Observation == nil ||
+					second.Observation.DocumentID != "FILE::com.apple.CloudDocs::allocated-document" || cloud.notes["from.md"].Size != 0 {
+					t.Fatalf("requests replayed or endpoints not settled: %+v; create/trash=%d/%d", second, cloud.creates, cloud.trashes)
+				}
+			}
+		})
+	}
+}
