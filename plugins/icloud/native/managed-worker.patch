+package bisync
+
+import (
+	"maps"
+	"path"
+	"strings"
+	"time"
+)
+
+const bbFolderCloneVersion = 10
+
+type BBFolderCloneAllocation struct {
+	DocumentID         string
+	Signature          string
+	ReferenceSignature string
+	WrappingKey        string
+	Receipt            string `json:",omitempty"`
+	Size               int64
+}
+
+type BBFolderCloneJournal struct {
+	Version              int
+	Intent               BBFolderMoveIntent
+	Step                 int
+	Dispatched           bool
+	ActivationStarted    time.Time         `json:",omitzero"`
+	ActivationDispatched bool              `json:",omitempty"`
+	RetireAcknowledged   bool              `json:",omitempty"`
+	Stage                *BBIndexedVersion `json:",omitempty"`
+	Copies               map[string]BBIndexedVersion
+	Allocation           *BBFolderCloneAllocation `json:",omitempty"`
+	Published            *BBIndexedVersion        `json:",omitempty"`
+	Retained             map[string]bool          `json:",omitempty"`
+}
+
+type bbAbandonedFolderStage struct {
+	OperationID string
+	Binding     string
+	Folder      BBIndexedVersion
+}
+
+func (stage bbAbandonedFolderStage) name() string {
+	return ".bb-icloud-rename-" + stage.OperationID
+}
+
+func (stage bbAbandonedFolderStage) valid() bool {
+	return bbOperationID.MatchString(stage.OperationID) && stage.Binding != "" && stage.Folder.ParentID == stage.Binding &&
+		stage.Folder.DocumentID != stage.Binding && validBBCloneIdentity(stage.Folder)
+}
+
+func (journal BBFolderCloneJournal) StageName() string {
+	return ".bb-icloud-rename-" + journal.Intent.OperationID
+}
+
+func (journal BBFolderCloneJournal) Current() (action, entry string, exists bool) {
+	steps, err := bbFolderCloneSteps(journal.Intent)
+	if err != nil || journal.Step < 0 || journal.Step >= len(steps) {
+		return "", "", false
+	}
+	step := steps[journal.Step]
+	return string(step.action), step.entry, true
+}
+
+func validBBCloneIdentity(value BBIndexedVersion) bool {
+	return value.DocumentID != "" && len(value.DocumentID) <= 512 &&
+		value.ParentID != "" && len(value.ParentID) <= 512 &&
+		value.ETag != "" && len(value.ETag) <= 512
+}
+
+func (journal BBFolderCloneJournal) valid() bool {
+	if journal.Version != 1 {
+		return false
+	}
+	steps, err := bbFolderCloneSteps(journal.Intent)
+	if err != nil || journal.Step < 0 || journal.Step > len(steps) ||
+		(journal.Dispatched && journal.Step == len(steps)) ||
+		len(journal.Copies) > len(journal.Intent.Entries) || len(journal.Retained) > len(journal.Intent.Entries) {
+		return false
+	}
+	if (journal.Stage != nil) != (journal.Step > 0) ||
+		(journal.Stage != nil && (!validBBCloneIdentity(*journal.Stage) ||
+			journal.Stage.ParentID != journal.Intent.Binding || journal.Stage.DocumentID == journal.Intent.Binding)) {
+		return false
+	}
+	ids := make(map[string]bool, len(journal.Copies)+len(journal.Intent.Entries)+2)
+	ids[journal.Intent.Binding] = true
+	for _, old := range journal.Intent.Entries {
+		ids[old.DocumentID] = true
+	}
+	if journal.Stage != nil {
+		if ids[journal.Stage.DocumentID] {
+			return false
+		}
+		ids[journal.Stage.DocumentID] = true
+	}
+	copied, retained := 0, 0
+	sawPublish := false
+	for _, step := range steps[:journal.Step] {
+		switch step.action {
+		case bbCloneCreateDir, bbCloneCopyFile:
+			result, ok := journal.Copies[step.entry]
+			parent := journal.Stage.DocumentID
+			if step.entry != journal.Intent.Source {
+				parent = journal.Copies[path.Dir(step.entry)].DocumentID
+			}
+			if !ok || !validBBCloneIdentity(result) || parent == "" || result.ParentID != parent || ids[result.DocumentID] {
+				return false
+			}
+			ids[result.DocumentID] = true
+			copied++
+		case bbClonePublish:
+			copy := journal.Copies[journal.Intent.Source]
+			if journal.Published == nil || !validBBCloneIdentity(*journal.Published) ||
+				journal.Published.DocumentID != copy.DocumentID ||
+				journal.Published.ParentID != journal.Intent.DestinationParent {
+				return false
+			}
+			sawPublish = true
+		case bbCloneRetire:
+			if journal.Retained[step.entry] {
+				retained++
+			}
+		}
+	}
+	if copied != len(journal.Copies) || retained != len(journal.Retained) ||
+		sawPublish != (journal.Published != nil) {
+		return false
+	}
+	if journal.RetireAcknowledged && (!journal.Dispatched || journal.Step == len(steps) ||
+		(steps[journal.Step].action != bbCloneRetire && steps[journal.Step].action != bbCloneRetireStage)) {
+		return false
+	}
+	if !journal.ActivationStarted.IsZero() && !journal.ActivationDispatched {
+		return false
+	}
+	if journal.ActivationDispatched && (journal.Allocation == nil || !journal.Dispatched) {
+		return false
+	}
+	if a := journal.Allocation; a != nil {
+		if !journal.Dispatched || journal.Step >= len(steps) || steps[journal.Step].action != bbCloneCopyFile ||
+			a.DocumentID == "" || len(a.DocumentID) > 512 || a.Signature == "" || len(a.Signature) > 4096 ||
+			len(a.ReferenceSignature) > 4096 || len(a.WrappingKey) > 4096 || a.Size < 0 || a.Size > (1<<30) ||
+			len(a.Receipt) > 8192 {
+			return false
+		}
+	}
+	return true
+}
+
+func (journal BBFolderCloneJournal) includesDocument(documentID string) bool {
+	if documentID == "" {
+		return false
+	}
+	if journal.Stage != nil && journal.Stage.DocumentID == documentID {
+		return true
+	}
+	for _, entry := range journal.Intent.Entries {
+		if entry.DocumentID == documentID {
+			return true
+		}
+	}
+	for _, entry := range journal.Copies {
+		if entry.DocumentID == documentID {
+			return true
+		}
+	}
+	return false
+}
+
+func (journal BBFolderCloneJournal) overlaps(name string, documents ...string) bool {
+	if name != "" {
+		fold := bbFoldPath(name)
+		for _, root := range []string{journal.Intent.Source, journal.Intent.Path, journal.StageName()} {
+			root = bbFoldPath(root)
+			if fold == root || strings.HasPrefix(fold, root+"/") {
+				return true
+			}
+		}
+	}
+	for _, document := range documents {
+		if journal.includesDocument(document) {
+			return true
+		}
+	}
+	return false
+}
+
+// The whole clone record lives in the managed native journal. A generation
+// predating clone support must not treat a staged vault as ordinary content.
+func BBReadFolderClone(workdir string) (*BBFolderCloneJournal, error) {
+	state, err := readBBDeliveries(workdir)
+	return state.FolderClone, err
+}
+
+func BBPrepareFolderClone(workdir string, intent BBFolderMoveIntent) error {
+	if !validBBFolderTransition(intent, true) {
+		return errBBInvalidDelivery
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if old := state.FolderClone; old != nil {
+		prior := old.Intent
+		if prior.OperationID != intent.OperationID || prior.Binding != intent.Binding || prior.Source != intent.Source ||
+			prior.Path != intent.Path || prior.DestinationParent != intent.DestinationParent ||
+			!maps.Equal(prior.Entries, intent.Entries) || !maps.Equal(prior.Hashes, intent.Hashes) {
+			return ErrBBDeliveryUnsettled
+		}
+		return nil
+	}
+	journal := BBFolderCloneJournal{Version: 1, Intent: intent, Copies: map[string]BBIndexedVersion{}}
+	if !journal.valid() || state.Pending != nil || state.Relocation != nil || state.FolderMove != nil {
+		return ErrBBDeliveryUnsettled
+	}
+	for _, confirmed := range state.Confirmed {
+		if journal.overlaps(confirmed.Path, confirmed.ProviderID) || journal.overlaps(confirmed.RemovedPath) {
+			return ErrBBDeliveryUnsettled
+		}
+	}
+	state.FolderClone = &journal
+	if state.Version < bbCloneAcknowledgementVersion {
+		state.Version = bbCloneAcknowledgementVersion
+	}
+	return state.write(workdir)
+}
+
+func updateBBFolderClone(workdir, operationID string, step int, change func(*BBFolderCloneJournal) error) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	journal := state.FolderClone
+	if journal == nil || journal.Intent.OperationID != operationID || journal.Step != step {
+		return ErrBBDeliveryUnsettled
+	}
+	if err := change(journal); err != nil {
+		return err
+	}
+	if !journal.valid() {
+		return errBBInvalidDelivery
+	}
+	if journal.RetireAcknowledged && state.Version < bbCloneAcknowledgementVersion {
+		state.Version = bbCloneAcknowledgementVersion
+	}
+	if journal.Allocation != nil && journal.Allocation.Receipt != "" && state.Version < bbCloneAnonymousUploadVersion {
+		state.Version = bbCloneAnonymousUploadVersion
+	}
+	return state.write(workdir)
+}
+
+func BBDispatchFolderCloneStep(workdir, operationID string, step int) error {
+	return updateBBFolderClone(workdir, operationID, step, func(journal *BBFolderCloneJournal) error {
+		action, _, exists := journal.Current()
+		if !exists || journal.Dispatched || action == string(bbCloneVerifyTree) {
+			return ErrBBDeliveryUnsettled
+		}
+		if action == string(bbClonePublish) && bbFoldPath(journal.Intent.Source) == bbFoldPath(journal.Intent.Path) && len(journal.Retained) != 0 {
+			return ErrBBDeliveryUnsettled
+		}
+		journal.Dispatched = true
+		return nil
+	})
+}
+
+func BBRecordFolderCloneAllocation(workdir, operationID string, step int, allocated BBFolderCloneAllocation) error {
+	return updateBBFolderClone(workdir, operationID, step, func(journal *BBFolderCloneJournal) error {
+		action, _, _ := journal.Current()
+		if action != string(bbCloneCopyFile) || journal.Dispatched || journal.Allocation != nil ||
+			allocated.Receipt == "" {
+			return ErrBBDeliveryUnsettled
+		}
+		journal.Dispatched = true
+		journal.Allocation = &allocated
+		return nil
+	})
+}
+
+func BBDispatchFolderCloneActivation(workdir, operationID string, step int) error {
+	return updateBBFolderClone(workdir, operationID, step, func(journal *BBFolderCloneJournal) error {
+		action, _, _ := journal.Current()
+		if action != string(bbCloneCopyFile) || journal.Allocation == nil || !journal.Dispatched || journal.ActivationDispatched {
+			return ErrBBDeliveryUnsettled
+		}
+		journal.ActivationDispatched = true
+		journal.ActivationStarted = time.Now().UTC()
+		return nil
+	})
+}
+
+// An unverified copy can release the original user paths once a fresh
+// staged-file lookup has had time to settle. The exact private stage remains
+// held. This is possible only before any canonical publication or retirement.
+func BBAbandonUnconfirmedFolderCopy(workdir, operationID string, now time.Time) (bool, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return false, err
+	}
+	clone := state.FolderClone
+	if clone == nil || clone.Intent.OperationID != operationID || clone.Published != nil || clone.Stage == nil ||
+		!clone.ActivationDispatched || clone.ActivationStarted.IsZero() || now.Sub(clone.ActivationStarted) < time.Minute {
+		return false, nil
+	}
+	action, _, ok := clone.Current()
+	if !ok || action != string(bbCloneCopyFile) || len(state.AbandonedStages) >= bbDeliveryLimit {
+		return false, nil
+	}
+	intent := clone.Intent
+	stage := bbAbandonedFolderStage{OperationID: operationID, Binding: intent.Binding, Folder: *clone.Stage}
+	if !stage.valid() {
+		return false, errBBInvalidDelivery
+	}
+	state.AbandonedStages = append(state.AbandonedStages, stage)
+	state.finishBBFolder(&BBFolderMove{Intent: intent}, BBIndexedVersion{}, true)
+	state.FolderClone = nil
+	state.Version = bbAbandonedStageVersion
+	if err := state.write(workdir); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// Capture Apple's explicit trash acknowledgement before the independent
+// absence read. An uncertain request never grants a case-only replacement.
+func BBRecordFolderCloneRetirement(workdir, operationID string, step int) error {
+	return updateBBFolderClone(workdir, operationID, step, func(journal *BBFolderCloneJournal) error {
+		action, _, ok := journal.Current()
+		if !ok || !journal.Dispatched || journal.RetireAcknowledged ||
+			(action != string(bbCloneRetire) && action != string(bbCloneRetireStage)) {
+			return ErrBBDeliveryUnsettled
+		}
+		journal.RetireAcknowledged = true
+		return nil
+	})
+}
+
+// Finish a step only from exact provider read-back. For a retirement,
+// retained means the independently changed original was left alone.
+func BBCompleteFolderCloneStep(workdir, operationID string, step int, identity *BBIndexedVersion, retained bool) error {
+	return updateBBFolderClone(workdir, operationID, step, func(journal *BBFolderCloneJournal) error {
+		action, entry, ok := journal.Current()
+		if !ok || ((action == string(bbCloneVerifyTree)) == journal.Dispatched) {
+			return ErrBBDeliveryUnsettled
+		}
+		wantsIdentity := action == string(bbCloneCreateStage) || action == string(bbCloneCreateDir) ||
+			action == string(bbCloneCopyFile) || action == string(bbClonePublish)
+		if wantsIdentity != (identity != nil) || (retained && action != string(bbCloneRetire)) ||
+			(action == string(bbCloneCopyFile) && (journal.Allocation == nil || !journal.ActivationDispatched || identity == nil ||
+				bbAllocatedDocumentID(identity.DocumentID) != journal.Allocation.DocumentID)) {
+			return errBBInvalidDelivery
+		}
+		switch bbCloneAction(action) {
+		case bbCloneCreateStage:
+			journal.Stage = identity
+		case bbCloneCreateDir, bbCloneCopyFile:
+			journal.Copies[entry] = *identity
+		case bbClonePublish:
+			journal.Published = identity
+		case bbCloneRetire:
+			if retained {
+				if journal.Retained == nil {
+					journal.Retained = make(map[string]bool)
+				}
+				journal.Retained[entry] = true
+			}
+		}
+		journal.Step++
+		journal.Dispatched = false
+		journal.ActivationDispatched = false
+		journal.ActivationStarted = time.Time{}
+		journal.RetireAcknowledged = false
+		journal.Allocation = nil
+		return nil
+	})
+}
+
+// Transfer the fully verified, externally visible copy into the paired
+// baseline reconciliation, atomically releasing its temporary namespace.
+func BBAdoptFinishedFolderClone(workdir, operationID string) (*BBFolderMove, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return nil, err
+	}
+	clone := state.FolderClone
+	if clone == nil || clone.Intent.OperationID != operationID || clone.Dispatched || clone.Published == nil || state.FolderMove != nil {
+		return nil, ErrBBDeliveryUnsettled
+	}
+	if _, _, exists := clone.Current(); exists {
+		return nil, ErrBBDeliveryUnsettled
+	}
+	copies := maps.Clone(clone.Copies)
+	copies[clone.Intent.Source] = *clone.Published
+	move := BBFolderMove{Intent: clone.Intent, Dispatched: true, Published: clone.Published, Copies: copies}
+	if !move.valid() {
+		return nil, errBBInvalidDelivery
+	}
+	state.FolderClone = nil
+	state.FolderMove = &move
+	if err := state.write(workdir); err != nil {
+		return nil, err
+	}
+	return &move, nil
+}
