+// CreateBBFolder sends a single directory allocation for the already
+// verified parent. The worker must confirm the resulting provider identity
+// before using it. Unreported allocation never grants ownership of a name.
+func (d *DriveService) CreateBBFolder(ctx context.Context, parentID, leaf, reservation string, dispatch func() error) (string, error) {
+	kind, zone, id := DeconstructDriveID(parentID)
+	if (kind != "FOLDER" && kind != "APP_LIBRARY") || !driveIdentifier.MatchString(zone) ||
+		!folderDestinationIdentifier.MatchString(id) || !folderReservationID.MatchString(reservation) ||
+		leaf == "" || leaf == "." || leaf == ".." || len(leaf) > 255 || !utf8.ValidString(leaf) ||
+		strings.IndexFunc(leaf, func(r rune) bool { return r < 32 || r == 127 || r == '/' || r == '\\' }) >= 0 {
+		return "", ErrConditionalRefused
+	}
