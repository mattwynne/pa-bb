+	folder := reply.Folders[0]
+	if folder.Status == "ALREADY_EXISTS" || folder.Status == "NAME_CONFLICT" {
+		return "", ErrConditionalConflict
+	}
+	actualKind, actualZone, actualID := DeconstructDriveID(folder.Drivewsid)
