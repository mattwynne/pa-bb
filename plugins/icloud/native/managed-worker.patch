+package bisync
+
+import (
+	"context"
+
+	"github.com/rclone/rclone/fs"
+)
+
+type bbVersionedObject interface {
+	BBListedIdentity() (documentID, parentID, etag string)
+}
+
+func bbCloudVersionFrom(ctx context.Context, obj fs.Object) (bbIndexedCloudObservation, bool) {
+	provider, ok := obj.(bbVersionedObject)
+	if !ok {
+		return bbIndexedCloudObservation{}, false
+	}
+	documentID, parentID, etag := provider.BBListedIdentity()
+	if documentID == "" {
+		return bbIndexedCloudObservation{}, false
+	}
+	return bbIndexedCloudObservation{BBIndexedVersion{documentID, parentID, etag}, obj.Size(), obj.ModTime(ctx)}, true
+}
