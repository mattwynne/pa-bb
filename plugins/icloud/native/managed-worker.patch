+	folder := BBFolderMoveIntent{
+		OperationID: operation, Source: source, Path: target, DestinationParent: binding, Binding: binding,
+		Entries: map[string]BBTreeIdentity{
+			source:              {root, true},
+			source + "/Note.md": {BBIndexedVersion{"original-file", root.DocumentID, "original"}, false},
+		},
+		Hashes: map[string][sha256.Size]byte{source + "/Note.md": original},
+	}
+	if err := BBPrepareFolderClone(workdir, folder); err != nil {
+		t.Fatal(err)
+	}
+	stage := BBIndexedVersion{"private-staging-root", binding, "stage"}
+	replica := BBIndexedVersion{"private-replica", stage.DocumentID, "replica"}
+	for step, identity := range []BBIndexedVersion{stage, replica} {
+		if err := BBDispatchFolderCloneStep(workdir, operation, step); err != nil {
+			t.Fatal(err)
+		}
+		if err := BBCompleteFolderCloneStep(workdir, operation, step, &identity, false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := BBRecordFolderCloneAllocation(workdir, operation, 2, BBFolderCloneAllocation{
+		DocumentID: "anonymous-slot", Signature: "digest", Receipt: "upload receipt", Size: 8,
+	}); err != nil {
+		t.Fatal(err)
