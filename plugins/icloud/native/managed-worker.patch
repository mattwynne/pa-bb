+	if err := BBDispatchFolderCloneActivation(workdir, operation, 2); err != nil {
+		t.Fatal(err)
+	}
+	journal, err := BBReadFolderClone(workdir)
+	if err != nil || journal == nil {
+		t.Fatal("missing dispatch", err)
+	}
+	if done, err := BBAbandonUnconfirmedFolderCopy(workdir, operation, journal.ActivationStarted.Add(59*time.Second)); done || err != nil {
+		t.Fatalf("premature release = %v, %v", done, err)
+	}
+	if done, err := BBAbandonUnconfirmedFolderCopy(workdir, operation, journal.ActivationStarted.Add(time.Minute)); !done || err != nil {
+		t.Fatalf("bounded release = %v, %v", done, err)
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil || state.FolderClone != nil || len(state.AbandonedStages) != 1 ||
+		state.AbandonedStages[0].Folder != stage || state.AbandonedStages[0].name() != journal.StageName() {
+		t.Fatalf("private stage not retained: %+v, %v", state.AbandonedStages, err)
+	}
+	closing, falsePublication, _, err := BBFolderMoveOutcome(workdir, operation, binding, source, target)
+	if err != nil || closing != nil || !falsePublication {
+		t.Fatalf("deferred move = %+v, %v, %v", closing, falsePublication, err)
+	}
+	body := []byte("normal local edit")
+	note := BBDeliveryIntent{"42666a94-d421-4055-8ff0-af27421f7581", journal.StageName() + "/Note.md", sha256.Sum256(body), false}
+	if err := BBBeginDeliveryWithData(workdir, note, body, "known-note"); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("private stage write was allowed: %v", err)
+	}
+	note.Path = source + "/Note.md"
+	if err := BBBeginDeliveryWithData(workdir, note, body, "original-file"); err != nil {
+		t.Fatalf("original canonical path was still held: %v", err)
+	}
+}
