+package main
+
+import (
+	"context"
+	"errors"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type caseRelocationCloud interface {
+	relocationCloud
+	ObserveBBCaseNamespace(context.Context, string, string) (iclouddrive.BBCaseNamespace, error)
+	TrashBBCaseSource(context.Context, string, iclouddrive.BBNoteRevision, func() error) error
+}
+
+func applyCaseRelocation(ctx context.Context, cloud caseRelocationCloud, workdir string, move *bisync.BBRelocation, source iclouddrive.BBNoteRevision) ownedNoteReply {
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	intent := move.Intent
+	if !move.CaseSourceRemoved {
+		if move.Removing {
+			// A missing reply cannot authorize recreating a file that a
+			// device might have deleted independently.
+			return preserveRelocationConflict(ctx, cloud, workdir, move)
+		}
+		dispatched := false
+		err := cloud.TrashBBCaseSource(ctx, intent.Source, source, func() error {
+			if err := bisync.BBDispatchRelocationTrash(workdir, intent); err != nil {
+				return err
+			}
+			dispatched = true
+			return nil
+		})
+		if err != nil {
+			if !dispatched && errors.Is(err, api.ErrConditionalConflict) && bisync.BBRefuseRelocation(workdir, intent) == nil {
+				return ownedNoteReply{Outcome: "refused"}
+			}
+			return uncertain
+		}
+		if !dispatched || bisync.BBRecordCaseSourceRemoval(workdir, intent) != nil {
+			return uncertain
+		}
+		move.Removing, move.CaseSourceRemoved = true, true
+	}
+
+	location, err := cloud.ObserveBBCaseNamespace(ctx, intent.Source, intent.Path)
+	if err != nil {
+		return uncertain
+	}
+	if location == iclouddrive.BBCaseSource {
+		current, err := cloud.ObserveBBCreate(ctx, intent.Source)
+		if err != nil || current.Revision == source {
+			// The old revision can still appear before iCloud's listing
+			// reflects a positively acknowledged removal.
+			return uncertain
+		}
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	}
+	if location == iclouddrive.BBCaseOccupied {
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	}
+
+	var target iclouddrive.BBNotePublication
+	switch {
+	case move.Allocation == "" && location == iclouddrive.BBCaseVacant:
+		target, err = cloud.CreateBBNote(ctx, intent.Path, intent.Binding, move.Data, func(id string) error {
+			if err := bisync.BBAllocateRelocation(workdir, intent, id); err != nil {
+				return err
+			}
+			move.Allocation = id
+			return nil
+		})
+	case move.Allocation != "" && location == iclouddrive.BBCaseDestination:
+		target, err = cloud.ObserveBBCreate(ctx, intent.Path)
+	case location == iclouddrive.BBCaseDestination:
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	default:
+		// Another request may still publish an already allocated name.
+		return uncertain
+	}
+	if err != nil {
+		return uncertain
+	}
+	_, _, document := api.DeconstructDriveID(target.Revision.DriveID)
+	if document != move.Allocation || target.Revision.Hash != intent.Hash || target.Revision.ParentID != source.ParentID {
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	}
+	if move.Destination == nil {
+		receipt := bisync.BBDeliveryReceipt{BBDeliveryIntent: intent.BBDeliveryIntent, Modified: target.Modified, Size: target.Size,
+			ProviderID: target.Revision.DriveID, ProviderParentID: target.Revision.ParentID, ETag: target.Revision.ETag}
+		if err := bisync.BBRecordRelocationDestination(workdir, intent, receipt); err != nil {
+			return uncertain
+		}
+		receipt.DocumentID = move.Allocation
+		receipt.RemovedPath = intent.Source
+		move.Destination = &receipt
+	}
+	if !matchesRelocationTarget(intent, *move.Destination, target) {
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	}
+	if bisync.BBFinishRelocation(workdir, intent) != nil {
+		return uncertain
+	}
+	return observedOwnedNote("published", target)
+}
