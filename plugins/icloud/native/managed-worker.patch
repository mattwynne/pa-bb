+
+type folderMoveFixture struct {
+	folderProofFixture
+	calls     int
+	block     bool
+	rejected  bool
+	collision bool
+}
+
+func (f *folderMoveFixture) BBFolderList(ctx context.Context, binding, parent string) ([]iclouddrive.BBFolderItem, error) {
+	if f.block {
+		return nil, api.ErrConditionalUnconfirmed
+	}
+	return f.folderProofFixture.BBFolderList(ctx, binding, parent)
+}
+
+func (f *folderMoveFixture) BBMoveFolder(_ context.Context, source iclouddrive.BBFolderItem, destination string) error {
+	f.calls++
+	if f.rejected {
+		return api.ErrConditionalConflict
+	}
+	f.items[source.ParentID] = f.items[source.ParentID][1:]
+	source.ParentID, source.ETag = destination, "updated"
+	if f.collision {
+		f.items[destination] = append(f.items[destination], iclouddrive.BBFolderItem{
+			Name: source.Name, DocumentID: "independent", ParentID: destination, ETag: "independent", Directory: true,
+		})
+		source.Name += " 2"
+	}
+	f.items[destination] = append(f.items[destination], source)
+	f.block = true
+	return api.ErrConditionalUnconfirmed
+}
+
+func generatedOwnedFolderRecovery(t *testing.T) (*folderMoveFixture, ownedNoteFrame, string, string) {
+	t.Helper()
+	source := iclouddrive.BBFolderItem{Name: "Folder", DocumentID: "source", ParentID: "root", ETag: "a", Directory: true}
+	parent := iclouddrive.BBFolderItem{Name: "Archive", DocumentID: "archive", ParentID: "root", ETag: "b", Directory: true}
+	cloud := &folderMoveFixture{folderProofFixture: folderProofFixture{items: map[string][]iclouddrive.BBFolderItem{"root": {source, parent}}}}
+	workdir := t.TempDir()
+	index, err := json.Marshal(map[string]any{
+		"version": 1, "binding": "root",
+		"entries": map[string]bisync.BBTreeIdentity{"Folder": {BBIndexedVersion: ownedFolderVersion(source), Directory: true}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(workdir, "bb-cloud-tree-identities-v1.json"), index, 0600); err != nil {
+		t.Fatal(err)
+	}
+	request := ownedNoteFrame{Binding: "root", Workdir: workdir, Source: "Folder", Path: "Archive/Folder",
+		FolderEntries: []ownedFolderEntry{}, OperationID: "36885b21-b80e-4007-9f73-6b3bbcecaa55"}
+	return cloud, request, source.DocumentID, parent.DocumentID
+}
+
+func TestBBFolderMoveRecoversUnreportedPublicationByIdentity(t *testing.T) {
+	cloud, request, document, parent := generatedOwnedFolderRecovery(t)
+	if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "uncertain" || cloud.calls != 1 {
+		t.Fatalf("lost response = %v, call count = %d", result.Outcome, cloud.calls)
+	}
+	cloud.block = false
+	request.FolderEntries = nil
+	if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "folder_published" ||
+		result.Folder.Source.DocumentID != document || result.Folder.Source.ParentID != parent || cloud.calls != 1 {
+		t.Fatalf("recover = %+v, call count = %d", result, cloud.calls)
+	}
+}
+
+func TestBBFolderMoveKeepsProviderRejectionAndAlternateOutcomesDistinct(t *testing.T) {
+	t.Run("definitive provider rejection", func(t *testing.T) {
+		cloud, request, _, _ := generatedOwnedFolderRecovery(t)
+		cloud.rejected = true
+		if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "folder_refused" {
+			t.Fatalf("first attempt = %v", result.Outcome)
+		}
+		request.FolderEntries = nil
+		if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "folder_refused" || cloud.calls != 1 {
+			t.Fatalf("readback = %v, calls = %d", result.Outcome, cloud.calls)
+		}
+		if move, err := bisync.BBReadFolderMove(request.Workdir, request.OperationID); err != nil || move != nil {
+			t.Fatalf("a rejected move still holds the mirror: %+v, %v", move, err)
+		}
+	})
+	t.Run("accepted under an alternate name", func(t *testing.T) {
+		cloud, request, _, _ := generatedOwnedFolderRecovery(t)
+		cloud.collision = true
+		if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "uncertain" {
+			t.Fatalf("lost reply = %v", result.Outcome)
+		}
+		cloud.block = false
+		request.FolderEntries = nil
+		if result := applyOwnedFolderMove(context.Background(), cloud, request); result.Outcome != "folder_collision" ||
+			result.AlternatePath != "Archive/Folder 2" || cloud.calls != 1 {
+			t.Fatalf("colliding outcome = %+v, calls = %d", result, cloud.calls)
+		}
+	})
+}
+
+func (f *folderMoveFixture) BBRenameFolder(_ context.Context, source iclouddrive.BBFolderItem, name string) error {
+	f.calls++
+	items := f.items[source.ParentID]
+	if f.collision {
+		items = append(items, iclouddrive.BBFolderItem{
+			Name: name, DocumentID: "independent", ParentID: source.ParentID, ETag: "independent", Directory: true,
+		})
+		f.items[source.ParentID] = items
+		name += " 2"
+	}
+	for i := range items {
+		if items[i].DocumentID == source.DocumentID {
+			items[i].Name, items[i].ETag = name, "renamed"
+		}
+	}
+	f.block = true
+	return api.ErrConditionalUnconfirmed
+}
+
+func TestBBFolderRenamePreservesIdentityAfterLostReply(t *testing.T) {
+	for _, target := range []string{"Renamed", "folder"} {
+		t.Run(target, func(t *testing.T) {
+			cloud, request, document, _ := generatedOwnedFolderRecovery(t)
+			request.Path = target
+			// The directory still has the indexed identity and name. A
+			// newer revision need not prevent moving its descendants.
+			cloud.items["root"][0].ETag = "changed-after-last-scan"
+			if got := applyOwnedFolderMove(context.Background(), cloud, request); got.Outcome != "uncertain" || cloud.calls != 1 {
+				t.Fatalf("lost response = %v, calls = %d", got.Outcome, cloud.calls)
+			}
+			if legacy, err := bisync.BBReadFolderClone(request.Workdir); legacy != nil || err != nil {
+				t.Fatalf("rename started a staged copy: %+v, %v", legacy, err)
+			}
+			cloud.block = false
+			request.FolderEntries = nil
+			got := applyOwnedFolderMove(context.Background(), cloud, request)
+			if got.Outcome != "folder_published" || got.Folder.Method != "move" ||
+				got.Folder.Source.DocumentID != document || got.Folder.Source.ParentID != "root" || cloud.calls != 1 {
+				t.Fatalf("recovered rename = %+v, calls = %d", got, cloud.calls)
+			}
+		})
+	}
+}
+
+func TestBBFolderRenameLetsNormalSyncHandleCollision(t *testing.T) {
+	cloud, request, document, _ := generatedOwnedFolderRecovery(t)
+	request.Path, cloud.collision = "Renamed", true
+	if got := applyOwnedFolderMove(context.Background(), cloud, request); got.Outcome != "uncertain" {
+		t.Fatalf("lost response = %v", got.Outcome)
+	}
+	cloud.block = false
+	request.FolderEntries = nil
+	if got := applyOwnedFolderMove(context.Background(), cloud, request); got.Outcome != "folder_refused" || cloud.calls != 1 {
+		t.Fatalf("collision recovery = %+v, calls = %d", got, cloud.calls)
+	}
+	if move, err := bisync.BBReadFolderMove(request.Workdir, request.OperationID); move != nil || err != nil {
+		t.Fatalf("the collision still holds the mirror: %+v, %v", move, err)
+	}
+	siblings := cloud.items["root"]
+	target, _ := folderNameIn(siblings, "Renamed")
+	alternate, _ := folderNameIn(siblings, "Renamed 2")
+	if target == nil || target.DocumentID != "independent" || alternate == nil || alternate.DocumentID != document {
+		t.Fatalf("rename collision did not retain both folders: %+v", siblings)
+	}
+}
