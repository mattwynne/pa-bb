+package bisync
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"os"
+	"path"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+)
+
+const bbDeliveryLimit = 256
+const bbEmptyNoteVersion = 8
+const bbDeliveryBytes = 1 << 20
+const bbDeliveryStateLimit = 16 << 20
+
+var bbOperationID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+const bbBoundCreationVersion = 11
+const bbCloneAcknowledgementVersion = 12
+const bbCloneAnonymousUploadVersion = 14
+const bbAbandonedStageVersion = 15
+
+var ErrBBDeliveryUnsettled = errors.New("an expedited iCloud publication still needs verification")
+var errBBInvalidDelivery = errors.New("invalid expedited delivery record")
+
+type BBDeliveryIntent struct {
+	OperationID string
+	Path        string
+	Hash        [sha256.Size]byte
+	Create      bool
+}
+
+type BBDeliveryReceipt struct {
+	BBDeliveryIntent
+	Modified         time.Time
+	Size             int64
+	DocumentID       string
+	ProviderID       string
+	ETag             string
+	RemovedPath      string `json:",omitempty"`
+	ProviderParentID string `json:",omitempty"`
+	SourceRetained   bool   `json:",omitempty"`
+}
+
+type bbDeliveryStore struct {
+	Version             int
+	Pending             *BBDeliveryIntent
+	PendingData         *[]byte                  `json:",omitempty"`
+	PendingDocument     string                   `json:",omitempty"`
+	PendingCreateParent string                   `json:",omitempty"`
+	Relocation          *BBRelocation            `json:",omitempty"`
+	AbandonedStages     []bbAbandonedFolderStage `json:",omitempty"`
+	FolderClone         *BBFolderCloneJournal    `json:",omitempty"`
+	FolderMove          *BBFolderMove            `json:",omitempty"`
+	FinishedFolders     []bbFolderPublication    `json:",omitempty"`
+	ReconciledConflicts []BBRelocationIntent     `json:",omitempty"`
+	Dispatched          bool
+	AllocatedDocument   string
+	Applied             []BBDeliveryReceipt
+	Confirmed           []BBDeliveryReceipt
+}
+
+func bbDeliveryPath(workdir string) string { return filepath.Join(workdir, "bb-delivery-v1.json") }
+
+func validBBDelivery(intent BBDeliveryIntent) bool {
+	p := intent.Path
+	return bbOperationID.MatchString(intent.OperationID) && intent.Hash != ([sha256.Size]byte{}) &&
+		p != "." && len(p) <= 1024 && path.Clean(p) == p && !path.IsAbs(p) &&
+		!strings.HasPrefix(p, "../") && !strings.ContainsAny(p, "\\\x00\r\n") && strings.HasSuffix(p, ".md")
+}
+
+func validBBReceipt(receipt BBDeliveryReceipt) bool {
+	return validBBDelivery(receipt.BBDeliveryIntent) && (!receipt.SourceRetained || receipt.RemovedPath != "") &&
+		(receipt.RemovedPath == "" || (receipt.Create && receipt.ProviderParentID != "" && receipt.ProviderID != "" && receipt.ETag != "" && receipt.DocumentID != "" && validBBRelocationPaths(receipt.RemovedPath, receipt.BBDeliveryIntent)))
+}
+
+func readBBDeliveries(workdir string) (bbDeliveryStore, error) {
+	raw, err := bbReadBounded(bbDeliveryPath(workdir), bbDeliveryStateLimit)
+	if errors.Is(err, os.ErrNotExist) {
+		return bbDeliveryStore{Version: 1}, nil
+	}
+	if err != nil {
+		return bbDeliveryStore{}, err
+	}
+	var state bbDeliveryStore
+	if err := json.Unmarshal(raw, &state); err != nil || (state.Version < 1 || state.Version > bbAbandonedStageVersion) ||
+		(state.FolderClone != nil && (state.Version < bbFolderCloneVersion || state.FolderMove != nil ||
+			state.Relocation != nil || !state.FolderClone.valid() ||
+			(state.FolderClone.RetireAcknowledged && state.Version < bbCloneAcknowledgementVersion) ||
+			(state.FolderClone.Allocation != nil && state.FolderClone.Allocation.Receipt != "" && state.Version < bbCloneAnonymousUploadVersion))) ||
+		(state.FolderMove != nil && (state.Version < bbFolderMoveVersion || !state.FolderMove.valid())) ||
+		(state.Relocation != nil && (state.Version < 2 || (state.Pending != nil && state.Version < 3) ||
+			(state.Version < 7 && BBCaseRelocation(state.Relocation.Intent.Source, state.Relocation.Intent.Path)) ||
+			(state.Version < bbEmptyNoteVersion && len(state.Relocation.Data) == 0) ||
+			(state.Relocation.Conflict != nil && state.Version < 4) || (state.Version < 5 && state.Relocation.Conflict != nil && state.Relocation.Conflict.Approved != nil) || !state.Relocation.valid())) ||
+		len(state.Confirmed) > bbDeliveryLimit || len(state.Applied) > bbDeliveryLimit || len(state.ReconciledConflicts) > bbDeliveryLimit || (state.Version < 5 && len(state.ReconciledConflicts) > 0) || (state.Pending == nil && state.Dispatched) || (state.Pending != nil && !validBBDelivery(*state.Pending)) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	if len(state.AbandonedStages) > bbDeliveryLimit || (len(state.AbandonedStages) > 0 && state.Version < bbAbandonedStageVersion) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	for _, stage := range state.AbandonedStages {
+		if !stage.valid() {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	}
+	if state.PendingData != nil && (state.Version < 6 || state.Pending == nil || *state.PendingData == nil ||
+		(len(*state.PendingData) == 0 && state.Version < bbEmptyNoteVersion) ||
+		len(*state.PendingData) > bbDeliveryBytes || sha256.Sum256(*state.PendingData) != state.Pending.Hash ||
+		(!state.Pending.Create && state.PendingDocument == "") || (state.Pending.Create && state.PendingDocument != "")) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	if state.PendingCreateParent != "" && (state.Version < bbBoundCreationVersion || state.Pending == nil ||
+		!state.Pending.Create || state.PendingData == nil || len(state.PendingCreateParent) > 512) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	if state.Relocation != nil && state.Pending != nil {
+		var document []string
+		if state.PendingDocument != "" {
+			document = []string{state.PendingDocument}
+		}
+		if bbCheckRelocationDisjoint(state.Relocation, *state.Pending, document) != nil {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	} else if state.PendingDocument != "" && state.PendingData == nil {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	if len(state.FinishedFolders) > bbDeliveryLimit || (len(state.FinishedFolders) > 0 && state.Version < bbFolderMoveVersion) {
+		return bbDeliveryStore{}, errBBInvalidDelivery
+	}
+	for _, record := range state.FinishedFolders {
+		if !record.valid() {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	}
+	for _, move := range state.ReconciledConflicts {
+		if !validBBRelocationIntent(move) || (state.Version < 7 && BBCaseRelocation(move.Source, move.Path)) {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	}
+	seen := map[string]bool{}
+	for _, receipt := range state.Confirmed {
+		if !validBBReceipt(receipt) || (state.Version == 1 && receipt.RemovedPath != "") || (state.Version < bbEmptyNoteVersion && receipt.Size == 0) ||
+			(BBCaseRelocation(receipt.RemovedPath, receipt.Path) && (state.Version < 7 || receipt.SourceRetained)) || seen[receipt.Path] || receipt.Modified.IsZero() ||
+			receipt.Size < 0 || receipt.Size > bbDeliveryBytes {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+		seen[receipt.Path] = true
+	}
+	for _, receipt := range state.Applied {
+		if !validBBReceipt(receipt) || (state.Version == 1 && receipt.RemovedPath != "") || (state.Version < bbEmptyNoteVersion && receipt.Size == 0) ||
+			(BBCaseRelocation(receipt.RemovedPath, receipt.Path) && (state.Version < 7 || receipt.SourceRetained)) || receipt.Modified.IsZero() || receipt.Size < 0 || receipt.Size > bbDeliveryBytes {
+			return bbDeliveryStore{}, errBBInvalidDelivery
+		}
+	}
+	return state, nil
+}
+
+func (state bbDeliveryStore) write(workdir string) error {
+	raw, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	if !filepath.IsAbs(workdir) || len(raw) > bbDeliveryStateLimit {
+		return errBBInvalidDelivery
+	}
+	return (bbListingPair{directory: workdir}).publishFile(bbDeliveryPath(workdir), raw, false)
+}
+
+// All delivery state transitions run while the caller owns this mirror's
+// mutation lock. The intent is durable before any request can publish bytes.
+func BBBeginDelivery(workdir string, intent BBDeliveryIntent, knownDocument ...string) error {
+	return bbBeginDelivery(workdir, intent, nil, "", knownDocument, false)
+}
+
+func BBBeginDeliveryWithData(workdir string, intent BBDeliveryIntent, data []byte, knownDocument ...string) error {
+	if data == nil || len(data) > bbDeliveryBytes || sha256.Sum256(data) != intent.Hash ||
+		(intent.Create && len(knownDocument) != 0) || (!intent.Create && (len(knownDocument) != 1 || knownDocument[0] == "" || len(knownDocument[0]) > 512)) {
+		return errBBInvalidDelivery
+	}
+	return bbBeginDelivery(workdir, intent, data, "", knownDocument, false)
+}
+
+// BBBeginDeliveryInMovedFolder binds a new note to a known parent identity
+// from a confirmed folder move. Its proof survives the later baseline remap.
+func BBBeginDeliveryInMovedFolder(workdir string, intent BBDeliveryIntent, data []byte, parent string) error {
+	if !intent.Create || parent == "" || len(parent) > 512 ||
+		data == nil || len(data) > bbDeliveryBytes || sha256.Sum256(data) != intent.Hash {
+		return errBBInvalidDelivery
+	}
+	return bbBeginDelivery(workdir, intent, data, parent, nil, false)
+}
+
+// Called only while the live transfer's journal lease is held for this
+// exact vacant name and provider parent.
+func BBBeginDeliveryInTransfer(workdir string, intent BBDeliveryIntent, data []byte, parent string) error {
+	if !intent.Create || parent == "" || len(parent) > 512 ||
+		data == nil || len(data) > bbDeliveryBytes || sha256.Sum256(data) != intent.Hash {
+		return errBBInvalidDelivery
+	}
+	return bbBeginDelivery(workdir, intent, data, parent, nil, true)
+}
+
+func bbBeginDelivery(workdir string, intent BBDeliveryIntent, data []byte, parent string, knownDocument []string, duringTransfer bool) error {
+	if !validBBDelivery(intent) {
+		return errBBInvalidDelivery
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	overlapsMove := state.FolderMove != nil && state.FolderMove.overlaps(intent.Path, knownDocument...)
+	var movedParent string
+	if overlapsMove {
+		movedParent = state.FolderMove.newNoteParent(intent)
+	}
+	if parent != "" && (!duringTransfer || overlapsMove) && movedParent != parent {
+		return ErrBBDeliveryUnsettled
+	}
+	if slices.ContainsFunc(state.AbandonedStages, func(stage bbAbandonedFolderStage) bool {
+		name := bbFoldPath(intent.Path)
+		root := stage.name()
+		return name == root || strings.HasPrefix(name, root+"/")
+	}) {
+		return ErrBBDeliveryUnsettled
+	}
+	if state.Pending != nil || (state.FolderClone != nil && state.FolderClone.overlaps(intent.Path, knownDocument...)) ||
+		(overlapsMove && parent == "" && !state.FolderMove.permitsReplacement(intent, knownDocument)) {
+		return ErrBBDeliveryUnsettled
+	}
+	if state.Relocation != nil {
+		if err := bbCheckRelocationDisjoint(state.Relocation, intent, knownDocument); err != nil {
+			return err
+		}
+		if state.Version < 3 {
+			state.Version = 3
+		}
+		if len(knownDocument) == 1 {
+			state.PendingDocument = knownDocument[0]
+		}
+	}
+	if slices.ContainsFunc(state.Confirmed, func(receipt BBDeliveryReceipt) bool {
+		return receipt.RemovedPath != "" && (equalBBPaths(receipt.Path, intent.Path) || equalBBPaths(receipt.RemovedPath, intent.Path))
+	}) {
+		return ErrBBDeliveryUnsettled
+	}
+	if len(state.Confirmed) == bbDeliveryLimit && !slices.ContainsFunc(state.Confirmed, func(r BBDeliveryReceipt) bool { return r.Path == intent.Path }) {
+		return ErrBBDeliveryUnsettled
+	}
+	state.Pending = &intent
+	if parent != "" {
+		if state.Version < bbBoundCreationVersion {
+			state.Version = bbBoundCreationVersion
+		}
+		state.PendingCreateParent = parent
+	}
+	if data != nil {
+		if state.Version < 6 {
+			state.Version = 6
+		}
+		if len(data) == 0 && state.Version < bbEmptyNoteVersion {
+			state.Version = bbEmptyNoteVersion
+		}
+		state.PendingData = &data
+		if len(knownDocument) == 1 {
+			state.PendingDocument = knownDocument[0]
+		}
+	}
+	return state.write(workdir)
+}
+
+// BBPendingDeliveryData accepts only the operation whose bytes were staged.
+func BBPendingDeliveryData(workdir string, intent BBDeliveryIntent) ([]byte, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return nil, err
+	}
+	if state.Pending == nil || *state.Pending != intent || state.PendingData == nil {
+		return nil, nil
+	}
+	return *state.PendingData, nil
+}
+
+// Resolve only from verified provider evidence. A definitive precondition
+// refusal is represented by a nil receipt; uncertain attempts stay pending.
+func BBResolveDelivery(workdir string, intent BBDeliveryIntent, receipt *BBDeliveryReceipt) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending == nil || *state.Pending != intent {
+		return errBBInvalidDelivery
+	}
+	if receipt != nil {
+		if receipt.BBDeliveryIntent != intent || receipt.Modified.IsZero() || receipt.Size < 0 || receipt.Size > bbDeliveryBytes ||
+			(state.PendingDocument != "" && state.PendingDocument != receipt.ProviderID) ||
+			(state.PendingCreateParent != "" && state.PendingCreateParent != receipt.ProviderParentID) ||
+			(state.Relocation != nil && receipt.ProviderID != "" && state.Relocation.hasProviderDocument(receipt.ProviderID)) {
+			return errBBInvalidDelivery
+		}
+		if receipt.Size == 0 && state.Version < bbEmptyNoteVersion {
+			state.Version = bbEmptyNoteVersion
+		}
+		recorded := *receipt
+		if intent.Create {
+			recorded.DocumentID = state.AllocatedDocument
+		}
+		receipt = &recorded
+		index := slices.IndexFunc(state.Confirmed, func(old BBDeliveryReceipt) bool { return old.Path == receipt.Path })
+		if index >= 0 {
+			// Keep the fact that this path may not exist in the prior listing until
+			// both listings have incorporated the earliest create receipt.
+			kept := *receipt
+			kept.Create = kept.Create || state.Confirmed[index].Create
+			state.Confirmed[index] = kept
+		} else {
+			state.Confirmed = append(state.Confirmed, *receipt)
+		}
+	}
+	state.Pending = nil
+	state.PendingData = nil
+	state.PendingDocument = ""
+	state.PendingCreateParent = ""
+	state.Dispatched = false
+	state.AllocatedDocument = ""
+	return state.write(workdir)
+}
+
+// BBDispatchDelivery is written after all precondition checks and immediately
+// before the conditional content publication request.
+func BBDispatchDelivery(workdir string, intent BBDeliveryIntent, allocated ...string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending == nil || *state.Pending != intent {
+		return errBBInvalidDelivery
+	}
+	if intent.Create {
+		if len(allocated) != 1 || allocated[0] == "" || len(allocated[0]) > 512 || state.Dispatched {
+			return errBBInvalidDelivery
+		}
+		state.AllocatedDocument = allocated[0]
+	}
+	state.Dispatched = true
+	return state.write(workdir)
+}
+
+func BBAllocatedDocument(workdir string, intent BBDeliveryIntent) (string, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return "", err
+	}
+	if !intent.Create {
+		return "", errBBInvalidDelivery
+	}
+	if state.Pending != nil && *state.Pending == intent && state.Dispatched && state.AllocatedDocument != "" {
+		return state.AllocatedDocument, nil
+	}
+	same := func(r BBDeliveryReceipt) bool {
+		return r.OperationID == intent.OperationID && r.Path == intent.Path && r.Hash == intent.Hash
+	}
+	for _, receipts := range [][]BBDeliveryReceipt{state.Confirmed, state.Applied} {
+		if i := slices.IndexFunc(receipts, same); i >= 0 && receipts[i].DocumentID != "" {
+			return receipts[i].DocumentID, nil
+		}
+	}
+	return "", errBBInvalidDelivery
+}
+
+type BBDeliveryStage string
+
+const (
+	BBDeliveryMissing    BBDeliveryStage = "missing"
+	BBDeliveryPrepared   BBDeliveryStage = "prepared"
+	BBDeliveryDispatched BBDeliveryStage = "dispatched"
+	BBDeliveryRecorded   BBDeliveryStage = "recorded"
+	BBDeliveryApplied    BBDeliveryStage = "applied"
+)
+
+func BBReadDeliveryStage(workdir string, intent BBDeliveryIntent) (BBDeliveryStage, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return "", err
+	}
+	if state.Pending != nil && *state.Pending == intent {
+		if state.Dispatched {
+			return BBDeliveryDispatched, nil
+		}
+		return BBDeliveryPrepared, nil
+	}
+	equal := func(r BBDeliveryReceipt) bool {
+		return r.OperationID == intent.OperationID && r.Path == intent.Path && r.Hash == intent.Hash
+	}
+	if slices.ContainsFunc(state.Confirmed, equal) {
+		return BBDeliveryRecorded, nil
+	}
+	if slices.ContainsFunc(state.Applied, equal) {
+		return BBDeliveryApplied, nil
+	}
+	return BBDeliveryMissing, nil
+}
