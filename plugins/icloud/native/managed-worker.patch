+func TestBBManagedCaseCloneReconcilesWhenEveryCloudTimestampChanged(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	cloudRoot, mirrorRoot, workdir := t.TempDir(), t.TempDir(), t.TempDir()
+	const source, target, binding = "Folder", "folder", "binding"
+	baseline := time.Unix(1700000000, 0)
+	contents := map[string]string{"Note.md": "same bytes", "Attachment.bin": "unchanged attachment"}
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		if err := os.Mkdir(filepath.Join(root, source), 0700); err != nil {
+			t.Fatal(err)
+		}
+		for name, body := range contents {
+			filename := filepath.Join(root, source, name)
+			if err := os.WriteFile(filename, []byte(body), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Chtimes(filename, baseline, baseline); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	cloudReal, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mirror, err := local.NewFs(ctx, "local", mirrorRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	options := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50}
+	if err := Bisync(ctx, cloudReal, mirror, &options); err != nil {
+		t.Fatal(err)
+	}
+
+	before := BBIndexedVersion{DocumentID: "original-folder", ParentID: binding, ETag: "before"}
+	published := BBIndexedVersion{DocumentID: "copied-folder", ParentID: binding, ETag: "published"}
+	intent := BBFolderMoveIntent{OperationID: "1617f294-1a70-4ca5-a592-b7325ea3ca48", Binding: binding, Source: source,
+		Path: target, DestinationParent: binding, Entries: map[string]BBTreeIdentity{source: {before, true}}, Hashes: map[string][sha256.Size]byte{}}
+	copies := map[string]BBIndexedVersion{source: published}
+	observed := map[string]BBIndexedVersion{}
+	for name, body := range contents {
+		sourceName := source + "/" + name
+		newName := target + "/" + name
+		intent.Entries[sourceName] = BBTreeIdentity{BBIndexedVersion: BBIndexedVersion{"original-" + name, before.DocumentID, "old"}}
+		intent.Hashes[sourceName] = sha256.Sum256([]byte(body))
+		copies[sourceName] = BBIndexedVersion{"new-" + name, published.DocumentID, "copied"}
+		observed[newName] = copies[sourceName]
+	}
+	state := bbDeliveryStore{Version: bbCloneAcknowledgementVersion, FolderMove: &BBFolderMove{
+		Intent: intent, Dispatched: true, Published: &published, Copies: copies,
+	}}
+	if err := state.write(workdir); err != nil {
+		t.Fatal(err)
+	}
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		if err := os.Rename(filepath.Join(root, source), filepath.Join(root, target)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for name := range contents {
+		filename := filepath.Join(cloudRoot, target, name)
+		newTime := baseline.Add(time.Minute)
+		if err := os.Chtimes(filename, newTime, newTime); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	cloud := bbHeldFolderFilesystem{&bbHeldListingFS{Fs: cloudReal, versions: observed}, map[string]BBIndexedVersion{target: published}}
+	options.Resync = false
+	if err := BBManagedBisync(ctx, &cloud, mirror, options, binding); err != nil {
+		t.Fatal(err)
+	}
+	for name, want := range contents {
+		for _, root := range []string{cloudRoot, mirrorRoot} {
+			payload, err := os.ReadFile(filepath.Join(root, target, name))
+			if err != nil || string(payload) != want {
+				t.Fatalf("reconciled %s = %q, %v", name, payload, err)
+			}
+		}
+	}
+	closed, rejected, copied, err := BBFolderMoveOutcome(workdir, intent.OperationID, binding, source, target)
+	if err != nil || rejected || !copied || closed == nil || *closed != published {
+		t.Fatalf("folder receipt = %+v, %t, %v", closed, rejected, err)
+	}
+}
