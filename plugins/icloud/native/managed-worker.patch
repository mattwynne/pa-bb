+package iclouddrive
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"io"
+	"strings"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+)
+
+// Until the owner gives this entry's published identity to reconciliation,
+// an allocation or staged copy is never authority to change source bytes.
+func (f *Fs) lookupBBFolderLeaf(ctx context.Context, binding, parentID, leaf string) (*BBFolderItem, error) {
+	items, err := f.BBFolderList(ctx, binding, parentID)
+	if err != nil {
+		return nil, err
+	}
+	var found *BBFolderItem
+	for i := range items {
+		if !strings.EqualFold(items[i].Name, leaf) {
+			continue
+		}
+		if items[i].Name != leaf || found != nil {
+			return nil, api.ErrConditionalConflict
+		}
+		found = &items[i]
+	}
+	return found, nil
+}
+
+func (f *Fs) BBReserveStageFolder(ctx context.Context, binding, parentID, leaf, reservation string) (BBFolderItem, error) {
+	return f.BBReserveStageFolderWithDispatch(ctx, binding, parentID, leaf, reservation, nil)
+}
+
+func (f *Fs) BBReserveStageFolderWithDispatch(ctx context.Context, binding, parentID, leaf, reservation string, dispatch func() error) (BBFolderItem, error) {
+	var empty BBFolderItem
+	found, err := f.lookupBBFolderLeaf(ctx, binding, parentID, leaf)
+	if err != nil {
+		return empty, err
+	}
+	if found != nil {
+		return empty, api.ErrConditionalConflict
+	}
+	id, err := f.service.CreateBBFolder(ctx, parentID, f.opt.Enc.FromStandardName(leaf), reservation, dispatch)
+	if err != nil {
+		return empty, err
+	}
+	fresh, err := f.lookupBBFolderLeaf(ctx, binding, parentID, leaf)
+	if err != nil || fresh == nil || fresh.DocumentID != id || !fresh.Directory {
+		return empty, api.ErrConditionalUnconfirmed
+	}
+	children, err := f.BBFolderList(ctx, binding, id)
+	if err != nil || len(children) != 0 {
+		return empty, api.ErrConditionalUnconfirmed
+	}
+	return *fresh, nil
+}
+
+// Upload the exact original bytes to an anonymous allocation. The server
+// copy endpoint can create a named duplicate in the original directory.
+func (f *Fs) BBReserveStageFile(ctx context.Context, binding string, expected BBFolderItem, original [sha256.Size]byte) (api.BBFolderFileAllocation, error) {
+	var empty api.BBFolderFileAllocation
+	fresh, err := f.lookupBBFolderLeaf(ctx, binding, expected.ParentID, expected.Name)
+	if err != nil || fresh == nil || fresh.Directory || expected.Directory ||
+		fresh.DocumentID != expected.DocumentID || fresh.ETag != expected.ETag || fresh.Size != expected.Size ||
+		fresh.Size < 0 || fresh.Size > 1<<30 {
+		return empty, api.ErrConditionalConflict
+	}
+	object, err := f.NewObjectFromDriveItem(ctx, fresh.Name, fresh.item)
+	if err != nil {
+		return empty, err
+	}
+	stream, err := object.Open(ctx)
+	if err != nil {
+		return empty, err
+	}
+	defer stream.Close()
+	zone := api.ZoneFromDriveID(binding)
+	name := f.opt.Enc.FromStandardName(fresh.Name)
+	slot, _, err := f.service.CreateUpload(ctx, fresh.Size, name, zone)
+	if err != nil || slot == nil || slot.URL == "" || slot.DocumentID == "" {
+		return empty, api.ErrConditionalUnconfirmed
+	}
+	digest := sha256.New()
+	content := io.TeeReader(io.LimitReader(stream, fresh.Size), digest)
+	result, _, err := f.service.Upload(ctx, content, fresh.Size, name, slot.URL)
+	if err != nil || result == nil || result.SingleFile == nil || result.SingleFile.Size != fresh.Size ||
+		result.SingleFile.Receipt == "" || result.SingleFile.Signature == "" || !bytes.Equal(digest.Sum(nil), original[:]) {
+		return empty, api.ErrConditionalUnconfirmed
+	}
+	return api.BBFolderFileAllocation{DocumentID: slot.DocumentID, Asset: *result.SingleFile}, nil
+}
+
+// Verify the exact allocated identity before trusting a resumed activation.
+// Other clients' items are never reused merely because their name or bytes match.
+func (f *Fs) BBObserveStageFile(ctx context.Context, binding, parentID, leaf, allocatedID string, original [sha256.Size]byte) (*BBFolderItem, error) {
+	current, err := f.lookupBBFolderLeaf(ctx, binding, parentID, leaf)
+	if err != nil || current == nil {
+		return current, err
+	}
+	_, zone, _ := api.DeconstructDriveID(parentID)
+	if current.Directory || current.DocumentID != api.ConstructDriveID(allocatedID, zone, "FILE") {
+		return nil, api.ErrConditionalConflict
+	}
+	digest, err := f.BBFolderFileHash(ctx, *current)
+	if err != nil || digest != original {
+		return nil, api.ErrConditionalUnconfirmed
+	}
+	return current, nil
+}
+
+func (f *Fs) BBActivateStageFile(ctx context.Context, binding, parentID, leaf string, allocated api.BBFolderFileAllocation, original [sha256.Size]byte, dispatch func() error) (*BBFolderItem, error) {
+	current, err := f.BBObserveStageFile(ctx, binding, parentID, leaf, allocated.DocumentID, original)
+	if err != nil || current != nil {
+		return current, err
+	}
+	started := false
+	_, publishErr := f.service.ActivateBBFolderFile(ctx, parentID, f.opt.Enc.FromStandardName(leaf), allocated.DocumentID, allocated.Asset, func() error {
+		if dispatch != nil {
+			if err := dispatch(); err != nil {
+				return err
+			}
+		}
+		started = true
+		return nil
+	})
+	if !started {
+		return nil, publishErr
+	}
+	current, err = f.BBObserveStageFile(ctx, binding, parentID, leaf, allocated.DocumentID, original)
+	if err != nil {
+		return nil, err
+	}
+	if current != nil {
+		return current, nil
+	}
+	if errors.Is(publishErr, api.ErrConditionalConflict) {
+		return nil, api.ErrConditionalConflict
+	}
+	return nil, api.ErrConditionalUnconfirmed
+}
+
+// The original item is retired only after the owner verifies a complete
+// replacement. A file must keep its saved revision. A directory must match
+// the caller's freshly verified exact identity and still be empty.
+func (f *Fs) BBRetireCopiedFolderItem(ctx context.Context, binding string, expected BBFolderItem) error {
+	return f.BBRetireCopiedFolderItemWithDispatch(ctx, binding, expected, nil, nil)
+}
+
+func (f *Fs) BBRetireCopiedFolderItemWithDispatch(ctx context.Context, binding string, expected BBFolderItem, dispatch, acknowledged func() error) error {
+	fresh, err := f.lookupBBFolderLeaf(ctx, binding, expected.ParentID, expected.Name)
+	if err != nil || fresh == nil || fresh.DocumentID != expected.DocumentID || fresh.ETag != expected.ETag ||
+		fresh.Directory != expected.Directory {
+		return api.ErrConditionalConflict
+	}
+	if fresh.Directory {
+		children, err := f.BBFolderList(ctx, binding, fresh.DocumentID)
+		if err != nil {
+			return err
+		}
+		if len(children) != 0 {
+			return api.ErrConditionalConflict
+		}
+		final, err := f.lookupBBFolderLeaf(ctx, binding, expected.ParentID, expected.Name)
+		if err != nil || final == nil || final.DocumentID != expected.DocumentID ||
+			final.ETag != expected.ETag || !final.Directory {
+			return api.ErrConditionalConflict
+		}
+	}
+	if err := f.service.RetireBBFolderItem(ctx, *fresh.item, dispatch); err != nil {
+		return err
+	}
+	if acknowledged != nil {
+		if err := acknowledged(); err != nil {
+			return err
+		}
+	}
+	siblings, err := f.BBFolderList(ctx, binding, expected.ParentID)
+	if err != nil {
+		return api.ErrConditionalUnconfirmed
+	}
+	for _, candidate := range siblings {
+		if candidate.DocumentID == expected.DocumentID {
+			return api.ErrConditionalUnconfirmed
+		}
+	}
+	return nil
+}
