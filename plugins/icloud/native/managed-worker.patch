+package bisync
+
+import (
+	"crypto/sha256"
+	"os"
+	"strings"
+)
+
+// Shift the exact old common subtree to the acknowledged local destination,
+// keeping its old metadata. New contents or a deletion can then be compared
+// normally from that shared ancestor. An occupied destination or different
+// source shape is ambiguous and must remain held.
+func relocateBBFolderBaseline(previous *fileList, move BBFolderMoveIntent, recordsDirectories bool) (*fileList, error) {
+	if previous == nil || (!validBBFolderMoveIntent(move) && !validBBFolderTransition(move, true)) {
+		return nil, errBBInvalidDelivery
+	}
+	source, destination := bbFoldPath(move.Source), bbFoldPath(move.Path)
+	next := newFileList()
+	next.hash = previous.hash
+	shifted := 0
+	for _, name := range previous.list {
+		key := bbFoldPath(name)
+		if source != destination && (key == destination || strings.HasPrefix(key, destination+"/")) {
+			return nil, ErrBBDeliveryUnsettled
+		}
+		if key != source && !strings.HasPrefix(key, source+"/") {
+			previous.getPut(name, next)
+			continue
+		}
+		entry, known := move.Entries[name]
+		info := previous.info[name]
+		if !known || (info.flags == "d") != entry.Directory {
+			return nil, ErrBBDeliveryUnsettled
+		}
+		shifted++
+		path := move.Path + name[len(move.Source):]
+		next.put(path, info.size, info.time, info.hash, info.id, info.flags)
+	}
+	expected := 0
+	for _, entry := range move.Entries {
+		if recordsDirectories || !entry.Directory {
+			expected++
+		}
+	}
+	if shifted != expected {
+		return nil, ErrBBDeliveryUnsettled
+	}
+	return next, nil
+}
+
+func (b *bisyncRun) installBBFolderBaseline(move *BBFolderMove) error {
+	pair, err := bbPairFor(b.listing1, b.listing2)
+	if err != nil {
+		return err
+	}
+	if err := pair.recover(nil); err != nil {
+		return err
+	}
+	transaction := bbListingPairJournal{Version: 2, FolderOperationID: move.Intent.OperationID}
+	for i, file := range pair.listings {
+		contents, err := bbReadBounded(file, bbListingLimit)
+		if err != nil {
+			return err
+		}
+		transaction.Before[i] = sha256.Sum256(contents)
+		previous, err := b.loadListing(file)
+		if err != nil {
+			return err
+		}
+		shifted, err := relocateBBFolderBaseline(previous, move.Intent, b.opt.CreateEmptySrcDirs)
+		if err != nil {
+			return err
+		}
+		proposal, err := os.CreateTemp(b.workDir, ".bb-folder-baseline-")
+		if err != nil {
+			return err
+		}
+		name := proposal.Name()
+		defer os.Remove(name)
+		if err := proposal.Close(); err != nil {
+			return err
+		}
+		if err := shifted.save(name); err != nil {
+			return err
+		}
+		transaction.After[i], err = bbReadBounded(name, bbListingLimit)
+		if err != nil {
+			return err
+		}
+	}
+	if err := pair.beginTransaction(transaction); err != nil {
+		return err
+	}
+	if err := pair.recover(nil); err != nil {
+		return err
+	}
+	move.BaselineInstalled = true
+	return nil
+}
+
+func (b *bisyncRun) observedBBFolderMove(move *BBFolderMove) bool {
+	intent := move.Intent
+	root := b.march.bbCloudDirs[intent.Path]
+	if move.Published == nil || !b.march.bbLocalDirs[intent.Path] ||
+		b.march.bbLocalDirs[intent.Source] ||
+		root.DocumentID != move.Published.DocumentID || root.ParentID != move.Published.ParentID ||
+		b.aliases.Alias(intent.Path) != intent.Path {
+		return false
+	}
+	for name, location := range b.march.bbCloudDirs {
+		if name != intent.Path && location.DocumentID == root.DocumentID {
+			return false
+		}
+	}
+	return true
+}
