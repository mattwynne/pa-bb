+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+)
+
+type capturedScan struct {
+	fs.Fs
+	captured atomic.Bool
+	seen     chan<- struct{}
+	resume   <-chan struct{}
+}
+
+func (f *capturedScan) List(ctx context.Context, name string) (fs.DirEntries, error) {
+	entries, err := f.Fs.List(ctx, name)
+	if name != "" || err != nil || !f.captured.CompareAndSwap(false, true) {
+		return entries, err
+	}
+	select {
+	case f.seen <- struct{}{}:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	select {
+	case <-f.resume:
+		return entries, nil
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func TestBBFastPublicationDuringReadOnlyScan(t *testing.T) {
+	for _, scenario := range []string{"unchanged", "mac edit", "mac delete", "bb edit", "interrupted pair then mac delete"} {
+		t.Run(scenario, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			cloudRoot, bbRoot := t.TempDir(), t.TempDir()
+			cloud, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			bb, err := local.NewFs(ctx, "local", bbRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			note := "note.md"
+			original := "original"
+			delivered := "delivered by BB"
+			laterMac := "later Mac edit"
+			laterBB := "later BB edit"
+			baseTime := time.Unix(1700000000, 0)
+			fastTime := baseTime.Add(20 * time.Second)
+			laterTime := baseTime.Add(40 * time.Second)
+			write := func(root, name, value string, timestamp time.Time) {
+				filename := filepath.Join(root, name)
+				if err := os.WriteFile(filename, []byte(value), 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Chtimes(filename, timestamp, timestamp); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, folder := range []string{cloudRoot, bbRoot} {
+				write(folder, note, original, baseTime)
+				for _, witness := range []string{"a.md", "b.md", "c.md"} {
+					write(folder, witness, "witness", baseTime)
+				}
+			}
+
+			options := Options{Workdir: t.TempDir(), CompareFlag: "size,modtime", MaxDelete: 50,
+				ConflictSuffixFlag: "icloud-conflict,bb-conflict", CheckSync: CheckSyncTrue, Resync: true}
+			if err := Bisync(ctx, cloud, bb, &options); err != nil {
+				t.Fatal(err)
+			}
+			options.Resync = false
+			options.bbMutationLock = filepath.Join(options.Workdir, "scan-mutation.lock")
+			scheduledEntered := make(chan struct{})
+			seen, resume := make(chan struct{}, 2), make(chan struct{})
+			options.beforeDeltas = func(ctx context.Context, b *bisyncRun) error {
+				close(scheduledEntered)
+				pair, err := bbPairFor(b.listing1, b.listing2)
+				if err != nil {
+					return err
+				}
+				var before [2][sha256.Size]byte
+				var after [2][]byte
+				for i, file := range pair.listings {
+					raw, err := bbReadBounded(file, bbListingLimit)
+					if err != nil {
+						return err
+					}
+					before[i] = sha256.Sum256(raw)
+					old, err := b.loadListing(file)
+					if err != nil {
+						return err
+					}
+					old.remove(note)
+					old.put(note, int64(len(delivered)), fastTime, "", "", "-")
+					path := filepath.Join(b.workDir, filepath.Base(file)+".generated-proposal")
+					if err := old.save(path); err != nil {
+						return err
+					}
+					after[i], err = bbReadBounded(path, bbListingLimit)
+					if err != nil {
+						return err
+					}
+					if err := os.Remove(path); err != nil {
+						return err
+					}
+				}
+				if err := pair.begin(before, after); err != nil {
+					return err
+				}
+				if scenario == "interrupted pair then mac delete" {
+					stop := errors.New("terminated after first listing")
+					err := pair.recover(func(int) error { return stop })
+					if !errors.Is(err, stop) {
+						return errors.New("interruption was not injected")
+					}
+				}
+				if err := pair.recover(nil); err != nil {
+					return err
+				}
+				return b.refreshPublishedPath(ctx, note)
+			}
+			done := make(chan error, 1)
+			go func() {
+				done <- Bisync(ctx, &capturedScan{Fs: cloud, seen: seen, resume: resume}, &capturedScan{Fs: bb, seen: seen, resume: resume}, &options)
+			}()
+			for range 2 {
+				select {
+				case <-seen:
+				case err := <-done:
+					t.Fatalf("sync quit before collecting listings: %v", err)
+				case <-ctx.Done():
+					t.Fatal(ctx.Err())
+				}
+			}
+
+			release, err := bbAcquireMutationPhase(ctx, options.bbMutationLock)
+			if err != nil {
+				t.Fatal(err)
+			}
+			stillHeld := true
+			defer func() {
+				if stillHeld {
+					_ = release()
+				}
+			}()
+			write(bbRoot, note, delivered, fastTime)
+			write(cloudRoot, note, delivered, fastTime)
+			switch scenario {
+			case "mac edit":
+				write(cloudRoot, note, laterMac, laterTime)
+			case "mac delete", "interrupted pair then mac delete":
+				if err := os.Remove(filepath.Join(cloudRoot, note)); err != nil {
+					t.Fatal(err)
+				}
+			case "bb edit":
+				write(bbRoot, note, laterBB, laterTime)
+			}
+			close(resume)
+			select {
+			case <-scheduledEntered:
+				t.Fatal("scheduled writer entered while fast publication still owned the lock")
+			case <-time.After(25 * time.Millisecond):
+			}
+			if err := release(); err != nil {
+				t.Fatal(err)
+			}
+			stillHeld = false
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			for _, folder := range []string{cloudRoot, bbRoot} {
+				value, err := os.ReadFile(filepath.Join(folder, note))
+				switch scenario {
+				case "unchanged":
+					if err != nil || string(value) != delivered {
+						t.Fatalf("fast delivery lost: %v", err)
+					}
+				case "mac delete", "interrupted pair then mac delete":
+					if !errors.Is(err, os.ErrNotExist) {
+						t.Fatal("Mac deletion did not propagate")
+					}
+				case "mac edit":
+					if err != nil || string(value) != laterMac {
+						t.Fatal("Mac edit did not propagate")
+					}
+				case "bb edit":
+					if err != nil || string(value) != laterBB {
+						t.Fatal("BB edit did not propagate")
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestBBExpeditedAndScheduledWritesShareOneMutationPhase(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	safeLock := filepath.Join(t.TempDir(), "private.lock")
+	release, err := bbAcquireMutationPhase(ctx, safeLock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	short, stop := context.WithTimeout(ctx, 50*time.Millisecond)
+	defer stop()
+	if other, err := bbAcquireMutationPhase(short, safeLock); !errors.Is(err, context.DeadlineExceeded) {
+		if other != nil {
+			_ = other()
+		}
+		t.Fatalf("concurrent writer entered: %v", err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	release, err = bbAcquireMutationPhase(ctx, safeLock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	unsafe := filepath.Join(t.TempDir(), "foreign.lock")
+	if err := os.Symlink(safeLock, unsafe); err != nil {
+		t.Fatal(err)
+	}
+	if release, err := bbAcquireMutationPhase(ctx, unsafe); err == nil {
+		_ = release()
+		t.Fatal("symlink was used as a lock")
+	}
+}
