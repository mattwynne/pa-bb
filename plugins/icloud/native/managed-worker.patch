+// Resolve the exact relative name at publication within the bound provider
+// root. A folder moved since staging is not an independent destination.
+func (d *DriveService) CreateConditionalMarkdown(ctx context.Context, folder, relative, allocatedDocID string, staged SingleFileInfo) (int, error) {
+	kind, zone, parent := DeconstructDriveID(folder)
+	if (kind != "FOLDER" && kind != "APP_LIBRARY") || !driveIdentifier.MatchString(zone) || !driveIdentifier.MatchString(parent) ||
+		!strings.HasSuffix(relative, ".md") || path.Clean(relative) != relative || path.IsAbs(relative) || strings.HasPrefix(relative, "../") || len(relative) > 1024 ||
+		!driveIdentifier.MatchString(allocatedDocID) || staged.Signature == "" || staged.Size <= 0 || staged.Size > (1<<20) {
+		return 0, ErrConditionalRefused
+	}
+	request := NewUpdateFileInfo()
+	request.AllowConflict = false
+	request.CreateShortGUID = false
+	request.Btime = time.Now().UnixMilli()
+	request.Mtime = request.Btime
+	request.DocumentID = allocatedDocID
+	request.Path.Path = relative
+	request.Path.StartingDocumentID = parent
+	request.Data.Receipt = staged.Receipt
+	request.Data.ReferenceSignature = staged.ReferenceSignature
+	request.Data.Signature = staged.Signature
+	request.Data.Size = staged.Size
+	request.Data.WrappingKey = staged.WrappingKey
+	raw, err := json.Marshal(request)
+	if err != nil {
+		return 0, ErrConditionalRefused
+	}
+	session := d.icloud.Session
+	resp, err := session.srv.Call(ctx, &rest.Opts{
+		Method: http.MethodPost, Path: "/ws/" + zone + "/update/documents", RootURL: d.docsEndpoint,
+		Body: io.NopCloser(bytes.NewReader(raw)), ExtraHeaders: session.GetHeaders(nil),
+		IgnoreStatus: true, NoRedirect: true,
+	})
+	if err != nil {
+		return 0, ErrConditionalUnconfirmed
+	}
+	defer resp.Body.Close()
+	raw, err = io.ReadAll(io.LimitReader(resp.Body, conditionalReplyLimit+1))
+	if err != nil || len(raw) > conditionalReplyLimit {
+		return resp.StatusCode, ErrConditionalUnconfirmed
+	}
+	if resp.StatusCode == http.StatusConflict {
+		return resp.StatusCode, ErrConditionalConflict
+	}
+	var reply conditionalReply
+	if json.Unmarshal(raw, &reply) != nil || resp.StatusCode < 200 || resp.StatusCode >= 300 ||
+		reply.Status.StatusCode != 0 || len(reply.Results) != 1 || reply.Results[0].Document == nil ||
+		reply.Results[0].Status.StatusCode != 0 || reply.Results[0].Document.DocumentID != allocatedDocID {
+		return resp.StatusCode, ErrConditionalUnconfirmed
+	}
+	return resp.StatusCode, nil
+}
