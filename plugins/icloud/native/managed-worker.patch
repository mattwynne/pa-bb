+package bisync
+
+import (
+	"crypto/sha256"
+	"path"
+	"slices"
+	"strings"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// BBRelocationIntent binds a locally committed move to the acknowledged
+// source revision. The destination can contain different bytes after a link
+// rewrite. Its hash is independent of the source hash.
+type BBRelocationIntent struct {
+	BBDeliveryIntent
+	Source     string
+	Binding    string
+	Previous   BBIndexedVersion
+	SourceHash [sha256.Size]byte
+}
+
+// BBRelocation retains the destination bytes across ambiguous requests and
+// intervening local edits. Scheduled sync retains each affected path's
+// last common baseline until the move receipt can be applied.
+type BBRelocation struct {
+	Intent            BBRelocationIntent
+	Data              []byte
+	Allocation        string
+	Destination       *BBDeliveryReceipt
+	Removing          bool
+	CaseSourceRemoved bool                  `json:",omitempty"`
+	Conflict          *BBRelocationConflict `json:",omitempty"`
+}
+
+func equalBBPaths(a, b string) bool {
+	return strings.EqualFold(norm.NFC.String(a), norm.NFC.String(b))
+}
+
+// BBCaseRelocation is a spelling change of one leaf in the same directory.
+func BBCaseRelocation(source, destination string) bool {
+	return source != "" && destination != "" && norm.NFC.String(source) != norm.NFC.String(destination) &&
+		path.Dir(source) == path.Dir(destination) && equalBBPaths(source, destination)
+}
+
+func validBBRelocationPaths(source string, destination BBDeliveryIntent) bool {
+	from := destination
+	from.Path = source
+	return validBBDelivery(from) && (!equalBBPaths(source, destination.Path) || BBCaseRelocation(source, destination.Path))
+}
+
+// Admission uses the frozen path names and the provider document identity.
+// A different name alone is not evidence that a renamed iCloud note is
+// independent of the relocation.
+func bbCheckRelocationDisjoint(move *BBRelocation, intent BBDeliveryIntent, knownDocument []string) error {
+	if move == nil {
+		return nil
+	}
+	if move.Intent.OperationID == intent.OperationID {
+		return ErrBBDeliveryUnsettled
+	}
+	for _, name := range move.heldPaths() {
+		key, endpoint := bbFoldPath(intent.Path), bbFoldPath(name)
+		if key == endpoint || strings.HasPrefix(key, endpoint+".") {
+			return ErrBBDeliveryUnsettled
+		}
+	}
+	if intent.Create {
+		// The provider is required to reject an occupied exact destination.
+		if len(knownDocument) != 0 {
+			return errBBInvalidDelivery
+		}
+		return nil
+	}
+	if len(knownDocument) != 1 || knownDocument[0] == "" || move.hasProviderDocument(knownDocument[0]) {
+		return ErrBBDeliveryUnsettled
+	}
+	return nil
+}
+
+func bbAllocatedDocumentID(providerID string) string {
+	_, rest, qualified := strings.Cut(providerID, "::")
+	_, bare, document := strings.Cut(rest, "::")
+	if !qualified || !document {
+		return ""
+	}
+	return bare
+}
+
+func (r *BBRelocation) hasProviderDocument(providerID string) bool {
+	bare := bbAllocatedDocumentID(providerID)
+	return providerID == r.Intent.Previous.DocumentID ||
+		(r.Destination != nil && providerID == r.Destination.ProviderID) ||
+		(bare != "" && r.Allocation != "" && bare == r.Allocation) ||
+		(bare != "" && r.Conflict != nil && r.Conflict.Copy == nil && bare == r.Conflict.Allocation)
+}
+
+func BBCheckDeliveryDisjoint(workdir string, intent BBDeliveryIntent, knownDocument ...string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.Pending != nil && *state.Pending == intent && state.PendingDocument != "" &&
+		(len(knownDocument) != 1 || knownDocument[0] != state.PendingDocument) {
+		return ErrBBDeliveryUnsettled
+	}
+	return bbCheckRelocationDisjoint(state.Relocation, intent, knownDocument)
+}
+
+func validBBRelocationIntent(intent BBRelocationIntent) bool {
+	return validBBDelivery(intent.BBDeliveryIntent) && intent.Create && validBBRelocationPaths(intent.Source, intent.BBDeliveryIntent) &&
+		intent.Binding != "" && len(intent.Binding) <= 512 && intent.Previous.DocumentID != "" && len(intent.Previous.DocumentID) <= 512 &&
+		intent.Previous.ParentID != "" && len(intent.Previous.ParentID) <= 512 && intent.Previous.ETag != "" && len(intent.Previous.ETag) <= 512 &&
+		intent.SourceHash != ([sha256.Size]byte{})
+}
+
+func (r BBRelocation) valid() bool {
+	intent := r.Intent
+	caseMove := BBCaseRelocation(intent.Source, intent.Path)
+	if !validBBRelocationIntent(intent) || len(r.Allocation) > 512 || r.Data == nil || len(r.Data) > bbDeliveryBytes ||
+		sha256.Sum256(r.Data) != intent.Hash ||
+		(!caseMove && (r.CaseSourceRemoved || (r.Removing && r.Destination == nil))) ||
+		(caseMove && ((r.CaseSourceRemoved && !r.Removing) || (!r.CaseSourceRemoved && (r.Allocation != "" || r.Destination != nil)))) {
+		return false
+	}
+	if r.Conflict != nil && !r.Conflict.valid(intent, len(r.Data)) {
+		return false
+	}
+	if target := r.Destination; target != nil {
+		return r.Allocation != "" && target.BBDeliveryIntent == intent.BBDeliveryIntent &&
+			target.RemovedPath == intent.Source && target.DocumentID == r.Allocation &&
+			target.ProviderID != "" && target.ProviderID != intent.Previous.DocumentID &&
+			target.ETag != "" && target.ProviderParentID != "" && !target.Modified.IsZero() && target.Size == int64(len(r.Data))
+	}
+	return true
+}
+
+// These calls require the per-mirror mutation lock. Returning a known
+// operation never changes its scope or reopens a completed relocation.
+func BBReadRelocation(workdir string, intent BBRelocationIntent) (*BBRelocation, *BBDeliveryReceipt, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return nil, nil, err
+	}
+	if state.Pending != nil || state.FolderMove != nil || state.FolderClone != nil {
+		return nil, nil, ErrBBDeliveryUnsettled
+	}
+	if state.Relocation != nil {
+		if state.Relocation.Intent != intent {
+			return nil, nil, ErrBBDeliveryUnsettled
+		}
+		return state.Relocation, nil, nil
+	}
+	for _, candidates := range [][]BBDeliveryReceipt{state.Confirmed, state.Applied} {
+		for _, receipt := range candidates {
+			if receipt.OperationID == intent.OperationID {
+				if receipt.BBDeliveryIntent != intent.BBDeliveryIntent || receipt.RemovedPath != intent.Source {
+					return nil, nil, errBBInvalidDelivery
+				}
+				return nil, &receipt, nil
+			}
+		}
+	}
+	return nil, nil, nil
+}
+
+func BBBeginRelocation(workdir string, intent BBRelocationIntent, data []byte) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	if state.FolderMove != nil || state.FolderClone != nil {
+		return ErrBBDeliveryUnsettled
+	}
+	move := BBRelocation{Intent: intent, Data: data}
+	if !move.valid() {
+		return errBBInvalidDelivery
+	}
+	related := func(r BBDeliveryReceipt) bool {
+		return !bbRelocationSupersedes(intent, r) && (r.OperationID == intent.OperationID ||
+			equalBBPaths(r.Path, intent.Path) || equalBBPaths(r.Path, intent.Source) ||
+			equalBBPaths(r.RemovedPath, intent.Path) || equalBBPaths(r.RemovedPath, intent.Source))
+	}
+	used := func(r BBDeliveryReceipt) bool { return r.OperationID == intent.OperationID }
+	canReplace := slices.ContainsFunc(state.Confirmed, func(r BBDeliveryReceipt) bool { return bbRelocationSupersedes(intent, r) })
+	if state.Pending != nil || state.Relocation != nil || (len(state.Confirmed) >= bbDeliveryLimit && !canReplace) ||
+		slices.ContainsFunc(state.Confirmed, related) || slices.ContainsFunc(state.Applied, used) ||
+		slices.ContainsFunc(state.ReconciledConflicts, func(previous BBRelocationIntent) bool { return previous.OperationID == intent.OperationID }) {
+		return ErrBBDeliveryUnsettled
+	}
+	// Previous binaries reject this version instead of ignoring a pending
+	// relocation or applying a destination receipt without its tombstone.
+	if state.Version < 2 {
+		state.Version = 2
+	}
+	if BBCaseRelocation(intent.Source, intent.Path) && state.Version < 7 {
+		state.Version = 7
+	}
+	if len(data) == 0 && state.Version < bbEmptyNoteVersion {
+		state.Version = bbEmptyNoteVersion
+	}
+	state.Relocation = &move
+	return state.write(workdir)
+}
+
+// A prior publication of the exact source revision is absorbed into the
+// move. Retain that publication's evidence until source removal is proved.
+func bbRelocationSupersedes(intent BBRelocationIntent, prior BBDeliveryReceipt) bool {
+	return prior.OperationID != intent.OperationID && prior.RemovedPath == "" && prior.Path == intent.Source &&
+		prior.Hash == intent.SourceHash && prior.ProviderID == intent.Previous.DocumentID && prior.ETag == intent.Previous.ETag
+}
+
+func bbChangeRelocation(workdir string, intent BBRelocationIntent, transition func(*bbDeliveryStore, *BBRelocation) bool) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.Relocation
+	if move == nil || move.Intent != intent || !transition(&state, move) ||
+		(state.Relocation != nil && !state.Relocation.valid()) {
+		return errBBInvalidDelivery
+	}
+	return state.write(workdir)
+}
+
+func BBAllocateRelocation(workdir string, intent BBRelocationIntent, allocation string) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation != "" || allocation == "" ||
+			(BBCaseRelocation(intent.Source, intent.Path) && !move.CaseSourceRemoved) {
+			return false
+		}
+		move.Allocation = allocation
+		return true
+	})
+}
+
+func BBRecordRelocationDestination(workdir string, intent BBRelocationIntent, target BBDeliveryReceipt) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation == "" || move.Destination != nil {
+			return false
+		}
+		target.DocumentID = move.Allocation
+		target.RemovedPath = intent.Source
+		move.Destination = &target
+		return true
+	})
+}
+
+func BBDispatchRelocationTrash(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		caseMove := BBCaseRelocation(intent.Source, intent.Path)
+		if move.Removing || move.Conflict != nil || (caseMove && move.Allocation != "") || (!caseMove && move.Destination == nil) {
+			return false
+		}
+		move.Removing = true
+		return true
+	})
+}
+
+// Record only a positive provider response to the exact conditional removal.
+// Mere absence cannot distinguish BB's removal from an independent deletion.
+func BBRecordCaseSourceRemoval(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if !BBCaseRelocation(intent.Source, intent.Path) || !move.Removing || move.CaseSourceRemoved || move.Conflict != nil {
+			return false
+		}
+		move.CaseSourceRemoved = true
+		return true
+	})
+}
+
+func BBFinishRelocation(workdir string, intent BBRelocationIntent) error {
+	return bbFinishRelocation(workdir, intent, false, false)
+}
+
+// A positively observed source replacement or absence is sufficient when
+// the exact destination has been verified. It is never a reason to retry
+// removal against the newer source.
+func BBFinishRelocationWithIndependentSource(workdir string, intent BBRelocationIntent, present bool) error {
+	return bbFinishRelocation(workdir, intent, true, present)
+}
+
+func bbFinishRelocation(workdir string, intent BBRelocationIntent, observedSource, sourcePresent bool) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if (!move.Removing && !observedSource) || move.Destination == nil || move.Conflict != nil ||
+			(BBCaseRelocation(intent.Source, intent.Path) && (!move.CaseSourceRemoved || observedSource)) {
+			return false
+		}
+		state.Confirmed = slices.DeleteFunc(state.Confirmed, func(prior BBDeliveryReceipt) bool {
+			if !bbRelocationSupersedes(intent, prior) {
+				return false
+			}
+			state.Applied = append(state.Applied, prior)
+			return true
+		})
+		if len(state.Confirmed) >= bbDeliveryLimit {
+			return false
+		}
+		if len(state.Applied) > bbDeliveryLimit {
+			state.Applied = state.Applied[len(state.Applied)-bbDeliveryLimit:]
+		}
+		confirmed := *move.Destination
+		confirmed.SourceRetained = sourcePresent
+		state.Confirmed = append(state.Confirmed, confirmed)
+		state.Relocation = nil
+		return true
+	})
+}
+
+// Refuse a move only while no destination request could have reached iCloud.
+func BBRefuseRelocation(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation != "" || move.Removing || move.Conflict != nil {
+			return false
+		}
+		state.Relocation = nil
+		return true
+	})
+}
