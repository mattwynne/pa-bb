+package iclouddrive
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"golang.org/x/text/unicode/norm"
+)
+
+type BBFolderItem struct {
+	Name, DocumentID, ParentID, ETag string
+	Directory                        bool
+	Size                             int64
+	item                             *api.DriveItem
+}
+
+// The owned folder walker obtains every descendant ID from directories it
+// has already verified beneath the bound mirror. Resolve a directory by
+// that identity so an insensitive path lookup cannot redirect a read.
+func (f *Fs) BBFolderList(ctx context.Context, binding, directoryID string) ([]BBFolderItem, error) {
+	_, boundZone, boundID := api.DeconstructDriveID(binding)
+	kind, zone, id := api.DeconstructDriveID(directoryID)
+	if boundID == "" || id == "" || boundZone != zone || (kind != "FOLDER" && (directoryID != binding || kind != "APP_LIBRARY")) {
+		return nil, api.ErrConditionalRefused
+	}
+	children, err := f.listAll(ctx, directoryID)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]BBFolderItem, 0, len(children))
+	for _, item := range children {
+		if item == nil || item.ParentID != directoryID || item.Drivewsid == "" || item.Etag == "" {
+			return nil, api.ErrConditionalUnconfirmed
+		}
+		isDirectory := item.Type == "FOLDER"
+		if !isDirectory && (item.Type != "FILE" || item.Size < 0) {
+			return nil, api.ErrConditionalRefused
+		}
+		out = append(out, BBFolderItem{norm.NFC.String(item.FullName()), item.Drivewsid, item.ParentID, item.Etag, isDirectory, item.Size, item})
+	}
+	return out, nil
+}
+
+func (f *Fs) BBFolderFileHash(ctx context.Context, item BBFolderItem) ([sha256.Size]byte, error) {
+	var result [sha256.Size]byte
+	if item.item == nil || item.Directory || item.Size < 0 || item.Size > 1<<30 || item.item.Drivewsid != item.DocumentID {
+		return result, api.ErrConditionalRefused
+	}
+	object, err := f.NewObjectFromDriveItem(ctx, item.Name, item.item)
+	if err != nil {
+		return result, err
+	}
+	stream, err := object.Open(ctx)
+	if err != nil {
+		return result, err
+	}
+	defer stream.Close()
+	sha := sha256.New()
+	count, err := io.Copy(sha, io.LimitReader(stream, item.Size+1))
+	if err != nil || count != item.Size {
+		return result, api.ErrConditionalUnconfirmed
+	}
+	copy(result[:], sha.Sum(nil))
+	return result, nil
+}
+
+// BBMoveFolder dispatches the single exact provider operation after the
+// owning worker verifies both parents and stages its durable intent.
+func (f *Fs) BBMoveFolder(ctx context.Context, source BBFolderItem, destinationID string) error {
+	if source.item == nil || !source.Directory || source.item.Drivewsid != source.DocumentID ||
+		source.item.ParentID != source.ParentID || source.item.Etag != source.ETag {
+		return api.ErrConditionalRefused
+	}
+	return f.service.MoveConditionalFolder(ctx, *source.item, destinationID)
+}
+
+func (f *Fs) BBRenameFolder(ctx context.Context, source BBFolderItem, name string) error {
+	if source.item == nil || !source.Directory || source.item.Drivewsid != source.DocumentID ||
+		source.item.ParentID != source.ParentID || source.item.Etag != source.ETag {
+		return api.ErrConditionalRefused
+	}
+	return f.service.RenameFolderOnce(ctx, *source.item, name)
+}
