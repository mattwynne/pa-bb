+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+)
+
+type bbHeldListingFS struct {
+	fs.Fs
+	versions map[string]BBIndexedVersion
+}
+
+type bbHeldListingObject struct {
+	fs.Object
+	version BBIndexedVersion
+}
+
+func (o bbHeldListingObject) BBListedIdentity() (string, string, string) {
+	return o.version.DocumentID, o.version.ParentID, o.version.ETag
+}
+
+func (f *bbHeldListingFS) List(ctx context.Context, dir string) (fs.DirEntries, error) {
+	items, err := f.Fs.List(ctx, dir)
+	for i, item := range items {
+		if obj, ok := item.(fs.Object); ok {
+			version, tracked := f.versions[item.Remote()]
+			if !tracked {
+				version = BBIndexedVersion{"different-" + item.Remote(), "parent", "version"}
+			}
+			items[i] = bbHeldListingObject{obj, version}
+		}
+	}
+	return items, err
+}
+
+func (f *bbHeldListingFS) NewObject(ctx context.Context, name string) (fs.Object, error) {
+	object, err := f.Fs.NewObject(ctx, name)
+	if err != nil {
+		return nil, err
+	}
+	if version, ok := f.versions[name]; ok {
+		return bbHeldListingObject{object, version}, nil
+	}
+	return object, nil
+}
+
+func TestBBUnconfirmedMoveProtectsBothEndpointsAndSyncsUnrelatedFiles(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	cloudRoot, mirrorRoot, workdir := t.TempDir(), t.TempDir(), t.TempDir()
+	cloud, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mirror, err := local.NewFs(ctx, "local", mirrorRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseline := time.Unix(1700000000, 0)
+	later := baseline.Add(40 * time.Second)
+	write := func(root, name, data string, mt time.Time) {
+		file := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(file), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(file, []byte(data), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(file, mt, mt); err != nil {
+			t.Fatal(err)
+		}
+	}
+	const source, destination, observedMove = "Source/From.md", "Archive/To.md", "Mac changed name.txt"
+	const original, wanted = "original version", "new bytes while moving"
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		write(root, source, original, baseline)
+		write(root, "Source/Anchor.md", "anchor", baseline)
+		write(root, "BB edit.md", "original BB bytes", baseline)
+		write(root, "Mac edit.md", "original Mac bytes", baseline)
+	}
+	options := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50, CreateEmptySrcDirs: true}
+	if err := Bisync(ctx, cloud, mirror, &options); err != nil {
+		t.Fatal(err)
+	}
+
+	// The move has already crossed the creation boundary. iCloud's new
+	// document now appears under an independently edited, non-Markdown name.
+	prev := BBIndexedVersion{"FILE::com.apple.CloudDocs::old", "FOLDER::com.apple.CloudDocs::source", "prior-etag"}
+	move := BBRelocationIntent{
+		BBDeliveryIntent: BBDeliveryIntent{"38da8cab-4ea1-48fa-9ef9-c93810322f4b", destination, sha256.Sum256([]byte(wanted)), true},
+		Source:           source, Binding: "FOLDER::com.apple.CloudDocs::vault", Previous: prev, SourceHash: sha256.Sum256([]byte(original)),
+	}
+	prior := BBDeliveryIntent{"e7bd52ef-e4a5-45d1-b4cc-ec4d6be5770c", source, move.SourceHash, false}
+	if err := BBBeginDelivery(workdir, prior); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBResolveDelivery(workdir, prior, &BBDeliveryReceipt{
+		BBDeliveryIntent: prior, Size: int64(len(original)), Modified: baseline, ProviderID: prev.DocumentID, ETag: prev.ETag,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBBeginRelocation(workdir, move, []byte(wanted)); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBAllocateRelocation(workdir, move, "allocated"); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBBeginRelocationConflict(workdir, move); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBAllocateRelocationConflict(workdir, move, "conflict-allocated"); err != nil {
+		t.Fatal(err)
+	}
+	copyIntent := move.ConflictIntent()
+	if err := os.Remove(filepath.Join(mirrorRoot, source)); err != nil {
+		t.Fatal(err)
+	}
+
+	write(mirrorRoot, destination, wanted, later)
+	write(mirrorRoot, "Archive/Adjacent.md", "new sibling in unconfirmed directory", later)
+	write(mirrorRoot, "BB edit.md", "BB edit during recovery", later)
+	write(cloudRoot, source, "Mac continued editing old source", later)
+	write(cloudRoot, observedMove, "independent content at altered provider path", later)
+	write(cloudRoot, "Mac edit.md", "Mac edit during recovery", later)
+	write(cloudRoot, copyIntent.Path, wanted, later)
+	cloudRevisions := map[string]BBIndexedVersion{
+		source:          {prev.DocumentID, prev.ParentID, "new-etag"},
+		observedMove:    {"FILE::com.apple.CloudDocs::allocated", "FOLDER::com.apple.CloudDocs::vault", "altered"},
+		copyIntent.Path: {"FILE::com.apple.CloudDocs::conflict-allocated", "FOLDER::com.apple.CloudDocs::vault", "conflict-version"},
+	}
+	cloudSide := &bbHeldListingFS{Fs: cloud, versions: cloudRevisions}
+	options.Resync = false
+	if err := BBManagedBisync(ctx, cloud, mirror, options, move.Binding); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("scan with a missing provider identity was admitted: %v", err)
+	}
+	if err := BBManagedBisync(ctx, cloudSide, mirror, options, move.Binding); err != nil {
+		t.Fatal(err)
+	}
+
+	wantOn := func(root, name, want string) {
+		t.Helper()
+		got, err := os.ReadFile(filepath.Join(root, name))
+		if err != nil || string(got) != want {
+			t.Fatalf("unexpected fixture contents at %s: %q %v", name, got, err)
+		}
+	}
+	absent := func(root, name string) {
+		t.Helper()
+		if _, err := os.Lstat(filepath.Join(root, name)); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("unexpected file at %s: %v", name, err)
+		}
+	}
+	wantOn(cloudRoot, "BB edit.md", "BB edit during recovery")
+	wantOn(mirrorRoot, "Mac edit.md", "Mac edit during recovery")
+	wantOn(cloudRoot, source, "Mac continued editing old source")
+	wantOn(mirrorRoot, destination, wanted)
+	wantOn(cloudRoot, observedMove, "independent content at altered provider path")
+	absent(mirrorRoot, source)
+	absent(mirrorRoot, observedMove)
+	absent(cloudRoot, "Archive")
+	absent(mirrorRoot, copyIntent.Path)
+	version := cloudRevisions[copyIntent.Path]
+	receipt := BBDeliveryReceipt{BBDeliveryIntent: copyIntent, DocumentID: "conflict-allocated",
+		ProviderID: version.DocumentID, ProviderParentID: version.ParentID, ETag: version.ETag, Size: int64(len(wanted)), Modified: later}
+	if err := BBRecordRelocationConflict(workdir, move, receipt); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBManagedBisync(ctx, cloudSide, mirror, options, move.Binding); err != nil {
+		t.Fatal(err)
+	}
+	wantOn(mirrorRoot, copyIntent.Path, wanted)
+	absent(mirrorRoot, source)
+	absent(mirrorRoot, observedMove)
+	state, err := readBBDeliveries(workdir)
+	if err != nil || state.Relocation == nil || state.Relocation.Allocation != "allocated" ||
+		len(state.Confirmed) != 1 || state.Confirmed[0].BBDeliveryIntent != prior {
+		t.Fatalf("unconfirmed state lost while syncing other files: %v", err)
+	}
+
+	// The user has independently made both canonical paths agree. A later
+	// iCloud change must invalidate the choice without erasing either side.
+	const firstChoice = "Device destination the user checked"
+	const laterChoice = "A newer destination after the check"
+	const reviewedSource = "Mac continued editing old source"
+	targetVersion := BBIndexedVersion{"FILE::com.apple.CloudDocs::device-target", "FOLDER::com.apple.CloudDocs::archive", "reviewed"}
+	cloudRevisions[destination] = targetVersion
+	for _, side := range []string{cloudRoot, mirrorRoot} {
+		write(side, destination, firstChoice, later)
+		write(side, source, reviewedSource, later)
+	}
+	sourceSnapshot := BBConflictSnapshot{true, cloudRevisions[source], sha256.Sum256([]byte(reviewedSource)), int64(len(reviewedSource)), later}
+	verified := BBConflictResolution{Source: sourceSnapshot, Destination: BBConflictSnapshot{
+		true, targetVersion, sha256.Sum256([]byte(firstChoice)), int64(len(firstChoice)), later,
+	}}
+	if err := BBApproveConflictResolution(workdir, move, verified); err != nil {
+		t.Fatal(err)
+	}
+	newAt := later.Add(20 * time.Second)
+	write(cloudRoot, destination, laterChoice, newAt)
+	targetVersion.ETag = "changed-after-approval"
+	cloudRevisions[destination] = targetVersion
+	if err := BBManagedBisync(ctx, cloudSide, mirror, options, move.Binding); err != nil {
+		t.Fatal(err)
+	}
+	if done, err := BBConflictResolved(workdir, move); err != nil || done {
+		t.Fatalf("a stale approval was applied: %v", err)
+	}
+	wantOn(mirrorRoot, destination, firstChoice)
+	wantOn(cloudRoot, destination, laterChoice)
+
+	write(mirrorRoot, destination, laterChoice, newAt)
+	verified.Destination = BBConflictSnapshot{true, targetVersion, sha256.Sum256([]byte(laterChoice)), int64(len(laterChoice)), newAt}
+	if err := BBApproveConflictResolution(workdir, move, verified); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBManagedBisync(ctx, cloudSide, mirror, options, move.Binding); err != nil {
+		t.Fatal(err)
+	}
+	if done, err := BBConflictResolved(workdir, move); err != nil || !done {
+		t.Fatalf("closure wasn't durably recorded: %v", err)
+	}
+	for _, side := range []string{cloudRoot, mirrorRoot} {
+		wantOn(side, destination, laterChoice)
+		wantOn(side, source, reviewedSource)
+		wantOn(side, copyIntent.Path, wanted)
+	}
+	if err := BBBeginRelocation(workdir, move, []byte(wanted)); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("acknowledged conflict could reopen: %v", err)
+	}
+
+}
+
+func TestBBIndependentDeliveryRetainsMoveAndBindsProviderIdentity(t *testing.T) {
+	root := t.TempDir()
+	data := []byte("published independent bytes")
+	prev := BBIndexedVersion{"FILE::com.apple.CloudDocs::original", "parent", "original-revision"}
+	move := BBRelocationIntent{
+		BBDeliveryIntent: BBDeliveryIntent{"6c59034c-13a9-4843-9902-93130d965046", "New/Target.md", sha256.Sum256(data), true},
+		Source:           "Old/Source.md", Binding: "binding", Previous: prev, SourceHash: sha256.Sum256([]byte("old")),
+	}
+	if err := BBBeginRelocation(root, move, data); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBAllocateRelocation(root, move, "allocated"); err != nil {
+		t.Fatal(err)
+	}
+	write := BBDeliveryIntent{"762407e3-1321-4b67-a506-020a1917e0ae", "Other.md", sha256.Sum256(data), false}
+	for _, disallowed := range []struct{ path, document string }{
+		{"OLD/source.md", "unrelated"}, {"New/Target.md.conflict.md", "unrelated"},
+		{"Mac renamed.md", prev.DocumentID}, {"Different.md", "FILE::com.apple.CloudDocs::allocated"},
+	} {
+		overlap := write
+		overlap.Path = disallowed.path
+		if err := BBBeginDelivery(root, overlap, disallowed.document); !errors.Is(err, ErrBBDeliveryUnsettled) {
+			t.Fatalf("a protected path or document was admitted: %v", err)
+		}
+	}
+	const document = "FILE::com.apple.CloudDocs::independent"
+	if err := BBBeginDelivery(root, write, document); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBCheckDeliveryDisjoint(root, write, "different-provider-document"); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("a resumed write changed its provider identity: %v", err)
+	}
+	if _, _, err := BBReadRelocation(root, move); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("move raced the unresolved write: %v", err)
+	}
+	receipt := BBDeliveryReceipt{BBDeliveryIntent: write, Size: int64(len(data)), Modified: time.Unix(1700000000, 0), ETag: "new", ProviderID: document}
+	if err := BBResolveDelivery(root, write, &receipt); err != nil {
+		t.Fatal(err)
+	}
+	pending, settled, err := BBReadRelocation(root, move)
+	if err != nil || pending == nil || pending.Allocation != "allocated" || settled != nil {
+		t.Fatalf("independent delivery replaced the original move: %v", err)
+	}
+}
