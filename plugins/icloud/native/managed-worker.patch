+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type folderProofFixture struct {
+	items     map[string][]iclouddrive.BBFolderItem
+	content   []byte
+	afterHash func()
+}
+
+func (f *folderProofFixture) BBFolderList(_ context.Context, _, parent string) ([]iclouddrive.BBFolderItem, error) {
+	return f.items[parent], nil
+}
+
+func (f *folderProofFixture) BBFolderFileHash(_ context.Context, _ iclouddrive.BBFolderItem) ([sha256.Size]byte, error) {
+	if f.afterHash != nil {
+		f.afterHash()
+	}
+	return sha256.Sum256(f.content), nil
+}
+
+func TestBBInspectOwnedFolderChecksDescendantsAfterHash(t *testing.T) {
+	source := iclouddrive.BBFolderItem{Name: "Folder", DocumentID: "source", ParentID: "root", ETag: "a", Directory: true}
+	parent := iclouddrive.BBFolderItem{Name: "Destination", DocumentID: "destination", ParentID: "root", ETag: "b", Directory: true}
+	attachment := iclouddrive.BBFolderItem{Name: "Attachment.bin", DocumentID: "file", ParentID: "source", ETag: "c", Size: 3}
+	content := []byte{0, 1, 255}
+	cloud := &folderProofFixture{items: map[string][]iclouddrive.BBFolderItem{
+		"root": {source, parent}, "source": {attachment},
+	}, content: content}
+	workdir := t.TempDir()
+	index, err := json.Marshal(map[string]any{
+		"version": 1, "binding": "root",
+		"entries": map[string]bisync.BBTreeIdentity{
+			"Folder":                {BBIndexedVersion: ownedFolderVersion(source), Directory: true},
+			"Folder/Attachment.bin": {BBIndexedVersion: ownedFolderVersion(attachment)},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(workdir, "bb-cloud-tree-identities-v1.json"), index, 0600); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(content)
+	request := ownedNoteFrame{Binding: "root", Workdir: workdir, Source: "Folder", Path: "Destination/Folder",
+		FolderEntries: []ownedFolderEntry{{Path: attachment.Name, Kind: "file", Size: attachment.Size, Hash: hex.EncodeToString(digest[:])}}}
+	got := inspectOwnedFolder(context.Background(), cloud, request)
+	if got.Folder == nil || got.Folder.Method != "move" || got.Folder.DestinationParent != "destination" {
+		t.Fatalf("unchanged exact tree = %+v", got)
+	}
+
+	cloud.afterHash = func() {
+		// The provider can rename a file without changing any ancestor ETag.
+		cloud.items["source"][0].Name = "Device.bin"
+	}
+	if got := inspectOwnedFolder(context.Background(), cloud, request); got.Outcome != "refused" {
+		t.Fatalf("renamed attachment = %+v", got)
+	}
+}
