+package bisync
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+const bbListingLimit = 16 << 20
+const bbJournalLimit = 48 << 20
+
+var errBBListingChanged = errors.New("paired sync listings changed outside the recorded transaction")
+
+type bbListingPairJournal struct {
+	Version int
+	Before  [2][sha256.Size]byte
+	After   [2][]byte
+}
+
+type bbListingPair struct {
+	directory string
+	listings  [2]string
+	journal   string
+}
+
+func bbPairFor(first, second string) (bbListingPair, error) {
+	stem, matched := strings.CutSuffix(filepath.Base(first), ".path1.lst")
+	if !matched || stem == "" || filepath.Base(second) != stem+".path2.lst" ||
+		!filepath.IsAbs(first) || !filepath.IsAbs(second) || filepath.Dir(first) != filepath.Dir(second) {
+		return bbListingPair{}, errors.New("expected the ordinary sync listing pair")
+	}
+	return bbListingPair{filepath.Dir(first), [2]string{first, second}, first + ".bb-pair-journal"}, nil
+}
+
+func bbReadBounded(path string, limit int) ([]byte, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	stat, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !stat.Mode().IsRegular() || stat.Size() > int64(limit) {
+		return nil, errors.New("listing exceeds its bounds")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, int64(limit)+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > limit {
+		return nil, errors.New("listing exceeds its bounds")
+	}
+	return data, nil
+}
+
+// Stage an already checked pair before either listing can change. This and
+// recover both require the same native owner and a drained mutation phase.
+func (p bbListingPair) begin(expected [2][sha256.Size]byte, after [2][]byte) error {
+	if err := p.verifyCurrent(expected, expected); err != nil {
+		return err
+	}
+	for _, data := range after {
+		if len(data) == 0 || len(data) > bbListingLimit {
+			return errors.New("replacement listing exceeds its bounds")
+		}
+	}
+	contents, err := json.Marshal(bbListingPairJournal{1, expected, after})
+	if err != nil {
+		return err
+	}
+	return p.publishFile(p.journal, contents, true)
+}
+
+func (p bbListingPair) verifyCurrent(before, after [2][sha256.Size]byte) error {
+	for i, path := range p.listings {
+		data, err := bbReadBounded(path, bbListingLimit)
+		if err != nil {
+			return err
+		}
+		observed := sha256.Sum256(data)
+		if observed != before[i] && observed != after[i] {
+			return errBBListingChanged
+		}
+	}
+	return nil
+}
+
+// Recover is idempotent across a stop after either replacement. It will not
+// modify either side if one has advanced to a version absent from the journal.
+func (p bbListingPair) recover(afterStep func(int) error) error {
+	raw, err := bbReadBounded(p.journal, bbJournalLimit)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var record bbListingPairJournal
+	if err := json.Unmarshal(raw, &record); err != nil || record.Version != 1 {
+		return errors.New("invalid paired listing journal")
+	}
+	var after [2][sha256.Size]byte
+	for i, data := range record.After {
+		if len(data) == 0 || len(data) > bbListingLimit {
+			return errors.New("invalid replacement listing")
+		}
+		after[i] = sha256.Sum256(data)
+	}
+	if err := p.verifyCurrent(record.Before, after); err != nil {
+		return err
+	}
+	for i, listing := range p.listings {
+		if err := p.publishFile(listing, record.After[i], false); err != nil {
+			return err
+		}
+		if afterStep != nil {
+			if err := afterStep(i); err != nil {
+				return err
+			}
+		}
+	}
+	if err := p.verifyCurrent(after, after); err != nil {
+		return err
+	}
+	if err := os.Remove(p.journal); err != nil {
+		return err
+	}
+	return p.sync()
+}
+
+func (p bbListingPair) publishFile(destination string, data []byte, exclusive bool) error {
+	temp, err := os.CreateTemp(p.directory, ".bb-listing-stage-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temp.Name())
+	n, writeErr := temp.Write(data)
+	if n != len(data) && writeErr == nil {
+		writeErr = io.ErrShortWrite
+	}
+	err = errors.Join(writeErr, temp.Sync(), temp.Close())
+	if err != nil {
+		return err
+	}
+	if exclusive {
+		err = os.Link(temp.Name(), destination)
+	} else {
+		err = os.Rename(temp.Name(), destination)
+	}
+	if err != nil {
+		return fmt.Errorf("publish sync listing state: %w", err)
+	}
+	return p.sync()
+}
+
+func (p bbListingPair) sync() error {
+	dir, err := os.Open(p.directory)
+	if err != nil {
+		return err
+	}
+	return errors.Join(dir.Sync(), dir.Close())
+}
