+package iclouddrive
+
+import (
+	"context"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"golang.org/x/text/unicode/norm"
+)
+
+type BBCaseNamespace uint8
+
+const (
+	BBCaseVacant BBCaseNamespace = iota
+	BBCaseSource
+	BBCaseDestination
+	BBCaseOccupied
+)
+
+func (f *Fs) ObserveBBCaseNamespace(ctx context.Context, source, destination string) (BBCaseNamespace, error) {
+	invalid := api.ErrConditionalRefused
+	placeholder := BBNoteRevision{DriveID: "scope", ParentID: "scope", ETag: "scope"}
+	if !validBBIntent(source, placeholder, []byte{1}) || !validBBIntent(destination, placeholder, []byte{1}) || path.Dir(source) != path.Dir(destination) {
+		return BBCaseOccupied, invalid
+	}
+	from, to := norm.NFC.String(path.Base(source)), norm.NFC.String(path.Base(destination))
+	if from == to || !strings.EqualFold(from, to) {
+		return BBCaseOccupied, invalid
+	}
+	_, parent, _, err := f.FindPath(ctx, source, false)
+	if err != nil {
+		return BBCaseOccupied, err
+	}
+	entries, err := f.listAll(ctx, parent)
+	if err != nil {
+		return BBCaseOccupied, err
+	}
+	location := BBCaseVacant
+	for _, item := range entries {
+		if item == nil {
+			return BBCaseOccupied, api.ErrConditionalUnconfirmed
+		}
+		leaf := norm.NFC.String(item.FullName())
+		if !strings.EqualFold(leaf, from) {
+			continue
+		}
+		if location != BBCaseVacant || item.Type != "FILE" || item.ParentID != parent {
+			return BBCaseOccupied, nil
+		}
+		switch leaf {
+		case from:
+			location = BBCaseSource
+		case to:
+			location = BBCaseDestination
+		default:
+			return BBCaseOccupied, nil
+		}
+	}
+	return location, nil
+}
+
+// The case-only move must prove that our conditional request removed the
+// source before recreating it. An absence after a lost reply is insufficient.
+func (f *Fs) TrashBBCaseSource(ctx context.Context, remote string, expected BBNoteRevision, dispatch func() error) error {
+	if !validBBIntent(remote, expected, []byte{1}) || dispatch == nil {
+		return api.ErrConditionalRefused
+	}
+	current, err := f.readBBNoteItem(ctx, remote)
+	if err != nil || !sameBBIdentity(expected, current) || current.Etag != expected.ETag {
+		return api.ErrConditionalConflict
+	}
+	if err := dispatch(); err != nil {
+		return api.ErrConditionalUnconfirmed
+	}
+	accepted, _, err := f.service.MoveItemToTrashByID(ctx, expected.DriveID, expected.ETag, false)
+	if err != nil || accepted == nil || accepted.Drivewsid != expected.DriveID {
+		return api.ErrConditionalUnconfirmed
+	}
+	return nil
+}
