+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+var folderDestinationIdentifier = regexp.MustCompile(`^[A-Za-z0-9._-]{1,160}(#[A-Za-z0-9._-]{1,32})?$`)
+
+type conditionalFolderMoveItem struct {
+	DriveID  string `json:"drivewsid"`
+	ETag     string `json:"etag"`
+	ClientID string `json:"clientId"`
+}
+
+type conditionalFolderMoveRequest struct {
+	DestinationID string                      `json:"destinationDrivewsId"`
+	Items         []conditionalFolderMoveItem `json:"items"`
+}
+
+// MoveConditionalFolder submits one source-version-guarded move without
+// automatic request replay. The owning worker must verify the new path and
+// stable folder identity via fresh listings even when Apple replies OK.
+func (d *DriveService) MoveConditionalFolder(ctx context.Context, source DriveItem, destinationID string) error {
+	kind, zone, id := DeconstructDriveID(source.Drivewsid)
+	targetKind, targetZone, targetID := DeconstructDriveID(destinationID)
+	if kind != "FOLDER" || source.Type != "FOLDER" || (targetKind != "FOLDER" && targetKind != "APP_LIBRARY") ||
+		zone != targetZone || !driveIdentifier.MatchString(zone) || !driveIdentifier.MatchString(id) ||
+		!folderDestinationIdentifier.MatchString(targetID) || source.Docwsid != id ||
+		source.ParentID == "" || destinationID == source.ParentID || source.Drivewsid == destinationID ||
+		source.Etag == "" || len(source.Etag) > 512 {
+		return ErrConditionalRefused
+	}
+	payload, err := json.Marshal(conditionalFolderMoveRequest{
+		DestinationID: destinationID,
+		Items:         []conditionalFolderMoveItem{{source.Drivewsid, source.Etag, source.Drivewsid}},
+	})
+	if err != nil {
+		return ErrConditionalRefused
+	}
+	return d.submitFolderChange(ctx, "/moveItems", payload, source.Drivewsid, destinationID)
+}
+
+// RenameFolderOnce keeps the original folder and lets iCloud arbitrate a
+// destination-name race. The caller still verifies its exact final name.
+func (d *DriveService) RenameFolderOnce(ctx context.Context, source DriveItem, name string) error {
+	kind, zone, id := DeconstructDriveID(source.Drivewsid)
+	if kind != "FOLDER" || source.Type != "FOLDER" || source.Docwsid != id ||
+		!driveIdentifier.MatchString(zone) || !driveIdentifier.MatchString(id) ||
+		source.ParentID == "" || source.Etag == "" || len(source.Etag) > 512 ||
+		name == "" || name == "." || name == ".." || len(name) > 255 || strings.ContainsAny(name, "/\x00") {
+		return ErrConditionalRefused
+	}
+	type renameItem struct {
+		DriveID string `json:"drivewsid"`
+		ETag    string `json:"etag"`
+		Name    string `json:"name"`
+	}
+	payload, err := json.Marshal(struct {
+		Items []renameItem `json:"items"`
+	}{
+		Items: []renameItem{{source.Drivewsid, source.Etag, name}},
+	})
+	if err != nil {
+		return ErrConditionalRefused
+	}
+	return d.submitFolderChange(ctx, "/renameItems", payload, source.Drivewsid, source.ParentID)
+}
+
+func (d *DriveService) submitFolderChange(ctx context.Context, endpoint string, payload []byte, sourceID, destinationID string) error {
+	session := d.icloud.Session
+	resp, err := session.srv.Call(ctx, &rest.Opts{
+		Method: http.MethodPost, Path: endpoint, RootURL: d.endpoint,
+		Body: bytes.NewReader(payload), ExtraHeaders: session.GetHeaders(nil),
+		NoRedirect: true, IgnoreStatus: true,
+	})
+	if err != nil {
+		return ErrConditionalUnconfirmed
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, conditionalReplyLimit+1))
+	if err != nil || len(body) > conditionalReplyLimit {
+		return ErrConditionalUnconfirmed
+	}
+	var reply DriveItem
+	if json.Unmarshal(body, &reply) != nil || len(reply.Items) != 1 || reply.Items[0] == nil {
+		return ErrConditionalUnconfirmed
+	}
+	item := reply.Items[0]
+	if item.Status == "ETAG_CONFLICT" && item.Drivewsid == sourceID &&
+		(resp.StatusCode == http.StatusConflict || resp.StatusCode == http.StatusOK) {
+		return ErrConditionalConflict
+	}
+	if resp.StatusCode != http.StatusOK || item.Status != statusOk ||
+		item.Drivewsid != sourceID || item.ParentID != destinationID {
+		return ErrConditionalUnconfirmed
+	}
+	return nil
+}
