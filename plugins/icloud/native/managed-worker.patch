+package main
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/cmd/bisync"
+	"github.com/rclone/rclone/fs"
+)
+
+func applyConflictResolution(ctx context.Context, cloud relocationCloud, workdir string, intent bisync.BBRelocationIntent, approve bool) ownedNoteReply {
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	done, err := bisync.BBConflictResolved(workdir, intent)
+	if err != nil {
+		return uncertain
+	}
+	if done {
+		return ownedNoteReply{Outcome: "conflict_resolved"}
+	}
+	state, _, err := bisync.BBReadRelocation(workdir, intent)
+	if err != nil || state == nil || state.Conflict == nil || state.Conflict.Copy == nil {
+		return uncertain
+	}
+	if !approve {
+		if state.Conflict.Approved == nil {
+			return uncertain
+		}
+		return ownedNoteReply{Outcome: "conflict_resolution_pending"}
+	}
+	parent := filepath.Dir(workdir)
+	if filepath.Base(parent) != "baselines" {
+		return ownedNoteReply{Outcome: "refused"}
+	}
+	local := filepath.Join(filepath.Dir(parent), "mirrors", filepath.Base(workdir))
+	caseMove := bisync.BBCaseRelocation(intent.Source, intent.Path)
+	var location iclouddrive.BBCaseNamespace
+	if caseMove {
+		caseCloud, ok := cloud.(caseRelocationCloud)
+		if !ok {
+			return uncertain
+		}
+		location, err = caseCloud.ObserveBBCaseNamespace(ctx, intent.Source, intent.Path)
+		if err != nil || location == iclouddrive.BBCaseOccupied {
+			return uncertain
+		}
+	}
+	read := func(name string) (bisync.BBConflictSnapshot, error) {
+		if caseMove && ((name == intent.Source && location != iclouddrive.BBCaseSource) ||
+			(name == intent.Path && location != iclouddrive.BBCaseDestination)) {
+			return bisync.BBConflictSnapshot{}, nil
+		}
+		remote, err := cloud.ObserveBBCreate(ctx, name)
+		if errors.Is(err, fs.ErrorObjectNotFound) || errors.Is(err, fs.ErrorDirNotFound) {
+			return bisync.BBConflictSnapshot{}, nil
+		}
+		if err != nil {
+			return bisync.BBConflictSnapshot{}, err
+		}
+		return bisync.BBConflictSnapshot{Present: true, Version: bisync.BBIndexedVersion{DocumentID: remote.Revision.DriveID,
+			ParentID: remote.Revision.ParentID, ETag: remote.Revision.ETag}, Hash: remote.Revision.Hash, Size: remote.Size, Modified: remote.Modified}, nil
+	}
+	names := []string{intent.Source, intent.Path, intent.ConflictIntent().Path}
+	staged := make([]bisync.BBConflictSnapshot, len(names))
+	for i, name := range names {
+		snapshot, err := read(name)
+		if err != nil {
+			return uncertain
+		}
+		if err := bisync.BBVerifyConflictLocal(local, name, snapshot, false); err != nil {
+			return ownedNoteReply{Outcome: "conflict_paths_differ"}
+		}
+		staged[i] = snapshot
+	}
+	saved := state.Conflict.Copy
+	copy := staged[2]
+	if !copy.Present || copy.Version.DocumentID != saved.ProviderID || copy.Version.ParentID != saved.ProviderParentID ||
+		copy.Version.ETag != saved.ETag || copy.Hash != saved.Hash || copy.Size != saved.Size || !copy.Modified.Equal(saved.Modified) {
+		return ownedNoteReply{Outcome: "conflict_paths_differ"}
+	}
+	if err := bisync.BBApproveConflictResolution(workdir, intent, bisync.BBConflictResolution{Source: staged[0], Destination: staged[1]}); err != nil {
+		return uncertain
+	}
+	return ownedNoteReply{Outcome: "conflict_resolution_pending"}
+}
