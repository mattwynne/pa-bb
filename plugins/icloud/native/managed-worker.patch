+package iclouddrive
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/text/unicode/norm"
+)
+
+func (f *Fs) BBNoteAbsent(ctx context.Context, remote string) bool {
+	placeholder := BBNoteRevision{DriveID: "scope", ParentID: "scope", ETag: "scope"}
+	if !validBBIntent(remote, placeholder, []byte{1}) {
+		return false
+	}
+	_, err := f.readBBNoteItem(ctx, remote)
+	return errors.Is(err, fs.ErrorObjectNotFound)
+}
+
+func (f *Fs) CreateBBNote(ctx context.Context, remote, binding string, data []byte, dispatch func(documentID string) error) (BBNotePublication, error) {
+	return f.CreateBBNoteInParent(ctx, remote, binding, "", data, dispatch)
+}
+
+func (f *Fs) CreateBBNoteInParent(ctx context.Context, remote, binding, expectedParent string, data []byte, dispatch func(documentID string) error) (BBNotePublication, error) {
+	var output BBNotePublication
+	placeholder := BBNoteRevision{DriveID: "scope", ParentID: "scope", ETag: "scope"}
+	if !validBBIntent(remote, placeholder, data) || dispatch == nil {
+		return output, api.ErrConditionalRefused
+	}
+	root, err := f.BBMirrorBinding(ctx)
+	if err != nil || root != binding {
+		return output, api.ErrConditionalConflict
+	}
+	resolve := func() (string, *api.DriveItem, error) {
+		return bbResolveCreateTarget(root, remote, func(id string) ([]*api.DriveItem, error) {
+			return f.listAll(ctx, id)
+		})
+	}
+	parent, occupied, err := resolve()
+	if err != nil || occupied != nil || (expectedParent != "" && parent != expectedParent) {
+		return output, api.ErrConditionalConflict
+	}
+	leaf := f.opt.Enc.FromStandardName(path.Base(remote))
+	slot, _, err := f.service.CreateUpload(ctx, int64(len(data)), leaf, api.ZoneFromDriveID(root))
+	if err != nil || slot == nil || slot.URL == "" || slot.DocumentID == "" {
+		return output, api.ErrConditionalRefused
+	}
+	upload, _, err := f.service.Upload(ctx, bytes.NewReader(data), int64(len(data)), leaf, slot.URL)
+	if err != nil || upload == nil || upload.SingleFile == nil || upload.SingleFile.Size != int64(len(data)) ||
+		upload.SingleFile.Signature == "" {
+		return output, api.ErrConditionalRefused
+	}
+
+	foundParent, occupied, err := resolve()
+	if err != nil || foundParent != parent || occupied != nil {
+		return output, api.ErrConditionalConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return output, api.ErrConditionalRefused
+	}
+	if err := dispatch(slot.DocumentID); err != nil {
+		return output, api.ErrConditionalUnconfirmed
+	}
+	status, publishErr := f.service.CreateConditionalMarkdown(ctx, parent, leaf, slot.DocumentID, *upload.SingleFile)
+	if status == 409 && errors.Is(publishErr, api.ErrConditionalConflict) {
+		return output, api.ErrConditionalConflict
+	}
+	foundParent, item, err := resolve()
+	if err != nil || foundParent != parent || item == nil || item.Docwsid != slot.DocumentID {
+		return output, api.ErrConditionalUnconfirmed
+	}
+	content, err := f.readBBExactNoteBytes(ctx, remote, item)
+	if err != nil || !bytes.Equal(content, data) {
+		return output, api.ErrConditionalUnconfirmed
+	}
+	return BBNotePublication{Revision: BBNoteRevision{item.Drivewsid, item.ParentID, item.Etag, sha256.Sum256(data)},
+		Modified: item.DateModified, Size: item.Size}, nil
+}
+
+// Resolve through exact names from the selected root, with no directory cache.
+// The activation uses the verified parent identity and leaf separately,
+// so a same-name replacement directory cannot receive an older intent.
+func bbResolveCreateTarget(root, remote string, list func(string) ([]*api.DriveItem, error)) (string, *api.DriveItem, error) {
+	parent := root
+	parts := strings.Split(remote, "/")
+	for _, part := range parts[:len(parts)-1] {
+		items, err := list(parent)
+		if err != nil {
+			return "", nil, err
+		}
+		var selected *api.DriveItem
+		want := norm.NFC.String(part)
+		for _, item := range items {
+			if item == nil || !strings.EqualFold(norm.NFC.String(item.FullName()), want) {
+				continue
+			}
+			kind, zone, id := api.DeconstructDriveID(item.Drivewsid)
+			if selected != nil || norm.NFC.String(item.FullName()) != want || item.Type != "FOLDER" ||
+				kind != "FOLDER" || zone != api.ZoneFromDriveID(root) || id == "" || item.ParentID != parent {
+				return "", nil, api.ErrConditionalConflict
+			}
+			selected = item
+		}
+		if selected == nil {
+			return "", nil, fs.ErrorDirNotFound
+		}
+		parent = selected.Drivewsid
+	}
+	items, err := list(parent)
+	if err != nil {
+		return "", nil, err
+	}
+	item, err := bbExactNoteItem(items, parts[len(parts)-1], parent)
+	if err != nil && !errors.Is(err, fs.ErrorObjectNotFound) {
+		return "", nil, err
+	}
+	return parent, item, nil
+}
+
+// Return definite absence only if the parent still resolves and has been
+// checked; a transport error is not an absent note and cannot cause replays.
+func (f *Fs) ObserveBBCreate(ctx context.Context, remote string) (BBNotePublication, error) {
+	return f.InspectBBNote(ctx, remote)
+}
