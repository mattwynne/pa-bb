+package bisync
+
+import (
+	"context"
+	"testing"
+
+	"github.com/rclone/rclone/cmd/bisync/bilib"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/filter"
+)
+
+func TestBBTransferScopeExcludesEveryQueuedFootprint(t *testing.T) {
+	ctx, config := fs.AddConfig(context.Background())
+	run := &bisyncRun{opt: &Options{bbReadVersions: true, bbMirrorBinding: "root"}, aliases: make(bilib.AliasMap)}
+	run.march.ls2 = newFileList()
+	run.march.bbIdentities = make(map[string]bbIndexedCloudObservation)
+	for _, name := range []string{
+		"Book/Keep.md", "Book/Upload.md", "Book/Download.md", "Book/Delete.md",
+		"Book/Résumé.md", "Other/Copy.md", "Held/Note.md", "Old.md/Note.md",
+		"Future.md", "Alias.md", "Duplicate.md", "duplicate.md", "LocalDir.md", "OnlyCloud.md",
+	} {
+		run.march.bbIdentities[name] = bbIndexedCloudObservation{BBIndexedVersion: BBIndexedVersion{DocumentID: name, ParentID: "parent"}}
+		if name != "OnlyCloud.md" {
+			flags := "-"
+			if name == "LocalDir.md" {
+				flags = "d"
+			}
+			run.march.ls2.list = append(run.march.ls2.list, name)
+			run.march.ls2.info[name] = &fileInfo{flags: flags}
+		}
+	}
+	copiedIdentity := run.march.bbIdentities["Other/Copy.md"]
+	copiedIdentity.DocumentID = "Book/Upload.md"
+	run.march.bbIdentities["Other/Copy.md"] = copiedIdentity
+	run.bbHeldRelocation = &bbRelocationHold{trees: map[string]bool{"held": true}}
+	run.aliases.Add("Alias.md", "ALIAS.MD")
+	uploads, downloads, removals := bilib.Names{}, bilib.Names{}, bilib.Names{}
+	uploads.Add("Book/Upload.md")
+	uploads.Add("book/re\u0301sume\u0301.md")
+	downloads.Add("Book/Download.md")
+	downloads.Add("Future.md/child.txt")
+	removals.Add("Book/Delete.md")
+	removals.Add("old.md")
+	book := BBIndexedVersion{DocumentID: "book", ParentID: "root", ETag: "stable"}
+	held := BBIndexedVersion{DocumentID: "held", ParentID: "root", ETag: "stable"}
+	run.march.bbDirectories = map[string]BBIndexedVersion{"Book": book, "Held": held}
