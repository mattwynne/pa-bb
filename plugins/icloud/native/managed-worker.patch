+package bisync
+
+import (
+	"context"
+	"errors"
+	"path"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/hash"
+)
+
+type bbCaseView struct {
+	cloud, local fs.Object
+}
+
+// A plain iCloud NewObject call resolves case-insensitively. List one
+// parent and retain the unique exact spelling for the affected namespace.
+func bbListCaseObject(ctx context.Context, filesystem fs.Fs, note string) (fs.Object, error) {
+	directory := path.Dir(note)
+	if directory == "." {
+		directory = ""
+	}
+	entries, err := filesystem.List(ctx, directory)
+	if errors.Is(err, fs.ErrorDirNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var found fs.Object
+	for _, entry := range entries {
+		if !equalBBPaths(entry.Remote(), note) {
+			continue
+		}
+		obj, ok := entry.(fs.Object)
+		if !ok || found != nil || path.Dir(obj.Remote()) != path.Dir(note) {
+			return nil, ErrBBDeliveryUnsettled
+		}
+		found = obj
+	}
+	return found, nil
+}
+
+func (b *bisyncRun) observePublishedCase(ctx context.Context, note string) (bbCaseView, error) {
+	cloud, err := bbListCaseObject(ctx, b.fs1, note)
+	if err != nil {
+		return bbCaseView{}, err
+	}
+	if cloud != nil && b.march.bbIdentities != nil {
+		if _, ok := bbCloudVersionFrom(ctx, cloud); !ok {
+			return bbCaseView{}, ErrBBDeliveryUnsettled
+		}
+	}
+	local, err := bbListCaseObject(ctx, b.fs2, note)
+	return bbCaseView{cloud: cloud, local: local}, err
+}
+
+func (b *bisyncRun) refreshPublishedCase(ctx context.Context, note string, view bbCaseView) error {
+	for name, peer := range b.aliases {
+		if equalBBPaths(name, note) || equalBBPaths(peer, note) {
+			delete(b.aliases, name)
+		}
+	}
+	for name := range b.march.bbIdentities {
+		if equalBBPaths(name, note) {
+			delete(b.march.bbIdentities, name)
+		}
+	}
+	for _, side := range []struct {
+		object  fs.Object
+		listing *fileList
+		output  string
+	}{{view.cloud, b.march.ls1, b.newListing1}, {view.local, b.march.ls2, b.newListing2}} {
+		if side.listing.hash != hash.None {
+			return ErrBBDeliveryUnsettled
+		}
+		for _, name := range append([]string(nil), side.listing.list...) {
+			if equalBBPaths(name, note) {
+				side.listing.remove(name)
+			}
+		}
+		if side.object != nil {
+			name := side.object.Remote()
+			side.listing.put(name, side.object.Size(), side.object.ModTime(ctx).In(TZ), "", "", "-")
+		}
+		if err := side.listing.save(side.output); err != nil {
+			return err
+		}
+	}
+	if view.cloud != nil && b.march.bbIdentities != nil {
+		version, _ := bbCloudVersionFrom(ctx, view.cloud)
+		b.march.bbIdentities[view.cloud.Remote()] = version
+	}
+	if view.cloud != nil && view.local != nil {
+		b.aliases.Add(view.cloud.Remote(), view.local.Remote())
+	}
+	return nil
+}
