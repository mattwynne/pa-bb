+package iclouddrive
+
+import (
+	"context"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+)
+
+// TrashBBNote issues a recoverable removal of exactly the previously
+// acknowledged document. It never adopts a newer ETag from the response.
+func (f *Fs) TrashBBNote(ctx context.Context, remote string, expected BBNoteRevision, dispatch func() error) error {
+	if !validBBIntent(remote, expected, []byte{1}) || dispatch == nil {
+		return api.ErrConditionalRefused
+	}
+	current, err := f.readBBNoteItem(ctx, remote)
+	if err != nil || !sameBBIdentity(expected, current) || current.Etag != expected.ETag {
+		return api.ErrConditionalConflict
+	}
+	if err := dispatch(); err != nil {
+		return api.ErrConditionalUnconfirmed
+	}
+	// Interpret the effect from exact subsequent readback. A transport
+	// error must never cause a replay of this removal.
+	_, _, _ = f.service.MoveItemToTrashByID(ctx, expected.DriveID, expected.ETag, false)
+	if !f.BBNoteAbsent(ctx, remote) {
+		return api.ErrConditionalUnconfirmed
+	}
+	return nil
+}
+
+// CheckBBNoteVersion verifies the metadata of a revision whose content was
+// already read back. Only the identical document, parent and ETag can reuse
+// the previously verified content hash.
+func (f *Fs) CheckBBNoteVersion(ctx context.Context, remote string, recorded BBNoteRevision) (BBNotePublication, error) {
+	if !validBBIntent(remote, recorded, []byte{1}) {
+		return BBNotePublication{}, api.ErrConditionalRefused
+	}
+	item, err := f.readBBNoteItem(ctx, remote)
+	if err != nil {
+		return BBNotePublication{}, err
+	}
+	if !sameBBIdentity(recorded, item) || item.Etag != recorded.ETag {
+		return BBNotePublication{}, api.ErrConditionalConflict
+	}
+	return BBNotePublication{Revision: recorded, Modified: item.DateModified, Size: item.Size}, nil
+}
