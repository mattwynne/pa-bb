+package bisync
+
+import (
+	"crypto/sha256"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestBBPairedListingRecovery(t *testing.T) {
+	for _, interrupted := range []int{-1, 0, 1} {
+		for _, foreign := range []bool{false, true} {
+			dir := t.TempDir()
+			first, second := filepath.Join(dir, "generated.path1.lst"), filepath.Join(dir, "generated.path2.lst")
+			p, err := bbPairFor(first, second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var original [2][sha256.Size]byte
+			next := [2][]byte{[]byte("new cloud listing"), []byte("new BB listing")}
+			for i, filename := range p.listings {
+				prior := []byte(filename)
+				if err := os.WriteFile(filename, prior, 0600); err != nil {
+					t.Fatal(err)
+				}
+				original[i] = sha256.Sum256(prior)
+			}
+			if err := p.begin(original, next); err != nil {
+				t.Fatal(err)
+			}
+			if err := p.begin(original, next); !errors.Is(err, os.ErrExist) {
+				t.Fatalf("existing journal was replaced: %v", err)
+			}
+			stop := errors.New("injected interruption")
+			if interrupted >= 0 {
+				err = p.recover(func(i int) error {
+					if i == interrupted {
+						return stop
+					}
+					return nil
+				})
+				if !errors.Is(err, stop) {
+					t.Fatalf("did not simulate interruption: %v", err)
+				}
+			}
+			if foreign {
+				if err := os.WriteFile(second, []byte("external replacement"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				firstBefore, err := os.ReadFile(first)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := p.recover(nil); !errors.Is(err, errBBListingChanged) {
+					t.Fatalf("failed to reject external replacement: %v", err)
+				}
+				firstAfter, err := os.ReadFile(first)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if string(firstAfter) != string(firstBefore) {
+					t.Fatal("first listing changed after refused transaction")
+				}
+				if _, err := os.Stat(p.journal); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				for range 2 {
+					if err := p.recover(nil); err != nil {
+						t.Fatal(err)
+					}
+				}
+				for i, filename := range p.listings {
+					actual, err := os.ReadFile(filename)
+					if err != nil || string(actual) != string(next[i]) {
+						t.Fatalf("listing did not recover: %v", err)
+					}
+				}
+				if _, err := os.Stat(p.journal); !errors.Is(err, os.ErrNotExist) {
+					t.Fatalf("journal left after recovery: %v", err)
+				}
+			}
+		}
+	}
+}
+
+func TestBBPairRecoversAfterProcessExit(t *testing.T) {
+	const worker = "BB_FIXTURE_PAIR_INTERRUPTION_DIR"
+	if dir := os.Getenv(worker); dir != "" {
+		pair, err := bbPairFor(filepath.Join(dir, "paired.path1.lst"), filepath.Join(dir, "paired.path2.lst"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		err = pair.recover(func(i int) error {
+			if i == 0 {
+				os.Exit(73)
+			}
+			return nil
+		})
+		t.Fatalf("child did not exit between listing replacements: %v", err)
+	}
+	dir := t.TempDir()
+	pair, err := bbPairFor(filepath.Join(dir, "paired.path1.lst"), filepath.Join(dir, "paired.path2.lst"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	prior := [2][]byte{[]byte("cloud-before"), []byte("bb-before")}
+	next := [2][]byte{[]byte("cloud-after"), []byte("bb-after")}
+	for i := range prior {
+		if err := os.WriteFile(pair.listings[i], prior[i], 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	before := [2][sha256.Size]byte{sha256.Sum256(prior[0]), sha256.Sum256(prior[1])}
+	if err := pair.begin(before, next); err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(os.Args[0], "-test.run=^TestBBPairRecoversAfterProcessExit$")
+	child.Env = append(os.Environ(), worker+"="+dir)
+	var exit *exec.ExitError
+	if err := child.Run(); !errors.As(err, &exit) || exit.ExitCode() != 73 {
+		t.Fatalf("unexpected child result: %v", err)
+	}
+	if err := pair.verifyCurrent([2][sha256.Size]byte{sha256.Sum256(next[0]), sha256.Sum256(prior[1])},
+		[2][sha256.Size]byte{sha256.Sum256(next[0]), sha256.Sum256(prior[1])}); err != nil {
+		t.Fatal(err)
+	}
+	if err := pair.recover(nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := pair.verifyCurrent([2][sha256.Size]byte{sha256.Sum256(next[0]), sha256.Sum256(next[1])},
+		[2][sha256.Size]byte{sha256.Sum256(next[0]), sha256.Sum256(next[1])}); err != nil {
+		t.Fatal(err)
+	}
+}
