+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+	"golang.org/x/sync/errgroup"
+	"golang.org/x/text/cases"
+	"golang.org/x/text/unicode/norm"
+)
+
+type ownedFolderEntry struct {
+	Path string `json:"path"`
+	Kind string `json:"kind"`
+	Size int64  `json:"size,omitempty"`
+	Hash string `json:"hash,omitempty"`
+}
+
+type ownedFolderObservation struct {
+	Source            bisync.BBIndexedVersion `json:"source"`
+	DestinationParent string                  `json:"destinationParent"`
+	Method            string                  `json:"method"`
+	item              iclouddrive.BBFolderItem
+	entries           map[string]bisync.BBTreeIdentity
+}
+
+type folderProofCloud interface {
+	BBFolderList(context.Context, string, string) ([]iclouddrive.BBFolderItem, error)
+	BBFolderFileHash(context.Context, iclouddrive.BBFolderItem) ([sha256.Size]byte, error)
+}
+
+func validFolderPath(name string) bool {
+	if name == "" || name == "." || name == ".." || len(name) > 1024 || path.IsAbs(name) || path.Clean(name) != name ||
+		strings.HasPrefix(name, "../") || norm.NFC.String(name) != name || strings.ContainsAny(name, "\\\x00\r\n") {
+		return false
+	}
+	for _, part := range strings.Split(name, "/") {
+		if len(part) > 255 || strings.IndexFunc(part, func(r rune) bool { return r < 32 || r == 127 }) != -1 {
+			return false
+		}
+	}
+	return true
+}
+
+func folderNameIn(items []iclouddrive.BBFolderItem, name string) (*iclouddrive.BBFolderItem, error) {
+	var found *iclouddrive.BBFolderItem
+	for i := range items {
+		if !strings.EqualFold(items[i].Name, name) {
+			continue
+		}
+		if found != nil || items[i].Name != name {
+			return nil, api.ErrConditionalConflict
+		}
+		found = &items[i]
+	}
+	return found, nil
+}
+
+func folderParentByName(ctx context.Context, cloud folderProofCloud, binding, name string) (string, error) {
+	id := binding
+	if name == "." {
+		return id, nil
+	}
+	for _, segment := range strings.Split(name, "/") {
+		items, err := cloud.BBFolderList(ctx, binding, id)
+		if err != nil {
+			return "", err
+		}
+		entry, err := folderNameIn(items, segment)
+		if err != nil || entry == nil || !entry.Directory {
+			return "", api.ErrConditionalConflict
+		}
+		id = entry.DocumentID
+	}
+	return id, nil
+}
+
+func ownedFolderVersion(item iclouddrive.BBFolderItem) bisync.BBIndexedVersion {
+	return bisync.BBIndexedVersion{DocumentID: item.DocumentID, ParentID: item.ParentID, ETag: item.ETag}
+}
+
+// Inspect the live tree and compare every name, identity, revision, and
+// byte hash against the acknowledged mirror and the saved local manifest.
+// The returned proof allows a caller to plan a mutation, never to skip
+// revalidation of its source and destination immediately before dispatch.
+func inspectOwnedFolder(ctx context.Context, cloud folderProofCloud, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	if !validFolderPath(request.Source) || !validFolderPath(request.Path) || request.Source == request.Path ||
+		request.Expected != nil || request.OperationID != "" || request.Text != nil || request.WantedHash != "" ||
+		request.FolderEntries == nil || len(request.FolderEntries) > 10000 {
+		return refused
+	}
+	fold := cases.Fold()
+	from, to := fold.String(request.Source), fold.String(request.Path)
+	sameParent := path.Dir(request.Source) == path.Dir(request.Path)
+	caseChange := strings.EqualFold(request.Source, request.Path)
+	if strings.HasPrefix(from, to+"/") || strings.HasPrefix(to, from+"/") ||
+		(!sameParent && (caseChange || path.Base(request.Source) != path.Base(request.Path))) {
+		return refused
+	}
+	children := make(map[string]ownedFolderEntry, len(request.FolderEntries))
+	var size int64
+	for _, entry := range request.FolderEntries {
+		if !validFolderPath(entry.Path) || !validFolderPath(path.Join(request.Source, entry.Path)) ||
+			!validFolderPath(path.Join(request.Path, entry.Path)) {
+			return refused
+		}
+		if _, exists := children[entry.Path]; exists {
+			return refused
+		}
+		switch entry.Kind {
+		case "directory":
+			if entry.Size != 0 || entry.Hash != "" {
+				return refused
+			}
+		case "file":
+			raw, err := hex.DecodeString(entry.Hash)
+			if err != nil || len(raw) != sha256.Size || strings.ToLower(entry.Hash) != entry.Hash || entry.Size < 0 || entry.Size > 1<<30 {
+				return refused
+			}
+			size += entry.Size
+			if size > 1<<30 {
+				return refused
+			}
+		default:
+			return refused
+		}
+		children[entry.Path] = entry
+	}
+	indexed, err := bisync.BBIndexedTree(request.Workdir, request.Binding, request.Source)
+	if err != nil || len(indexed) != len(children)+1 {
+		return refused
+	}
+	inspectEndpoints := func() (iclouddrive.BBFolderItem, string, error) {
+		var empty iclouddrive.BBFolderItem
+		sourceParent, err := folderParentByName(ctx, cloud, request.Binding, path.Dir(request.Source))
+		if err != nil {
+			return empty, "", err
+		}
+		sourceSiblings, err := cloud.BBFolderList(ctx, request.Binding, sourceParent)
+		if err != nil {
+			return empty, "", err
+		}
+		source, err := folderNameIn(sourceSiblings, path.Base(request.Source))
+		prior := indexed[request.Source]
+		if err != nil || source == nil || !source.Directory || !prior.Directory ||
+			prior.DocumentID != source.DocumentID || prior.ParentID != source.ParentID ||
+			(!sameParent && prior.ETag != source.ETag) {
+			return empty, "", api.ErrConditionalConflict
+		}
+		destinationParent := sourceParent
+		destinationSiblings := sourceSiblings
+		if path.Dir(request.Source) != path.Dir(request.Path) {
+			destinationParent, err = folderParentByName(ctx, cloud, request.Binding, path.Dir(request.Path))
+			if err != nil {
+				return empty, "", err
+			}
+			destinationSiblings, err = cloud.BBFolderList(ctx, request.Binding, destinationParent)
+			if err != nil {
+				return empty, "", err
+			}
+		}
+		for _, sibling := range destinationSiblings {
+			if strings.EqualFold(sibling.Name, path.Base(request.Path)) &&
+				(!caseChange || sibling.DocumentID != source.DocumentID || sibling.ParentID != sourceParent) {
+				return empty, "", api.ErrConditionalConflict
+			}
+		}
+		return *source, destinationParent, nil
+	}
+	source, destinationParent, err := inspectEndpoints()
+	if err != nil {
+		return refused
+	}
+	if sameParent {
+		// Rename the directory in place. The same descendants move with it
+		// and their ordinary changes still compare against the old baseline.
+		return ownedNoteReply{Outcome: "folder_verified", Folder: &ownedFolderObservation{
+			Source: ownedFolderVersion(source), DestinationParent: destinationParent, Method: "move", item: source, entries: indexed,
+		}}
+	}
+
+	type fileCheck struct {
+		observed iclouddrive.BBFolderItem
+		wanted   string
+	}
+	inspectTree := func(root iclouddrive.BBFolderItem, collectFiles bool) ([]fileCheck, error) {
+		var files []fileCheck
+		known := map[string]bool{root.DocumentID: true}
+		visited := 0
+		var walk func(string, string, int) error
+		walk = func(parent, suffix string, level int) error {
+			if level > 64 || ctx.Err() != nil {
+				return api.ErrConditionalUnconfirmed
+			}
+			entries, err := cloud.BBFolderList(ctx, request.Binding, parent)
+			if err != nil {
+				return err
+			}
+			siblings := make(map[string]bool, len(entries))
+			for _, entry := range entries {
+				folded := fold.String(entry.Name)
+				if !validFolderPath(entry.Name) || strings.Contains(entry.Name, "/") || siblings[folded] ||
+					known[entry.DocumentID] || entry.ParentID != parent {
+					return api.ErrConditionalConflict
+				}
+				siblings[folded] = true
+				known[entry.DocumentID] = true
+				sibling := path.Join(suffix, entry.Name)
+				manifest, found := children[sibling]
+				baseline := indexed[path.Join(request.Source, sibling)]
+				if !found || baseline.BBIndexedVersion != ownedFolderVersion(entry) ||
+					baseline.Directory != entry.Directory || (manifest.Kind == "directory") != entry.Directory {
+					return api.ErrConditionalConflict
+				}
+				visited++
+				if visited > len(children) {
+					return api.ErrConditionalConflict
+				}
+				if entry.Directory {
+					if err := walk(entry.DocumentID, sibling, level+1); err != nil {
+						return err
+					}
+				} else {
+					if manifest.Size != entry.Size {
+						return api.ErrConditionalConflict
+					}
+					if collectFiles {
+						files = append(files, fileCheck{entry, manifest.Hash})
+					}
+				}
+			}
+			return nil
+		}
+		if err := walk(root.DocumentID, "", 0); err != nil {
+			return nil, err
+		}
+		if visited != len(children) {
+			return nil, api.ErrConditionalConflict
+		}
+		return files, nil
+	}
+	files, err := inspectTree(source, true)
+	if err != nil {
+		return refused
+	}
+
+	group, verifyCtx := errgroup.WithContext(ctx)
+	group.SetLimit(4)
+	for _, file := range files {
+		if verifyCtx.Err() != nil {
+			break
+		}
+		group.Go(func() error {
+			digest, err := cloud.BBFolderFileHash(verifyCtx, file.observed)
+			if err != nil || hex.EncodeToString(digest[:]) != file.wanted {
+				return api.ErrConditionalConflict
+			}
+			return nil
+		})
+	}
+	if group.Wait() != nil || ctx.Err() != nil {
+		return refused
+	}
+	// File renames may leave every ancestor ETag untouched. Re-list the
+	// descendants after reading the bytes before returning the observation.
+	if _, err := inspectTree(source, false); err != nil {
+		return refused
+	}
+	finalSource, finalParent, err := inspectEndpoints()
+	if err != nil || ownedFolderVersion(finalSource) != ownedFolderVersion(source) || finalParent != destinationParent {
+		return refused
+	}
+	return ownedNoteReply{Outcome: "folder_verified", Folder: &ownedFolderObservation{
+		Source: ownedFolderVersion(source), DestinationParent: destinationParent, Method: "move", item: finalSource, entries: indexed,
+	}}
+}
