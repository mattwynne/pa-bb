+package bisync
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+)
+
+const bbIndexLimit = 16 << 20
+const BBIndexName = "bb-cloud-note-identities-v1.json"
+
+type BBIndexedVersion struct {
+	DocumentID string `json:"documentId"`
+	ParentID   string `json:"parentId"`
+	ETag       string `json:"etag"`
+}
+
+type bbIndexFile struct {
+	Version int                         `json:"version"`
+	Binding string                      `json:"binding"`
+	Notes   map[string]BBIndexedVersion `json:"notes"`
+}
+
+type bbIndexedCloudObservation struct {
+	BBIndexedVersion
+	Size     int64
+	Modified time.Time
+}
+
+func (b *bisyncRun) writeBBVersionIndex(ctx context.Context, binding string) error {
+	cloud, err := b.loadListing(b.listing1)
+	if err != nil {
+		return err
+	}
+	mirror, err := b.loadListing(b.listing2)
+	if err != nil {
+		return err
+	}
+	index := bbIndexFile{Version: 1, Binding: binding, Notes: map[string]BBIndexedVersion{}}
+	tree := bbTreeIndexFile{Version: 1, Binding: binding, Entries: map[string]BBTreeIdentity{}}
+	for name, version := range b.march.bbDirectories {
+		// Directory matches are captured independently of bisync's empty
+		// directory option, which controls only its ordinary listings.
+		if version.ParentID != "" && version.ETag != "" && !b.bbHeldRelocation.includes(name) &&
+			(!b.opt.CreateEmptySrcDirs || (cloud.isDir(name) && mirror.isDir(name))) {
+			tree.Entries[name] = BBTreeIdentity{version, true}
+		}
+	}
+	for name, version := range b.march.bbIdentities {
+		if version.ParentID == "" || version.ETag == "" || !cloud.has(name) || !mirror.has(name) ||
+			cloud.isDir(name) || mirror.isDir(name) || b.aliases.Alias(name) != name || b.bbHeldRelocation.includes(name) {
+			continue
+		}
+		if cloud.getSize(name) != version.Size || timeDiffers(ctx, cloud.getTime(name), version.Modified, b.fs1, b.fs1) {
+			// A native pass can change an item after taking the listing.
+			// The following scan can establish its identity.
+			continue
+		}
+		tree.Entries[name] = BBTreeIdentity{version.BBIndexedVersion, false}
+		if strings.HasSuffix(name, ".md") {
+			index.Notes[name] = version.BBIndexedVersion
+		}
+	}
+	output, err := json.Marshal(index)
+	if err != nil {
+		return err
+	}
+	if len(output) > bbIndexLimit {
+		return errors.New("cloud note identity index exceeds its byte limit")
+	}
+	owner := bbListingPair{directory: b.workDir}
+	if err := owner.publishFile(filepath.Join(b.workDir, BBIndexName), output, false); err != nil {
+		return err
+	}
+	return writeBBTreeIndex(owner, tree)
+}
+
+func bbRefreshVersion(ctx context.Context, side fs.Fs, path string, index map[string]bbIndexedCloudObservation) error {
+	if index == nil {
+		return nil
+	}
+	delete(index, path)
+	obj, err := side.NewObject(ctx, path)
+	if errors.Is(err, fs.ErrorObjectNotFound) || errors.Is(err, fs.ErrorDirNotFound) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if ver, ok := bbCloudVersionFrom(ctx, obj); ok {
+		index[path] = ver
+	}
+	return nil
+}
