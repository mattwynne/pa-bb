+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type folderMoveCloud interface {
+	folderProofCloud
+	BBMoveFolder(context.Context, iclouddrive.BBFolderItem, string) error
+}
+
+func observeOwnedFolderMove(ctx context.Context, cloud folderProofCloud, move *bisync.BBFolderMove, workdir string) ownedNoteReply {
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	intent := move.Intent
+	prior := intent.Entries[intent.Source].BBIndexedVersion
+	oldParent, err := folderParentByName(ctx, cloud, intent.Binding, path.Dir(intent.Source))
+	if err != nil || oldParent != prior.ParentID {
+		return uncertain
+	}
+	newParent, err := folderParentByName(ctx, cloud, intent.Binding, path.Dir(intent.Path))
+	if err != nil || newParent != intent.DestinationParent {
+		return uncertain
+	}
+	destinations, err := cloud.BBFolderList(ctx, intent.Binding, newParent)
+	if err != nil {
+		return uncertain
+	}
+	found, err := folderNameIn(destinations, path.Base(intent.Path))
+	if err != nil {
+		return uncertain
+	}
+	if oldParent != newParent {
+		sources, err := cloud.BBFolderList(ctx, intent.Binding, oldParent)
+		if err != nil {
+			return uncertain
+		}
+		for _, item := range sources {
+			if item.DocumentID == prior.DocumentID {
+				return uncertain
+			}
+		}
+	}
+	if found == nil || found.DocumentID != prior.DocumentID {
+		var alternate string
+		for _, item := range destinations {
+			if item.DocumentID != prior.DocumentID {
+				continue
+			}
+			if alternate != "" || !item.Directory || item.ParentID != newParent ||
+				!validFolderPath(item.Name) || strings.Contains(item.Name, "/") {
+				return uncertain
+			}
+			exact, nameErr := folderNameIn(destinations, item.Name)
+			if nameErr != nil || exact == nil || exact.DocumentID != prior.DocumentID {
+				return uncertain
+			}
+			alternate = path.Join(path.Dir(intent.Path), item.Name)
+		}
+		if found != nil && alternate != "" && alternate != intent.Path && alternate != intent.Source {
+			if oldParent == newParent {
+				// iCloud kept the requested name occupied and placed the
+				// original under a separate name. Let normal sync see both.
+				if err := bisync.BBRejectDispatchedFolderMove(workdir, intent.OperationID); err != nil {
+					return uncertain
+				}
+				return ownedNoteReply{Outcome: "folder_refused"}
+			}
+			return ownedNoteReply{Outcome: "folder_collision", AlternatePath: alternate}
+		}
+		return uncertain
+	}
+	if !found.Directory || found.ParentID != newParent {
+		return uncertain
+	}
+	proof := ownedFolderVersion(*found)
+	if move.Published == nil {
+		// The first fresh observation supplies the confirmed ETag. A later
+		// descendant edit does not change the original move receipt.
+		if err := bisync.BBConfirmFolderMove(workdir, intent.OperationID, proof); err != nil {
+			return uncertain
+		}
+	} else {
+		proof = *move.Published
+	}
+	return ownedNoteReply{Outcome: "folder_published", Folder: &ownedFolderObservation{
+		Source: proof, DestinationParent: newParent, Method: "move",
+	}}
+}
+
+func completedFolderReply(published bisync.BBIndexedVersion, copied bool) ownedNoteReply {
+	method := "move"
+	if copied {
+		method = "copy"
+	}
+	return ownedNoteReply{Outcome: "folder_published", Folder: &ownedFolderObservation{
+		Source: published, DestinationParent: published.ParentID, Method: method,
+	}}
+}
+
+func applyOwnedFolderMove(ctx context.Context, cloud folderMoveCloud, request ownedNoteFrame) ownedNoteReply {
+	refused, uncertain := ownedNoteReply{Outcome: "refused"}, ownedNoteReply{Outcome: "uncertain"}
+	if request.OperationID == "" || request.Expected != nil || request.Text != nil || request.WantedHash != "" {
+		return refused
+	}
+	prior, rejected, copied, err := bisync.BBFolderMoveOutcome(request.Workdir, request.OperationID, request.Binding, request.Source, request.Path)
+	if err != nil {
+		return uncertain
+	}
+	if rejected {
+		return ownedNoteReply{Outcome: "folder_refused"}
+	}
+	if prior != nil {
+		return completedFolderReply(*prior, copied)
+	}
+	clone, err := bisync.BBReadFolderClone(request.Workdir)
+	if err != nil {
+		return uncertain
+	}
+	if clone != nil {
+		worker, ok := cloud.(ownedCloneMover)
+		if !ok {
+			return uncertain
+		}
+		return runOwnedFolderClone(ctx, worker, request)
+	}
+	existing, err := bisync.BBReadFolderMove(request.Workdir, request.OperationID)
+	if err != nil {
+		return uncertain
+	}
+	if existing != nil {
+		intent := existing.Intent
+		if intent.Binding != request.Binding || intent.Source != request.Source || intent.Path != request.Path {
+			return refused
+		}
+		if len(existing.Copies) > 0 && existing.Published != nil {
+			return completedFolderReply(*existing.Published, true)
+		}
+		if existing.Dispatched {
+			return observeOwnedFolderMove(ctx, cloud, existing, request.Workdir)
+		}
+	}
+	if request.FolderEntries == nil {
+		if existing != nil && bisync.BBAbortUndispatchedFolderMove(request.Workdir, request.OperationID) != nil {
+			return uncertain
+		}
+		return ownedNoteReply{Outcome: "folder_not_dispatched"}
+	}
+	inspect := request
+	inspect.OperationID = ""
+	reply := inspectOwnedFolder(ctx, cloud, inspect)
+	if reply.Outcome != "folder_verified" || reply.Folder == nil {
+		if existing != nil && bisync.BBAbortUndispatchedFolderMove(request.Workdir, request.OperationID) != nil {
+			return uncertain
+		}
+		return refused
+	}
+	folder := reply.Folder
+	hashes := make(map[string][sha256.Size]byte)
+	for _, entry := range request.FolderEntries {
+		if entry.Kind == "file" {
+			value, _ := hex.DecodeString(entry.Hash) // inspectOwnedFolder validated the digest.
+			hashes[path.Join(request.Source, entry.Path)] = [sha256.Size]byte(value)
+		}
+	}
+	move := bisync.BBFolderMove{Intent: bisync.BBFolderMoveIntent{
+		OperationID: request.OperationID, Binding: request.Binding, Source: request.Source, Path: request.Path,
+		DestinationParent: folder.DestinationParent, Entries: folder.entries, Hashes: hashes,
+	}, Dispatched: true}
+	dispatch := func() error { return cloud.BBMoveFolder(ctx, folder.item, folder.DestinationParent) }
+	if folder.item.ParentID == folder.DestinationParent {
+		renamer, ok := cloud.(interface {
+			BBRenameFolder(context.Context, iclouddrive.BBFolderItem, string) error
+		})
+		if !ok {
+			return refused
+		}
+		dispatch = func() error { return renamer.BBRenameFolder(ctx, folder.item, path.Base(request.Path)) }
+	}
+	if err := bisync.BBPrepareFolderMove(request.Workdir, move.Intent); err != nil {
+		return uncertain
+	}
+	if ctx.Err() != nil {
+		if err := bisync.BBAbortUndispatchedFolderMove(request.Workdir, request.OperationID); err != nil {
+			return uncertain
+		}
+		return refused
+	}
+	if err := bisync.BBDispatchFolderMove(request.Workdir, request.OperationID); err != nil {
+		return uncertain
+	}
+	// Success or failure of the HTTP call alone cannot settle a move.
+	// Read back the original folder identity exactly once the call returns.
+	if err := dispatch(); errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+		if err := bisync.BBRejectDispatchedFolderMove(request.Workdir, request.OperationID); err != nil {
+			return uncertain
+		}
+		return ownedNoteReply{Outcome: "folder_refused"}
+	}
+	return observeOwnedFolderMove(ctx, cloud, &move, request.Workdir)
+}
