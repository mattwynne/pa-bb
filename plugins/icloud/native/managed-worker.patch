+
+func TestBBPrivateNoteFrameRejectsUnexpectedInput(t *testing.T) {
+	const prefix = `{"binding":"FOLDER::com.apple.CloudDocs::test","path":"Test.md"`
+	accepted, err := readOwnedNoteFrame(strings.NewReader(prefix + `,"text":"generated"}`))
+	if err != nil || accepted.Text == nil || *accepted.Text != "generated" {
+		t.Fatal("valid note frame was not parsed")
+	}
+	for _, input := range []string{
+		prefix + `,"unknown":true}`, prefix + `} {}`, `{"binding":"generated"}`,
+		prefix + `,"text":"` + strings.Repeat("x", maxOwnedFrame) + `"}`,
+	} {
+		if _, err := readOwnedNoteFrame(strings.NewReader(input)); err == nil {
+			t.Fatal("unexpected frame was accepted")
+		}
+	}
+}
+
+func TestBBPrivateBindingFrameCannotCarryNoteOperations(t *testing.T) {
+	binding, err := readOwnedNoteFrame(strings.NewReader(`{"workdir":"/tmp/owned","binding":""}`))
+	if err != nil || !validOwnedNoteFrame("binding", binding) || validOwnedNoteFrame("replace", binding) {
+		t.Fatal("binding request became a note operation")
+	}
+	if _, err := readOwnedNoteFrame(strings.NewReader(`{"workdir":"/tmp/owned","text":"attempted mutation"}`)); err == nil {
+		t.Fatal("binding command accepted mutation content")
+	}
+	operation, err := readOwnedNoteFrame(strings.NewReader(`{"workdir":"/tmp/owned","binding":"claimed","path":"Note.md"}`))
+	if err != nil || validOwnedNoteFrame("binding", operation) {
+		t.Fatal("ordinary note request became binding discovery")
+	}
+}
