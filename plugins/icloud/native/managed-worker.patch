+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/sys/unix"
+)
+
+type BBConflictSnapshot struct {
+	Present  bool
+	Version  BBIndexedVersion
+	Hash     [sha256.Size]byte
+	Size     int64
+	Modified time.Time
+}
+
+type BBConflictResolution struct {
+	Source, Destination BBConflictSnapshot
+}
+
+func (s BBConflictSnapshot) valid() bool {
+	if !s.Present {
+		return s == (BBConflictSnapshot{})
+	}
+	return s.Version.DocumentID != "" && s.Version.ParentID != "" && s.Version.ETag != "" &&
+		s.Hash != ([sha256.Size]byte{}) && s.Size > 0 && s.Size <= bbDeliveryBytes && !s.Modified.IsZero()
+}
+
+func (r BBConflictResolution) valid() bool { return r.Source.valid() && r.Destination.valid() }
+
+func (r BBRelocationIntent) conflictEndpointNames() []string {
+	return []string{r.Source, r.Path, r.ConflictIntent().Path}
+}
+
+func BBConflictResolved(workdir string, intent BBRelocationIntent) (bool, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return false, err
+	}
+	for _, done := range state.ReconciledConflicts {
+		if done.OperationID == intent.OperationID {
+			if done != intent {
+				return false, errBBInvalidDelivery
+			}
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// Approval does not change either endpoint. The next managed scan
+// revalidates all three agreed files before changing its paired baselines.
+func BBApproveConflictResolution(workdir string, intent BBRelocationIntent, resolution BBConflictResolution) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if state.Pending != nil || move.Conflict == nil || move.Conflict.Copy == nil || !resolution.valid() {
+			return false
+		}
+		state.Version = 5
+		move.Conflict.Approved = &resolution
+		return true
+	})
+}
+
+func BBVerifyConflictLocal(root, relative string, snapshot BBConflictSnapshot, align bool) error {
+	if !snapshot.valid() {
+		return errBBInvalidDelivery
+	}
+	if snapshot.Present {
+		if align {
+			return bbConfirmLocalReceiptTime(root, relative, snapshot.Hash, snapshot.Modified, nil)
+		}
+		return bbCheckLocalReceipt(root, relative, snapshot.Hash, nil, nil)
+	}
+	if path.Clean(relative) != relative || relative == "." || path.IsAbs(relative) ||
+		strings.HasPrefix(relative, "../") || !strings.HasSuffix(relative, ".md") {
+		return errBBInvalidDelivery
+	}
+	fd, err := unix.Open(root, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = unix.Close(fd) }()
+	parts := strings.Split(relative, "/")
+	for _, part := range parts[:len(parts)-1] {
+		next, err := unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		_ = unix.Close(fd)
+		fd = next
+	}
+	var st unix.Stat_t
+	if err := unix.Fstatat(fd, parts[len(parts)-1], &st, unix.AT_SYMLINK_NOFOLLOW); !errors.Is(err, unix.ENOENT) {
+		return errBBLocalSuperseded
+	}
+	return nil
+}
+
+func (r *BBRelocation) conflictSnapshots() []BBConflictSnapshot {
+	checkpoint := r.Conflict.Approved
+	copy := r.Conflict.Copy
+	saved := BBConflictSnapshot{true, BBIndexedVersion{copy.ProviderID, copy.ProviderParentID, copy.ETag}, copy.Hash, copy.Size, copy.Modified}
+	return []BBConflictSnapshot{checkpoint.Source, checkpoint.Destination, saved}
+}
+
+func (b *bisyncRun) conflictResolutionReady(ctx context.Context, move *BBRelocation) bool {
+	for i, name := range move.Intent.conflictEndpointNames() {
+		selected := move.conflictSnapshots()[i]
+		if b.aliases.Alias(name) != name || BBVerifyConflictLocal(b.fs2.Root(), name, selected, false) != nil {
+			return false
+		}
+		now, err := b.fs1.NewObject(ctx, name)
+		if !selected.Present {
+			if (!errors.Is(err, fs.ErrorObjectNotFound) && !errors.Is(err, fs.ErrorDirNotFound)) || b.march.ls1.has(name) {
+				return false
+			}
+			continue
+		}
+		if err != nil || now.Remote() != name || !b.march.ls1.has(name) {
+			return false
+		}
+		current, ok := bbCloudVersionFrom(ctx, now)
+		if !ok || b.march.bbIdentities[name].BBIndexedVersion != selected.Version || current.BBIndexedVersion != selected.Version || current.Size != selected.Size || !current.Modified.Equal(selected.Modified) {
+			return false
+		}
+	}
+	return true
+}
+
+func (b *bisyncRun) alignConflictBaseline(move *BBRelocation) error {
+	for i, name := range move.Intent.conflictEndpointNames() {
+		if err := BBVerifyConflictLocal(b.fs2.Root(), name, move.conflictSnapshots()[i], true); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (state *bbDeliveryStore) conflictBaselinesAdopted(move *BBRelocation) {
+	remaining := state.Confirmed[:0]
+	for _, receipt := range state.Confirmed {
+		if bbRelocationSupersedes(move.Intent, receipt) {
+			state.Applied = append(state.Applied, receipt)
+		} else {
+			remaining = append(remaining, receipt)
+		}
+	}
+	state.Confirmed = remaining
+	if len(state.Applied) > bbDeliveryLimit {
+		state.Applied = state.Applied[len(state.Applied)-bbDeliveryLimit:]
+	}
+	state.ReconciledConflicts = append(state.ReconciledConflicts, move.Intent)
+	if len(state.ReconciledConflicts) > bbDeliveryLimit {
+		state.ReconciledConflicts = state.ReconciledConflicts[len(state.ReconciledConflicts)-bbDeliveryLimit:]
+	}
+	state.Relocation = nil
+}
