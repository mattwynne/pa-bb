+package bisync
+
+import (
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestBBReceiptTimestampCannotRetargetAReplacement(t *testing.T) {
+	root := t.TempDir()
+	note := filepath.Join(root, "note.md")
+	contents := []byte("verified provider bytes")
+	if err := os.WriteFile(note, contents, 0600); err != nil {
+		t.Fatal(err)
+	}
+	target := time.Unix(1705012323, 0)
+	if err := bbConfirmLocalReceiptTime(root, "note.md", sha256.Sum256(contents), target, nil); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.Stat(note)
+	if err != nil || !got.ModTime().Equal(target) {
+		t.Fatalf("verified timestamp was not adopted: %v", err)
+	}
+
+	replacement := filepath.Join(root, "replacement")
+	later := target.Add(90 * time.Second)
+	if err := os.WriteFile(replacement, []byte("later BB save"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(replacement, later, later); err != nil {
+		t.Fatal(err)
+	}
+	fresh := func() {
+		if err := os.Rename(replacement, note); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := bbConfirmLocalReceiptTime(root, "note.md", sha256.Sum256(contents), target, fresh); !errors.Is(err, errBBLocalSuperseded) {
+		t.Fatalf("later note was not detected: %v", err)
+	}
+	got, err = os.Stat(note)
+	if err != nil || !got.ModTime().Equal(later) {
+		t.Fatalf("retimestamp affected newer note: %v", err)
+	}
+	actual, err := os.ReadFile(note)
+	if err != nil || string(actual) != "later BB save" {
+		t.Fatalf("newer bytes were changed: %v", err)
+	}
+}
