+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		for _, name := range []string{"Cloud.md", "Local.md", "Gone.md", "Keep.md", "Both.md", "Recreated.md", "Fast.md"} {
+			write(root, source+"/"+name, "old")
+		}
+		write(root, "Anchor.md", "independent anchor")
+		if err := os.Mkdir(filepath.Join(root, "Destination"), 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cloudReal, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mirror, err := local.NewFs(ctx, "local", mirrorRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	options := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50}
+	if err := Bisync(ctx, cloudReal, mirror, &options); err != nil {
+		t.Fatal(err)
+	}
+	rootVersion := BBIndexedVersion{"folder", "source-parent", "source-folder-etag"}
+	move := BBFolderMoveIntent{
+		OperationID: "fc774bfb-944a-4cdd-a0a8-f1aa3fb74610", Binding: "binding", Source: source, Path: destination,
+		DestinationParent: "destination-parent",
+		Entries:           map[string]BBTreeIdentity{source: {BBIndexedVersion: rootVersion, Directory: true}},
+		Hashes:            map[string][sha256.Size]byte{},
+	}
+	newVersions := map[string]BBIndexedVersion{}
+	for _, name := range []string{"Cloud.md", "Local.md", "Gone.md", "Keep.md", "Both.md", "Recreated.md", "Fast.md"} {
+		version := BBIndexedVersion{name, rootVersion.DocumentID, "original-file-etag"}
+		move.Entries[source+"/"+name] = BBTreeIdentity{BBIndexedVersion: version}
+		move.Hashes[source+"/"+name] = sha256.Sum256([]byte("old"))
+		if name == "Cloud.md" || name == "Both.md" {
+			version.ETag = "changed-with-same-metadata"
+		}
+		if name == "Recreated.md" {
+			version.DocumentID = "independent-new-identity"
+		}
+		newVersions[destination+"/"+name] = version
+	}
+	if err := BBPrepareFolderMove(workdir, move); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBDispatchFolderMove(workdir, move.OperationID); err != nil {
+		t.Fatal(err)
+	}
+	publication := BBIndexedVersion{rootVersion.DocumentID, move.DestinationParent, "moved"}
+	if err := BBConfirmFolderMove(workdir, move.OperationID, publication); err != nil {
+		t.Fatal(err)
+	}
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		if err := os.Rename(filepath.Join(root, source), filepath.Join(root, destination)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	fast := []byte("fast note after folder move")
+	fastPath := destination + "/Fast.md"
+	fastVersion := newVersions[fastPath]
+	note := BBDeliveryIntent{OperationID: "5ec49f07-dd77-4f54-8756-dd2d5d49c060", Path: fastPath, Hash: sha256.Sum256(fast)}
+	if err := BBBeginDeliveryWithData(workdir, note, fast, fastVersion.DocumentID); err != nil {
+		t.Fatal(err)
+	}
+	fastVersion.ETag = "fast-replacement"
+	newVersions[fastPath] = fastVersion
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		write(root, fastPath, string(fast))
+	}
+	if err := BBResolveDelivery(workdir, note, &BBDeliveryReceipt{
+		BBDeliveryIntent: note, Modified: modified, Size: int64(len(fast)), ProviderID: fastVersion.DocumentID, ETag: fastVersion.ETag,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	write(cloudRoot, destination+"/Cloud.md", "new")
+	write(mirrorRoot, destination+"/Local.md", "cpu")
+	write(cloudRoot, destination+"/Both.md", "mac")
+	write(mirrorRoot, destination+"/Both.md", "loc")
+	write(mirrorRoot, destination+"/Recreated.md", "bbr")
+	if err := os.Remove(filepath.Join(cloudRoot, destination, "Gone.md")); err != nil {
+		t.Fatal(err)
+	}
+	cloud := bbHeldFolderFilesystem{&bbHeldListingFS{Fs: cloudReal, versions: newVersions},
+		map[string]BBIndexedVersion{destination: publication}}
+	options.Resync = false
+	if err := BBManagedBisync(ctx, &cloud, mirror, options, move.Binding); err != nil {
+		t.Fatal(err)
+	}
+	for _, root := range []string{cloudRoot, mirrorRoot} {
+		for name, expected := range map[string]string{"Cloud.md": "new", "Local.md": "cpu", "Keep.md": "old", "Fast.md": string(fast)} {
+			bytes, err := os.ReadFile(filepath.Join(root, destination, name))
+			if err != nil || string(bytes) != expected {
+				t.Fatalf("reconciled %s = %q, error = %v", name, bytes, err)
+			}
+		}
+		expectedConflicts := map[string][]string{"Both*": {"loc", "mac"}, "Recreated*": {"bbr", "old"}}
+		for pattern, expected := range expectedConflicts {
+			conflicts, err := filepath.Glob(filepath.Join(root, destination, pattern))
+			if err != nil || len(conflicts) != 2 {
+				t.Fatalf("conflict candidate count = %d, error = %v", len(conflicts), err)
+			}
+			var choices []string
+			for _, conflict := range conflicts {
+				content, err := os.ReadFile(conflict)
+				if err != nil {
+					t.Fatal(err)
+				}
+				choices = append(choices, string(content))
+			}
+			slices.Sort(choices)
+			if !slices.Equal(choices, expected) {
+				t.Fatalf("the two conflicting revisions were not preserved: %v", choices)
+			}
+		}
+		for _, name := range []string{source, destination + "/Gone.md"} {
+			if _, err := os.Stat(filepath.Join(root, name)); !os.IsNotExist(err) {
+				t.Fatalf("resurrected %q, error = %v", name, err)
+			}
+		}
+	}
+	if record, rejected, _, err := BBFolderMoveOutcome(workdir, move.OperationID, move.Binding, source, destination); err != nil || rejected || record == nil || *record != publication {
+		t.Fatalf("settled move = %+v, error = %v", record, err)
+	}
+}
