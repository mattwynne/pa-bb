+type bbHeldFolderFilesystem struct {
+	*bbHeldListingFS
+	directories map[string]BBIndexedVersion
+}
+
+type bbHeldDirectory struct {
+	fs.Directory
+	version BBIndexedVersion
+}
+
+func (d bbHeldDirectory) BBListedIdentity() (string, string, string) {
+	return d.version.DocumentID, d.version.ParentID, d.version.ETag
+}
+
+func (f bbHeldFolderFilesystem) List(ctx context.Context, name string) (fs.DirEntries, error) {
+	items, err := f.bbHeldListingFS.List(ctx, name)
+	for i, item := range items {
+		if dir, ok := item.(fs.Directory); ok {
+			id, listed := f.directories[item.Remote()]
+			if !listed {
+				id = BBIndexedVersion{"directory-" + item.Remote(), "parent", "prior"}
+			}
+			items[i] = bbHeldDirectory{dir, id}
+		}
+	}
+	return items, err
+}
