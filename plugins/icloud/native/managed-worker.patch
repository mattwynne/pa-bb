+	run.march.bbLocalDirs = map[string]bool{"Book": true, "Held": true}
+	scope := run.bbTransferScope(ctx, uploads, downloads, removals)
+	if len(scope.Replacements) != 1 || scope.Replacements["Book/Keep.md"] != (bbTransferIdentity{"Book/Keep.md", "parent"}) {
+		t.Fatalf("scope = %+v", scope)
