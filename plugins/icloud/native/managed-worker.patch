+	"time"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+const conditionalReplyLimit = 65536
+
+var (
+	driveIdentifier           = regexp.MustCompile(`^[A-Za-z0-9._-]{1,160}$`)
+	ErrConditionalRefused     = errors.New("conditional write requires an exact generated fixture and version")
+	ErrConditionalConflict    = errors.New("provider refused the expected version")
+	ErrConditionalUnconfirmed = errors.New("conditional write outcome requires read-back")
+)
+
+type conditionalPayload struct {
+	Command    string          `json:"command"`
+	DocumentID string          `json:"document_id"`
+	ETag       string          `json:"etag"`
+	Mtime      int64           `json:"mtime"`
+	Data       conditionalData `json:"data"`
+}
+
+type conditionalData struct {
+	Receipt            string `json:"receipt,omitempty"`
+	ReferenceSignature string `json:"reference_signature,omitempty"`
+	Signature          string `json:"signature"`
+	Size               int64  `json:"size"`
+	WrappingKey        string `json:"wrapping_key,omitempty"`
+}
+
+type conditionalReply struct {
+	DocumentUpdateResponse
+	Code       string `json:"error_code"`
+	ServerCode string `json:"serverErrorCode"`
+}
+
+// PublishGeneratedFixture submits the receipt once against the original
+// document identity and ETag. A successful response still requires fresh
+// exact-path, identity, revision, and byte verification by its caller.
+// PublishConditionalNote is called only after the worker proves the bound
+// mirror, exact path, prior bytes, and original document identity.
+func (d *DriveService) PublishConditionalNote(ctx context.Context, item DriveItem, expectedParent, expectedName string, staged SingleFileInfo, modified time.Time) (*Document, error) {
+	kind, zone, documentID := DeconstructDriveID(item.Drivewsid)
+	if kind != "FILE" || item.Type != "FILE" || expectedName == "" || item.FullName() != expectedName ||
+		!driveIdentifier.MatchString(zone) || !driveIdentifier.MatchString(documentID) ||
+		documentID != item.Docwsid || expectedParent == "" || item.ParentID != expectedParent || item.Etag == "" ||
+		staged.Signature == "" || staged.Size <= 0 || staged.Size > (1<<20) {
+		return nil, ErrConditionalRefused
+	}
+	payload, err := json.Marshal(conditionalPayload{
+		Command: "modify_file", DocumentID: documentID, ETag: item.Etag, Mtime: modified.UnixMilli(),
+		Data: conditionalData{
+			Receipt: staged.Receipt, ReferenceSignature: staged.ReferenceSignature,
+			Signature: staged.Signature, Size: staged.Size, WrappingKey: staged.WrappingKey,
+		},
+	})
+	if err != nil {
+		return nil, ErrConditionalRefused
+	}
+
+	// Use the existing session transport without Client.Request's automatic
+	// authentication-and-replay behavior around a content mutation.
+	session := d.icloud.Session
+	resp, err := session.srv.Call(ctx, &rest.Opts{
+		Method: http.MethodPost, Path: "/ws/" + zone + "/update/documents",
+		RootURL: d.docsEndpoint, Body: io.NopCloser(bytes.NewReader(payload)),
+		ExtraHeaders: session.GetHeaders(nil),
+		NoRedirect:   true, IgnoreStatus: true,
+	})
+	if err != nil {
+		return nil, ErrConditionalUnconfirmed
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, conditionalReplyLimit+1))
+	if err != nil || len(body) > conditionalReplyLimit {
+		return nil, ErrConditionalUnconfirmed
+	}
+	var reply conditionalReply
+	if err := json.Unmarshal(body, &reply); err != nil {
+		return nil, ErrConditionalUnconfirmed
+	}
+	if resp.StatusCode == http.StatusConflict &&
+		(reply.Code == "OP_LOCK_FAILURE" || reply.ServerCode == "OP_LOCK_FAILURE") {
+		return nil, ErrConditionalConflict
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 ||
+		reply.Status.StatusCode != 0 || len(reply.Results) != 1 {
+		return nil, ErrConditionalUnconfirmed
+	}
+	result := reply.Results[0]
+	doc := result.Document
+	if result.Status.StatusCode != 0 || doc == nil || doc.Status.StatusCode != 0 ||
+		doc.DocumentID != documentID || doc.Deleted {
+		return nil, ErrConditionalUnconfirmed
+	}
+	return doc, nil
+}
