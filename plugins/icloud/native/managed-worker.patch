+		Folders []conditionalFolderPreparation `json:"folders"`
+	}{parentID, []conditionalFolderPreparation{{ClientID: clientID, Name: leaf}}})
+	if err != nil {
+		return "", ErrConditionalRefused
+	}
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	if dispatch != nil {
+		if err := dispatch(); err != nil {
