+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"path"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type ownedCloneCloud interface {
+	folderProofCloud
+	BBReserveStageFolderWithDispatch(context.Context, string, string, string, string, func() error) (iclouddrive.BBFolderItem, error)
+	BBReserveStageFile(context.Context, string, iclouddrive.BBFolderItem, [sha256.Size]byte) (api.BBFolderFileAllocation, error)
+	BBActivateStageFile(context.Context, string, string, string, api.BBFolderFileAllocation, [sha256.Size]byte, func() error) (*iclouddrive.BBFolderItem, error)
+	BBObserveStageFile(context.Context, string, string, string, string, [sha256.Size]byte) (*iclouddrive.BBFolderItem, error)
+}
+
+func cloneFolderLeaf(ctx context.Context, cloud folderProofCloud, binding, parent, leaf string) (*iclouddrive.BBFolderItem, error) {
+	items, err := cloud.BBFolderList(ctx, binding, parent)
+	if err != nil {
+		return nil, err
+	}
+	return folderNameIn(items, leaf)
+}
+
+func advanceCloneConstruction(ctx context.Context, cloud ownedCloneCloud, workdir string, journal *bisync.BBFolderCloneJournal) error {
+	action, entry, ok := journal.Current()
+	if !ok {
+		return api.ErrConditionalRefused
+	}
+	intent := journal.Intent
+	if action == "verify_staged_tree" {
+		if err := verifyOwnedCloneTree(ctx, cloud, journal, false); err != nil {
+			return err
+		}
+		return bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, nil, false)
+	}
+
+	switch action {
+	case "create_stage", "create_directory":
+		if journal.Dispatched {
+			// Provider did not acknowledge a new ID. An independent
+			// same-name folder is never claimed after a lost reply.
+			return api.ErrConditionalUnconfirmed
+		}
+		parent, name := intent.Binding, journal.StageName()
+		if action == "create_directory" {
+			name = path.Base(intent.Path)
+			parent = journal.Stage.DocumentID
+			if entry != intent.Source {
+				name = path.Base(entry)
+				parent = journal.Copies[path.Dir(entry)].DocumentID
+			}
+		}
+		nonce := uuid.NewSHA1(uuid.MustParse(intent.OperationID), []byte(action+"\x00"+entry)).String()
+		folder, err := cloud.BBReserveStageFolderWithDispatch(ctx, intent.Binding, parent, name, nonce, func() error {
+			return beforeCloneDispatch(ctx, func() error {
+				return bisync.BBDispatchFolderCloneStep(workdir, intent.OperationID, journal.Step)
+			})
+		})
+		if err != nil {
+			return err
+		}
+		version := ownedFolderVersion(folder)
+		return bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, &version, false)
+
+	case "copy_file":
+		parent := journal.Copies[path.Dir(entry)].DocumentID
+		label := path.Base(entry)
+		digest := intent.Hashes[entry]
+		allocated := journal.Allocation
+		if allocated == nil {
+			if journal.Dispatched {
+				return api.ErrConditionalUnconfirmed
+			}
+			prior := intent.Entries[entry].BBIndexedVersion
+			current, err := cloneFolderLeaf(ctx, cloud, intent.Binding, prior.ParentID, label)
+			if err != nil || current == nil || ownedFolderVersion(*current) != prior {
+				return api.ErrConditionalConflict
+			}
+			slot, err := cloud.BBReserveStageFile(ctx, intent.Binding, *current, digest)
+			if err != nil {
+				return err
+			}
+			allocated = &bisync.BBFolderCloneAllocation{
+				DocumentID: slot.DocumentID, Signature: slot.Asset.Signature, ReferenceSignature: slot.Asset.ReferenceSignature,
+				WrappingKey: slot.Asset.WrappingKey, Size: slot.Asset.Size, Receipt: slot.Asset.Receipt,
+			}
+			// Start activation from the durable allocation, with a fresh
+			// dispatch check after its own provider preflight.
+			return bisync.BBRecordFolderCloneAllocation(workdir, intent.OperationID, journal.Step, *allocated)
+		}
+		var found *iclouddrive.BBFolderItem
+		var err error
+		if journal.ActivationDispatched {
+			found, err = cloud.BBObserveStageFile(ctx, intent.Binding, parent, label, allocated.DocumentID, digest)
+			if found == nil && err == nil {
+				released, releaseErr := bisync.BBAbandonUnconfirmedFolderCopy(workdir, intent.OperationID, time.Now())
+				if releaseErr != nil {
+					return releaseErr
+				}
+				if released {
+					return errFolderDeferredToScheduledSync
+				}
+			}
+		} else if allocated.Receipt != "" {
+			slot := api.BBFolderFileAllocation{DocumentID: allocated.DocumentID, Asset: api.SingleFileInfo{
+				Signature: allocated.Signature, ReferenceSignature: allocated.ReferenceSignature,
+				WrappingKey: allocated.WrappingKey, Receipt: allocated.Receipt, Size: allocated.Size,
+			}}
+			found, err = cloud.BBActivateStageFile(ctx, intent.Binding, parent, label, slot, digest, func() error {
+				return beforeCloneDispatch(ctx, func() error {
+					return bisync.BBDispatchFolderCloneActivation(workdir, intent.OperationID, journal.Step)
+				})
+			})
+		}
+		if err != nil || found == nil {
+			return api.ErrConditionalUnconfirmed
+		}
+		version := ownedFolderVersion(*found)
+		return bisync.BBCompleteFolderCloneStep(workdir, intent.OperationID, journal.Step, &version, false)
+	}
+	return api.ErrConditionalRefused
+}
+
+// Leave enough of the bounded attempt for the provider mutation and its
+// acknowledgement. An expired preflight must never become a lost reply.
+func beforeCloneDispatch(ctx context.Context, record func() error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if deadline, ok := ctx.Deadline(); ok && time.Until(deadline) < 6*time.Second {
+		return context.DeadlineExceeded
+	}
+	return record()
+}
+
+func verifyOwnedCloneTree(ctx context.Context, cloud folderProofCloud, journal *bisync.BBFolderCloneJournal, published bool) error {
+	intent := journal.Intent
+	parent := journal.Stage.DocumentID
+	if published {
+		parent = intent.DestinationParent
+	}
+	root, err := cloneFolderLeaf(ctx, cloud, intent.Binding, parent, path.Base(intent.Path))
+	if err != nil || root == nil || !root.Directory || root.DocumentID != journal.Copies[intent.Source].DocumentID {
+		return api.ErrConditionalUnconfirmed
+	}
+	count := 1
+	var verify func(string, string) error
+	verify = func(at, id string) error {
+		children, err := cloud.BBFolderList(ctx, intent.Binding, id)
+		if err != nil {
+			return err
+		}
+		for _, child := range children {
+			if !validFolderPath(child.Name) || path.Base(child.Name) != child.Name {
+				return api.ErrConditionalConflict
+			}
+			name := path.Join(at, child.Name)
+			original, known := intent.Entries[name]
+			copy := journal.Copies[name]
+			if !known || child.DocumentID != copy.DocumentID || child.ParentID != copy.ParentID || child.Directory != original.Directory {
+				return api.ErrConditionalConflict
+			}
+			count++
+			if child.Directory {
+				if err := verify(name, child.DocumentID); err != nil {
+					return err
+				}
+			} else {
+				hash, err := cloud.BBFolderFileHash(ctx, child)
+				if err != nil || hash != intent.Hashes[name] {
+					return api.ErrConditionalConflict
+				}
+			}
+		}
+		return nil
+	}
+	if err := verify(intent.Source, root.DocumentID); err != nil {
+		return err
+	}
+	if count != len(intent.Entries) {
+		return api.ErrConditionalConflict
+	}
+	return nil
+}
