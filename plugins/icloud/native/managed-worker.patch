+func TestBBFolderMoveJournalPreventsReplayAndProtectsDescendants(t *testing.T) {
+	root := BBIndexedVersion{DocumentID: "folder", ParentID: "old", ETag: "original"}
+	child := BBIndexedVersion{DocumentID: "child", ParentID: "folder", ETag: "child-original"}
+	intent := BBFolderMoveIntent{
+		OperationID: "1d73db11-f4ce-4148-9081-48e27e8e1d83", Binding: "binding", Source: "old/Folder", Path: "new/Folder",
+		DestinationParent: "new", Hashes: map[string][sha256.Size]byte{"old/Folder/Child.md": sha256.Sum256([]byte("old"))}, Entries: map[string]BBTreeIdentity{
+			"old/Folder":          {BBIndexedVersion: root, Directory: true},
+			"old/Folder/Child.md": {BBIndexedVersion: child},
+		},
+	}
+	workdir := t.TempDir()
+	if err := BBPrepareFolderMove(workdir, intent); err != nil {
+		t.Fatal(err)
+	}
+	after := BBIndexedVersion{DocumentID: "folder", ParentID: "new", ETag: "moved"}
+	if err := BBConfirmFolderMove(workdir, intent.OperationID, after); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("confirmation before dispatch = %v", err)
+	}
+	if err := BBDispatchFolderMove(workdir, intent.OperationID); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBDispatchFolderMove(workdir, intent.OperationID); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("replay after lost response = %v", err)
+	}
+	if err := BBAbortUndispatchedFolderMove(workdir, intent.OperationID); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("abort after dispatch = %v", err)
+	}
+
+	data := []byte("new data")
+	note := BBDeliveryIntent{OperationID: "1eb96515-4168-4e82-beff-574bfc347a29", Path: "DeviceRename.md", Hash: sha256.Sum256(data)}
+	if err := BBBeginDeliveryWithData(workdir, note, data, child.DocumentID); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("replacement on a provider alias = %v", err)
+	}
+	note.Path, note.Create = "New/folder/New.md", true
+	if err := BBBeginDeliveryWithData(workdir, note, data); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("creation inside the folder = %v", err)
+	}
+	note.Path, note.Create = "Unrelated.md", false
+	if err := BBBeginDeliveryWithData(workdir, note, data, "unrelated"); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBConfirmFolderMove(workdir, intent.OperationID, after); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := BBResolveDelivery(workdir, note, nil); err != nil {
+		t.Fatal(err)
+	}
+	note.Path = "new/Folder/Child.md"
+	version, digest, ok := BBMovedNoteBaseline(workdir, intent.Binding, note.Path)
+	if !ok || version != child || digest != intent.Hashes["old/Folder/Child.md"] {
+		t.Fatalf("remapped note proof = %+v, %t", version, ok)
+	}
+	if _, _, ok := BBMovedNoteBaseline(workdir, "different-account-root", note.Path); ok {
+		t.Fatal("accepted a different mirror binding")
+	}
+	if err := BBBeginDeliveryWithData(workdir, note, data, "independently-recreated"); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("replacement on another iCloud identity = %v", err)
+	}
+	if err := BBBeginDeliveryWithData(workdir, note, data, child.DocumentID); err != nil {
+		t.Fatal(err)
+	}
+
+	record, err := BBReadFolderMove(workdir, intent.OperationID)
+	if err != nil || record == nil || record.Published == nil || *record.Published != after {
+		t.Fatalf("durable receipt = %+v, error = %v", record, err)
+	}
+}
