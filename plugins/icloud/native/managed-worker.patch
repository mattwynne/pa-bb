+package bisync
+
+// BBRelocationConflict preserves the staged BB bytes at a deterministic
+// create-only path. It is separate from the disputed canonical destination.
+type BBRelocationConflict struct {
+	Allocation string
+	Copy       *BBDeliveryReceipt
+	Approved   *BBConflictResolution `json:",omitempty"`
+}
+
+func (r BBRelocationIntent) ConflictIntent() BBDeliveryIntent {
+	intent := r.BBDeliveryIntent
+	intent.Path = "BB move conflict " + intent.OperationID + ".md"
+	return intent
+}
+
+func (r *BBRelocation) heldPaths() []string {
+	paths := []string{r.Intent.Source, r.Intent.Path}
+	if r.Conflict != nil && r.Conflict.Copy == nil {
+		paths = append(paths, r.Intent.ConflictIntent().Path)
+	}
+	return paths
+}
+
+func (c *BBRelocationConflict) valid(intent BBRelocationIntent, size int) bool {
+	target := intent.ConflictIntent()
+	if !validBBRelocationPaths(intent.Source, target) || !validBBRelocationPaths(intent.Path, target) ||
+		len(c.Allocation) > 512 {
+		return false
+	}
+	if c.Copy == nil {
+		return c.Approved == nil
+	}
+	if c.Approved != nil && !c.Approved.valid() {
+		return false
+	}
+	return c.Allocation != "" && c.Copy.BBDeliveryIntent == target && c.Copy.DocumentID == c.Allocation &&
+		c.Copy.RemovedPath == "" && !c.Copy.SourceRetained && c.Copy.ProviderID != "" && bbAllocatedDocumentID(c.Copy.ProviderID) == c.Allocation &&
+		c.Copy.ProviderParentID != "" && c.Copy.ETag != "" && c.Copy.Size == int64(size) && !c.Copy.Modified.IsZero()
+}
+
+func BBBeginRelocationConflict(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation == "" || move.Conflict != nil {
+			return false
+		}
+		if state.Version < 4 {
+			state.Version = 4
+		}
+		move.Conflict = &BBRelocationConflict{}
+		return true
+	})
+}
+
+func BBAllocateRelocationConflict(workdir string, intent BBRelocationIntent, allocation string) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Conflict == nil || move.Conflict.Allocation != "" || allocation == "" || allocation == move.Allocation {
+			return false
+		}
+		move.Conflict.Allocation = allocation
+		return true
+	})
+}
+
+func BBRecordRelocationConflict(workdir string, intent BBRelocationIntent, receipt BBDeliveryReceipt) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Conflict == nil || move.Conflict.Allocation == "" || move.Conflict.Copy != nil ||
+			receipt.ProviderID == move.Intent.Previous.DocumentID ||
+			(move.Destination != nil && receipt.ProviderID == move.Destination.ProviderID) {
+			return false
+		}
+		move.Conflict.Copy = &receipt
+		return true
+	})
+}
