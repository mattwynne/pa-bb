+package bisync
+
+import (
+	"cmp"
+	"path"
+	"slices"
+	"strings"
+)
+
+type bbCloneAction string
+
+const (
+	bbCloneCreateStage bbCloneAction = "create_stage"
+	bbCloneCreateDir   bbCloneAction = "create_directory"
+	bbCloneCopyFile    bbCloneAction = "copy_file"
+	bbCloneVerifyTree  bbCloneAction = "verify_staged_tree"
+	bbClonePublish     bbCloneAction = "publish_verified_tree"
+	bbCloneRetire      bbCloneAction = "retire_original_entry"
+	bbCloneRetireStage bbCloneAction = "retire_empty_stage"
+)
+
+type bbFolderCloneStep struct {
+	action bbCloneAction
+	entry  string
+}
+
+// Build a stable ordering from the immutable original manifest. Every
+// original leaf remains untouched until the owner's staged-tree proof.
+func bbFolderCloneSteps(intent BBFolderMoveIntent) ([]bbFolderCloneStep, error) {
+	if !validBBFolderTransition(intent, true) {
+		return nil, errBBInvalidDelivery
+	}
+	dirs := make([]string, 0, len(intent.Entries))
+	files := make([]string, 0, len(intent.Hashes))
+	for name, entry := range intent.Entries {
+		if entry.Directory {
+			dirs = append(dirs, name)
+		} else {
+			files = append(files, name)
+		}
+	}
+	slices.SortFunc(dirs, func(a, b string) int {
+		if depth := cmp.Compare(strings.Count(a, "/"), strings.Count(b, "/")); depth != 0 {
+			return depth
+		}
+		return cmp.Compare(a, b)
+	})
+	slices.Sort(files)
+	result := []bbFolderCloneStep{{bbCloneCreateStage, ""}}
+	for _, name := range dirs {
+		result = append(result, bbFolderCloneStep{bbCloneCreateDir, name})
+	}
+	for _, name := range files {
+		result = append(result, bbFolderCloneStep{bbCloneCopyFile, name})
+	}
+	result = append(result, bbFolderCloneStep{bbCloneVerifyTree, intent.Source})
+	caseOnly := bbFoldPath(intent.Source) == bbFoldPath(intent.Path) && path.Dir(intent.Source) == path.Dir(intent.Path)
+	if !caseOnly {
+		result = append(result, bbFolderCloneStep{bbClonePublish, intent.Source})
+	}
+	for _, name := range files {
+		result = append(result, bbFolderCloneStep{bbCloneRetire, name})
+	}
+	for i := len(dirs) - 1; i >= 0; i-- {
+		result = append(result, bbFolderCloneStep{bbCloneRetire, dirs[i]})
+	}
+	if caseOnly {
+		result = append(result, bbFolderCloneStep{bbClonePublish, intent.Source})
+	}
+	return append(result, bbFolderCloneStep{bbCloneRetireStage, ""}), nil
+}
