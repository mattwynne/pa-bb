+package bisync
+
+import (
+	"context"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/text/cases"
+	"golang.org/x/text/unicode/norm"
+)
+
+// During an unconfirmed publication the scheduled scan retains the previous
+// observations of affected paths. Queue construction must never see them as
+// differences, and the next successful scan must still compare against the
+// original baseline.
+type bbRelocationHold struct {
+	files map[string]bool
+	trees map[string]bool
+}
+
+func (h *bbRelocationHold) holdsReceipt(r BBDeliveryReceipt) bool {
+	return h.includes(r.Path) || h.includes(r.RemovedPath)
+}
+
+var bbPathCase = cases.Fold()
+
+func bbFoldPath(name string) string {
+	return bbPathCase.String(norm.NFC.String(name))
+}
+
+func (h *bbRelocationHold) includes(name string) bool {
+	if h == nil || name == "" {
+		return false
+	}
+	key := bbFoldPath(name)
+	if h.files[key] {
+		return true
+	}
+	// Conflict copies are associated with the same logical note.
+	suffix := strings.LastIndex(key, ".md.")
+	if suffix >= 0 && h.files[key[:suffix+3]] {
+		return true
+	}
+	for parent := key; parent != "."; parent = path.Dir(parent) {
+		if h.trees[parent] {
+			return true
+		}
+		if parent == "/" {
+			break
+		}
+	}
+	return false
+}
+
+func (h *bbRelocationHold) retain(previous, current *fileList) *fileList {
+	retained := newFileList()
+	retained.hash = current.hash
+	for _, name := range current.list {
+		if !h.includes(name) {
+			current.getPut(name, retained)
+		}
+	}
+	for _, name := range previous.list {
+		if h.includes(name) {
+			previous.getPut(name, retained)
+		}
+	}
+	return retained
+}
+
+func (b *bisyncRun) holdBBPublications(ctx context.Context, state bbDeliveryStore) error {
+	if b.march.bbIdentities == nil || b.opt.RemoveEmptyDirs || fs.GetConfig(ctx).TrackRenames {
+		return ErrBBDeliveryUnsettled
+	}
+	pending := state.Pending
+	if pending != nil && (state.PendingData == nil ||
+		(!pending.Create && state.PendingDocument == "") ||
+		(pending.Create && state.Dispatched && state.AllocatedDocument == "")) {
+		// A legacy record without matching proof cannot identify a
+		// publication that may have moved after its response was lost.
+		return ErrBBDeliveryUnsettled
+	}
+	cloud, err := b.loadListing(b.listing1)
+	if err != nil {
+		return err
+	}
+	local, err := b.loadListing(b.listing2)
+	if err != nil {
+		return err
+	}
+	for _, name := range b.march.ls1.list {
+		if !b.march.ls1.isDir(name) && b.march.bbIdentities[name].DocumentID == "" {
+			// An item without an identity could be a later name for one of
+			// the affected documents. Do not construct a partial queue.
+			return ErrBBDeliveryUnsettled
+		}
+	}
+	held := &bbRelocationHold{files: map[string]bool{}, trees: map[string]bool{}}
+	folder := state.FolderMove
+	var folderDocuments map[string]bool
+	if folder != nil {
+		folderDocuments = make(map[string]bool, len(folder.Intent.Entries))
+		for _, entry := range folder.Intent.Entries {
+			folderDocuments[entry.DocumentID] = true
+		}
+		for _, entry := range folder.Copies {
+			folderDocuments[entry.DocumentID] = true
+		}
+		for _, name := range []string{folder.Intent.Source, folder.Intent.Path} {
+			held.trees[bbFoldPath(name)] = true
+			held.trees[bbFoldPath(b.aliases.Alias(name))] = true
+		}
+		for name, version := range b.march.bbCloudDirs {
+			if version.DocumentID == "" {
+				return ErrBBDeliveryUnsettled
+			}
+			if folderDocuments[version.DocumentID] {
+				held.trees[bbFoldPath(name)] = true
+				held.trees[bbFoldPath(b.aliases.Alias(name))] = true
+			}
+		}
+	}
+	clone := state.FolderClone
+	var cloneDocuments map[string]bool
+	if clone != nil {
+		cloneDocuments = make(map[string]bool, len(clone.Intent.Entries)+len(clone.Copies)+1)
+		if clone.Stage != nil {
+			cloneDocuments[clone.Stage.DocumentID] = true
+		}
+		for _, entry := range clone.Intent.Entries {
+			cloneDocuments[entry.DocumentID] = true
+		}
+		for _, copy := range clone.Copies {
+			cloneDocuments[copy.DocumentID] = true
+		}
+		for _, name := range []string{clone.Intent.Source, clone.Intent.Path, clone.StageName()} {
+			held.trees[bbFoldPath(name)] = true
+			held.trees[bbFoldPath(b.aliases.Alias(name))] = true
+		}
+		for name, version := range b.march.bbCloudDirs {
+			if version.DocumentID == "" {
+				return ErrBBDeliveryUnsettled
+			}
+			if cloneDocuments[version.DocumentID] {
+				held.trees[bbFoldPath(name)] = true
+				held.trees[bbFoldPath(b.aliases.Alias(name))] = true
+			}
+		}
+	}
+	if len(state.AbandonedStages) > 0 {
+		stages := make(map[string]bool, len(state.AbandonedStages))
+		for _, stage := range state.AbandonedStages {
+			stages[stage.Folder.DocumentID] = true
+			for _, name := range []string{stage.name(), b.aliases.Alias(stage.name())} {
+				held.trees[bbFoldPath(name)] = true
+			}
+		}
+		for name, version := range b.march.bbCloudDirs {
+			if version.DocumentID == "" {
+				return ErrBBDeliveryUnsettled
+			}
+			if stages[version.DocumentID] {
+				held.trees[bbFoldPath(name)] = true
+				held.trees[bbFoldPath(b.aliases.Alias(name))] = true
+			}
+		}
+	}
+	var paths []string
+	move := state.Relocation
+	if move != nil {
+		paths = append(paths, move.heldPaths()...)
+	}
+	if pending != nil {
+		paths = append(paths, pending.Path)
+	}
+	for name, observation := range b.march.bbIdentities {
+		id := observation.DocumentID
+		if folderDocuments[id] || cloneDocuments[id] || (move != nil && move.hasProviderDocument(id)) ||
+			(pending != nil && ((!pending.Create && id == state.PendingDocument) ||
+				(pending.Create && state.AllocatedDocument != "" && bbAllocatedDocumentID(id) == state.AllocatedDocument))) {
+			paths = append(paths, name)
+		}
+	}
+	for _, name := range paths {
+		for _, related := range []string{name, b.aliases.Alias(name)} {
+			held.files[bbFoldPath(related)] = true
+			for dir := path.Dir(related); dir != "." && dir != "/"; dir = path.Dir(dir) {
+				if b.opt.CreateEmptySrcDirs && (!cloud.isDir(dir) || !local.isDir(dir) ||
+					!b.march.ls1.isDir(dir) || !b.march.ls2.isDir(dir)) {
+					// Directory creation/removal must not act on an incomplete
+					// subtree. Preserve that ancestor and all its contents.
+					held.trees[bbFoldPath(dir)] = true
+				}
+			}
+		}
+	}
+	// Retain the real provider metadata internally only long enough to
+	// identify affected files. Never advertise a held alias as an
+	// acknowledged baseline for another fast operation.
+	for name := range b.march.bbIdentities {
+		if held.includes(name) {
+			delete(b.march.bbIdentities, name)
+		}
+	}
+	b.march.ls1 = held.retain(cloud, b.march.ls1)
+	b.march.ls2 = held.retain(local, b.march.ls2)
+	if err := b.march.ls1.save(b.newListing1); err != nil {
+		return err
+	}
+	if err := b.march.ls2.save(b.newListing2); err != nil {
+		return err
+	}
+	b.bbHeldRelocation = held
+	fs.Infof(nil, "An iCloud publication is awaiting verification. Unrelated paths continue through scheduled sync.")
+	return nil
+}
