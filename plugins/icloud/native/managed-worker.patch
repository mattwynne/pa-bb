+package iclouddrive
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"io"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"golang.org/x/text/unicode/norm"
+)
+
+const bbMarkdownLimit = 1 << 20
+
+// A revision represents the document and cloud version already acknowledged
+// by this mirror. A file recreated at the same path is a different document,
+// even if its content is byte-identical.
+type BBNoteRevision struct {
+	DriveID  string
+	ParentID string
+	ETag     string
+	Hash     [sha256.Size]byte
+}
+
+type BBNotePublication struct {
+	Revision BBNoteRevision
+	Modified time.Time
+	Size     int64
+}
+
+// ReplaceBBNote uses an already-authenticated, scope-bound filesystem selected
+// by the BB worker. This method is not a stock backend command.
+func (f *Fs) ReplaceBBNote(ctx context.Context, remote string, base BBNoteRevision, data []byte) (BBNotePublication, error) {
+	return f.ReplaceBBNoteWithDispatch(ctx, remote, base, data, nil)
+}
+
+func (f *Fs) ReplaceBBNoteWithDispatch(ctx context.Context, remote string, base BBNoteRevision, data []byte, dispatch func() error) (BBNotePublication, error) {
+	var out BBNotePublication
+	if !validBBIntent(remote, base, data) {
+		return out, api.ErrConditionalRefused
+	}
+	original, previous, err := f.readBBNoteRevision(ctx, remote)
+	if err != nil || !bbRevisionMatches(base, original, previous) {
+		return out, api.ErrConditionalConflict
+	}
+
+	zone := api.ZoneFromDriveID(original.Drivewsid)
+	name := original.FullName()
+	slot, _, err := f.service.CreateUpload(ctx, int64(len(data)), name, zone)
+	if err != nil || slot == nil || slot.URL == "" {
+		return out, api.ErrConditionalRefused
+	}
+	upload, _, err := f.service.Upload(ctx, bytes.NewReader(data), int64(len(data)), name, slot.URL)
+	if err != nil || upload == nil || upload.SingleFile == nil ||
+		upload.SingleFile.Size != int64(len(data)) || upload.SingleFile.Signature == "" {
+		return out, api.ErrConditionalRefused
+	}
+
+	// Open a new exact-name observation after staging. Keep the initial
+	// revision as the conditional version in the publication itself.
+	before, beforeBytes, err := f.readBBNoteRevision(ctx, remote)
+	if err != nil || !bbRevisionMatches(base, before, beforeBytes) {
+		return out, api.ErrConditionalConflict
+	}
+	if dispatch != nil {
+		if err := dispatch(); err != nil {
+			return out, api.ErrConditionalUnconfirmed
+		}
+	}
+	published, publishErr := f.service.PublishConditionalNote(ctx, *original, base.ParentID, name, *upload.SingleFile, time.Now())
+	if errors.Is(publishErr, api.ErrConditionalConflict) || errors.Is(publishErr, api.ErrConditionalRefused) {
+		return out, publishErr
+	}
+	updated, uploaded, err := f.readBBNoteRevision(ctx, remote)
+	if err != nil || !sameBBIdentity(base, updated) || updated.Etag == base.ETag ||
+		(published != nil && published.Etag != "" && published.Etag != updated.Etag) || !bytes.Equal(data, uploaded) {
+		return out, api.ErrConditionalUnconfirmed
+	}
+	return BBNotePublication{
+		Revision: BBNoteRevision{updated.Drivewsid, updated.ParentID, updated.Etag, sha256.Sum256(data)},
+		Modified: updated.DateModified,
+		Size:     int64(len(data)),
+	}, nil
+}
+
+func validBBIntent(remote string, base BBNoteRevision, data []byte) bool {
+	return remote != "." && path.Clean(remote) == remote && !path.IsAbs(remote) &&
+		!strings.HasPrefix(remote, "../") && !strings.ContainsAny(remote, "\\\x00\r\n") &&
+		strings.HasSuffix(remote, ".md") &&
+		base.DriveID != "" && base.ParentID != "" && base.ETag != "" && len(data) > 0 && len(data) <= bbMarkdownLimit
+}
+
+func sameBBIdentity(base BBNoteRevision, item *api.DriveItem) bool {
+	return item != nil && item.Drivewsid == base.DriveID && item.ParentID == base.ParentID && item.Etag != ""
+}
+
+func bbRevisionMatches(base BBNoteRevision, item *api.DriveItem, data []byte) bool {
+	return sameBBIdentity(base, item) && item.Etag == base.ETag && sha256.Sum256(data) == base.Hash
+}
+
+func (f *Fs) readBBNoteRevision(ctx context.Context, remote string) (*api.DriveItem, []byte, error) {
+	leaf, folder, _, err := f.FindPath(ctx, remote, false)
+	if err != nil {
+		return nil, nil, err
+	}
+	// The name and parent identity are checked again after the directory lookup.
+	item, found, err := f.findLeafItem(ctx, folder, leaf)
+	if err != nil || !found || item == nil || item.ParentID != folder || item.Type != "FILE" ||
+		norm.NFC.String(item.FullName()) != norm.NFC.String(leaf) || item.Etag == "" || item.Size < 1 || item.Size > bbMarkdownLimit {
+		return nil, nil, api.ErrConditionalConflict
+	}
+	obj, err := f.NewObjectFromDriveItem(ctx, remote, item)
+	if err != nil {
+		return nil, nil, err
+	}
+	stream, err := obj.Open(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer stream.Close()
+	data, err := io.ReadAll(io.LimitReader(stream, bbMarkdownLimit+1))
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(data) > bbMarkdownLimit || int64(len(data)) != item.Size {
+		return nil, nil, api.ErrConditionalUnconfirmed
+	}
+	return item, data, nil
+}
+
+// BBListedIdentity exposes the provider revision already present in the
+// directory response. It does not query or download note contents.
+func (o *Object) BBListedIdentity() (driveID, parentID, etag string) {
+	return o.driveID, o.bbParentID, o.etag
+}
+
+// BBMirrorBinding reports the authenticated root's exact provider identity.
+func (f *Fs) BBMirrorBinding(ctx context.Context) (string, error) {
+	if f.name != "icloud" || f.root == "" {
+		return "", api.ErrConditionalRefused
+	}
+	folder, _, err := f.FindDir(ctx, "", false)
+	if err != nil {
+		return "", api.ErrConditionalUnconfirmed
+	}
+	kind, zone, doc := api.DeconstructDriveID(folder)
+	if (kind != "FOLDER" && kind != "APP_LIBRARY") || zone == "" || doc == "" {
+		return "", api.ErrConditionalRefused
+	}
+	return folder, nil
+}
+
+// InspectBBNote reads only the bound note and projects its current revision.
+func (f *Fs) InspectBBNote(ctx context.Context, remote string) (BBNotePublication, error) {
+	placeholder := BBNoteRevision{DriveID: "scope", ParentID: "scope", ETag: "scope"}
+	if !validBBIntent(remote, placeholder, []byte{1}) {
+		return BBNotePublication{}, api.ErrConditionalRefused
+	}
+	item, contents, err := f.readBBNoteRevision(ctx, remote)
+	if err != nil {
+		return BBNotePublication{}, err
+	}
+	return BBNotePublication{Revision: BBNoteRevision{item.Drivewsid, item.ParentID, item.Etag, sha256.Sum256(contents)},
+		Modified: item.DateModified, Size: item.Size}, nil
+}
