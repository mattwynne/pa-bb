+package iclouddrive
+
+import (
+	"crypto/sha256"
+	"testing"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+)
+
+func TestBBRevisionRejectsSameNameRecreation(t *testing.T) {
+	bytes := []byte("# Existing note\n")
+	base := BBNoteRevision{"existing-drive-id", "existing-parent", "etag-1", sha256.Sum256(bytes)}
+	item := api.DriveItem{Drivewsid: base.DriveID, ParentID: base.ParentID, Etag: base.ETag}
+	if !bbRevisionMatches(base, &item, bytes) {
+		t.Fatal("matching revision rejected")
+	}
+	changed := item
+	changed.Drivewsid = "recreated-drive-id"
+	if bbRevisionMatches(base, &changed, bytes) {
+		t.Fatal("a same-name recreation matched prior identity")
+	}
+	changed = item
+	changed.ParentID = "different-parent"
+	if bbRevisionMatches(base, &changed, bytes) {
+		t.Fatal("a different parent matched prior identity")
+	}
+	changed = item
+	changed.Etag = "etag-2"
+	if bbRevisionMatches(base, &changed, bytes) {
+		t.Fatal("a later ETag matched")
+	}
+	if bbRevisionMatches(base, &item, []byte("# Changed bytes\n")) {
+		t.Fatal("different bytes matched")
+	}
+	for _, invalid := range []string{"../other.md", "/absolute.md", "folder/../note.md", "other.txt", "embedded\nname.md"} {
+		if validBBIntent(invalid, base, bytes) {
+			t.Fatal("unexpected valid path")
+		}
+	}
+	if !validBBIntent("Vault/Note.md", base, bytes) {
+		t.Fatal("valid note rejected")
+	}
+}
