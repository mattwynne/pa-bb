+package bisync
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+
+	"golang.org/x/sys/unix"
+)
+
+const bbWriterLockName = "bb-managed-writer.lock"
+const bbTransferLeaseName = "bb-managed-transfer.lock"
+const bbTransferScopeName = "bb-managed-transfer-scope.json"
+
+type bbTransferPhase struct {
+	journal func() error
+	lease   func() error
+}
+
+func bbTryPhaseFile(path string, mode int) (func() error, error) {
+	fd, err := bbOpenPhaseFile(path)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Flock(fd, mode|unix.LOCK_NB); err != nil {
+		unix.Close(fd)
+		return nil, err
+	}
+	return func() error { return unix.Close(fd) }, nil
+}
+
+// The caller already owns the primary scheduled mutation lock. The journal
+// lock serializes its reads and writes with any admitted expedited mutation.
+func bbBeginTransferPhase(ctx context.Context, workdir string) (*bbTransferPhase, error) {
+	journal, err := bbAcquireMutationPhase(ctx, filepath.Join(workdir, bbWriterLockName))
+	if err != nil {
+		return nil, err
+	}
+	return &bbTransferPhase{journal: journal}, nil
+}
+
+func (phase *bbTransferPhase) open(workdir string, paths *bbTransferPlan) error {
+	if phase == nil || paths == nil || (len(paths.Replacements) == 0 && len(paths.Parents) == 0) {
+		return nil
+	}
+	raw, err := json.Marshal(paths)
+	if err != nil {
+		return err
+	}
+	if len(raw) > bbIndexLimit {
+		return nil
+	}
+	owner := bbListingPair{directory: workdir}
+	if err := owner.publishFile(filepath.Join(workdir, bbTransferScopeName), raw, false); err != nil {
+		return err
+	}
+	phase.lease, err = bbTryPhaseFile(filepath.Join(workdir, bbTransferLeaseName), unix.LOCK_EX)
+	if err != nil {
+		return err
+	}
+	release := phase.journal
+	phase.journal = nil
+	return release()
+}
+
+func (phase *bbTransferPhase) drain(ctx context.Context, workdir string) error {
+	if phase == nil || phase.lease == nil {
+		return nil
+	}
+	release := phase.lease
+	phase.lease = nil
+	// Stop admitting new writes before waiting for the current journal owner.
+	if err := release(); err != nil {
+		return err
+	}
+	var err error
+	phase.journal, err = bbAcquireMutationPhase(ctx, filepath.Join(workdir, bbWriterLockName))
+	return err
+}
+
+func (phase *bbTransferPhase) close() error {
+	var leaseErr, journalErr error
+	if phase.lease != nil {
+		leaseErr = phase.lease()
+	}
+	if phase.journal != nil {
+		journalErr = phase.journal()
+	}
+	return errors.Join(leaseErr, journalErr)
+}
+
+// Acquire the journal lock first for every expedited mutation. If the normal
+// mutation lock is busy, only an exact replacement listed by a live scheduled
+// transfer may proceed. After a process crash the file can remain, but the
+// kernel releases its lease and the scope alone authorizes no request.
+func BBTryTransferWriteAdmission(workdir, name, document, parent string, tryPrimary func() bool) (func() error, bool) {
+	release, _, admitted := bbTryWriteAdmission(workdir, tryPrimary, func(plan bbTransferPlan) (string, bool) {
+		return "", name != "" && document != "" && parent != "" &&
+			plan.Replacements[name] == (bbTransferIdentity{document, parent})
+	})
+	return release, admitted
+}
+
+// The exact provider parent is returned only for a lease-scoped
+// placement. With the ordinary lock, the normal create checks apply.
+func BBTryTransferCreationAdmission(workdir, name string, tryPrimary func() bool) (func() error, string, bool) {
+	return bbTryWriteAdmission(workdir, tryPrimary, func(plan bbTransferPlan) (string, bool) {
+		parent := plan.creationParent(name)
+		return parent, parent != ""
+	})
+}
+
+func bbTryWriteAdmission(workdir string, tryPrimary func() bool, selectPath func(bbTransferPlan) (string, bool)) (release func() error, expectedParent string, admitted bool) {
+	if tryPrimary == nil {
+		return nil, "", false
+	}
+	journal, err := bbTryPhaseFile(filepath.Join(workdir, bbWriterLockName), unix.LOCK_EX)
+	if err != nil {
+		return nil, "", false
+	}
+	defer func() {
+		if !admitted {
+			_ = journal()
+		}
+	}()
+	if tryPrimary() {
+		return journal, "", true
+	}
+	probe, err := bbTryPhaseFile(filepath.Join(workdir, bbTransferLeaseName), unix.LOCK_SH)
+	if err == nil {
+		_ = probe()
+		return nil, "", false
+	}
+	if !errors.Is(err, unix.EWOULDBLOCK) {
+		return nil, "", false
+	}
+	raw, err := bbReadBounded(filepath.Join(workdir, bbTransferScopeName), bbIndexLimit)
+	if err != nil {
+		return nil, "", false
+	}
+	var plan bbTransferPlan
+	if json.Unmarshal(raw, &plan) != nil {
+		return nil, "", false
+	}
+	expectedParent, allowed := selectPath(plan)
+	if !allowed {
+		return nil, "", false
+	}
+	return journal, expectedParent, true
+}
