+package bisync
+
+import (
+	"context"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/cmd/bisync/bilib"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/filter"
+)
+
+type bbTransferIdentity struct {
+	DocumentID string `json:"documentId"`
+	ParentID   string `json:"parentId"`
+}
+
+// Paths in the pending operations are excluded even when the latest
+// listing did not see an item with that name. Existing keeps new-note
+// admission to names absent from both observations made by this scan.
+type bbTransferPlan struct {
+	Replacements   map[string]bbTransferIdentity `json:"replacements,omitempty"`
+	Parents        map[string]string             `json:"parents,omitempty"`
+	Existing       map[string]bool               `json:"existing,omitempty"`
+	Blocked        map[string]bool               `json:"blocked,omitempty"`
+	BlockedParents map[string]bool               `json:"blockedParents,omitempty"`
+	HeldFiles      map[string]bool               `json:"heldFiles,omitempty"`
+	HeldTrees      map[string]bool               `json:"heldTrees,omitempty"`
+}
+
+func (plan bbTransferPlan) overlaps(name string) bool {
+	key := bbFoldPath(name)
+	if plan.BlockedParents[key] {
+		return true
+	}
+	for at := key; at != "." && at != "/"; at = path.Dir(at) {
+		if plan.Blocked[at] {
+			return true
+		}
+	}
+	return false
+}
+
+func (plan bbTransferPlan) creationParent(name string) string {
+	if !strings.HasSuffix(name, ".md") || !validBBFolderPath(name) || plan.Existing[bbFoldPath(name)] || plan.overlaps(name) {
+		return ""
+	}
+	held := bbRelocationHold{files: plan.HeldFiles, trees: plan.HeldTrees}
+	if held.includes(name) {
+		return ""
+	}
+	return plan.Parents[path.Dir(name)]
+}
+
+// Explicit file filters and the observed aliases bound the two scheduled
+// copy queues. Also exclude ancestors and descendants of affected paths:
+// an entry changing between file and directory can otherwise cross the filter.
+func (b *bisyncRun) bbTransferScope(ctx context.Context, queues ...bilib.Names) *bbTransferPlan {
+	ci := fs.GetConfig(ctx)
+	if !b.opt.bbReadVersions || b.opt.RemoveEmptyDirs || ci.TrackRenames || ci.FixCase ||
+		ci.BackupDir != "" || ci.Suffix != "" || b.opt.BackupDir1 != "" || b.opt.BackupDir2 != "" ||
+		filter.GetConfig(ctx).Opt.DeleteExcluded || len(b.march.bbIdentities) == 0 || b.march.ls2 == nil {
+		return nil
+	}
+	scope := &bbTransferPlan{
+		Replacements:   make(map[string]bbTransferIdentity),
+		Parents:        make(map[string]string),
+		Existing:       make(map[string]bool),
+		Blocked:        make(map[string]bool),
+		BlockedParents: make(map[string]bool),
+	}
+	if b.bbHeldRelocation != nil {
+		scope.HeldFiles, scope.HeldTrees = b.bbHeldRelocation.files, b.bbHeldRelocation.trees
+	}
+	dirty, dirtyParents := scope.Blocked, scope.BlockedParents
+	mark := func(name string) {
+		key := bbFoldPath(name)
+		dirty[key] = true
+		for parent := path.Dir(key); parent != "." && parent != "/" && !dirtyParents[parent]; parent = path.Dir(parent) {
+			dirtyParents[parent] = true
+		}
+	}
+	markAliases := func(name string) {
+		mark(name)
+		mark(b.aliases.Alias(name))
+	}
+	for _, queue := range queues {
+		for name := range queue {
+			markAliases(name)
+		}
+	}
+	for name := range b.bbFolderChanges {
+		markAliases(name)
+	}
+	for name := range b.bbContentDeltas {
+		markAliases(name)
+	}
+
+	seen := make(map[string]bool)
+	for name := range b.march.bbLocalDirs {
+		seen[bbFoldPath(name)] = true
+	}
+	for _, name := range b.march.ls2.list {
+		if b.march.ls2.isDir(name) {
+			continue
+		}
+		key := bbFoldPath(name)
+		if seen[key] {
+			mark(name)
+		}
+		seen[key] = true
+	}
+	clear(seen)
+	for name := range b.march.bbCloudDirs {
+		seen[bbFoldPath(name)] = true
+	}
+	documents := make(map[string]string)
+	for name, identity := range b.march.bbIdentities {
+		if other, exists := documents[identity.DocumentID]; identity.DocumentID != "" && exists {
+			mark(name)
+			mark(other)
+		}
+		documents[identity.DocumentID] = name
+		key := bbFoldPath(name)
+		if seen[key] {
+			mark(name)
+		}
+		seen[key] = true
+	}
+
+	if b.opt.bbMirrorBinding != "" {
+		scope.Parents["."] = b.opt.bbMirrorBinding
+		for _, listing := range []*fileList{b.march.ls1, b.march.ls2} {
+			if listing == nil {
+				continue
+			}
+			for _, name := range listing.list {
+				scope.Existing[bbFoldPath(name)] = true
+			}
+		}
+		for name := range b.march.bbLocalDirs {
+			scope.Existing[bbFoldPath(name)] = true
+		}
+		cloudDirs := make(map[string]int)
+		for name := range b.march.bbCloudDirs {
+			key := bbFoldPath(name)
+			cloudDirs[key]++
+			scope.Existing[key] = true
+		}
+		for name, identity := range b.march.bbDirectories {
+			if cloudDirs[bbFoldPath(name)] == 1 && identity.DocumentID != "" && validBBFolderPath(name) &&
+				b.aliases.Alias(name) == name && !b.bbHeldRelocation.includes(name) {
+				scope.Parents[name] = identity.DocumentID
+			}
+		}
+	}
+	for name, seen := range b.march.bbIdentities {
+		if !strings.HasSuffix(name, ".md") || !validBBFolderPath(name) || seen.DocumentID == "" || seen.ParentID == "" ||
+			!b.march.ls2.has(name) || b.march.ls2.isDir(name) || b.aliases.Alias(name) != name ||
+			b.bbHeldRelocation.includes(name) || scope.overlaps(name) {
+			continue
+		}
+		scope.Replacements[name] = bbTransferIdentity{DocumentID: seen.DocumentID, ParentID: seen.ParentID}
+	}
+	return scope
+}
