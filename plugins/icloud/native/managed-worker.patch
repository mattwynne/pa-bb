+func TestBBTransferPhaseRequiresLiveExactScope(t *testing.T) {
+	ctx := t.Context()
+	workdir := t.TempDir()
+	phase, err := bbBeginTransferPhase(ctx, workdir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = phase.close() })
+	unavailable := func() bool { return false }
+	scope := &bbTransferPlan{Replacements: map[string]bbTransferIdentity{"Keep.md": {"document", "parent"}}}
+	denied := func(path, document, parent string) {
+		t.Helper()
+		if release, admitted := BBTryTransferWriteAdmission(workdir, path, document, parent, unavailable); admitted {
+			_ = release()
+			t.Fatalf("unexpectedly admitted %q", path)
+		}
+	}
+	denied("Keep.md", "document", "parent")
+	if err := phase.open(workdir, scope); err != nil {
+		t.Fatal(err)
+	}
+	denied("keep.md", "document", "parent")
+	denied("Keep.md", "wrong", "parent")
+	denied("Keep.md", "document", "wrong")
+	denied("Unset.md", "document", "parent")
+	denied("", "", "")
+	release, admitted := BBTryTransferWriteAdmission(workdir, "Keep.md", "document", "parent", unavailable)
+	if !admitted {
+		t.Fatal("the live exact scope was refused")
+	}
+	defer func() {
+		if release != nil {
+			_ = release()
+		}
+	}()
+	denied("Keep.md", "document", "parent")
+	// The scheduled owner closes admission before waiting for the active
+	// writer. A cancelled drain must never leave the scope live.
+	cancelCtx, cancel := context.WithTimeout(ctx, 25*time.Millisecond)
+	defer cancel()
+	if err := phase.drain(cancelCtx, workdir); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("drain while write owns journal = %v", err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	release = nil
+	if _, err := bbReadBounded(filepath.Join(workdir, bbTransferScopeName), bbIndexLimit); err != nil {
+		t.Fatal("test needs the stale scope left in place", err)
+	}
+	denied("Keep.md", "document", "parent")
+	normal, admitted := BBTryTransferWriteAdmission(workdir, "", "", "", func() bool { return true })
+	if !admitted {
+		t.Fatal("normal primary admission stopped working")
+	}
+	defer normal()
+	denied("Keep.md", "document", "parent")
+}
+
+type bbPhaseVersionedCloud struct {
+	fs.Fs
+}
+
+func (cloud bbPhaseVersionedCloud) List(ctx context.Context, name string) (fs.DirEntries, error) {
+	entries, err := cloud.Fs.List(ctx, name)
+	for i, entry := range entries {
+		if object, ok := entry.(fs.Object); ok {
+			entries[i] = bbPhaseVersionedObject{object}
+		}
+	}
+	return entries, err
+}
+
+func (cloud bbPhaseVersionedCloud) NewObject(ctx context.Context, name string) (fs.Object, error) {
+	object, err := cloud.Fs.NewObject(ctx, name)
+	if err != nil {
+		return nil, err
+	}
+	return bbPhaseVersionedObject{object}, nil
+}
+
+type bbPhaseVersionedObject struct {
+	fs.Object
+}
+
+func (object bbPhaseVersionedObject) BBListedIdentity() (string, string, string) {
+	return "document-" + object.Remote(), "parent", object.ModTime(context.Background()).String()
+}
