+package bisync
+
+import (
+	"crypto/sha256"
+	"maps"
+	"path"
+	"slices"
+	"strings"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+const bbFolderMoveVersion = 9
+
+// BBFolderMoveIntent records the previously shared source tree and the one
+// destination that the confirmed Obsidian move selected. The stable provider
+// IDs let reconciliation track a later cloud rename without reusing its name.
+type BBFolderMoveIntent struct {
+	OperationID       string
+	Binding           string
+	Source            string
+	Path              string
+	DestinationParent string
+	Entries           map[string]BBTreeIdentity
+	Hashes            map[string][sha256.Size]byte
+}
+
+type BBFolderMove struct {
+	Intent            BBFolderMoveIntent
+	Dispatched        bool
+	Published         *BBIndexedVersion           `json:",omitempty"`
+	BaselineInstalled bool                        `json:",omitempty"`
+	Copies            map[string]BBIndexedVersion `json:",omitempty"`
+}
+
+type bbFolderPublication struct {
+	OperationID string
+	Binding     string
+	Source      string
+	Path        string
+	Published   BBIndexedVersion
+	Rejected    bool `json:",omitempty"`
+	// Nil is a receipt from before direct, same-parent renames were supported.
+	Copied *bool `json:",omitempty"`
+}
+
+func (record bbFolderPublication) valid() bool {
+	return bbOperationID.MatchString(record.OperationID) && record.Binding != "" &&
+		validBBFolderPath(record.Source) && validBBFolderPath(record.Path) &&
+		record.Source != record.Path &&
+		(bbFoldPath(record.Source) != bbFoldPath(record.Path) || path.Dir(record.Source) == path.Dir(record.Path)) &&
+		((record.Rejected && record.Published == (BBIndexedVersion{})) ||
+			(!record.Rejected && record.Published.DocumentID != "" && record.Published.ParentID != "" && record.Published.ETag != ""))
+}
+
+func BBFolderMoveOutcome(workdir, operationID, binding, source, target string) (*BBIndexedVersion, bool, bool, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return nil, false, false, err
+	}
+	for _, record := range state.FinishedFolders {
+		if record.OperationID != operationID {
+			continue
+		}
+		if record.Binding != binding || record.Source != source || record.Path != target {
+			return nil, false, false, errBBInvalidDelivery
+		}
+		if record.Rejected {
+			return nil, true, false, nil
+		}
+		copied := path.Base(source) != path.Base(target)
+		if record.Copied != nil {
+			copied = *record.Copied
+		}
+		return &record.Published, false, copied, nil
+	}
+	return nil, false, false, nil
+}
+
+func validBBFolderPath(name string) bool {
+	return name != "" && name != "." && name != ".." && len(name) <= 1024 && path.Clean(name) == name &&
+		!path.IsAbs(name) && !strings.HasPrefix(name, "../") && norm.NFC.String(name) == name &&
+		strings.IndexFunc(name, func(r rune) bool { return r < 32 || r == 127 || r == '\\' }) < 0
+}
+
+func validBBFolderMoveIntent(intent BBFolderMoveIntent) bool {
+	return validBBFolderTransition(intent, false)
+}
+
+func validBBFolderTransition(intent BBFolderMoveIntent, clone bool) bool {
+	if !bbOperationID.MatchString(intent.OperationID) || intent.Binding == "" || intent.DestinationParent == "" ||
+		!validBBFolderPath(intent.Source) || !validBBFolderPath(intent.Path) || intent.Source == intent.Path ||
+		(!clone && path.Dir(intent.Source) != path.Dir(intent.Path) && path.Base(intent.Source) != path.Base(intent.Path)) ||
+		(clone && path.Base(intent.Source) == path.Base(intent.Path)) ||
+		len(intent.Entries) == 0 || len(intent.Entries) > 10001 {
+		return false
+	}
+	from, to := bbFoldPath(intent.Source), bbFoldPath(intent.Path)
+	if (from == to && path.Dir(intent.Source) != path.Dir(intent.Path)) ||
+		strings.HasPrefix(from, to+"/") || strings.HasPrefix(to, from+"/") {
+		return false
+	}
+	root := intent.Entries[intent.Source]
+	sameParent := path.Dir(intent.Source) == path.Dir(intent.Path)
+	if !root.Directory || (!clone && (root.ParentID == intent.DestinationParent) != sameParent) || root.DocumentID == intent.DestinationParent ||
+		root.DocumentID == intent.Binding {
+		return false
+	}
+	if len(intent.Hashes) > len(intent.Entries)-1 {
+		return false
+	}
+	ids := make(map[string]bool, len(intent.Entries))
+	paths := make(map[string]bool, len(intent.Entries))
+	files := 0
+	for name, entry := range intent.Entries {
+		fold := bbFoldPath(name)
+		if !validBBFolderPath(name) || paths[fold] || (name != intent.Source && !strings.HasPrefix(name, intent.Source+"/")) ||
+			ids[entry.DocumentID] || entry.DocumentID == "" || entry.ParentID == "" || entry.ETag == "" ||
+			entry.DocumentID == intent.DestinationParent {
+			return false
+		}
+		if name != intent.Source {
+			parent := intent.Entries[path.Dir(name)]
+			if !parent.Directory || parent.DocumentID != entry.ParentID {
+				return false
+			}
+		}
+		digest, hasHash := intent.Hashes[name]
+		if entry.Directory == hasHash || (hasHash && digest == ([sha256.Size]byte{})) {
+			return false
+		}
+		if hasHash {
+			files++
+		}
+		ids[entry.DocumentID] = true
+		paths[fold] = true
+	}
+	return !ids[root.ParentID] && files == len(intent.Hashes)
+}
+
+func (move BBFolderMove) valid() bool {
+	cloned := len(move.Copies) > 0
+	if !validBBFolderTransition(move.Intent, cloned) {
+		return false
+	}
+	if move.Published == nil {
+		return !move.BaselineInstalled && !cloned
+	}
+	root := move.providerFor(move.Intent.Source)
+	if !move.Dispatched || !validBBCloneIdentity(*move.Published) || move.Published.DocumentID != root.DocumentID ||
+		move.Published.ParentID != move.Intent.DestinationParent {
+		return false
+	}
+	if !cloned {
+		return true
+	}
+	if len(move.Copies) != len(move.Intent.Entries) || root != *move.Published {
+		return false
+	}
+	identities := make(map[string]bool, len(move.Copies)+len(move.Intent.Entries))
+	for _, original := range move.Intent.Entries {
+		identities[original.DocumentID] = true
+	}
+	identities[move.Intent.Binding] = true
+	for name, copied := range move.Copies {
+		if _, known := move.Intent.Entries[name]; !known || !validBBCloneIdentity(copied) || identities[copied.DocumentID] ||
+			(name != move.Intent.Source && copied.ParentID != move.Copies[path.Dir(name)].DocumentID) {
+			return false
+		}
+		identities[copied.DocumentID] = true
+	}
+	return true
+}
+
+func (move BBFolderMove) providerFor(source string) BBIndexedVersion {
+	if len(move.Copies) != 0 {
+		return move.Copies[source]
+	}
+	return move.Intent.Entries[source].BBIndexedVersion
+}
+
+func (move BBFolderMove) overlaps(notePath string, documents ...string) bool {
+	wanted := bbFoldPath(notePath)
+	for _, folder := range []string{move.Intent.Source, move.Intent.Path} {
+		root := bbFoldPath(folder)
+		if wanted == root || strings.HasPrefix(wanted, root+"/") {
+			return true
+		}
+	}
+	if len(documents) != 0 {
+		for _, entry := range move.Intent.Entries {
+			if slices.Contains(documents, entry.DocumentID) {
+				return true
+			}
+		}
+		for _, entry := range move.Copies {
+			if slices.Contains(documents, entry.DocumentID) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// A confirmed identity-preserving move proves the original document at its
+// new exact path while the scheduled scan still holds the old index.
+func (move BBFolderMove) movedFile(target string) (BBIndexedVersion, [sha256.Size]byte, bool) {
+	if move.Published == nil || !strings.HasPrefix(target, move.Intent.Path+"/") {
+		return BBIndexedVersion{}, [sha256.Size]byte{}, false
+	}
+	old := move.Intent.Source + strings.TrimPrefix(target, move.Intent.Path)
+	entry := move.Intent.Entries[old]
+	digest, exists := move.Intent.Hashes[old]
+	return move.providerFor(old), digest, exists && !entry.Directory && entry.DocumentID != ""
+}
+
+func BBMovedNoteBaseline(workdir, binding, target string) (BBIndexedVersion, [sha256.Size]byte, bool) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil || state.FolderMove == nil || state.FolderMove.Intent.Binding != binding {
+		return BBIndexedVersion{}, [sha256.Size]byte{}, false
+	}
+	return state.FolderMove.movedFile(target)
+}
+
+func (move BBFolderMove) permitsReplacement(intent BBDeliveryIntent, knownDocument []string) bool {
+	entry, _, exists := move.movedFile(intent.Path)
+	return !intent.Create && exists && len(knownDocument) == 1 && entry.DocumentID == knownDocument[0]
+}
+
+func (move BBFolderMove) newNoteParent(intent BBDeliveryIntent) string {
+	if !intent.Create || move.Published == nil || !strings.HasPrefix(intent.Path, move.Intent.Path+"/") {
+		return ""
+	}
+	original := move.Intent.Source + strings.TrimPrefix(intent.Path, move.Intent.Path)
+	// A same-fold sibling might be a different spelling of a prior note
+	// rather than a new item. The full proof forbids treating it as vacant.
+	for name := range move.Intent.Entries {
+		if bbFoldPath(name) == bbFoldPath(original) {
+			return ""
+		}
+	}
+	parent := path.Dir(original)
+	entry := move.Intent.Entries[parent]
+	if !entry.Directory {
+		return ""
+	}
+	if parent == move.Intent.Source {
+		return move.Published.DocumentID
+	}
+	return move.providerFor(parent).DocumentID
+}
+
+// BBExpectedCreationParent returns the durable parent from a pending note,
+// or the exact parent a completed folder move can prove for a new note.
+// A known but unacknowledged or differently spelled move is a held scope.
+func BBExpectedCreationParent(workdir, binding string, intent BBDeliveryIntent) (string, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return "", err
+	}
+	if !intent.Create || !validBBDelivery(intent) {
+		return "", errBBInvalidDelivery
+	}
+	if state.Pending != nil && *state.Pending == intent && state.PendingCreateParent != "" {
+		return state.PendingCreateParent, nil
+	}
+	if state.FolderClone != nil && state.FolderClone.overlaps(intent.Path) {
+		return "", ErrBBDeliveryUnsettled
+	}
+	move := state.FolderMove
+	if move == nil || !move.overlaps(intent.Path) {
+		return "", nil
+	}
+	if move.Intent.Binding != binding {
+		return "", ErrBBDeliveryUnsettled
+	}
+	parent := move.newNoteParent(intent)
+	if parent == "" {
+		return "", ErrBBDeliveryUnsettled
+	}
+	return parent, nil
+}
+
+// Folder move transitions use the same per-mirror mutation lock as note
+// delivery and scheduled baseline installation.
+func BBReadFolderMove(workdir, operationID string) (*BBFolderMove, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil || state.FolderMove == nil {
+		return nil, err
+	}
+	if state.FolderMove.Intent.OperationID != operationID {
+		return nil, ErrBBDeliveryUnsettled
+	}
+	return state.FolderMove, nil
+}
+
+func BBPrepareFolderMove(workdir string, intent BBFolderMoveIntent) error {
+	if !validBBFolderMoveIntent(intent) {
+		return errBBInvalidDelivery
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := BBFolderMove{Intent: intent}
+	if previous := state.FolderMove; previous != nil {
+		old := previous.Intent
+		if old.OperationID != intent.OperationID || old.Binding != intent.Binding || old.Source != intent.Source ||
+			old.Path != intent.Path || old.DestinationParent != intent.DestinationParent || !maps.Equal(old.Entries, intent.Entries) ||
+			!maps.Equal(old.Hashes, intent.Hashes) {
+			return ErrBBDeliveryUnsettled
+		}
+		return nil
+	}
+	if state.Pending != nil || state.Relocation != nil || state.FolderClone != nil || slices.ContainsFunc(state.Confirmed, func(receipt BBDeliveryReceipt) bool {
+		return move.overlaps(receipt.Path, receipt.ProviderID) || (receipt.RemovedPath != "" && move.overlaps(receipt.RemovedPath))
+	}) {
+		return ErrBBDeliveryUnsettled
+	}
+	if state.Version < bbFolderMoveVersion {
+		state.Version = bbFolderMoveVersion
+	}
+	state.FolderMove = &move
+	return state.write(workdir)
+}
+
+func BBDispatchFolderMove(workdir, operationID string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Intent.OperationID != operationID || move.Dispatched {
+		return ErrBBDeliveryUnsettled
+	}
+	move.Dispatched = true
+	return state.write(workdir)
+}
+
+func BBConfirmFolderMove(workdir, operationID string, published BBIndexedVersion) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Intent.OperationID != operationID || !move.Dispatched {
+		return ErrBBDeliveryUnsettled
+	}
+	if move.Published != nil {
+		if *move.Published == published {
+			return nil
+		}
+		return errBBInvalidDelivery
+	}
+	move.Published = &published
+	if !move.valid() {
+		return errBBInvalidDelivery
+	}
+	return state.write(workdir)
+}
+
+func BBAbortUndispatchedFolderMove(workdir, operationID string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Intent.OperationID != operationID || move.Dispatched {
+		return ErrBBDeliveryUnsettled
+	}
+	state.FolderMove = nil
+	return state.write(workdir)
+}
+
+func markBBFolderBaselineInstalled(workdir, operationID string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Published == nil || move.Intent.OperationID != operationID {
+		return errBBInvalidDelivery
+	}
+	if move.BaselineInstalled {
+		return nil
+	}
+	move.BaselineInstalled = true
+	return state.write(workdir)
+}
+
+func (state *bbDeliveryStore) finishBBFolder(move *BBFolderMove, publication BBIndexedVersion, rejected bool) {
+	state.FolderMove = nil
+	copied := len(move.Copies) != 0
+	state.FinishedFolders = append(state.FinishedFolders, bbFolderPublication{
+		OperationID: move.Intent.OperationID, Binding: move.Intent.Binding,
+		Source: move.Intent.Source, Path: move.Intent.Path, Published: publication, Rejected: rejected, Copied: &copied,
+	})
+	if len(state.FinishedFolders) > bbDeliveryLimit {
+		state.FinishedFolders = state.FinishedFolders[len(state.FinishedFolders)-bbDeliveryLimit:]
+	}
+}
+
+// Record only the provider's definitive rejection of the dispatched
+// original revision. A dropped response cannot use this transition.
+func BBRejectDispatchedFolderMove(workdir, operationID string) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Intent.OperationID != operationID || !move.Dispatched || move.Published != nil {
+		return ErrBBDeliveryUnsettled
+	}
+	state.finishBBFolder(move, BBIndexedVersion{}, true)
+	return state.write(workdir)
+}
