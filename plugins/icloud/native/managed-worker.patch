+package iclouddrive
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/fs"
+)
+
+func TestBBResolveCreateTargetRequiresExactParentAndVacancy(t *testing.T) {
+	const root, old, replacement = "FOLDER::zone::root", "FOLDER::zone::old", "FOLDER::zone::replacement"
+	folder := func(name, id string) *api.DriveItem {
+		return &api.DriveItem{Name: name, Drivewsid: id, Type: "FOLDER", ParentID: root}
+	}
+	file := &api.DriveItem{Name: "Note", Extension: "md", Drivewsid: "FILE::zone::note", ParentID: replacement, Type: "FILE", Etag: "present"}
+	state := map[string][]*api.DriveItem{root: {folder("Folder", old)}}
+	resolve := func() (string, *api.DriveItem, error) {
+		return bbResolveCreateTarget(root, "Folder/Note.md", func(id string) ([]*api.DriveItem, error) { return state[id], nil })
+	}
+	parent, occupied, err := resolve()
+	if err != nil || parent != old || occupied != nil {
+		t.Fatalf("initial target = %q, %v, %v", parent, occupied, err)
+	}
+	// A fresh parent check cannot silently reuse the original spelling cache.
+	state[root] = []*api.DriveItem{folder("Renamed", old), folder("Folder", replacement)}
+	state[replacement] = []*api.DriveItem{file}
+	parent, occupied, err = resolve()
+	if err != nil || parent != replacement || occupied != file {
+		t.Fatalf("recreated target = %q, %v, %v", parent, occupied, err)
+	}
+	state[root] = append(state[root], folder("folder", "FOLDER::zone::collision"))
+	if _, _, err := resolve(); !errors.Is(err, api.ErrConditionalConflict) {
+		t.Fatalf("competing casing = %v", err)
+	}
+	state[root] = []*api.DriveItem{folder("Renamed", old)}
+	if _, _, err := resolve(); !errors.Is(err, fs.ErrorDirNotFound) {
+		t.Fatalf("moved original reported as vacant = %v", err)
+	}
+}
