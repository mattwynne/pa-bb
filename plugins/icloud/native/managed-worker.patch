+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+	"testing"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+)
+
+type caseRelocationFake struct {
+	*relocationFake
+	competing, independentDelete bool
+}
+
+func (f caseRelocationFake) ObserveBBCaseNamespace(_ context.Context, from, to string) (iclouddrive.BBCaseNamespace, error) {
+	if f.competing {
+		return iclouddrive.BBCaseOccupied, nil
+	}
+	_, source := f.notes[from]
+	_, destination := f.notes[to]
+	switch {
+	case source && destination:
+		return iclouddrive.BBCaseOccupied, nil
+	case source:
+		return iclouddrive.BBCaseSource, nil
+	case destination:
+		return iclouddrive.BBCaseDestination, nil
+	default:
+		return iclouddrive.BBCaseVacant, nil
+	}
+}
+
+func (f caseRelocationFake) TrashBBCaseSource(ctx context.Context, name string, expected iclouddrive.BBNoteRevision, dispatch func() error) error {
+	if !f.independentDelete {
+		return f.TrashBBNote(ctx, name, expected, dispatch)
+	}
+	if err := dispatch(); err != nil {
+		return err
+	}
+	// The source disappeared because a device deleted it first.
+	delete(f.notes, name)
+	return api.ErrConditionalUnconfirmed
+}
+
+func TestOwnedCaseMoveRequiresAcknowledgedRemovalBeforeCreatingTheNewSpelling(t *testing.T) {
+	for _, scenario := range []string{"success", "empty note", "lost create", "lost trash", "independent deletion", "competing spelling"} {
+		t.Run(scenario, func(t *testing.T) {
+			source := fixturePublication("original-document", "original-revision", []byte("Original"))
+			cloud := caseRelocationFake{relocationFake: &relocationFake{notes: map[string]iclouddrive.BBNotePublication{"from.md": source},
+				lostCreate: scenario == "lost create", lostTrash: scenario == "lost trash"}, competing: scenario == "competing spelling",
+				independentDelete: scenario == "independent deletion"}
+			text := "Locally rewritten body"
+			if scenario == "empty note" {
+				text = ""
+			}
+			request := ownedNoteFrame{Workdir: t.TempDir(), Binding: source.Revision.ParentID, Source: "from.md", Path: "From.md",
+				OperationID: "7dcdd7dc-ad20-4d59-a8f3-4977f85c0960", Text: &text,
+				Expected: &ownedNoteVersion{source.Revision.DriveID, source.Revision.ParentID, source.Revision.ETag, hex.EncodeToString(source.Revision.Hash[:])}}
+			hash := sha256.Sum256([]byte(*request.Text))
+			request.WantedHash = hex.EncodeToString(hash[:])
+			ctx := context.Background()
+			reply := applyOwnedRelocation(ctx, cloud, request)
+			request.Text = nil
+			if reply.Outcome == "uncertain" {
+				reply = applyOwnedRelocation(ctx, cloud, request)
+			}
+			if scenario == "success" || scenario == "empty note" || scenario == "lost create" {
+				if reply.Outcome != "published" || reply.SourceRetained || reply.Observation.DocumentID == source.Revision.DriveID ||
+					reply.Observation.Hash != request.WantedHash || cloud.notes[request.Path].Revision.Hash != hash {
+					t.Fatalf("exact case move = %s", reply.Outcome)
+				}
+			} else {
+				if reply.Outcome != "conflict_preserved" || !strings.HasPrefix(reply.ConflictCopy, "BB move conflict ") ||
+					cloud.notes[reply.ConflictCopy].Revision.Hash != hash || cloud.notes[request.Path].Revision.DriveID != "" {
+					t.Fatalf("a contested removal recreated the canonical note: %s", reply.Outcome)
+				}
+			}
+			if cloud.creates != 1 || cloud.trashes > 1 {
+				t.Fatalf("replayed request: %d creations, %d removals", cloud.creates, cloud.trashes)
+			}
+		})
+	}
+}
