+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+)
+
+func TestBBManagedScanConsumesDurablePublication(t *testing.T) {
+	for _, scenario := range []string{"later edit", "identical metadata", "interrupted reconciliation", "independent local edit", "later delete", "unconfirmed", "new note", "superseded local"} {
+		t.Run(scenario, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			cloudRoot, localRoot, workdir := t.TempDir(), t.TempDir(), t.TempDir()
+			cloud, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			mirror, err := local.NewFs(ctx, "local", localRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := "note.md"
+			baseline := time.Unix(1700000000, 0)
+			publication, subsequent := baseline.Add(15*time.Second), baseline.Add(30*time.Second)
+			original, fast, later := "old", "published-fast", "later independent edit"
+			equalMetadata := scenario == "identical metadata" || scenario == "interrupted reconciliation" || scenario == "independent local edit"
+			if equalMetadata {
+				later = "edited-over-it"
+			}
+			write := func(root, name, text string, modified time.Time) {
+				file := filepath.Join(root, name)
+				if err := os.WriteFile(file, []byte(text), 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Chtimes(file, modified, modified); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, root := range []string{cloudRoot, localRoot} {
+				for _, w := range []string{"a.md", "b.md", "c.md"} {
+					write(root, w, "unchanged", baseline)
+				}
+				if scenario != "new note" {
+					write(root, path, original, baseline)
+				}
+			}
+			opts := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50}
+			if err := Bisync(ctx, cloud, mirror, &opts); err != nil {
+				t.Fatal(err)
+			}
+			opts.Resync = false
+			seen, resume := make(chan struct{}, 2), make(chan struct{})
+			done := make(chan error, 1)
+			var scanCloud fs.Fs = &capturedScan{Fs: cloud, seen: seen, resume: resume}
+			if equalMetadata {
+				scanCloud = &bbTestVersionedFs{Fs: scanCloud}
+			}
+			go func() {
+				done <- BBManagedBisync(ctx, scanCloud,
+					&capturedScan{Fs: mirror, seen: seen, resume: resume}, opts)
+			}()
+			for range 2 {
+				select {
+				case <-seen:
+				case err := <-done:
+					t.Fatalf("scan did not start: %v", err)
+				case <-ctx.Done():
+					t.Fatal(ctx.Err())
+				}
+			}
+
+			// Deliver from a separate file description while the managed scan is
+			// still holding old observations. The next process uses only disk state.
+			release, err := bbAcquireMutationPhase(ctx, filepath.Join(workdir, BBMutationLockName))
+			if err != nil {
+				t.Fatal(err)
+			}
+			intent := BBDeliveryIntent{"e7bd52ef-e4a5-45d1-b4cc-ec4d6be5770c", path, sha256.Sum256([]byte(fast)), scenario == "new note"}
+			if err := BBBeginDelivery(workdir, intent); err != nil {
+				t.Fatal(err)
+			}
+			write(localRoot, path, fast, publication.Add(-2*time.Second))
+			if scenario != "unconfirmed" {
+				write(cloudRoot, path, fast, publication)
+				receipt := BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: publication, Size: int64(len(fast))}
+				if equalMetadata {
+					receipt.ProviderID, receipt.ETag = "document", "published"
+				}
+				if err := BBResolveDelivery(workdir, intent, &receipt); err != nil {
+					t.Fatal(err)
+				}
+			}
+			switch scenario {
+			case "later edit":
+				write(cloudRoot, path, later, subsequent)
+			case "identical metadata", "interrupted reconciliation", "independent local edit":
+				write(cloudRoot, path, later, publication)
+				if scenario == "interrupted reconciliation" {
+					write(localRoot, path, later, publication)
+				}
+				if scenario == "independent local edit" {
+					write(localRoot, path, "local only", subsequent)
+				}
+			case "later delete":
+				if err := os.Remove(filepath.Join(cloudRoot, path)); err != nil {
+					t.Fatal(err)
+				}
+			case "superseded local":
+				write(localRoot, path, later, subsequent)
+			}
+			if err := release(); err != nil {
+				t.Fatal(err)
+			}
+			close(resume)
+			err = <-done
+			store, storeErr := readBBDeliveries(workdir)
+			if storeErr != nil {
+				t.Fatal(storeErr)
+			}
+			want := fast
+			switch scenario {
+			case "unconfirmed":
+				if !errors.Is(err, ErrBBDeliveryUnsettled) || store.Pending == nil {
+					t.Fatalf("uncertain request was not kept: %v", err)
+				}
+				body, readErr := os.ReadFile(filepath.Join(cloudRoot, path))
+				if readErr != nil || string(body) != original {
+					t.Fatal("the managed scan overwrote the note after an uncertain request")
+				}
+				return
+			case "superseded local":
+				if !errors.Is(err, errBBLocalSuperseded) || len(store.Confirmed) != 1 {
+					t.Fatalf("later local revision lost its publication evidence: %v", err)
+				}
+				return
+			case "independent local edit":
+				if !errors.Is(err, errBBLocalSuperseded) || len(store.Confirmed) != 1 {
+					t.Fatalf("independent local edit lost its publication evidence: %v", err)
+				}
+				for root, expected := range map[string]string{localRoot: "local only", cloudRoot: later} {
+					body, readErr := os.ReadFile(filepath.Join(root, path))
+					if readErr != nil || string(body) != expected {
+						t.Fatalf("independent edit overwritten: %v", readErr)
+					}
+				}
+				return
+			case "later edit", "identical metadata", "interrupted reconciliation":
+				want = later
+			}
+			if err != nil || len(store.Confirmed) != 0 || store.Pending != nil {
+				t.Fatalf("managed sync did not settle: %v", err)
+			}
+			for _, root := range []string{cloudRoot, localRoot} {
+				body, readErr := os.ReadFile(filepath.Join(root, path))
+				if scenario == "later delete" {
+					if !errors.Is(readErr, os.ErrNotExist) {
+						t.Fatal("deletion was resurrected")
+					}
+				} else if readErr != nil || string(body) != want {
+					t.Fatalf("later note state differed: %v", readErr)
+				}
+			}
+		})
+	}
+}
+
+type bbTestVersionedFs struct{ fs.Fs }
+
+func (f *bbTestVersionedFs) NewObject(ctx context.Context, remote string) (fs.Object, error) {
+	obj, err := f.Fs.NewObject(ctx, remote)
+	if err != nil {
+		return nil, err
+	}
+	return bbTestVersionedObject{obj}, nil
+}
+
+type bbTestVersionedObject struct{ fs.Object }
+
+func (bbTestVersionedObject) BBListedIdentity() (string, string, string) {
+	return "document", "parent", "later"
+}
+
+func TestBBManagedScanReconcilesBothRelocationEndpoints(t *testing.T) {
+	for _, recreate := range []bool{false, true} {
+		name := "moved source stays absent"
+		if recreate {
+			name = "later Mac recreation is downloaded"
+		}
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+			defer cancel()
+			cloudRoot, localRoot, workdir := t.TempDir(), t.TempDir(), t.TempDir()
+			pair := []string{cloudRoot, localRoot}
+			baseline := time.Unix(1700000000, 0)
+			write := func(root, name, data string, when time.Time) {
+				target := filepath.Join(root, name)
+				if err := os.WriteFile(target, []byte(data), 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Chtimes(target, when, when); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, side := range pair {
+				if err := os.Mkdir(filepath.Join(side, "Archive"), 0700); err != nil {
+					t.Fatal(err)
+				}
+				write(side, "anchor.md", "unchanged", baseline)
+				write(side, "Archive/anchor.md", "unchanged", baseline)
+				write(side, "from.md", "original", baseline)
+			}
+			cloud, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			mirror, err := local.NewFs(ctx, "local", localRoot, configmap.Simple{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			opt := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50}
+			if err := Bisync(ctx, cloud, mirror, &opt); err != nil {
+				t.Fatal(err)
+			}
+
+			opt.Resync = false
+			seen, resume := make(chan struct{}, 2), make(chan struct{})
+			completed := make(chan error, 1)
+			go func() {
+				completed <- BBManagedBisync(ctx, &bbTestVersionedFs{Fs: &capturedScan{Fs: cloud, seen: seen, resume: resume}},
+					&capturedScan{Fs: mirror, seen: seen, resume: resume}, opt)
+			}()
+			defer func() {
+				select {
+				case <-resume:
+				default:
+					close(resume)
+				}
+			}()
+			for range 2 {
+				select {
+				case <-seen:
+				case err := <-completed:
+					t.Fatalf("scan did not start: %v", err)
+				case <-ctx.Done():
+					t.Fatal(ctx.Err())
+				}
+			}
+
+			release, err := bbAcquireMutationPhase(ctx, filepath.Join(workdir, BBMutationLockName))
+			if err != nil {
+				t.Fatal(err)
+			}
+			content := "Edited during relocation"
+			publication := baseline.Add(20 * time.Second)
+			for _, side := range pair {
+				if err := os.Remove(filepath.Join(side, "from.md")); err != nil {
+					t.Fatal(err)
+				}
+				write(side, "Archive/to.md", content, publication)
+			}
+			intent := BBRelocationIntent{
+				BBDeliveryIntent: BBDeliveryIntent{"6c59034c-13a9-4843-9902-93130d965046", "Archive/to.md", sha256.Sum256([]byte(content)), true},
+				Source:           "from.md", Binding: "bound-root", Previous: BBIndexedVersion{"old-document", "parent", "old-version"},
+				SourceHash: sha256.Sum256([]byte("original")),
+			}
+			if err := BBBeginRelocation(workdir, intent, []byte(content)); err != nil {
+				t.Fatal(err)
+			}
+			if err := BBAllocateRelocation(workdir, intent, "allocation"); err != nil {
+				t.Fatal(err)
+			}
+			receipt := BBDeliveryReceipt{BBDeliveryIntent: intent.BBDeliveryIntent, Modified: publication, Size: int64(len(content)),
+				ProviderID: "document", ProviderParentID: "parent", ETag: "later"}
+			if err := BBRecordRelocationDestination(workdir, intent, receipt); err != nil {
+				t.Fatal(err)
+			}
+			if err := BBDispatchRelocationTrash(workdir, intent); err != nil {
+				t.Fatal(err)
+			}
+			if err := BBFinishRelocation(workdir, intent); err != nil {
+				t.Fatal(err)
+			}
+			if recreate {
+				write(cloudRoot, "from.md", "Mac recreated source", publication.Add(10*time.Second))
+			}
+			if err := release(); err != nil {
+				t.Fatal(err)
+			}
+			close(resume)
+			if err := <-completed; err != nil {
+				t.Fatal(err)
+			}
+			for _, side := range pair {
+				body, err := os.ReadFile(filepath.Join(side, "Archive/to.md"))
+				if err != nil || string(body) != content {
+					t.Fatalf("destination: %s %v", body, err)
+				}
+				body, err = os.ReadFile(filepath.Join(side, "from.md"))
+				if recreate {
+					if err != nil || string(body) != "Mac recreated source" {
+						t.Fatalf("later source: %s %v", body, err)
+					}
+				} else if !errors.Is(err, os.ErrNotExist) {
+					t.Fatalf("old source was resurrected: %v", err)
+				}
+			}
+			state, err := readBBDeliveries(workdir)
+			if err != nil || state.Relocation != nil || len(state.Confirmed) != 0 || len(state.Applied) != 1 {
+				t.Fatalf("receipt remained unsettled: %v", err)
+			}
+		})
+	}
+}
