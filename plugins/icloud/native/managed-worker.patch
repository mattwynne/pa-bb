+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+// RetireBBFolderItem sends exactly one original-revision trash operation.
+// The caller has verified the saved copy and, for a folder, its emptiness.
+func (d *DriveService) RetireBBFolderItem(ctx context.Context, original DriveItem, dispatch func() error) error {
+	kind, zone, id := DeconstructDriveID(original.Drivewsid)
+	if (kind != "FOLDER" && kind != "FILE") || original.Type != kind ||
+		!driveIdentifier.MatchString(zone) || !driveIdentifier.MatchString(id) ||
+		original.Docwsid != id || original.ParentID == "" || len(original.ParentID) > 512 ||
+		original.Etag == "" || len(original.Etag) > 512 {
+		return ErrConditionalRefused
+	}
+	payload, err := json.Marshal(struct {
+		Items []conditionalFolderMoveItem `json:"items"`
+	}{[]conditionalFolderMoveItem{{original.Drivewsid, original.Etag, original.Drivewsid}}})
+	if err != nil {
+		return ErrConditionalRefused
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if dispatch != nil {
+		if err := dispatch(); err != nil {
+			return err
+		}
+	}
+	session := d.icloud.Session
+	resp, err := session.srv.Call(ctx, &rest.Opts{
+		Method: http.MethodPost, Path: "/moveItemsToTrash", RootURL: d.endpoint,
+		Body: bytes.NewReader(payload), ExtraHeaders: session.GetHeaders(nil),
+		NoRedirect: true, IgnoreStatus: true,
+	})
+	if err != nil {
+		return ErrConditionalUnconfirmed
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, conditionalReplyLimit+1))
+	if err != nil || len(body) > conditionalReplyLimit {
+		return ErrConditionalUnconfirmed
+	}
+	var reply DriveItem
+	if json.Unmarshal(body, &reply) != nil || len(reply.Items) != 1 || reply.Items[0] == nil || reply.Items[0].Drivewsid != original.Drivewsid {
+		return ErrConditionalUnconfirmed
+	}
+	item := reply.Items[0]
+	if item.Status == "ETAG_CONFLICT" && (resp.StatusCode == http.StatusConflict || resp.StatusCode == http.StatusOK) {
+		return ErrConditionalConflict
+	}
+	if resp.StatusCode != http.StatusOK || item.Status != statusOk {
+		return ErrConditionalUnconfirmed
+	}
+	return nil
+}
