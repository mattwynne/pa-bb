+package bisync
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"strings"
+)
+
+const bbTreeIndexName = "bb-cloud-tree-identities-v1.json"
+
+type BBTreeIdentity struct {
+	BBIndexedVersion
+	Directory bool `json:"directory"`
+}
+
+type bbTreeIndexFile struct {
+	Version int                       `json:"version"`
+	Binding string                    `json:"binding"`
+	Entries map[string]BBTreeIdentity `json:"entries"`
+}
+
+func writeBBTreeIndex(owner bbListingPair, tree bbTreeIndexFile) error {
+	data, err := json.Marshal(tree)
+	if err != nil {
+		return err
+	}
+	if len(data) > bbIndexLimit {
+		// Do not retain a stale complete-looking prefix when a tree grows
+		// beyond the index budget. Ordinary note delivery still has its index.
+		tree.Entries = nil
+		data, err = json.Marshal(tree)
+		if err != nil {
+			return err
+		}
+	}
+	return owner.publishFile(filepath.Join(owner.directory, bbTreeIndexName), data, false)
+}
+
+// BBIndexedTree returns one bound acknowledgment for use by a folder
+// operation. A caller must still revalidate the exact provider contents.
+func BBIndexedTree(workdir, binding, source string) (map[string]BBTreeIdentity, error) {
+	if binding == "" || source == "" {
+		return nil, errBBInvalidDelivery
+	}
+	raw, err := bbReadBounded(filepath.Join(workdir, bbTreeIndexName), bbIndexLimit)
+	if err != nil {
+		return nil, err
+	}
+	var tree bbTreeIndexFile
+	if json.Unmarshal(raw, &tree) != nil || tree.Version != 1 || tree.Binding != binding ||
+		!tree.Entries[source].Directory {
+		return nil, errBBInvalidDelivery
+	}
+	selected := make(map[string]BBTreeIdentity)
+	for name, identity := range tree.Entries {
+		if name == source || strings.HasPrefix(name, source+"/") {
+			if identity.DocumentID == "" || identity.ParentID == "" || identity.ETag == "" {
+				return nil, errBBInvalidDelivery
+			}
+			selected[name] = identity
+		}
+	}
+	return selected, nil
+}
