+func TestBBAbandonUnconfirmedStagingOnlyReleasesCanonicalPaths(t *testing.T) {
+	workdir := t.TempDir()
+	const operation = "f2baffcf-ee64-4af6-a857-c380bb126b70"
+	const source = "Folder"
