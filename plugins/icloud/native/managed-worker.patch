+package api
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/rclone/rclone/lib/rest"
+)
+
+func TestBBConditionalFolderMoveUsesOriginalVersionOnce(t *testing.T) {
+	const id = "FOLDER::icloud.example::source"
+	const from = "FOLDER::icloud.example::parent"
+	const to = "APP_LIBRARY::icloud.example::documents#a1b"
+	source := DriveItem{Drivewsid: id, Docwsid: "source", Type: "FOLDER", ParentID: from, Etag: "original"}
+	for _, scenario := range []struct {
+		name, status, documentID, newParent string
+		httpStatus                          int
+		want                                error
+	}{
+		{"succeeded", "OK", id, to, http.StatusOK, nil},
+		{"stale", "ETAG_CONFLICT", id, "", http.StatusOK, ErrConditionalConflict},
+		{"unexpected identity", "OK", from, to, http.StatusOK, ErrConditionalUnconfirmed},
+		{"redirect refused", "OK", id, to, http.StatusTemporaryRedirect, ErrConditionalUnconfirmed},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			var calls atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				var payload conditionalFolderMoveRequest
+				if r.URL.Path != "/moveItems" || r.Method != http.MethodPost || readJSONBody(r, &payload) != nil ||
+					payload.DestinationID != to || len(payload.Items) != 1 ||
+					payload.Items[0] != (conditionalFolderMoveItem{id, "original", id}) {
+					t.Errorf("incorrect request: %s %s %#v", r.Method, r.URL.Path, payload)
+				}
+				w.Header().Set("Location", "/unexpected-replay")
+				w.WriteHeader(scenario.httpStatus)
+				writeJSON(t, w, DriveItem{Items: []*DriveItem{{
+					Drivewsid: scenario.documentID, ParentID: scenario.newParent, Status: scenario.status, Etag: "different",
+				}}})
+			}))
+			defer server.Close()
+			session := NewSession()
+			session.srv = rest.NewClient(server.Client())
+			service := DriveService{endpoint: server.URL, icloud: &Client{Session: session}}
+			if got := service.MoveConditionalFolder(context.Background(), source, to); !errors.Is(got, scenario.want) {
+				t.Fatalf("move response = %v, want %v", got, scenario.want)
+			}
+			if got := calls.Load(); got != 1 {
+				t.Fatalf("move submit count = %d", got)
+			}
+		})
+	}
+}
