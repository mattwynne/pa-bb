+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+)
+
+type bbFolderContentChange struct {
+	changed [2]bool
+	hashes  [2]*[sha256.Size]byte
+}
+
+func (b *bisyncRun) prepareBBFolderContent(ctx context.Context, move *BBFolderMove, state bbDeliveryStore) (map[string]bbFolderContentChange, error) {
+	changes := make(map[string]bbFolderContentChange)
+	// Later note publications are reconciled by their own receipts. If
+	// one is unresolved, the note hold retains its shifted baseline.
+	notePaths := make(map[string]bool, len(state.Confirmed)+1)
+	if state.Pending != nil {
+		notePaths[state.Pending.Path] = true
+	}
+	for _, receipt := range state.Confirmed {
+		notePaths[receipt.Path] = true
+	}
+	for source, original := range move.Intent.Hashes {
+		name := move.Intent.Path + strings.TrimPrefix(source, move.Intent.Source)
+		if notePaths[name] {
+			continue
+		}
+		// A spelling change may be paired by rclone as an alias. Retain the
+		// old baseline until the exact path can be reconciled safely.
+		if b.aliases.Alias(name) != name {
+			return nil, ErrBBDeliveryUnsettled
+		}
+		change := bbFolderContentChange{}
+		for i, side := range []fs.Fs{b.fs1, b.fs2} {
+			listed := b.march.ls1
+			if i == 1 {
+				listed = b.march.ls2
+			}
+			if !listed.has(name) {
+				continue // a deletion will be compared against the shifted baseline
+			}
+			if listed.isDir(name) {
+				return nil, ErrBBDeliveryUnsettled
+			}
+			recreated := false
+			if i == 0 {
+				prior := move.providerFor(source)
+				observed := b.march.bbIdentities[name]
+				if observed.DocumentID == "" {
+					return nil, ErrBBDeliveryUnsettled
+				}
+				recreated = observed.DocumentID != prior.DocumentID || observed.ParentID != prior.ParentID
+				if observed.BBIndexedVersion == prior {
+					digest := original
+					change.hashes[i] = &digest
+					continue
+				}
+			}
+			obj, err := side.NewObject(ctx, name)
+			if err != nil || obj.Remote() != name || obj.Size() != listed.getSize(name) ||
+				timeDiffers(ctx, obj.ModTime(ctx), listed.getTime(name), side, side) {
+				return nil, ErrBBDeliveryUnsettled
+			}
+			if i == 0 {
+				observed, ok := bbCloudVersionFrom(ctx, obj)
+				if !ok || observed.BBIndexedVersion != b.march.bbIdentities[name].BBIndexedVersion {
+					return nil, ErrBBDeliveryUnsettled
+				}
+			}
+			digest, err := bbObjectHash(ctx, obj, 1<<30)
+			if err != nil {
+				return nil, err
+			}
+			change.hashes[i] = &digest
+			change.changed[i] = recreated || digest != original
+		}
+		verifiedClone := len(move.Copies) > 0 && change.hashes[0] != nil && change.hashes[1] != nil
+		if change.changed[0] || change.changed[1] || verifiedClone {
+			changes[name] = change
+		}
+	}
+	return changes, nil
+}
+
+// Apple can assign a new timestamp to each staged copy. In a mirror
+// containing only the moved notes this can look like a whole-vault change.
+// Keep the safety abort for any difference beyond a verified same-content
+// clone with an exact name and a timestamp-only delta.
+func (b *bisyncRun) onlyAcknowledgedCloneTimestamps(ds *deltaSet) bool {
+	if b.bbFolderReconcile == "" || ds.oldCount == 0 || ds.oldCount != len(ds.deltas) {
+		return false
+	}
+	for name, delta := range ds.deltas {
+		change, known := b.bbFolderChanges[name]
+		if !known || delta == deltaZero || delta & ^deltaTime != 0 ||
+			change.changed[0] || change.changed[1] || change.hashes[0] == nil || change.hashes[1] == nil ||
+			*change.hashes[0] != *change.hashes[1] {
+			return false
+		}
+	}
+	return true
+}
+
+func (b *bisyncRun) verifyBBFolderVersion(ctx context.Context, side fs.Fs, name string, wanted *[sha256.Size]byte) error {
+	obj, err := side.NewObject(ctx, name)
+	if wanted == nil && errors.Is(err, fs.ErrorObjectNotFound) {
+		return nil
+	}
+	if err != nil || wanted == nil || obj.Remote() != name {
+		return errBBContentChangedDuringScan
+	}
+	found, err := bbObjectHash(ctx, obj, 1<<30)
+	if err != nil {
+		return err
+	}
+	if found != *wanted {
+		return errBBContentChangedDuringScan
+	}
+	return nil
+}
+
+func (b *bisyncRun) verifyBBFolderChanges(ctx context.Context) error {
+	for name, change := range b.bbFolderChanges {
+		if renames, conflict := b.renames[name]; conflict {
+			for i, path := range []string{renames.path1.newName, renames.path2.newName} {
+				if change.hashes[i] == nil {
+					continue
+				}
+				if path == "" {
+					return ErrBBDeliveryUnsettled
+				}
+				for _, side := range []fs.Fs{b.fs1, b.fs2} {
+					if err := b.verifyBBFolderVersion(ctx, side, path, change.hashes[i]); err != nil {
+						return err
+					}
+				}
+			}
+			continue
+		}
+		winner := 0
+		if change.changed[1] {
+			winner = 1
+		}
+		for _, side := range []fs.Fs{b.fs1, b.fs2} {
+			if err := b.verifyBBFolderVersion(ctx, side, name, change.hashes[winner]); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (b *bisyncRun) finishBBFolderMove(ctx context.Context) error {
+	if b.bbFolderReconcile == "" {
+		return nil
+	}
+	if err := b.verifyBBFolderChanges(ctx); err != nil {
+		return err
+	}
+	state, err := readBBDeliveries(b.workDir)
+	if err != nil {
+		return err
+	}
+	move := state.FolderMove
+	if move == nil || move.Intent.OperationID != b.bbFolderReconcile || !move.BaselineInstalled {
+		return errBBInvalidDelivery
+	}
+	state.finishBBFolder(move, *move.Published, false)
+	return state.write(b.workDir)
+}
