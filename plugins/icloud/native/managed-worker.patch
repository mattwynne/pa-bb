+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+)
+
+type ownedCloneFixture struct {
+	children                   map[string][]iclouddrive.BBFolderItem
+	bodies                     map[string][]byte
+	serial                     int
+	activationCount            int
+	activationPreflightRefused bool
+	retirementPreflightRefused bool
+	retirementReadbackLost     bool
+	skipOneActivationPreflight bool
+	moveCount                  int
+	editSource                 bool
+	deleteSource               bool
+}
+
+func (f *ownedCloneFixture) BBFolderList(_ context.Context, _, parent string) ([]iclouddrive.BBFolderItem, error) {
+	return slices.Clone(f.children[parent]), nil
+}
+
+func (f *ownedCloneFixture) BBFolderFileHash(_ context.Context, item iclouddrive.BBFolderItem) ([sha256.Size]byte, error) {
+	return sha256.Sum256(f.bodies[item.DocumentID]), nil
+}
+
+func (f *ownedCloneFixture) id() string {
+	f.serial++
+	return fmt.Sprintf("id-%d", f.serial)
+}
+
+func (f *ownedCloneFixture) BBReserveStageFolderWithDispatch(_ context.Context, _, parent, name, _ string, dispatch func() error) (iclouddrive.BBFolderItem, error) {
+	if err := dispatch(); err != nil {
+		return iclouddrive.BBFolderItem{}, err
+	}
+	item := iclouddrive.BBFolderItem{Name: name, DocumentID: "FOLDER::zone::" + f.id(), ParentID: parent, ETag: "dir", Directory: true}
+	f.children[parent] = append(f.children[parent], item)
+	return item, nil
+}
+
+func (f *ownedCloneFixture) BBReserveStageFile(_ context.Context, _ string, old iclouddrive.BBFolderItem, _ [sha256.Size]byte) (api.BBFolderFileAllocation, error) {
+	return api.BBFolderFileAllocation{DocumentID: f.id(),
+		Asset: api.SingleFileInfo{Signature: string(f.bodies[old.DocumentID]), Size: old.Size, Receipt: "owned-upload"}}, nil
+}
+
+func (f *ownedCloneFixture) BBActivateStageFile(_ context.Context, _, parent, name string, allocation api.BBFolderFileAllocation, _ [sha256.Size]byte, dispatch func() error) (*iclouddrive.BBFolderItem, error) {
+	if f.skipOneActivationPreflight && !f.activationPreflightRefused {
+		f.activationPreflightRefused = true
+		return nil, context.DeadlineExceeded
+	}
+	if err := dispatch(); err != nil {
+		return nil, err
+	}
+	f.activationCount++
+	item := iclouddrive.BBFolderItem{Name: name, DocumentID: "FILE::zone::" + allocation.DocumentID, ParentID: parent, ETag: "copy", Size: allocation.Asset.Size}
+	f.children[parent] = append(f.children[parent], item)
+	f.bodies[item.DocumentID] = []byte(allocation.Asset.Signature)
+	if f.editSource {
+		f.bodies["FILE::zone::original"] = []byte("device edit")
+		f.children["FOLDER::zone::original"][0].ETag = "independent edit"
+	}
+	if f.deleteSource {
+		delete(f.bodies, "FILE::zone::original")
+		f.children["FOLDER::zone::original"] = nil
+	}
+	// The next request must recover the allocated identity, without a retry.
+	return nil, api.ErrConditionalUnconfirmed
+}
+
+func (f *ownedCloneFixture) BBObserveStageFile(_ context.Context, _, parent, name, allocation string, digest [sha256.Size]byte) (*iclouddrive.BBFolderItem, error) {
+	for _, child := range f.children[parent] {
+		if child.Name != name {
+			continue
+		}
+		if child.DocumentID == "FILE::zone::"+allocation && sha256.Sum256(f.bodies[child.DocumentID]) == digest {
+			return &child, nil
+		}
+		return nil, api.ErrConditionalConflict
+	}
+	return nil, nil
+}
+
+func (f *ownedCloneFixture) BBMoveFolder(_ context.Context, item iclouddrive.BBFolderItem, parent string) error {
+	f.moveCount++
+	f.children[item.ParentID] = slices.DeleteFunc(f.children[item.ParentID], func(sibling iclouddrive.BBFolderItem) bool {
+		return sibling.DocumentID == item.DocumentID
+	})
+	item.ParentID, item.ETag = parent, "moved"
+	f.children[parent] = append(f.children[parent], item)
+	return api.ErrConditionalUnconfirmed
+}
+
+func (f *ownedCloneFixture) BBRetireCopiedFolderItemWithDispatch(_ context.Context, _ string, item iclouddrive.BBFolderItem, dispatch, acknowledged func() error) error {
+	if !f.retirementPreflightRefused {
+		f.retirementPreflightRefused = true
+		return context.DeadlineExceeded
+	}
+	if item.Directory && len(f.children[item.DocumentID]) > 0 {
+		return api.ErrConditionalConflict
+	}
+	if err := dispatch(); err != nil {
+		return err
+	}
+	f.children[item.ParentID] = slices.DeleteFunc(f.children[item.ParentID], func(sibling iclouddrive.BBFolderItem) bool {
+		return sibling.DocumentID == item.DocumentID && sibling.ETag == item.ETag
+	})
+	if err := acknowledged(); err != nil {
+		return err
+	}
+	if !f.retirementReadbackLost {
+		f.retirementReadbackLost = true
+		return context.DeadlineExceeded
+	}
+	return nil
+}
+
+func TestBBFolderCloneRecoversActivationAndProtectsIndependentChanges(t *testing.T) {
+	for _, trial := range []struct {
+		name, target                string
+		edit, remove, expectPublish bool
+	}{
+		{name: "new name with independent original", target: "Renamed", edit: true, expectPublish: true},
+		{name: "case-only with unchanged source", target: "source", expectPublish: true},
+		{name: "case-only with independent original", target: "source", edit: true},
+		{name: "case-only with independently deleted original", target: "source", remove: true},
+	} {
+		t.Run(trial.name, func(t *testing.T) {
+			const binding = "FOLDER::zone::root"
+			source := iclouddrive.BBFolderItem{Name: "Source", DocumentID: "FOLDER::zone::original", ParentID: binding, ETag: "old", Directory: true}
+			file := iclouddrive.BBFolderItem{Name: "Data.bin", DocumentID: "FILE::zone::original", ParentID: source.DocumentID, ETag: "old", Size: 3}
+			cloud := &ownedCloneFixture{
+				children:   map[string][]iclouddrive.BBFolderItem{binding: {source}, source.DocumentID: {file}},
+				bodies:     map[string][]byte{file.DocumentID: []byte("abc")},
+				editSource: trial.edit, deleteSource: trial.remove, skipOneActivationPreflight: true,
+			}
+			workdir := t.TempDir()
+			entries := map[string]bisync.BBTreeIdentity{
+				"Source":          {BBIndexedVersion: ownedFolderVersion(source), Directory: true},
+				"Source/Data.bin": {BBIndexedVersion: ownedFolderVersion(file)},
+			}
+			index, err := json.Marshal(map[string]any{"version": 1, "binding": binding, "entries": entries})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(workdir, "bb-cloud-tree-identities-v1.json"), index, 0600); err != nil {
+				t.Fatal(err)
+			}
+			digest := sha256.Sum256([]byte("abc"))
+			req := ownedNoteFrame{Binding: binding, Workdir: workdir, Source: "Source", Path: trial.target,
+				OperationID: "0755a78a-db26-4863-af4b-e84560e68149", FolderEntries: []ownedFolderEntry{{
+					Path: "Data.bin", Kind: "file", Size: 3, Hash: hex.EncodeToString(digest[:]),
+				}}}
+			// A deployed worker can still have a journal from before
+			// direct renames were introduced. Resume that exact operation.
+			if err := bisync.BBPrepareFolderClone(workdir, bisync.BBFolderMoveIntent{
+				OperationID: req.OperationID, Binding: binding, Source: req.Source, Path: req.Path,
+				DestinationParent: binding, Entries: entries,
+				Hashes: map[string][sha256.Size]byte{"Source/Data.bin": digest},
+			}); err != nil {
+				t.Fatal(err)
+			}
+			ctx := context.Background()
+			reply := applyOwnedFolderMove(ctx, cloud, req)
+			req.FolderEntries = nil
+			for count := 0; reply.Outcome == "uncertain" && count < 12; count++ {
+				reply = applyOwnedFolderMove(ctx, cloud, req)
+			}
+			if (reply.Outcome == "folder_published") != trial.expectPublish || cloud.activationCount != 1 ||
+				!cloud.activationPreflightRefused || !cloud.retirementPreflightRefused {
+				t.Fatalf("reply = %+v, activations = %d", reply, cloud.activationCount)
+			}
+			if (trial.expectPublish || trial.remove) && !cloud.retirementReadbackLost {
+				t.Fatal("the test never exercised a confirmed trash with lost read-back")
+			}
+			if trial.expectPublish {
+				item, _ := cloneFolderLeaf(ctx, cloud, binding, binding, trial.target)
+				if item == nil || item.DocumentID == source.DocumentID || cloud.moveCount != 1 {
+					t.Fatalf("published copy = %+v, moves = %d", item, cloud.moveCount)
+				}
+				child, _ := cloneFolderLeaf(ctx, cloud, binding, item.DocumentID, file.Name)
+				if child == nil || child.DocumentID == file.DocumentID || string(cloud.bodies[child.DocumentID]) != "abc" {
+					t.Fatalf("copied child = %+v", child)
+				}
+			} else if cloud.moveCount != 0 {
+				t.Fatal("published alongside an independently changed case-folded original")
+			}
+			if trial.edit {
+				old, _ := cloneFolderLeaf(ctx, cloud, binding, source.DocumentID, file.Name)
+				if old == nil || old.DocumentID != file.DocumentID || string(cloud.bodies[old.DocumentID]) != "device edit" {
+					t.Fatalf("independent version = %+v", old)
+				}
+			}
+		})
+	}
+}
