+func TestBBFolderListingReplayMarksBothListingsInstalledBeforeClosing(t *testing.T) {
+	workdir := t.TempDir()
+	paths := [2]string{filepath.Join(workdir, "folder.path1.lst"), filepath.Join(workdir, "folder.path2.lst")}
+	pair, err := bbPairFor(paths[0], paths[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := BBIndexedVersion{"folder", "source-parent", "prior"}
+	move := BBFolderMoveIntent{
+		OperationID: "00e076ca-6a04-4f60-9629-ce540ff1af9f", Binding: "binding",
+		Source: "Source/Folder", Path: "Target/Folder", DestinationParent: "target-parent",
+		Entries: map[string]BBTreeIdentity{"Source/Folder": {BBIndexedVersion: root, Directory: true}},
+	}
+	if err := BBPrepareFolderMove(workdir, move); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBDispatchFolderMove(workdir, move.OperationID); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBConfirmFolderMove(workdir, move.OperationID, BBIndexedVersion{"folder", "target-parent", "published"}); err != nil {
+		t.Fatal(err)
+	}
+	before := [2][]byte{[]byte("before cloud"), []byte("before local")}
+	after := [2][]byte{[]byte("after cloud"), []byte("after local")}
+	for i, file := range paths {
+		if err := os.WriteFile(file, before[i], 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := pair.beginTransaction(bbListingPairJournal{
+		Version: 2, FolderOperationID: move.OperationID,
+		Before: [2][sha256.Size]byte{sha256.Sum256(before[0]), sha256.Sum256(before[1])}, After: after,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	interrupted := errors.New("interrupted after first publication")
+	if err := pair.recover(func(i int) error {
+		if i == 0 {
+			return interrupted
+		}
+		return nil
+	}); !errors.Is(err, interrupted) {
+		t.Fatalf("first replay = %v", err)
+	}
+	interim, err := BBReadFolderMove(workdir, move.OperationID)
+	if err != nil || interim == nil || interim.BaselineInstalled {
+		t.Fatalf("partially installed state = %+v, err = %v", interim, err)
+	}
+	if err := pair.recover(nil); err != nil {
+		t.Fatal(err)
+	}
+	installed, err := BBReadFolderMove(workdir, move.OperationID)
+	if err != nil || installed == nil || !installed.BaselineInstalled {
+		t.Fatalf("replayed state = %+v, err = %v", installed, err)
+	}
+}
