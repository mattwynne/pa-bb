+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd"
+	"github.com/rclone/rclone/cmd/bisync"
+	"github.com/rclone/rclone/fs"
+	"github.com/spf13/cobra"
+	"golang.org/x/sys/unix"
+)
+
+const maxOwnedFrame = 8 << 20
+
+type ownedNoteFrame struct {
+	Binding     string            `json:"binding"`
+	Path        string            `json:"path"`
+	Source      string            `json:"source,omitempty"`
+	Expected    *ownedNoteVersion `json:"expected,omitempty"`
+	Workdir     string            `json:"workdir,omitempty"`
+	OperationID string            `json:"operationId,omitempty"`
+	Text        string            `json:"text,omitempty"`
+	WantedHash  string            `json:"wantedHash,omitempty"`
+}
+
+type ownedNoteVersion struct {
+	DocumentID string `json:"documentId"`
+	ParentID   string `json:"parentId"`
+	ETag       string `json:"etag"`
+	Hash       string `json:"hash"`
+}
+
+type ownedNoteReply struct {
+	Outcome        string                `json:"outcome"`
+	Binding        string                `json:"binding,omitempty"`
+	Observation    *ownedNoteObservation `json:"observation,omitempty"`
+	SourceRetained bool                  `json:"sourceRetained,omitempty"`
+	ConflictCopy   string                `json:"conflictCopy,omitempty"`
+}
+
+type ownedNoteObservation struct {
+	ownedNoteVersion
+	ModifiedMs int64 `json:"modifiedMs"`
+	Size       int64 `json:"size"`
+}
+
+func readOwnedNoteFrame(in io.Reader) (ownedNoteFrame, error) {
+	var message ownedNoteFrame
+	raw, err := io.ReadAll(io.LimitReader(in, maxOwnedFrame+1))
+	if err != nil || len(raw) > maxOwnedFrame {
+		return message, api.ErrConditionalRefused
+	}
+	// Decode one complete frame and refuse unknown fields or trailing input.
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&message) != nil || decoder.Decode(new(any)) != io.EOF ||
+		(!validOwnedNoteFrame("binding", message) && !validOwnedNoteFrame("inspect", message)) {
+		return ownedNoteFrame{}, api.ErrConditionalRefused
+	}
+	return message, nil
+}
+
+func validOwnedNoteFrame(operation string, message ownedNoteFrame) bool {
+	if operation == "binding" {
+		return message.Workdir != "" && message.Binding == "" && message.Path == "" && message.Source == "" &&
+			message.Expected == nil && message.OperationID == "" && message.Text == "" && message.WantedHash == ""
+	}
+	return message.Binding != "" && message.Path != ""
+}
+
+func ownedNoteDeadline(operation string) time.Duration {
+	if operation == "relocate" || operation == "reconcile-relocation" {
+		return 24 * time.Second
+	}
+	return 12 * time.Second
+}
+
+func init() {
+	command := &cobra.Command{
+		Use:    "bb-owned-note <operation> <bound-remote>",
+		Short:  "Run one scoped note operation through the inherited iCloud worker.",
+		Hidden: true,
+		Args:   cobra.ExactArgs(2),
+		RunE: func(_ *cobra.Command, args []string) error {
+			message, err := readOwnedNoteFrame(os.Stdin)
+			if err != nil {
+				return json.NewEncoder(os.Stdout).Encode(ownedNoteReply{Outcome: "refused"})
+			}
+			if !validOwnedNoteFrame(args[0], message) || (args[0] != "inspect" && args[0] != "inspect-relocation" && !ownInheritedMutationLock(message.Workdir)) {
+				return json.NewEncoder(os.Stdout).Encode(ownedNoteReply{Outcome: "refused"})
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), ownedNoteDeadline(args[0]))
+			defer cancel()
+			return json.NewEncoder(os.Stdout).Encode(applyOwnedNote(ctx, args[0], args[1], message))
+		},
+	}
+	cmd.Root.AddCommand(command)
+}
+
+func applyOwnedNote(ctx context.Context, operation, remote string, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	if !validOwnedNoteFrame(operation, request) {
+		return refused
+	}
+	if operation != "inspect" && operation != "replace" && operation != "recover" && operation != "create" && operation != "recover-create" && operation != "relocate" && operation != "binding" && operation != "inspect-relocation" && operation != "reconcile-relocation" && operation != "read-relocation-resolution" {
+		return refused
+	}
+	backend, name, root, config, err := fs.ConfigFs(remote)
+	if err != nil || name != "icloud" || root == "" || backend.Name != "iclouddrive" {
+		return refused
+	}
+	if operation == "read-relocation-resolution" {
+		// The exact workdir and move receipt already carry the scope.
+		// Checking the durable closure record needs no provider session.
+		return applyRelocationOperation(ctx, nil, request, operation)
+	}
+	selected, err := backend.NewFs(ctx, name, root, config)
+	if err != nil {
+		return uncertain
+	}
+	cloud, ok := selected.(*iclouddrive.Fs)
+	if !ok {
+		return refused
+	}
+	binding, err := cloud.BBMirrorBinding(ctx)
+	if err != nil {
+		return refused
+	}
+	if operation == "binding" {
+		return ownedNoteReply{Outcome: "bound", Binding: binding}
+	}
+	if binding != request.Binding {
+		return refused
+	}
+	if operation == "relocate" || operation == "reconcile-relocation" || operation == "read-relocation-resolution" {
+		return applyRelocationOperation(ctx, cloud, request, operation)
+	}
+	if operation == "inspect-relocation" {
+		if request.Source == "" || request.Expected != nil || request.OperationID != "" || request.Text != "" || request.WantedHash != "" {
+			return refused
+		}
+		source, err := cloud.ObserveBBCreate(ctx, request.Source)
+		if err != nil || !cloud.BBNoteAbsent(ctx, request.Path) {
+			return refused
+		}
+		return observedOwnedNote("observed", source)
+	}
+	if request.Source != "" || request.WantedHash != "" {
+		return refused
+	}
+	if operation == "inspect" {
+		if request.Expected != nil || request.Text != "" {
+			return refused
+		}
+		published, err := cloud.ObserveBBCreate(ctx, request.Path)
+		if errors.Is(err, fs.ErrorObjectNotFound) {
+			return ownedNoteReply{Outcome: "absent"}
+		}
+		if err != nil {
+			return uncertain
+		}
+		return observedOwnedNote("observed", published)
+	}
+	if operation == "create" || operation == "recover-create" {
+		return applyOwnedCreate(ctx, cloud, operation, request)
+	}
+	if request.Expected == nil || len(request.Text) < 1 || len(request.Text) > 1<<20 {
+		return refused
+	}
+	prior := request.Expected
+	priorHash, err := hex.DecodeString(prior.Hash)
+	if err != nil || len(priorHash) != 32 || prior.DocumentID == "" || prior.ParentID == "" || prior.ETag == "" {
+		return refused
+	}
+	revision := iclouddrive.BBNoteRevision{DriveID: prior.DocumentID, ParentID: prior.ParentID, ETag: prior.ETag}
+	copy(revision.Hash[:], priorHash)
+	wanted := sha256.Sum256([]byte(request.Text))
+	intent := bisync.BBDeliveryIntent{OperationID: request.OperationID, Path: request.Path, Hash: wanted}
+	if err := bisync.BBCheckDeliveryDisjoint(request.Workdir, intent, revision.DriveID); err != nil {
+		return refused
+	}
+	stage, stageErr := bisync.BBReadDeliveryStage(request.Workdir, intent)
+	if stageErr != nil {
+		return uncertain
+	}
+	if operation == "recover" {
+		now, err := cloud.InspectBBNote(ctx, request.Path)
+		if err != nil || now.Revision.DriveID != revision.DriveID || now.Revision.ParentID != revision.ParentID {
+			return uncertain
+		}
+		if now.Revision.ETag != revision.ETag && now.Revision.Hash == wanted {
+			if stage == bisync.BBDeliveryDispatched {
+				if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: now.Modified, Size: now.Size, ProviderID: now.Revision.DriveID, ETag: now.Revision.ETag}); err != nil {
+					return uncertain
+				}
+			} else if stage != bisync.BBDeliveryRecorded && stage != bisync.BBDeliveryApplied {
+				return uncertain
+			}
+			return observedOwnedNote("published", now)
+		}
+		// A recovered retry is conditional on the original, freshly checked
+		// identity, revision and bytes. Even if the first request is still
+		// finishing remotely, only one request can use this ETag.
+		if now.Revision.ETag != revision.ETag || now.Revision.Hash != revision.Hash ||
+			(stage != bisync.BBDeliveryPrepared && stage != bisync.BBDeliveryDispatched && stage != bisync.BBDeliveryMissing) {
+			return uncertain
+		}
+	}
+	if operation == "replace" || stage == bisync.BBDeliveryMissing {
+		if err := bisync.BBBeginDelivery(request.Workdir, intent, revision.DriveID); err != nil {
+			return refused
+		}
+	}
+	published, err := cloud.ReplaceBBNoteWithDispatch(ctx, request.Path, revision, []byte(request.Text),
+		func() error { return bisync.BBDispatchDelivery(request.Workdir, intent) })
+	if errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+		if err := bisync.BBResolveDelivery(request.Workdir, intent, nil); err != nil {
+			return uncertain
+		}
+		return refused
+	}
+	if err != nil {
+		return uncertain
+	}
+	if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: published.Modified, Size: published.Size, ProviderID: published.Revision.DriveID, ETag: published.Revision.ETag}); err != nil {
+		return uncertain
+	}
+	return observedOwnedNote("published", published)
+}
+
+func applyOwnedCreate(ctx context.Context, cloud *iclouddrive.Fs, operation string, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	if request.Expected != nil || len(request.Text) < 1 || len(request.Text) > 1<<20 {
+		return refused
+	}
+	data := []byte(request.Text)
+	intent := bisync.BBDeliveryIntent{OperationID: request.OperationID, Path: request.Path, Hash: sha256.Sum256(data), Create: true}
+	if err := bisync.BBCheckDeliveryDisjoint(request.Workdir, intent); err != nil {
+		return refused
+	}
+	stage, err := bisync.BBReadDeliveryStage(request.Workdir, intent)
+	if err != nil {
+		return uncertain
+	}
+	if operation == "recover-create" {
+		current, err := cloud.ObserveBBCreate(ctx, request.Path)
+		if err == nil && current.Revision.Hash == intent.Hash {
+			issued, err := bisync.BBAllocatedDocument(request.Workdir, intent)
+			_, _, currentDocID := api.DeconstructDriveID(current.Revision.DriveID)
+			if err != nil || currentDocID != issued {
+				return uncertain
+			}
+			if stage == bisync.BBDeliveryDispatched {
+				if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: current.Modified, Size: current.Size, ProviderID: current.Revision.DriveID, ETag: current.Revision.ETag}); err != nil {
+					return uncertain
+				}
+			} else if stage != bisync.BBDeliveryRecorded && stage != bisync.BBDeliveryApplied {
+				return uncertain
+			}
+			return observedOwnedNote("published", current)
+		}
+		if !errors.Is(err, fs.ErrorObjectNotFound) || (stage != bisync.BBDeliveryMissing && stage != bisync.BBDeliveryPrepared) {
+			return uncertain
+		}
+	}
+	if operation == "create" || stage == bisync.BBDeliveryMissing {
+		if err := bisync.BBBeginDelivery(request.Workdir, intent); err != nil {
+			return refused
+		}
+	}
+	published, err := cloud.CreateBBNote(ctx, request.Path, request.Binding, data,
+		func(id string) error { return bisync.BBDispatchDelivery(request.Workdir, intent, id) })
+	if errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+		if err := bisync.BBResolveDelivery(request.Workdir, intent, nil); err != nil {
+			return uncertain
+		}
+		return refused
+	}
+	if err != nil {
+		return uncertain
+	}
+	if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: published.Modified, Size: published.Size, ProviderID: published.Revision.DriveID, ETag: published.Revision.ETag}); err != nil {
+		return uncertain
+	}
+	return observedOwnedNote("published", published)
+}
+
+func observedOwnedNote(outcome string, result iclouddrive.BBNotePublication) ownedNoteReply {
+	return ownedNoteReply{Outcome: outcome, Observation: &ownedNoteObservation{
+		ownedNoteVersion: ownedNoteVersion{result.Revision.DriveID, result.Revision.ParentID, result.Revision.ETag, hex.EncodeToString(result.Revision.Hash[:])},
+		ModifiedMs:       result.Modified.UnixMilli(), Size: result.Size,
+	}}
+}
+
+// The BB owner opens the same per-mirror mutation phase file for both
+// its fast command and its scheduled scan. Never substitute a CLI path.
+func ownInheritedMutationLock(workdir string) bool {
+	const phaseFD = 5
+	var stat unix.Stat_t
+	if unix.Fstat(phaseFD, &stat) != nil || int(stat.Uid) != os.Getuid() || stat.Nlink != 1 ||
+		stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Mode&0077 != 0 {
+		return false
+	}
+	var bound, root unix.Stat_t
+	if !filepath.IsAbs(workdir) || filepath.Clean(workdir) != workdir ||
+		unix.Lstat(workdir, &root) != nil || root.Mode&unix.S_IFMT != unix.S_IFDIR || root.Mode&0077 != 0 || int(root.Uid) != os.Getuid() ||
+		unix.Lstat(filepath.Join(workdir, bisync.BBMutationLockName), &bound) != nil || bound.Dev != stat.Dev || bound.Ino != stat.Ino {
+		return false
+	}
+	return unix.Flock(phaseFD, unix.LOCK_EX|unix.LOCK_NB) == nil
+}
