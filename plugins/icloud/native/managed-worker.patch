+package bisync
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+
+	"github.com/rclone/rclone/fs"
+)
+
+const BBMutationLockName = "bb-managed-mutation.lock"
+
+var errBBManagedScanRetryable = errors.New("managed bisync stopped before a retryable failure")
+
+// BBManagedBisync shares the mutation phase fence with expedited writes.
+// There is no ordinary-bisync fallback after a mirror starts using this mode.
+func BBManagedBisync(ctx context.Context, cloud, local fs.Fs, options Options, binding ...string) error {
+	if options.Resync || options.DryRun || options.CheckSync != CheckSyncTrue || !filepath.IsAbs(options.Workdir) ||
+		options.CompareFlag != "size,modtime" {
+		return errors.New("unsupported managed bisync options")
+	}
+	if len(binding) == 1 && binding[0] != "" {
+		options.bbReadVersions = true
+	}
+	options.bbMutationLock = filepath.Join(options.Workdir, BBMutationLockName)
+	options.bbBeforeScan = func(ctx context.Context, b *bisyncRun) error {
+		release, err := bbAcquireMutationPhase(ctx, options.bbMutationLock)
+		if err != nil {
+			return err
+		}
+		pair, err := bbPairFor(b.listing1, b.listing2)
+		if err == nil {
+			err = pair.recover(nil)
+		}
+		return errors.Join(err, release())
+	}
+	options.beforeDeltas = func(ctx context.Context, b *bisyncRun) error {
+		return b.incorporateBBDeliveries(ctx)
+	}
+	options.bbAfterSync = func(ctx context.Context, b *bisyncRun) error {
+		if err := b.finishBBContentDeltas(ctx); err != nil {
+			return err
+		}
+		if options.bbReadVersions {
+			return b.writeBBVersionIndex(ctx, binding[0])
+		}
+		return nil
+	}
+	return Bisync(ctx, cloud, local, &options)
+}
+
+func (b *bisyncRun) incorporateBBDeliveries(ctx context.Context) error {
+	state, err := readBBDeliveries(b.workDir)
+	if err != nil {
+		return err
+	}
+	if state.Pending != nil || state.Relocation != nil {
+		return ErrBBDeliveryUnsettled
+	}
+	if len(state.Confirmed) == 0 {
+		return nil
+	}
+	pair, err := bbPairFor(b.listing1, b.listing2)
+	if err != nil {
+		return err
+	}
+	if err := pair.recover(nil); err != nil {
+		return err
+	}
+	// A confirmed publication is the shared baseline. When a newer provider
+	// version has the same listing metadata, keep its content delta until the
+	// local copy is verified. A restarted scan can recognize completed copies.
+	b.bbContentDeltas = make(map[string]bbContentDelta)
+	for _, receipt := range state.Confirmed {
+		later, err := bbRemoteContentDelta(ctx, b.fs1, receipt)
+		if err != nil {
+			return err
+		}
+		localBaseline := receipt.Hash
+		if later != nil {
+			local, err := b.fs2.NewObject(ctx, receipt.Path)
+			if err != nil {
+				return err
+			}
+			localHash, err := bbNoteHash(ctx, local)
+			if err != nil {
+				return err
+			}
+			mirrored := localHash == *later
+			b.bbContentDeltas[receipt.Path] = bbContentDelta{receipt.Hash, *later, mirrored}
+			if mirrored {
+				localBaseline = *later
+			}
+		}
+		if err := bbConfirmLocalReceiptTime(b.fs2.Root(), receipt.Path, localBaseline, receipt.Modified, nil); err != nil {
+			return err
+		}
+	}
+	var before [2][sha256.Size]byte
+	var after [2][]byte
+	for i, file := range pair.listings {
+		raw, err := bbReadBounded(file, bbListingLimit)
+		if err != nil {
+			return err
+		}
+		before[i] = sha256.Sum256(raw)
+		previous, err := b.loadListing(file)
+		if err != nil {
+			return err
+		}
+		for _, r := range state.Confirmed {
+			if r.RemovedPath != "" {
+				if previous.isDir(r.RemovedPath) {
+					return errBBInvalidDelivery
+				}
+				previous.remove(r.RemovedPath)
+			}
+			if previous.isDir(r.Path) || (!r.Create && !previous.has(r.Path)) {
+				return errBBInvalidDelivery
+			}
+			previous.remove(r.Path)
+			previous.put(r.Path, r.Size, r.Modified, "", "", "-")
+		}
+		tmp, err := os.CreateTemp(b.workDir, ".bb-listings-proposal-")
+		if err != nil {
+			return err
+		}
+		name := tmp.Name()
+		defer os.Remove(name)
+		if err := tmp.Close(); err != nil {
+			return err
+		}
+		if err := previous.save(name); err != nil {
+			return err
+		}
+		after[i], err = bbReadBounded(name, bbListingLimit)
+		if err != nil {
+			return err
+		}
+	}
+	if err := pair.begin(before, after); err != nil {
+		return err
+	}
+	if err := pair.recover(nil); err != nil {
+		return err
+	}
+	for _, receipt := range state.Confirmed {
+		for _, name := range []string{receipt.Path, receipt.RemovedPath} {
+			if name == "" {
+				continue
+			}
+			if err := b.refreshPublishedPath(ctx, name); err != nil {
+				return err
+			}
+			if err := bbRefreshVersion(ctx, b.fs1, name, b.march.bbIdentities); err != nil {
+				return err
+			}
+		}
+	}
+	return b.settleBBDeliveries(ctx, state, false)
+}
+
+type bbContentDelta struct {
+	published [sha256.Size]byte
+	incoming  [sha256.Size]byte
+	mirrored  bool
+}
+
+func (b *bisyncRun) finishBBContentDeltas(ctx context.Context) error {
+	if len(b.bbContentDeltas) == 0 {
+		return nil
+	}
+	state, err := readBBDeliveries(b.workDir)
+	if err != nil {
+		return err
+	}
+	return b.settleBBDeliveries(ctx, state, true)
+}
+
+func (b *bisyncRun) settleBBDeliveries(ctx context.Context, state bbDeliveryStore, finished bool) error {
+	remaining := make([]BBDeliveryReceipt, 0, len(state.Confirmed))
+	for _, receipt := range state.Confirmed {
+		if change, ok := b.bbContentDeltas[receipt.Path]; ok {
+			if !finished {
+				remaining = append(remaining, receipt)
+				continue
+			}
+			local, err := b.fs2.NewObject(ctx, receipt.Path)
+			if err != nil {
+				return err
+			}
+			digest, err := bbNoteHash(ctx, local)
+			if err != nil {
+				return err
+			}
+			if digest != change.incoming {
+				return errBBContentChangedDuringScan
+			}
+		}
+		state.Applied = append(state.Applied, receipt)
+	}
+	if len(state.Applied) > bbDeliveryLimit {
+		state.Applied = state.Applied[len(state.Applied)-bbDeliveryLimit:]
+	}
+	state.Confirmed = remaining
+	return state.write(b.workDir)
+}
+
+var errBBContentChangedDuringScan = errors.New("note content changed during managed reconciliation")
+
+// iCloud listing timestamps have one-second resolution. A later cloud edit
+// can have identical listing metadata to the publication that preceded it.
+func bbRemoteContentDelta(ctx context.Context, cloud fs.Fs, receipt BBDeliveryReceipt) (*[sha256.Size]byte, error) {
+	if receipt.ETag == "" || receipt.ProviderID == "" {
+		return nil, nil
+	}
+	obj, err := cloud.NewObject(ctx, receipt.Path)
+	if errors.Is(err, fs.ErrorObjectNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	listed, ok := bbCloudVersionFrom(ctx, obj)
+	if !ok {
+		return nil, errBBInvalidDelivery
+	}
+	if listed.DocumentID == receipt.ProviderID && listed.ETag == receipt.ETag {
+		return nil, nil
+	}
+	if obj.Size() != receipt.Size || timeDiffers(ctx, obj.ModTime(ctx), receipt.Modified, cloud, cloud) {
+		return nil, nil
+	}
+	digest, err := bbNoteHash(ctx, obj)
+	if err != nil || digest == receipt.Hash {
+		return nil, err
+	}
+	return &digest, nil
+}
+
+func bbNoteHash(ctx context.Context, obj fs.Object) ([sha256.Size]byte, error) {
+	var digest [sha256.Size]byte
+	if obj.Size() < 0 || obj.Size() > bbDeliveryBytes {
+		return digest, errBBContentChangedDuringScan
+	}
+	body, err := obj.Open(ctx)
+	if err != nil {
+		return digest, err
+	}
+	h := sha256.New()
+	n, readErr := io.Copy(h, io.LimitReader(body, bbDeliveryBytes+1))
+	if err := errors.Join(readErr, body.Close()); err != nil {
+		return digest, err
+	}
+	if n != obj.Size() || n > bbDeliveryBytes {
+		return digest, errBBContentChangedDuringScan
+	}
+	return [sha256.Size]byte(h.Sum(nil)), nil
+}
