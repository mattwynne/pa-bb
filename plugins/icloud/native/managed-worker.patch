+func TestBBMovedFolderCreationKeepsVerifiedParentThroughReconciliation(t *testing.T) {
+	const binding, oldPath, newPath = "binding", "old/Folder", "new/Folder"
+	root := BBIndexedVersion{DocumentID: "folder", ParentID: "old", ETag: "before"}
+	prior := BBIndexedVersion{DocumentID: "child", ParentID: "folder", ETag: "untouched"}
+	folder := BBFolderMoveIntent{
+		OperationID: "1d73db11-f4ce-4148-9081-48e27e8e1d83", Binding: binding, Source: oldPath, Path: newPath, DestinationParent: "new",
+		Entries: map[string]BBTreeIdentity{oldPath: {root, true}, oldPath + "/Existing.md": {prior, false}},
+		Hashes:  map[string][sha256.Size]byte{oldPath + "/Existing.md": sha256.Sum256([]byte("existing"))},
+	}
+	body := []byte("first BB note after move")
+	creation := BBDeliveryIntent{"1eb96515-4168-4e82-beff-574bfc347a29", newPath + "/New.md", sha256.Sum256(body), true}
+	workdir := t.TempDir()
+	if err := BBPrepareFolderMove(workdir, folder); err != nil {
+		t.Fatal(err)
+	}
+	if parent, err := BBExpectedCreationParent(workdir, binding, creation); parent != "" || !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("unacknowledged move provided parent %q, %v", parent, err)
+	}
+	after := BBIndexedVersion{DocumentID: root.DocumentID, ParentID: "new", ETag: "moved"}
+	if err := BBDispatchFolderMove(workdir, folder.OperationID); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBConfirmFolderMove(workdir, folder.OperationID, after); err != nil {
+		t.Fatal(err)
+	}
+	if parent, err := BBExpectedCreationParent(workdir, binding, creation); parent != after.DocumentID || err != nil {
+		t.Fatalf("acknowledged move provided parent %q, %v", parent, err)
+	}
+	refused := creation
+	for _, name := range []string{newPath + "/existing.md", oldPath + "/New.md", "NEW/Folder/New.md"} {
+		refused.Path = name
+		if _, err := BBExpectedCreationParent(workdir, binding, refused); !errors.Is(err, ErrBBDeliveryUnsettled) {
+			t.Fatalf("held path %q was eligible: %v", name, err)
+		}
+	}
+	if err := BBBeginDeliveryInMovedFolder(workdir, creation, body, "same-name-replacement"); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("wrong parent prepared: %v", err)
+	}
+	if err := BBBeginDeliveryInMovedFolder(workdir, creation, body, after.DocumentID); err != nil {
+		t.Fatal(err)
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil || state.FolderMove == nil {
+		t.Fatal("missing durable move", err)
+	}
+	state.finishBBFolder(state.FolderMove, after, false)
+	if err := state.write(workdir); err != nil {
+		t.Fatal(err)
+	}
+	if parent, err := BBExpectedCreationParent(workdir, binding, creation); parent != after.DocumentID || err != nil {
+		t.Fatalf("pending creation lost its parent after remap: %q, %v", parent, err)
+	}
+	if err := BBDispatchDelivery(workdir, creation, "allocated"); err != nil {
+		t.Fatal(err)
+	}
+	receipt := BBDeliveryReceipt{BBDeliveryIntent: creation, ProviderID: "FILE::zone::allocated",
+		ProviderParentID: "same-name-replacement", ETag: "result", Modified: time.Now(), Size: int64(len(body))}
+	if err := BBResolveDelivery(workdir, creation, &receipt); !errors.Is(err, errBBInvalidDelivery) {
+		t.Fatalf("wrong parent settled: %v", err)
+	}
+	receipt.ProviderParentID = after.DocumentID
+	if err := BBResolveDelivery(workdir, creation, &receipt); err != nil {
+		t.Fatal(err)
+	}
+	state, err = readBBDeliveries(workdir)
+	if err != nil || state.Pending != nil || state.PendingCreateParent != "" || len(state.Confirmed) != 1 || state.Confirmed[0].DocumentID != "allocated" {
+		t.Fatalf("bounded receipt not recorded: %+v, %v", state, err)
+	}
+}
