+func TestBBTransferPhasePreservesReceiptFromDisjointConcurrentWrite(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	workdir, cloudRoot, localRoot := t.TempDir(), t.TempDir(), t.TempDir()
+	baseline := time.Unix(1700000000, 0)
+	publication := baseline.Add(2 * time.Minute)
+	const kept = "Keep.md"
+	const changed = "Transfer.md"
+	const prior = "Prior.md"
+	write := func(root, name, body string, when time.Time) {
+		t.Helper()
+		filename := filepath.Join(root, name)
+		if err := os.WriteFile(filename, []byte(body), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(filename, when, when); err != nil {
+			t.Fatal(err)
+		}
+	}
+	check := func(root, name, expected string) {
+		t.Helper()
+		body, err := os.ReadFile(filepath.Join(root, name))
+		if err != nil || string(body) != expected {
+			t.Fatalf("%s = %q, %v", name, body, err)
+		}
+	}
+	for _, root := range []string{cloudRoot, localRoot} {
+		for _, name := range []string{kept, changed, prior} {
+			write(root, name, "baseline", baseline)
+		}
+	}
+	cloud, err := local.NewFs(ctx, "local", cloudRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mirror, err := local.NewFs(ctx, "local", localRoot, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	opts := Options{Resync: true, Workdir: workdir, CompareFlag: "size,modtime", CheckSync: CheckSyncTrue, MaxDelete: 50}
+	if err := Bisync(ctx, cloud, mirror, &opts); err != nil {
+		t.Fatal(err)
+	}
+	opts.Resync = false
+	fs1 := bbPhaseVersionedCloud{cloud}
+	// The existing receipt has a later cloud edit with the same metadata.
+	// This forces the scheduled finalization to reopen the journal.
+	const publicationID = "1e1e7f71-93c9-4845-91b2-57175de2c5d4"
+	old := BBDeliveryIntent{OperationID: publicationID, Path: prior, Hash: sha256.Sum256([]byte("published"))}
+	if err := BBBeginDelivery(workdir, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := BBResolveDelivery(workdir, old, &BBDeliveryReceipt{
+		BBDeliveryIntent: old, Modified: publication, Size: int64(len("published")),
+		ProviderID: "document-" + prior, ETag: "publication-etag",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	write(cloudRoot, prior, "from Mac!", publication)
+	write(localRoot, prior, "published", publication)
+	write(localRoot, changed, "queued upload", baseline.Add(time.Minute))
+
+	transferring, resume := make(chan struct{}), make(chan struct{})
+	var notify sync.Once
+	var resumeOnce sync.Once
+	releaseTransfers := func() { resumeOnce.Do(func() { close(resume) }) }
+	defer releaseTransfers()
+	opts.TestFn = func() {
+		notify.Do(func() { close(transferring) })
+		select {
+		case <-resume:
+		case <-ctx.Done():
+		}
+	}
+	completed := make(chan error, 1)
+	go func() { completed <- BBManagedBisync(ctx, fs1, mirror, opts, "binding") }()
+	select {
+	case <-transferring:
+	case err := <-completed:
+		t.Fatalf("scheduled sync ended before the transfer hook: %v", err)
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	noPrimary := func() bool { return false }
+	if release, allowed := BBTryTransferWriteAdmission(workdir, changed, "document-"+changed, "parent", noPrimary); allowed {
+		_ = release()
+		t.Fatal("the active queue admitted an overlapping write")
+	}
+	release, allowed := BBTryTransferWriteAdmission(workdir, kept, "document-"+kept, "parent", noPrimary)
+	if !allowed {
+		t.Fatal("the active queue blocked an independent replacement")
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	const created = "New.md"
+	const createBody = "independent new BB note"
+	creationRelease, parent, ok := BBTryTransferCreationAdmission(workdir, created, noPrimary)
+	if !ok || parent != "binding" {
+		t.Fatalf("the active queue blocked new note admission: %q, %t", parent, ok)
+	}
+	newBody := []byte(createBody)
+	creation := BBDeliveryIntent{OperationID: "6dae1ed4-6599-478d-bfcf-a5631f5339cf", Path: created, Hash: sha256.Sum256(newBody), Create: true}
+	if err := BBBeginDeliveryInTransfer(workdir, creation, newBody, parent); err != nil {
+		_ = creationRelease()
+		t.Fatal(err)
+	}
+	if err := BBDispatchDelivery(workdir, creation, "allocated"); err != nil {
+		_ = creationRelease()
+		t.Fatal(err)
+	}
+	write(cloudRoot, created, createBody, publication)
+	write(localRoot, created, createBody, publication)
+	if err := BBResolveDelivery(workdir, creation, &BBDeliveryReceipt{
+		BBDeliveryIntent: creation, Modified: publication, Size: int64(len(newBody)),
+		ProviderID: "document-" + created, ProviderParentID: parent, ETag: publication.String(),
+	}); err != nil {
+		_ = creationRelease()
+		t.Fatal(err)
+	}
+	if err := creationRelease(); err != nil {
+		t.Fatal(err)
+	}
+	release, allowed = BBTryTransferWriteAdmission(workdir, kept, "document-"+kept, "parent", noPrimary)
+	if !allowed {
+		t.Fatal("the active queue blocked an independent replacement")
+	}
+	body := []byte("from BB")
+	operation := BBDeliveryIntent{OperationID: "82d7248d-d062-4f11-be5f-a6ad85024fd7", Path: kept, Hash: sha256.Sum256(body)}
+	if err := BBBeginDeliveryWithData(workdir, operation, body, "document-"+kept); err != nil {
+		_ = release()
+		t.Fatal(err)
+	}
+	write(cloudRoot, kept, string(body), publication)
+	write(localRoot, kept, string(body), publication)
+	if err := BBResolveDelivery(workdir, operation, &BBDeliveryReceipt{
+		BBDeliveryIntent: operation, Modified: publication, Size: int64(len(body)),
+		ProviderID: "document-" + kept, ETag: publication.String(),
+	}); err != nil {
+		_ = release()
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	releaseTransfers()
+	if err := <-completed; err != nil {
+		t.Fatal(err)
+	}
+	state, err := readBBDeliveries(workdir)
+	if err != nil || len(state.Confirmed) != 2 || state.Confirmed[0].BBDeliveryIntent != creation || state.Confirmed[1].BBDeliveryIntent != operation {
+		t.Fatalf("later operation was consumed by the earlier scan: %+v, %v", state.Confirmed, err)
+	}
+	check(localRoot, prior, "from Mac!")
+	check(cloudRoot, changed, "queued upload")
+	check(cloudRoot, kept, "from BB")
+	check(cloudRoot, created, createBody)
+	write(cloudRoot, kept, "Mac edit", publication.Add(time.Second))
+	opts.TestFn = nil
+	if err := BBManagedBisync(ctx, fs1, mirror, opts, "binding"); err != nil {
+		t.Fatal(err)
+	}
+	check(localRoot, kept, "Mac edit")
+	check(localRoot, created, createBody)
+}
