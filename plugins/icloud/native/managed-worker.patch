+package bisync
+
+import (
+	"crypto/sha256"
+	"slices"
+	"strings"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// BBRelocationIntent binds a locally committed move to the acknowledged
+// source revision. The destination can contain different bytes after a link
+// rewrite. Its hash is independent of the source hash.
+type BBRelocationIntent struct {
+	BBDeliveryIntent
+	Source     string
+	Binding    string
+	Previous   BBIndexedVersion
+	SourceHash [sha256.Size]byte
+}
+
+// BBRelocation retains the destination bytes across ambiguous requests and
+// intervening local edits. It excludes both stock publication and other fast
+// commands until both endpoints have a verified baseline.
+type BBRelocation struct {
+	Intent      BBRelocationIntent
+	Data        []byte
+	Allocation  string
+	Destination *BBDeliveryReceipt
+	Removing    bool
+}
+
+func equalBBPaths(a, b string) bool {
+	return strings.EqualFold(norm.NFC.String(a), norm.NFC.String(b))
+}
+
+func validBBRelocationPaths(source string, destination BBDeliveryIntent) bool {
+	from := destination
+	from.Path = source
+	return validBBDelivery(from) && !equalBBPaths(source, destination.Path)
+}
+
+func (r BBRelocation) valid() bool {
+	intent := r.Intent
+	if !validBBDelivery(intent.BBDeliveryIntent) || !intent.Create ||
+		!validBBRelocationPaths(intent.Source, intent.BBDeliveryIntent) ||
+		intent.Binding == "" || len(intent.Binding) > 512 ||
+		intent.Previous.DocumentID == "" || len(intent.Previous.DocumentID) > 512 ||
+		intent.Previous.ETag == "" || len(intent.Previous.ETag) > 512 ||
+		intent.Previous.ParentID == "" || len(intent.Previous.ParentID) > 512 ||
+		intent.SourceHash == ([sha256.Size]byte{}) || len(r.Allocation) > 512 ||
+		len(r.Data) < 1 || len(r.Data) > bbDeliveryBytes ||
+		sha256.Sum256(r.Data) != intent.Hash || (r.Removing && r.Destination == nil) {
+		return false
+	}
+	if target := r.Destination; target != nil {
+		return r.Allocation != "" && target.BBDeliveryIntent == intent.BBDeliveryIntent &&
+			target.RemovedPath == intent.Source && target.DocumentID == r.Allocation &&
+			target.ProviderID != "" && target.ProviderID != intent.Previous.DocumentID &&
+			target.ETag != "" && target.ProviderParentID != "" && !target.Modified.IsZero() && target.Size == int64(len(r.Data))
+	}
+	return true
+}
+
+// These calls require the per-mirror mutation lock. Returning a known
+// operation never changes its scope or reopens a completed relocation.
+func BBReadRelocation(workdir string, intent BBRelocationIntent) (*BBRelocation, *BBDeliveryReceipt, error) {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return nil, nil, err
+	}
+	if state.Relocation != nil {
+		if state.Relocation.Intent != intent {
+			return nil, nil, ErrBBDeliveryUnsettled
+		}
+		return state.Relocation, nil, nil
+	}
+	for _, candidates := range [][]BBDeliveryReceipt{state.Confirmed, state.Applied} {
+		for _, receipt := range candidates {
+			if receipt.OperationID == intent.OperationID {
+				if receipt.BBDeliveryIntent != intent.BBDeliveryIntent || receipt.RemovedPath != intent.Source {
+					return nil, nil, errBBInvalidDelivery
+				}
+				return nil, &receipt, nil
+			}
+		}
+	}
+	return nil, nil, nil
+}
+
+func BBBeginRelocation(workdir string, intent BBRelocationIntent, data []byte) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := BBRelocation{Intent: intent, Data: data}
+	if !move.valid() {
+		return errBBInvalidDelivery
+	}
+	related := func(r BBDeliveryReceipt) bool {
+		return !bbRelocationSupersedes(intent, r) && (r.OperationID == intent.OperationID ||
+			equalBBPaths(r.Path, intent.Path) || equalBBPaths(r.Path, intent.Source) ||
+			equalBBPaths(r.RemovedPath, intent.Path) || equalBBPaths(r.RemovedPath, intent.Source))
+	}
+	used := func(r BBDeliveryReceipt) bool { return r.OperationID == intent.OperationID }
+	canReplace := slices.ContainsFunc(state.Confirmed, func(r BBDeliveryReceipt) bool { return bbRelocationSupersedes(intent, r) })
+	if state.Pending != nil || state.Relocation != nil || (len(state.Confirmed) >= bbDeliveryLimit && !canReplace) ||
+		slices.ContainsFunc(state.Confirmed, related) || slices.ContainsFunc(state.Applied, used) {
+		return ErrBBDeliveryUnsettled
+	}
+	// Previous binaries reject this version instead of ignoring a pending
+	// relocation or applying a destination receipt without its tombstone.
+	state.Version = 2
+	state.Relocation = &move
+	return state.write(workdir)
+}
+
+// A prior publication of the exact source revision is absorbed into the
+// move. Retain that publication's evidence until source removal is proved.
+func bbRelocationSupersedes(intent BBRelocationIntent, prior BBDeliveryReceipt) bool {
+	return prior.OperationID != intent.OperationID && prior.RemovedPath == "" && prior.Path == intent.Source &&
+		prior.Hash == intent.SourceHash && prior.ProviderID == intent.Previous.DocumentID && prior.ETag == intent.Previous.ETag
+}
+
+func bbChangeRelocation(workdir string, intent BBRelocationIntent, transition func(*bbDeliveryStore, *BBRelocation) bool) error {
+	state, err := readBBDeliveries(workdir)
+	if err != nil {
+		return err
+	}
+	move := state.Relocation
+	if move == nil || move.Intent != intent || !transition(&state, move) ||
+		(state.Relocation != nil && !state.Relocation.valid()) {
+		return errBBInvalidDelivery
+	}
+	return state.write(workdir)
+}
+
+func BBAllocateRelocation(workdir string, intent BBRelocationIntent, allocation string) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation != "" || allocation == "" {
+			return false
+		}
+		move.Allocation = allocation
+		return true
+	})
+}
+
+func BBRecordRelocationDestination(workdir string, intent BBRelocationIntent, target BBDeliveryReceipt) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation == "" || move.Destination != nil {
+			return false
+		}
+		target.DocumentID = move.Allocation
+		target.RemovedPath = intent.Source
+		move.Destination = &target
+		return true
+	})
+}
+
+func BBDispatchRelocationTrash(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(_ *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Destination == nil || move.Removing {
+			return false
+		}
+		move.Removing = true
+		return true
+	})
+}
+
+func BBFinishRelocation(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if !move.Removing || move.Destination == nil {
+			return false
+		}
+		state.Confirmed = slices.DeleteFunc(state.Confirmed, func(prior BBDeliveryReceipt) bool {
+			if !bbRelocationSupersedes(intent, prior) {
+				return false
+			}
+			state.Applied = append(state.Applied, prior)
+			return true
+		})
+		if len(state.Confirmed) >= bbDeliveryLimit {
+			return false
+		}
+		if len(state.Applied) > bbDeliveryLimit {
+			state.Applied = state.Applied[len(state.Applied)-bbDeliveryLimit:]
+		}
+		state.Confirmed = append(state.Confirmed, *move.Destination)
+		state.Relocation = nil
+		return true
+	})
+}
+
+// Refuse a move only while no destination request could have reached iCloud.
+func BBRefuseRelocation(workdir string, intent BBRelocationIntent) error {
+	return bbChangeRelocation(workdir, intent, func(state *bbDeliveryStore, move *BBRelocation) bool {
+		if move.Allocation != "" {
+			return false
+		}
+		state.Relocation = nil
+		return true
+	})
+}
