+package bisync
+
+import (
+	"context"
+	"errors"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/hash"
+)
+
+// refreshPublishedPath discards just the scanned observations that may
+// predate a fast publication. The owner is responsible for fencing writers
+// and verifying the corresponding previous listings first.
+func (b *bisyncRun) refreshPublishedPath(ctx context.Context, name string) error {
+	if name == "." || name == "" || path.Clean(name) != name || !strings.HasSuffix(name, ".md") ||
+		strings.HasPrefix(name, "/") || strings.HasPrefix(name, "../") || b.aliases.Alias(name) != name {
+		return errors.New("path requires full reconciliation")
+	}
+	sides := []struct {
+		files   fs.Fs
+		listing *fileList
+		output  string
+	}{
+		{b.fs1, b.march.ls1, b.newListing1},
+		{b.fs2, b.march.ls2, b.newListing2},
+	}
+	for _, side := range sides {
+		if side.listing.hash != hash.None || side.listing.isDir(name) {
+			return errors.New("listing requires full reconciliation")
+		}
+		obj, err := side.files.NewObject(ctx, name)
+		if errors.Is(err, fs.ErrorObjectNotFound) {
+			side.listing.remove(name)
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if obj.Remote() != name {
+			return errors.New("file identity requires full reconciliation")
+		}
+		side.listing.remove(name)
+		side.listing.put(name, obj.Size(), obj.ModTime(ctx).In(TZ), "", "", "-")
+	}
+	for _, side := range sides {
+		if err := side.listing.save(side.output); err != nil {
+			return err
+		}
+	}
+	return nil
+}
