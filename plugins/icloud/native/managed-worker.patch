+func (f *ownedRecoveryFixture) write(id string, data []byte, dispatch func() error) (iclouddrive.BBNotePublication, error) {
+	f.attempts++
+	if f.beforeDispatch {
+		f.beforeDispatch = false
+		return iclouddrive.BBNotePublication{}, api.ErrConditionalUnconfirmed
+	}
+	if err := dispatch(); err != nil {
+		return iclouddrive.BBNotePublication{}, err
+	}
+	f.sent = bytes.Clone(data)
+	f.current = iclouddrive.BBNotePublication{
+		Revision: iclouddrive.BBNoteRevision{DriveID: id, ParentID: "parent", ETag: "published", Hash: sha256.Sum256(data)},
+		Modified: time.Unix(200, 0), Size: int64(len(data)),
+	}
+	if f.loseResponse {
+		f.loseResponse = false
+		return iclouddrive.BBNotePublication{}, api.ErrConditionalUnconfirmed
+	}
+	return f.current, nil
+}
