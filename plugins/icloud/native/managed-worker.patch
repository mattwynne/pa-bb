+package bisync
+
+import (
+	"crypto/sha256"
+	"errors"
+	"io"
+	"os"
+	"path"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+var errBBLocalSuperseded = errors.New("published note has been superseded locally")
+
+// Normalize only the inode whose bytes were confirmed in iCloud. A rename or
+// an atomic note replacement cannot redirect the timestamp change.
+func bbConfirmLocalReceiptTime(root, relative string, digest [sha256.Size]byte, mtime time.Time, beforeTimestamp func()) error {
+	if mtime.IsZero() {
+		return errBBLocalSuperseded
+	}
+	return bbCheckLocalReceipt(root, relative, digest, &mtime, beforeTimestamp)
+}
+
+func bbCheckLocalReceipt(root, relative string, digest [sha256.Size]byte, mtime *time.Time, beforeTimestamp func()) error {
+	if path.Clean(relative) != relative || path.IsAbs(relative) || relative == "." ||
+		strings.HasPrefix(relative, "../") || !strings.HasSuffix(relative, ".md") {
+		return errBBLocalSuperseded
+	}
+	folder, err := unix.Open(root, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = unix.Close(folder) }()
+	parts := strings.Split(relative, "/")
+	for _, part := range parts[:len(parts)-1] {
+		next, err := unix.Openat(folder, part, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_DIRECTORY, 0)
+		if err != nil {
+			return err
+		}
+		_ = unix.Close(folder)
+		folder = next
+	}
+	leaf := parts[len(parts)-1]
+	fd, err := unix.Openat(folder, leaf, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(fd), leaf)
+	defer file.Close()
+	stat, err := file.Stat()
+	if err != nil || !stat.Mode().IsRegular() || stat.Size() > 1<<20 {
+		return errBBLocalSuperseded
+	}
+	verify := func() error {
+		if _, err := file.Seek(0, io.SeekStart); err != nil {
+			return err
+		}
+		contents, err := io.ReadAll(io.LimitReader(file, (1<<20)+1))
+		if err != nil || len(contents) > 1<<20 || sha256.Sum256(contents) != digest {
+			return errBBLocalSuperseded
+		}
+		var bound, endpoint unix.Stat_t
+		if unix.Fstat(fd, &bound) != nil || unix.Fstatat(folder, leaf, &endpoint, unix.AT_SYMLINK_NOFOLLOW) != nil ||
+			bound.Dev != endpoint.Dev || bound.Ino != endpoint.Ino || bound.Size != endpoint.Size || bound.Mtim != endpoint.Mtim || bound.Ctim != endpoint.Ctim {
+			return errBBLocalSuperseded
+		}
+		return nil
+	}
+	if err := verify(); err != nil {
+		return err
+	}
+	if mtime == nil {
+		return nil
+	}
+	if beforeTimestamp != nil {
+		beforeTimestamp()
+	}
+	touched := unix.NsecToTimeval(mtime.UnixNano())
+	if err := unix.Futimes(fd, []unix.Timeval{touched, touched}); err != nil {
+		return err
+	}
+	return verify()
+}
