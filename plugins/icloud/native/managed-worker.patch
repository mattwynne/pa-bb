+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd"
+	"github.com/rclone/rclone/cmd/bisync"
+	"github.com/rclone/rclone/fs"
+	"github.com/spf13/cobra"
+	"golang.org/x/sys/unix"
+)
+
+const maxOwnedFrame = 8 << 20
+
+type ownedNoteFrame struct {
+	Binding              string             `json:"binding"`
+	Path                 string             `json:"path"`
+	Source               string             `json:"source,omitempty"`
+	Expected             *ownedNoteVersion  `json:"expected,omitempty"`
+	Workdir              string             `json:"workdir,omitempty"`
+	OperationID          string             `json:"operationId,omitempty"`
+	Text                 *string            `json:"text,omitempty"`
+	WantedHash           string             `json:"wantedHash,omitempty"`
+	FolderEntries        []ownedFolderEntry `json:"folderEntries,omitempty"`
+	activeTransferParent string
+}
+
+type ownedNoteVersion struct {
+	DocumentID string `json:"documentId"`
+	ParentID   string `json:"parentId"`
+	ETag       string `json:"etag"`
+	Hash       string `json:"hash"`
+}
+
+type ownedNoteReply struct {
+	Outcome        string                  `json:"outcome"`
+	Binding        string                  `json:"binding,omitempty"`
+	Observation    *ownedNoteObservation   `json:"observation,omitempty"`
+	MovedBaseline  *ownedNoteVersion       `json:"movedBaseline,omitempty"`
+	SourceRetained bool                    `json:"sourceRetained,omitempty"`
+	ConflictCopy   string                  `json:"conflictCopy,omitempty"`
+	AlternatePath  string                  `json:"alternatePath,omitempty"`
+	Folder         *ownedFolderObservation `json:"folder,omitempty"`
+}
+
+type ownedNoteObservation struct {
+	ownedNoteVersion
+	ModifiedMs int64 `json:"modifiedMs"`
+	Size       int64 `json:"size"`
+}
+
+func readOwnedNoteFrame(in io.Reader) (ownedNoteFrame, error) {
+	var message ownedNoteFrame
+	raw, err := io.ReadAll(io.LimitReader(in, maxOwnedFrame+1))
+	if err != nil || len(raw) > maxOwnedFrame {
+		return message, api.ErrConditionalRefused
+	}
+	// Decode one complete frame and refuse unknown fields or trailing input.
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&message) != nil || decoder.Decode(new(any)) != io.EOF ||
+		(!validOwnedNoteFrame("binding", message) && !validOwnedNoteFrame("inspect", message)) {
+		return ownedNoteFrame{}, api.ErrConditionalRefused
+	}
+	return message, nil
+}
+
+func validOwnedNoteFrame(operation string, message ownedNoteFrame) bool {
+	if operation == "binding" {
+		return message.Workdir != "" && message.Binding == "" && message.Path == "" && message.Source == "" &&
+			message.Expected == nil && message.OperationID == "" && message.Text == nil && message.WantedHash == "" && message.FolderEntries == nil
+	}
+	return message.Binding != "" && message.Path != ""
+}
+
+func ownedNoteDeadline(operation string) time.Duration {
+	if operation == "relocate" || operation == "reconcile-relocation" || operation == "inspect-folder" || operation == "relocate-folder" {
+		return 24 * time.Second
+	}
+	return 12 * time.Second
+}
+
+func init() {
+	command := &cobra.Command{
+		Use:    "bb-owned-note <operation> <bound-remote>",
+		Short:  "Run one scoped note operation through the inherited iCloud worker.",
+		Hidden: true,
+		Args:   cobra.ExactArgs(2),
+		RunE: func(_ *cobra.Command, args []string) error {
+			message, err := readOwnedNoteFrame(os.Stdin)
+			if err != nil {
+				return json.NewEncoder(os.Stdout).Encode(ownedNoteReply{Outcome: "refused"})
+			}
+			if !validOwnedNoteFrame(args[0], message) {
+				return json.NewEncoder(os.Stdout).Encode(ownedNoteReply{Outcome: "refused"})
+			}
+			if args[0] != "inspect" && args[0] != "inspect-relocation" && args[0] != "inspect-folder" {
+				release, admitted := admitOwnedMutation(args[0], &message)
+				if !admitted {
+					return json.NewEncoder(os.Stdout).Encode(ownedNoteReply{Outcome: "refused"})
+				}
+				defer release()
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), ownedNoteDeadline(args[0]))
+			defer cancel()
+			return json.NewEncoder(os.Stdout).Encode(applyOwnedNote(ctx, args[0], args[1], message))
+		},
+	}
+	cmd.Root.AddCommand(command)
+}
+
+func applyOwnedNote(ctx context.Context, operation, remote string, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	if !validOwnedNoteFrame(operation, request) || (operation != "inspect-folder" && operation != "relocate-folder" && request.FolderEntries != nil) {
+		return refused
+	}
+	if operation != "inspect" && operation != "replace" && operation != "recover" && operation != "create" && operation != "recover-create" && operation != "relocate" && operation != "binding" && operation != "inspect-relocation" && operation != "reconcile-relocation" && operation != "read-relocation-resolution" && operation != "inspect-folder" && operation != "relocate-folder" {
+		return refused
+	}
+	backend, name, root, config, err := fs.ConfigFs(remote)
+	if err != nil || name != "icloud" || root == "" || backend.Name != "iclouddrive" {
+		return refused
+	}
+	if operation == "read-relocation-resolution" {
+		// The exact workdir and move receipt already carry the scope.
+		// Checking the durable closure record needs no provider session.
+		return applyRelocationOperation(ctx, nil, request, operation)
+	}
+	selected, err := backend.NewFs(ctx, name, root, config)
+	if err != nil {
+		return uncertain
+	}
+	cloud, ok := selected.(*iclouddrive.Fs)
+	if !ok {
+		return refused
+	}
+	binding, err := cloud.BBMirrorBinding(ctx)
+	if err != nil {
+		return refused
+	}
+	if operation == "binding" {
+		return ownedNoteReply{Outcome: "bound", Binding: binding}
+	}
+	if binding != request.Binding {
+		return refused
+	}
+	if operation == "inspect-folder" {
+		return inspectOwnedFolder(ctx, cloud, request)
+	}
+	if operation == "relocate-folder" {
+		return applyOwnedFolderMove(ctx, cloud, request)
+	}
+
+	if operation == "relocate" || operation == "reconcile-relocation" || operation == "read-relocation-resolution" {
+		return applyRelocationOperation(ctx, cloud, request, operation)
+	}
+	if operation == "inspect-relocation" {
+		if request.Source == "" || request.Expected != nil || request.OperationID != "" || request.Text != nil || request.WantedHash != "" {
+			return refused
+		}
+		source, err := cloud.ObserveBBCreate(ctx, request.Source)
+		if err != nil || (!bisync.BBCaseRelocation(request.Source, request.Path) && !cloud.BBNoteAbsent(ctx, request.Path)) {
+			return refused
+		}
+		return observedOwnedNote("observed", source)
+	}
+	if request.Source != "" || (request.WantedHash != "" && operation != "recover" && operation != "recover-create") {
+		return refused
+	}
+	if operation == "inspect" {
+		if request.Expected != nil || request.Text != nil {
+			return refused
+		}
+		published, err := cloud.ObserveBBCreate(ctx, request.Path)
+		if errors.Is(err, fs.ErrorObjectNotFound) {
+			return ownedNoteReply{Outcome: "absent"}
+		}
+		if err != nil {
+			return uncertain
+		}
+		result := observedOwnedNote("observed", published)
+		if original, digest, ok := bisync.BBMovedNoteBaseline(request.Workdir, binding, request.Path); ok &&
+			original.DocumentID == published.Revision.DriveID && original.ParentID == published.Revision.ParentID {
+			result.MovedBaseline = &ownedNoteVersion{original.DocumentID, original.ParentID, original.ETag, hex.EncodeToString(digest[:])}
+		}
+		return result
+	}
+	if operation == "create" || operation == "recover-create" {
+		return applyOwnedCreate(ctx, cloud, operation, request)
+	}
+	return applyOwnedReplacement(ctx, cloud, operation, request)
+}
+
+type ownedReplacementCloud interface {
+	InspectBBNote(context.Context, string) (iclouddrive.BBNotePublication, error)
+	ReplaceBBNoteWithDispatch(context.Context, string, iclouddrive.BBNoteRevision, []byte, func() error) (iclouddrive.BBNotePublication, error)
+}
+
+type ownedCreationCloud interface {
+	ObserveBBCreate(context.Context, string) (iclouddrive.BBNotePublication, error)
+	CreateBBNote(context.Context, string, string, []byte, func(string) error) (iclouddrive.BBNotePublication, error)
+}
+
+func prepareOwnedDelivery(request ownedNoteFrame, create bool) (bisync.BBDeliveryIntent, []byte, bool) {
+	var data []byte
+	if request.Text != nil {
+		data = []byte(*request.Text)
+	}
+	intent := bisync.BBDeliveryIntent{OperationID: request.OperationID, Path: request.Path, Create: create}
+	if len(data) > 1<<20 || (data == nil && request.WantedHash == "") {
+		return intent, nil, false
+	}
+	if data != nil {
+		intent.Hash = sha256.Sum256(data)
+	}
+	if request.WantedHash != "" {
+		wanted, err := hex.DecodeString(request.WantedHash)
+		if err != nil || len(wanted) != sha256.Size || (data != nil && !bytes.Equal(wanted, intent.Hash[:])) {
+			return intent, nil, false
+		}
+		copy(intent.Hash[:], wanted)
+	}
+	return intent, data, true
+}
+
+func ownedRecoveryData(request ownedNoteFrame, intent bisync.BBDeliveryIntent, fallback []byte) ([]byte, error) {
+	staged, err := bisync.BBPendingDeliveryData(request.Workdir, intent)
+	if err != nil || staged != nil {
+		return staged, err
+	}
+	return fallback, nil
+}
+
+func applyOwnedReplacement(ctx context.Context, cloud ownedReplacementCloud, operation string, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	intent, data, valid := prepareOwnedDelivery(request, false)
+	if !valid || request.Expected == nil || (operation == "replace" && data == nil) {
+		return refused
+	}
+	prior := request.Expected
+	priorHash, err := hex.DecodeString(prior.Hash)
+	if err != nil || len(priorHash) != 32 || prior.DocumentID == "" || prior.ParentID == "" || prior.ETag == "" {
+		return refused
+	}
+	revision := iclouddrive.BBNoteRevision{DriveID: prior.DocumentID, ParentID: prior.ParentID, ETag: prior.ETag}
+	copy(revision.Hash[:], priorHash)
+	if err := bisync.BBCheckDeliveryDisjoint(request.Workdir, intent, revision.DriveID); err != nil {
+		return refused
+	}
+	stage, stageErr := bisync.BBReadDeliveryStage(request.Workdir, intent)
+	if stageErr != nil {
+		return uncertain
+	}
+	if operation == "recover" {
+		data, stageErr = ownedRecoveryData(request, intent, data)
+		if stageErr != nil {
+			return uncertain
+		}
+		if data == nil && (stage == bisync.BBDeliveryMissing || stage == bisync.BBDeliveryPrepared) {
+			if stage == bisync.BBDeliveryPrepared && bisync.BBResolveDelivery(request.Workdir, intent, nil) != nil {
+				return uncertain
+			}
+			return ownedNoteReply{Outcome: "cleared"}
+		}
+		now, err := cloud.InspectBBNote(ctx, request.Path)
+		if err != nil || now.Revision.DriveID != revision.DriveID || now.Revision.ParentID != revision.ParentID {
+			return uncertain
+		}
+		if now.Revision.ETag != revision.ETag && now.Revision.Hash == intent.Hash {
+			if stage == bisync.BBDeliveryDispatched {
+				if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: now.Modified, Size: now.Size, ProviderID: now.Revision.DriveID, ETag: now.Revision.ETag}); err != nil {
+					return uncertain
+				}
+			} else if stage != bisync.BBDeliveryRecorded && stage != bisync.BBDeliveryApplied {
+				return uncertain
+			}
+			return observedOwnedNote("published", now)
+		}
+		// A recovered retry is conditional on the original, freshly checked
+		// identity, revision and bytes. Even if the first request is still
+		// finishing remotely, only one request can use this ETag.
+		if data == nil || now.Revision.ETag != revision.ETag || now.Revision.Hash != revision.Hash ||
+			(stage != bisync.BBDeliveryPrepared && stage != bisync.BBDeliveryDispatched && stage != bisync.BBDeliveryMissing) {
+			return uncertain
+		}
+	}
+	if operation == "replace" || stage == bisync.BBDeliveryMissing {
+		if err := bisync.BBBeginDeliveryWithData(request.Workdir, intent, data, revision.DriveID); err != nil {
+			return refused
+		}
+	}
+	published, err := cloud.ReplaceBBNoteWithDispatch(ctx, request.Path, revision, data,
+		func() error { return bisync.BBDispatchDelivery(request.Workdir, intent) })
+	if errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+		if stage == bisync.BBDeliveryDispatched {
+			return uncertain
+		}
+		if err := bisync.BBResolveDelivery(request.Workdir, intent, nil); err != nil {
+			return uncertain
+		}
+		if operation == "recover" {
+			return ownedNoteReply{Outcome: "cleared"}
+		}
+		return refused
+	}
+	if err != nil {
+		return uncertain
+	}
+	if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: published.Modified, Size: published.Size, ProviderID: published.Revision.DriveID, ETag: published.Revision.ETag}); err != nil {
+		return uncertain
+	}
+	return observedOwnedNote("published", published)
+}
+
+func applyOwnedCreate(ctx context.Context, cloud ownedCreationCloud, operation string, request ownedNoteFrame) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	intent, data, valid := prepareOwnedDelivery(request, true)
+	if !valid || request.Expected != nil || (operation == "create" && data == nil) {
+		return refused
+	}
+	if err := bisync.BBCheckDeliveryDisjoint(request.Workdir, intent); err != nil {
+		return refused
+	}
+	expectedParent, err := bisync.BBExpectedCreationParent(request.Workdir, request.Binding, intent)
+	if err != nil {
+		return refused
+	}
+	if request.activeTransferParent != "" {
+		if expectedParent != "" && expectedParent != request.activeTransferParent {
+			return uncertain
+		}
+		expectedParent = request.activeTransferParent
+	}
+	create := cloud.CreateBBNote
+	if expectedParent != "" {
+		scoped, ok := cloud.(interface {
+			CreateBBNoteInParent(context.Context, string, string, string, []byte, func(string) error) (iclouddrive.BBNotePublication, error)
+		})
+		if !ok {
+			return uncertain
+		}
+		create = func(ctx context.Context, path, binding string, data []byte, dispatch func(string) error) (iclouddrive.BBNotePublication, error) {
+			return scoped.CreateBBNoteInParent(ctx, path, binding, expectedParent, data, dispatch)
+		}
+	}
+	stage, err := bisync.BBReadDeliveryStage(request.Workdir, intent)
+	if err != nil {
+		return uncertain
+	}
+	if operation == "recover-create" {
+		data, err = ownedRecoveryData(request, intent, data)
+		if err != nil {
+			return uncertain
+		}
+		if data == nil && (stage == bisync.BBDeliveryMissing || stage == bisync.BBDeliveryPrepared) {
+			if stage == bisync.BBDeliveryPrepared && bisync.BBResolveDelivery(request.Workdir, intent, nil) != nil {
+				return uncertain
+			}
+			return ownedNoteReply{Outcome: "cleared"}
+		}
+		current, err := cloud.ObserveBBCreate(ctx, request.Path)
+		if err == nil && current.Revision.Hash == intent.Hash {
+			if expectedParent != "" && current.Revision.ParentID != expectedParent {
+				return uncertain
+			}
+			issued, err := bisync.BBAllocatedDocument(request.Workdir, intent)
+			_, _, currentDocID := api.DeconstructDriveID(current.Revision.DriveID)
+			if err != nil || currentDocID != issued {
+				return uncertain
+			}
+			if stage == bisync.BBDeliveryDispatched {
+				if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: current.Modified, Size: current.Size, ProviderID: current.Revision.DriveID, ETag: current.Revision.ETag, ProviderParentID: current.Revision.ParentID}); err != nil {
+					return uncertain
+				}
+			} else if stage != bisync.BBDeliveryRecorded && stage != bisync.BBDeliveryApplied {
+				return uncertain
+			}
+			return observedOwnedNote("published", current)
+		}
+		if data == nil || !errors.Is(err, fs.ErrorObjectNotFound) || (stage != bisync.BBDeliveryMissing && stage != bisync.BBDeliveryPrepared) {
+			return uncertain
+		}
+	}
+	if operation == "create" || stage == bisync.BBDeliveryMissing {
+		var prepareErr error
+		switch {
+		case expectedParent == "":
+			prepareErr = bisync.BBBeginDeliveryWithData(request.Workdir, intent, data)
+		case request.activeTransferParent != "":
+			prepareErr = bisync.BBBeginDeliveryInTransfer(request.Workdir, intent, data, expectedParent)
+		default:
+			prepareErr = bisync.BBBeginDeliveryInMovedFolder(request.Workdir, intent, data, expectedParent)
+		}
+		if prepareErr != nil {
+			return refused
+		}
+	}
+	published, err := create(ctx, request.Path, request.Binding, data,
+		func(id string) error { return bisync.BBDispatchDelivery(request.Workdir, intent, id) })
+	if errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+		if err := bisync.BBResolveDelivery(request.Workdir, intent, nil); err != nil {
+			return uncertain
+		}
+		if operation == "recover-create" {
+			return ownedNoteReply{Outcome: "cleared"}
+		}
+		return refused
+	}
+	if err != nil {
+		return uncertain
+	}
+	if err := bisync.BBResolveDelivery(request.Workdir, intent, &bisync.BBDeliveryReceipt{BBDeliveryIntent: intent, Modified: published.Modified, Size: published.Size, ProviderID: published.Revision.DriveID, ETag: published.Revision.ETag, ProviderParentID: published.Revision.ParentID}); err != nil {
+		return uncertain
+	}
+	return observedOwnedNote("published", published)
+}
+
+func observedOwnedNote(outcome string, result iclouddrive.BBNotePublication) ownedNoteReply {
+	return ownedNoteReply{Outcome: outcome, Observation: &ownedNoteObservation{
+		ownedNoteVersion: ownedNoteVersion{result.Revision.DriveID, result.Revision.ParentID, result.Revision.ETag, hex.EncodeToString(result.Revision.Hash[:])},
+		ModifiedMs:       result.Modified.UnixMilli(), Size: result.Size,
+	}}
+}
+
+// The BB owner opens the same per-mirror mutation phase file for both
+// its fast command and its scheduled scan. Never substitute a CLI path.
+func admitOwnedMutation(operation string, request *ownedNoteFrame) (func() error, bool) {
+	workdir := request.Workdir
+	const phaseFD = 5
+	var stat unix.Stat_t
+	if unix.Fstat(phaseFD, &stat) != nil || int(stat.Uid) != os.Getuid() || stat.Nlink != 1 ||
+		stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Mode&0077 != 0 {
+		return nil, false
+	}
+	var bound, root unix.Stat_t
+	if !filepath.IsAbs(workdir) || filepath.Clean(workdir) != workdir ||
+		unix.Lstat(workdir, &root) != nil || root.Mode&unix.S_IFMT != unix.S_IFDIR || root.Mode&0077 != 0 || int(root.Uid) != os.Getuid() ||
+		unix.Lstat(filepath.Join(workdir, bisync.BBMutationLockName), &bound) != nil || bound.Dev != stat.Dev || bound.Ino != stat.Ino {
+		return nil, false
+	}
+	var name, document, parent string
+	if (operation == "replace" || operation == "recover") && request.Expected != nil {
+		name, document, parent = request.Path, request.Expected.DocumentID, request.Expected.ParentID
+	}
+	tryPrimary := func() bool { return unix.Flock(phaseFD, unix.LOCK_EX|unix.LOCK_NB) == nil }
+	if operation == "create" || operation == "recover-create" {
+		release, expectedParent, admitted := bisync.BBTryTransferCreationAdmission(workdir, request.Path, tryPrimary)
+		if admitted {
+			request.activeTransferParent = expectedParent
+		}
+		return release, admitted
+	}
+	return bisync.BBTryTransferWriteAdmission(workdir, name, document, parent, tryPrimary)
+}
