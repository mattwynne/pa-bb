+func TestBBOnlyVerifiedCloneTimestampsBypassAllChangedAbort(t *testing.T) {
+	original := sha256.Sum256([]byte("original"))
+	changed := sha256.Sum256([]byte("changed"))
+	move := &bisyncRun{
+		bbFolderReconcile: "known operation",
+		bbFolderChanges: map[string]bbFolderContentChange{
+			"folder/note.md":   {hashes: [2]*[sha256.Size]byte{&original, &original}},
+			"folder/asset.bin": {hashes: [2]*[sha256.Size]byte{&original, &original}},
+		},
+	}
+	observed := &deltaSet{
+		oldCount: 2,
+		deltas:   map[string]delta{"folder/note.md": deltaNewer, "folder/asset.bin": deltaOlder},
+	}
+	if !move.onlyAcknowledgedCloneTimestamps(observed) {
+		t.Fatal("proven timestamp-only differences still triggered whole-vault protection")
+	}
+	for _, change := range []delta{deltaDeleted, deltaNew, deltaLarger, deltaHash, deltaNewer | deltaLarger} {
+		observed.deltas["folder/asset.bin"] = change
+		if move.onlyAcknowledgedCloneTimestamps(observed) {
+			t.Fatalf("unsafe difference was accepted: %d", change)
+		}
+	}
+	observed.deltas["folder/asset.bin"] = deltaNewer
+	move.bbFolderChanges["folder/asset.bin"] = bbFolderContentChange{hashes: [2]*[sha256.Size]byte{&original, &changed}}
+	if move.onlyAcknowledgedCloneTimestamps(observed) {
+		t.Fatal("a changed payload bypassed whole-vault protection")
+	}
+	delete(move.bbFolderChanges, "folder/asset.bin")
+	if move.onlyAcknowledgedCloneTimestamps(observed) {
+		t.Fatal("an unproven path bypassed whole-vault protection")
+	}
+}
