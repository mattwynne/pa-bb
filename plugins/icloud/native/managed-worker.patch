+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+
+	"github.com/rclone/rclone/backend/iclouddrive"
+	"github.com/rclone/rclone/backend/iclouddrive/api"
+	"github.com/rclone/rclone/cmd/bisync"
+	"github.com/rclone/rclone/fs"
+)
+
+type relocationCloud interface {
+	ObserveBBCreate(context.Context, string) (iclouddrive.BBNotePublication, error)
+	CreateBBNote(context.Context, string, string, []byte, func(string) error) (iclouddrive.BBNotePublication, error)
+	TrashBBNote(context.Context, string, iclouddrive.BBNoteRevision, func() error) error
+	CheckBBNoteVersion(context.Context, string, iclouddrive.BBNoteRevision) (iclouddrive.BBNotePublication, error)
+}
+
+func applyOwnedRelocation(ctx context.Context, cloud relocationCloud, request ownedNoteFrame) ownedNoteReply {
+	return applyRelocationOperation(ctx, cloud, request, "relocate")
+}
+
+func applyRelocationOperation(ctx context.Context, cloud relocationCloud, request ownedNoteFrame, operation string) ownedNoteReply {
+	refused := ownedNoteReply{Outcome: "refused"}
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	if request.Expected == nil || request.Source == "" || len(request.Text) > 1<<20 {
+		return refused
+	}
+	previous := request.Expected
+	previousHash, err := hex.DecodeString(previous.Hash)
+	if err != nil || len(previousHash) != sha256.Size {
+		return refused
+	}
+	data := []byte(request.Text)
+	wanted := sha256.Sum256(data)
+	if request.WantedHash != "" {
+		raw, err := hex.DecodeString(request.WantedHash)
+		if err != nil || len(raw) != sha256.Size || (len(data) > 0 && wanted != [sha256.Size]byte(raw)) {
+			return refused
+		}
+		wanted = [sha256.Size]byte(raw)
+	} else if len(data) == 0 {
+		return refused
+	}
+	intent := bisync.BBRelocationIntent{
+		BBDeliveryIntent: bisync.BBDeliveryIntent{OperationID: request.OperationID, Path: request.Path, Hash: wanted, Create: true},
+		Source:           request.Source, Binding: request.Binding,
+		Previous:   bisync.BBIndexedVersion{DocumentID: previous.DocumentID, ParentID: previous.ParentID, ETag: previous.ETag},
+		SourceHash: [sha256.Size]byte(previousHash),
+	}
+	if operation != "relocate" {
+		if len(data) != 0 || request.WantedHash == "" {
+			return refused
+		}
+		return applyConflictResolution(ctx, cloud, request.Workdir, intent, operation == "reconcile-relocation")
+	}
+
+	sourceVersion := iclouddrive.BBNoteRevision{DriveID: previous.DocumentID, ParentID: previous.ParentID, ETag: previous.ETag, Hash: intent.SourceHash}
+
+	state, completed, err := bisync.BBReadRelocation(request.Workdir, intent)
+	if err != nil {
+		return uncertain
+	}
+	if completed != nil {
+		// The committed receipt already proved both endpoints. Later
+		// device edits do not invalidate this acknowledgement.
+		reply := observedOwnedNote("published", iclouddrive.BBNotePublication{
+			Revision: iclouddrive.BBNoteRevision{DriveID: completed.ProviderID, ParentID: completed.ProviderParentID, ETag: completed.ETag, Hash: completed.Hash},
+			Modified: completed.Modified, Size: completed.Size,
+		})
+		reply.SourceRetained = completed.SourceRetained
+		return reply
+	}
+	if state == nil {
+		// A recovery frame cannot open a new move. An operation whose
+		// local bytes vanished can only resume its exact native journal.
+		if len(data) == 0 {
+			return refused
+		}
+		source, err := cloud.ObserveBBCreate(ctx, request.Source)
+		if err != nil || source.Revision != sourceVersion {
+			return refused
+		}
+		if _, err := cloud.ObserveBBCreate(ctx, request.Path); !errors.Is(err, fs.ErrorObjectNotFound) {
+			return refused
+		}
+		if err := bisync.BBBeginRelocation(request.Workdir, intent, data); err != nil {
+			return refused
+		}
+		state = &bisync.BBRelocation{Intent: intent, Data: data}
+	}
+
+	if state.Conflict != nil {
+		return preserveRelocationConflict(ctx, cloud, request.Workdir, state)
+	}
+
+	var target iclouddrive.BBNotePublication
+	if state.Destination == nil {
+		if state.Allocation == "" {
+			target, err = cloud.CreateBBNote(ctx, request.Path, request.Binding, state.Data,
+				func(id string) error { return bisync.BBAllocateRelocation(request.Workdir, intent, id) })
+			if errors.Is(err, api.ErrConditionalConflict) || errors.Is(err, api.ErrConditionalRefused) {
+				if bisync.BBRefuseRelocation(request.Workdir, intent) == nil {
+					return refused
+				}
+			}
+		} else {
+			target, err = cloud.ObserveBBCreate(ctx, request.Path)
+			_, _, currentID := api.DeconstructDriveID(target.Revision.DriveID)
+			if err == nil && (currentID != state.Allocation || target.Revision.Hash != intent.Hash) {
+				return preserveRelocationConflict(ctx, cloud, request.Workdir, state)
+			}
+		}
+		if err != nil {
+			return uncertain
+		}
+		receipt := bisync.BBDeliveryReceipt{BBDeliveryIntent: intent.BBDeliveryIntent, Modified: target.Modified, Size: target.Size, ProviderID: target.Revision.DriveID, ProviderParentID: target.Revision.ParentID, ETag: target.Revision.ETag}
+		if err := bisync.BBRecordRelocationDestination(request.Workdir, intent, receipt); err != nil {
+			return uncertain
+		}
+		state, _, err = bisync.BBReadRelocation(request.Workdir, intent)
+		if err != nil || state == nil || state.Destination == nil {
+			return uncertain
+		}
+	}
+
+	// Re-read the destination immediately before source removal. A verified
+	// upload is insufficient once another client modified or replaced it.
+	expectedTarget := iclouddrive.BBNoteRevision{DriveID: state.Destination.ProviderID, ParentID: state.Destination.ProviderParentID,
+		ETag: state.Destination.ETag, Hash: intent.Hash}
+	if target.Revision != expectedTarget {
+		target, err = cloud.CheckBBNoteVersion(ctx, request.Path, expectedTarget)
+		if err != nil || !matchesRelocationTarget(intent, *state.Destination, target) {
+			return verifyRelocationDestinationDispute(ctx, cloud, request.Workdir, state, expectedTarget)
+		}
+	}
+	sourceNeedsReadback := state.Removing
+	if !state.Removing {
+		sourceNeedsReadback = cloud.TrashBBNote(ctx, request.Source, sourceVersion,
+			func() error { return bisync.BBDispatchRelocationTrash(request.Workdir, intent) }) != nil
+	}
+	sourcePresent := false
+	if sourceNeedsReadback {
+		current, err := cloud.ObserveBBCreate(ctx, request.Source)
+		switch {
+		case err == nil && current.Revision != sourceVersion:
+			// Another device owns this newer revision. Leave it intact.
+			sourcePresent = true
+		case errors.Is(err, fs.ErrorObjectNotFound):
+			// The exact source is already gone. No removal is needed.
+		default:
+			return uncertain
+		}
+	}
+	target, err = cloud.CheckBBNoteVersion(ctx, request.Path, expectedTarget)
+	if err != nil || !matchesRelocationTarget(intent, *state.Destination, target) {
+		return verifyRelocationDestinationDispute(ctx, cloud, request.Workdir, state, expectedTarget)
+	}
+	if sourceNeedsReadback {
+		err = bisync.BBFinishRelocationWithIndependentSource(request.Workdir, intent, sourcePresent)
+	} else {
+		err = bisync.BBFinishRelocation(request.Workdir, intent)
+	}
+	if err != nil {
+		return uncertain
+	}
+	reply := observedOwnedNote("published", target)
+	reply.SourceRetained = sourcePresent
+	return reply
+}
+
+func verifyRelocationDestinationDispute(ctx context.Context, cloud relocationCloud, workdir string, move *bisync.BBRelocation, expected iclouddrive.BBNoteRevision) ownedNoteReply {
+	current, err := cloud.ObserveBBCreate(ctx, move.Intent.Path)
+	if errors.Is(err, fs.ErrorObjectNotFound) || (err == nil && current.Revision != expected) {
+		return preserveRelocationConflict(ctx, cloud, workdir, move)
+	}
+	return ownedNoteReply{Outcome: "uncertain"}
+}
+
+// An independent destination is left untouched. Save the staged bytes
+// through a second conditional create and never advance the move's original
+// removal phase. Confirmation is distinct from successful relocation.
+func preserveRelocationConflict(ctx context.Context, cloud relocationCloud, workdir string, move *bisync.BBRelocation) ownedNoteReply {
+	uncertain := ownedNoteReply{Outcome: "uncertain"}
+	intent := move.Intent
+	copyIntent := intent.ConflictIntent()
+	conflict := move.Conflict
+	if conflict == nil {
+		if err := bisync.BBBeginRelocationConflict(workdir, intent); err != nil {
+			return uncertain
+		}
+		conflict = &bisync.BBRelocationConflict{}
+	}
+	if conflict.Copy != nil {
+		return ownedNoteReply{Outcome: "conflict_preserved", ConflictCopy: copyIntent.Path}
+	}
+	allocation := conflict.Allocation
+	var observed iclouddrive.BBNotePublication
+	var err error
+	if allocation == "" {
+		observed, err = cloud.CreateBBNote(ctx, copyIntent.Path, intent.Binding, move.Data, func(id string) error {
+			if err := bisync.BBAllocateRelocationConflict(workdir, intent, id); err != nil {
+				return err
+			}
+			allocation = id
+			return nil
+		})
+	} else {
+		observed, err = cloud.ObserveBBCreate(ctx, copyIntent.Path)
+	}
+	if err != nil || allocation == "" || observed.Revision.Hash != intent.Hash {
+		return uncertain
+	}
+	receipt := bisync.BBDeliveryReceipt{BBDeliveryIntent: copyIntent, DocumentID: allocation, ProviderID: observed.Revision.DriveID,
+		ProviderParentID: observed.Revision.ParentID, ETag: observed.Revision.ETag, Modified: observed.Modified, Size: observed.Size}
+	if err := bisync.BBRecordRelocationConflict(workdir, intent, receipt); err != nil {
+		return uncertain
+	}
+	return ownedNoteReply{Outcome: "conflict_preserved", ConflictCopy: copyIntent.Path}
+}
+
+func matchesRelocationTarget(intent bisync.BBRelocationIntent, receipt bisync.BBDeliveryReceipt, target iclouddrive.BBNotePublication) bool {
+	return target.Revision.DriveID == receipt.ProviderID && target.Revision.ParentID == receipt.ProviderParentID && target.Revision.ETag == receipt.ETag &&
+		target.Revision.Hash == intent.Hash && target.Size == receipt.Size
+}
