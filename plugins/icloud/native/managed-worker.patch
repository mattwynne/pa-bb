+)
+
+func TestBBFolderCloneVerifiesCompleteCopyBeforeRetiringAnyOriginal(t *testing.T) {
+	const from = "Projects/Active"
+	intent := BBFolderMoveIntent{
+		OperationID: "e1a2b6ae-0b51-4d83-adab-7ce02a86309b", Binding: "vault", Source: from, DestinationParent: "projects",
+		Entries: map[string]BBTreeIdentity{
+			from:                       {BBIndexedVersion: BBIndexedVersion{"original", "projects", "etag"}, Directory: true},
+			from + "/Nested":           {BBIndexedVersion: BBIndexedVersion{"nested", "original", "etag"}, Directory: true},
+			from + "/Nested/Bytes.bin": {BBIndexedVersion: BBIndexedVersion{"asset", "nested", "etag"}},
+		},
+		Hashes: map[string][sha256.Size]byte{from + "/Nested/Bytes.bin": sha256.Sum256([]byte("original"))},
+	}
+	for _, scenario := range []struct {
+		name     string
+		caseOnly bool
+	}{
+		{"Projects/Retitled", false}, {"Projects/active", true},
+	} {
+		intent.Path = scenario.name
+		steps, err := bbFolderCloneSteps(intent)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := []bbFolderCloneStep{
+			{bbCloneCreateStage, ""}, {bbCloneCreateDir, from}, {bbCloneCreateDir, from + "/Nested"},
+			{bbCloneCopyFile, from + "/Nested/Bytes.bin"}, {bbCloneVerifyTree, from},
+		}
+		if !scenario.caseOnly {
+			want = append(want, bbFolderCloneStep{bbClonePublish, from})
+		}
+		want = append(want,
+			bbFolderCloneStep{bbCloneRetire, from + "/Nested/Bytes.bin"}, bbFolderCloneStep{bbCloneRetire, from + "/Nested"},
+			bbFolderCloneStep{bbCloneRetire, from})
+		if scenario.caseOnly {
+			want = append(want, bbFolderCloneStep{bbClonePublish, from})
+		}
+		want = append(want, bbFolderCloneStep{bbCloneRetireStage, ""})
+		if !slices.Equal(steps, want) {
+			t.Fatalf("generated provider steps = %+v, expected %+v", steps, want)
+		}
+	}
+}
+
+func TestBBCaseCloneBaselineShiftKeepsExactNamesAndRefusesAnotherVariant(t *testing.T) {
+	const from, to = "Projects/ACTIVE", "Projects/active"
+	intent := BBFolderMoveIntent{
+		OperationID: "481b42ec-eb5e-4390-84cb-878aae7a5dcf", Binding: "vault",
+		Source: from, Path: to, DestinationParent: "projects",
+		Entries: map[string]BBTreeIdentity{
+			from:              {BBIndexedVersion: BBIndexedVersion{"original", "projects", "etag"}, Directory: true},
+			from + "/Note.md": {BBIndexedVersion: BBIndexedVersion{"file", "original", "etag"}},
+		},
+		Hashes: map[string][sha256.Size]byte{from + "/Note.md": sha256.Sum256([]byte("old"))},
+	}
+	old := newFileList()
+	old.put(from+"/Note.md", 3, time.Unix(1700000000, 0), "", "", "-")
+	shifted, err := relocateBBFolderBaseline(old, intent, false)
+	if err != nil || shifted.info[to+"/Note.md"] == nil || shifted.info[from+"/Note.md"] != nil {
+		t.Fatalf("case relocated listing = %+v, error = %v", shifted, err)
+	}
+	old.put("Projects/Active/Note.md", 1, time.Unix(1700000001, 0), "", "", "-")
+	if _, err := relocateBBFolderBaseline(old, intent, false); !errors.Is(err, ErrBBDeliveryUnsettled) {
+		t.Fatalf("case alias was not fenced: %v", err)
+	}
+}
