+		noteBefore:                     {"source-note", "source-parent", "original"},
+		stageAlias + "/Unconfirmed.md": {"partial-file", stage.DocumentID, "partial"},
+	}}, map[string]BBIndexedVersion{stageAlias: {stage.DocumentID, binding, "later-name"}}}
+	options.Resync = false
