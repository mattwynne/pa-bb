{
  "name": "bb-plugin-photos",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": "^22 || >=24", "bb": ">=0.50.1", "bbPluginSdk": ">=0.6.157 <1" },
  "bb": {
    "name": "Photos",
