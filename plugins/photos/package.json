  "dependencies": { "@modelcontextprotocol/client": "2.4.0", "zod": "4.6.7" },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157", "@types/better-sqlite3": "^7.6.13", "@types/node": "22.20.5",
    "@types/react": "19.2.7", "bb-app": "0.50.1", "better-sqlite3": "^13.0.3", "cron-parser": "^5.10.2",
    "hono": "^4.13.13", "playwright": "^1.65.1", "react": "19.2.0", "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bb plugin build", "typecheck": "tsc --noEmit && bb plugin types --check",
    "test": "node ../../scripts/sync-connection-ui.mjs --check && node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
