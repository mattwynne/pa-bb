{
  "name": "bb-plugin-obsidian",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.45.0",
    "bbPluginSdk": ">=0.6.132 <1"
  },
  "bb": {
    "name": "Obsidian",
    "description": "Read and edit connected iCloud vaults with attributed assistant tools.",
    "branding": {
      "icon": "Notebook"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@quartz-community/remark-obsidian": "2.2.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm-table": "2.1.1",
    "picomatch": "^4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "19.2.7",
    "bb-app": "0.45.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "playwright": "^1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "bb-app": { "npm": "11.21.3" }
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit && bb plugin types --check",
    "spec": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --import 'features/step_definitions/*.ts' --format progress",
    "test": "node ../../scripts/sync-connection-ui.mjs --check && npm run build && npm run spec && node --import tsx --test test/*.test.ts"
  }
}
