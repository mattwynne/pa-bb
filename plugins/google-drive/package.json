{
  "name": "bb-plugin-google-drive",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.45.0",
    "bbPluginSdk": ">=0.6.15 <1"
  },
  "bb": {
    "name": "Google Drive",
    "description": "Find Drive files and read Google Docs from connected accounts.",
    "branding": {
      "icon": "FolderOpen"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@get-bb/plugin-sdk": "0.6.80",
    "@types/react": "19.2.7",
    "bb-app": "0.45.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "fflate": "0.8.3",
    "hono": "^4.11.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit && bb plugin types --check",
    "test:docs": "cucumber-js --profile docs",
    "test:acceptance": "cucumber-js --profile oauth && npm run test:docs",
    "test": "node ../../scripts/sync-connection-ui.mjs --check && npm run build && npm --prefix ../google-calendar run build && npm run test:acceptance && node --test test/*.test.mjs"
  }
}
