# Allow only application source into the build context: never Git history or state.
**
!Dockerfile
!docker/
!docker/**
!plugins/
!plugins/**
# Keep local copies of upstream articles out of the image build context.
plugins/obsidian/docs/reference/help/
plugins/obsidian/docs/reference/developer/
!shared/
!shared/**
!AGENTS.md
!CONTRIBUTING.md
!README.md
**/node_modules
**/dist
**/.git
**/__pycache__
**/.env
**/.env.*
**/*.log
**/*.sqlite*
**/*.db
